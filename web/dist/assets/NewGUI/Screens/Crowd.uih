
Texture:(CrowdTex,Crowd2Multi.png)
Texture:(CrowdTex_COL,Crowd2Multi_LT1.png)
AnimModel:(CrowdLow,CrowdAnims,true)
AnimModel:(CrowdVLow,CrowdLowAnims,true)

Surf:($STADIUMLIGHTING,512,512,False)


//CrowdShirtHomeColourMacro
Macro:(M_ShirtHColour,?COL?,?NUM?)
	Draw:(CrowdTex_COL,6,0,64,64,,#FFFFFFFFFFFFFFFF)
		set(gel.colour,twk(Match,Team1Col))

	Draw:(CrowdTex_COL,134,0,64,64,,#FFFFFFFFFFFFFFFF)
		set(gel.colour,twk(Match,Team1Col))
EndM
//CrowdShirtAwayColourMacro
Macro:(M_ShirtAColour)
	Draw:(CrowdTex_COL,262,0,64,64,,#FFFFFFFFFFFFFFFF)     
		set(gel.colour,twk(Match,Team2Col))

	Draw:(CrowdTex_COL,390,0,64,64,,#FFFFFFFFFFFFFFFF)     
		set(gel.colour,twk(Match,Team2Col))
EndM

//------------------------------------------Recolour Crowd Home and Away
View:(CrowdTex,512,512)
	M_ONCE:()
{
	Sheet:(0,512,0,0,0,0,0,1,-1,1)
	{
		//Draw:(CrowdTex,0,0,512,512)
	  	//----------------------------------------------Away
		M_ShirtAColour:()

		//----------------------------------------------Home
		M_ShirtHColour:()
	}
}

