Macro:(M_Crowd)
	View:($STADIUMLIGHTING,512,512)
	{
		Sheet:()
		{
			Cls:(#FFFFFFFF)
		}
	}

	UseShader:(Crowd3D)
		Layer(Sky)
		SetSampler(TexSamp1,$STADIUMLIGHTING)
	{
		DrawEmbedded:(CROWD_E)
			set(gel.vis,twk(Populated,PitchStandE))
		DrawEmbedded:(CROWD_W)
			set(gel.vis,twk(Populated,PitchStandW))
		DrawEmbedded:(CROWD_S)
			set(gel.vis,twk(Populated,PitchStandS))
		DrawEmbedded:(CROWD_N)
			set(gel.vis,twk(Populated,PitchStandN))
		DrawEmbedded:(CROWD_6)
	}
	UseShader:(CrowdCorner3D)
		SetSampler(TexSamp1,$STADIUMLIGHTING)
	{
		DrawEmbedded:(CROWD_CORNER)
			set(gel.vis,twk(Populated,PitchCorners))
	}

EndM
