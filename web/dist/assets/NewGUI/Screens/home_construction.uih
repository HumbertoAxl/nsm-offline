Macro:(M_StandEConstruction4,?NUM?)
	Rect:() // Visibility set by tier selector
	{
		Rect:()
			M_CheckShowConstruction:(PitchStandE,?NUM?)
		{
			// Animated scaffold mesh for home screen
			Locator:((0,-150,0),(0,0,0),(1,1,1))
			{
				
				//------Crane
				//Column
				M_ConstructionCranePop_new:(-2105,3300,0,0,ConstructionPop,Diggerpop,Construction_Crane_Base,Construction_Crane_BaseB,Construction_Crane_Side,Construction_Crane_Sections,0.6,1,1)
				//Arm
				Locator:((-2105,3300,0),(0,0,0),(1,1,1))
					float(%t)
					add(%t,FrameTime*0.1)
					add(gel3d.rotz,0.01)
					set(gel3d.rotz,lerp(210,340,[sin(%t)+1]/2))
