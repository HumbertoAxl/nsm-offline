			M_CheckShowConstruction:(PitchStandN,?NUM?)
		{
			// Animated scaffold for home screen
			Locator:((100,-50,0),(0,0,-90),(1,1,1))
			{
				//Base
				//M_ConstructionBase_new:(0,100,-2,0,0,0,3,3.7,1.2)
										
				//Digger
