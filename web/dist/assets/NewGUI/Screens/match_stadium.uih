//---------------------------------------------General Pitch assets
StaticModel:(Stadium_CornerFlags_Lv_1,Stadium_CornerFlags_Lv_1)
StaticModel:(Stadium_CornerFlags_Shadows_Lv_1,Stadium_CornerFlags_Shadows_Lv_1)
StaticModel:(Ad_Pitch,Ad_Pitch)
StaticModel:(Ad_Pitch_Side,Ad_Pitch_Side)
			
//------------------------------------------Collision Tap Mesh
StaticModel:(BoxCollider,TESTCUBE,True)


//Make This Define Equal to a Texture Such as GoalNetTexture to show the colliders for the stadium
Define:(?MATCH_STADIUM_SHOW_COLLIDERS?=) 



//---------------------------------------Macros

//AC: Needs to be after texture definitions.
Import:(StadiumSteps.uih)

//--------------------------------------------------------------------------------------------Home
Macro:(M_StadiumBaseHome,?SCALE?)
Locator:((0,0,0),(0,0,0),(?SCALE?,?SCALE?,?SCALE?))
	{
		Rect:()
			Layer(Ground)
		{
			//-----------------------------------------------------Tier 0
			Rect:()
				set(gel.vis,twk(Facilities,PitchStandWLevel)=0)
			{
				UseShader:(ProjectedLight3DVCol)
					SetSampler(TexSamp1,$CLOUDSHADOW)
				{
					##IA
					DrawStaticModel:(Stadium_Base_Lv_0,GenBase)
					DrawStaticModel:(Stadium_Houses_Lv_0,HouseA)
					##P4N
					DrawStaticModel:(Stadium_Base_HI_Lv_0,Base_HI)
						M_TextureSelectW:()

					DrawStaticModel:(Stadium_Houses_HI_Lv_0,Buildings_HI)
						M_TextureSelectW:()
					##*
				}
				
				//Tree Shadows
				UseShader:(Simple3DNZW)
					Layer(Shadows)
				{
					##IA
					DrawStaticModel:(Stadium_Trees_Shadow_Lv_0,GenTrees)
						Blend(ONE,INV_IMAGE_ALPHA)
					##P4N
					DrawStaticModel:(Stadium_Trees_Shadow_HI_Lv_0,Trees_HI)
						Blend(ONE,INV_IMAGE_ALPHA)
						M_TextureSelectW:()
					##*
				}

				
				//Trees STANDARD
				##IA
				UseShader:(ProjectedLight3DVColOneBit)
					Layer(OneBit)
					SetSampler(TexSamp1,$CLOUDSHADOW)
				{
					DrawStaticModel:(Stadium_Trees_Lv_0,GenTrees)
						Blend(ONE,INV_IMAGE_ALPHA)
				}
				//Trees HIGH DETAIL
				##P4N
				UseShader:(ProjectedLight3DVColOneBit_Alt)
					SetSampler(TexSamp1,$CLOUDSHADOW)
					Layer(OneBit)
				{
					DrawStaticModel:(Stadium_Trees_HI_Lv_0,Trees_HI)
						Blend(ONE,INV_IMAGE_ALPHA)
						M_TextureSelectW:()
				}
				##*				

				//Vehicles
				UseShader:(ProjectedLight3DVCol)
					Layer(Ground)
					SetSampler(TexSamp1,$CLOUDSHADOW)
				{
					##IA
					Batch:(BatchedStandWT0Cars)
						Blend(ONE,INV_IMAGE_ALPHA)
					{
						M_Vehicle:(-2200,-3650,Car,Car,-90,Green)
						M_Vehicle:(-2200,-3350,Car,Car,-95,Black)
						M_Vehicle:(-2200,-3050,Car,Car,90,Cyan)
						M_Vehicle:(-1220,-3350,Car,Car,90,Red)
						M_Vehicle:(-1220,-3050,Car,Car,-90,White)
					}
					Batch:(BatchedStandWT0Vans)
						Blend(ONE,INV_IMAGE_ALPHA)
					{
						M_Vehicle:(-1220,-3650,Van,Van,90,Green)
					}
					##P4N
					Batch:(BatchedStandWT0CarsHI)
						Blend(ONE,INV_IMAGE_ALPHA)
						M_TextureSelect:(NSM_CarSheet_HI)
					{
						M_Vehicle_HI:(-2200,-3650,Car1_Type2,Car,-90)
						M_Vehicle_HI:(-2200,-3350,Car2_Type1,Car,-95)
						M_Vehicle_HI:(-2200,-3050,Car3_Type1,Car,90)
						M_Vehicle_HI:(-1220,-3350,Car1_Type3,Car,90)
						M_Vehicle_HI:(-1220,-3050,Car2_Type2,Car,-90)
					}
					M_Vehicle_HI_Single:(-1220,-3650,Van1_Type1,Van,90)
					##*

				}
			}

			//-----------------------------------------------------Tier 1
			Rect:()
				set(gel.vis,twk(Facilities,PitchStandWLevel)=1)
			{
				UseShader:(ProjectedLight3DVCol)
					SetSampler(TexSamp1,$CLOUDSHADOW)
				{
					##IA
					DrawStaticModel:(Stadium_Base_Lv_1,GenBase)
					DrawStaticModel:(Stadium_Houses_Lv_1,HouseA)
					##P4N
					DrawStaticModel:(Stadium_Base_HI_Lv_1,Base_HI)
						M_TextureSelectW:()

					DrawStaticModel:(Stadium_Houses_HI_Lv_1,Buildings_HI)
						M_TextureSelectW:()
					##*
				}
				
				//Tree Shadows
				UseShader:(Simple3DNZW)
					Layer(Shadows)
				{
					##IA
					DrawStaticModel:(Stadium_Trees_Shadow_Lv_1,GenTrees)
						Blend(ONE,INV_IMAGE_ALPHA)
					##P4N
					DrawStaticModel:(Stadium_Trees_Shadow_HI_Lv_1,Trees_HI)
						Blend(ONE,INV_IMAGE_ALPHA)
						M_TextureSelectW:()
					##*
				}

				//Trees STANDARD
				##IA
				UseShader:(ProjectedLight3DVColOneBit)
					Layer(OneBit)
					SetSampler(TexSamp1,$CLOUDSHADOW)
				{
					DrawStaticModel:(Stadium_Trees_Lv_1,GenTrees)
						Blend(ONE,INV_IMAGE_ALPHA)
				}
				//Trees HIGH DETAIL
				##P4N
				UseShader:(ProjectedLight3DVColOneBit_Alt)
					SetSampler(TexSamp1,$CLOUDSHADOW)
					Layer(OneBit)
				{
					DrawStaticModel:(Stadium_Trees_HI_Lv_1,Trees_HI)
						Blend(ONE,INV_IMAGE_ALPHA)
						M_TextureSelectW:()
				}
				##*

				//Vehicles
				UseShader:(ProjectedLight3DVCol)
					SetSampler(TexSamp1,$CLOUDSHADOW)
					Layer(Ground)
				{
					##IA
					Batch:(BatchedStandWT1Cars)
						Blend(ONE,INV_IMAGE_ALPHA)
					{
						M_Vehicle:(-2200,-3050,Car,Car,0,Blue)
						M_Vehicle:(-2040,-3050,Car,Car,182,Red)
						M_Vehicle:(-1860,-3050,Car,Car,-2,White)

						M_Vehicle:(-1325,-3650,Car,Car,0,Blue)
						M_Vehicle:(-1170,-3650,Car,Car,180,Orange)
					}

					M_Vehicle:(-1500,-3050,Van,Van,0,Red)

					##P4N
					Batch:(BatchedStandWT1CarsHI)
						Blend(ONE,INV_IMAGE_ALPHA)
						M_TextureSelect:(NSM_CarSheet_HI)
					{
						M_Vehicle_HI:(-2200,-3050,Car1_Type2,Car,0)
						M_Vehicle_HI:(-2040,-3050,Car2_Type1,Car,182)
						M_Vehicle_HI:(-1860,-3050,Car1_Type1,Car,-2)

						M_Vehicle_HI:(-1325,-3650,Car3_Type3,Car,0)
						M_Vehicle_HI:(-1170,-3650,Car2_Type2,Car,180)
					}
					M_Vehicle_HI_Single:(-1500,-3050,Van1_Type2,Van,0)
					##*

				}
			}
			
			//-----------------------------------------------------Tier 2
			Rect:()
				set(gel.vis,twk(Facilities,PitchStandWLevel)=2)
			{
				UseShader:(ProjectedLight3DVCol)
					SetSampler(TexSamp1,$CLOUDSHADOW)
				{
					##IA
					DrawStaticModel:(Stadium_Base_Lv_2,GenBase)
					##P4N
					DrawStaticModel:(Stadium_Base_HI_Lv_2,Base_HI)
						M_TextureSelectW:()
					##*
				}

				//Houses
				UseShader:(ProjectedLight3DVCol)
					SetSampler(TexSamp1,$CLOUDSHADOW)
				{
					##IA
					DrawStaticModel:(Stadium_Houses_Lv_2,HouseA)
					##P4N
					DrawStaticModel:(Stadium_Houses_HI_Lv_2,Buildings_HI)
						M_TextureSelectW:()
					Rect:() $HIDE
						.set(gel.vis,twk(Facilities,Night)=1)
					{
						DrawStaticModel:(Stadium_Houses_Lights_HI_Lv_2,Buildings_HI_Night)
					}
					##*
				}

				//Tree Shadows
				UseShader:(Simple3DNZW)
					Layer(Shadows)
				{
					##IA
					DrawStaticModel:(Stadium_Trees_Shadow_Lv_2,GenTrees)
						Blend(ONE,INV_IMAGE_ALPHA)
					##P4N
					DrawStaticModel:(Stadium_Trees_Shadow_HI_Lv_2,Trees_HI)
						Blend(ONE,INV_IMAGE_ALPHA)
						M_TextureSelectW:()
					##*
				}

				//Trees STANDARD
				##IA
				UseShader:(ProjectedLight3DVColOneBit)
					Layer(OneBit)
					SetSampler(TexSamp1,$CLOUDSHADOW)
				{
					DrawStaticModel:(Stadium_Trees_Lv_2,GenTrees)
						Blend(ONE,INV_IMAGE_ALPHA)
				}
				//Trees HIGH DETAIL
				##P4N
				UseShader:(ProjectedLight3DVColOneBit_Alt)
					SetSampler(TexSamp1,$CLOUDSHADOW)
					Layer(OneBit)
				{
					DrawStaticModel:(Stadium_Trees_HI_Lv_2,Trees_HI)
						Blend(ONE,INV_IMAGE_ALPHA)
						M_TextureSelectW:()
				}
				##*

				//Vehicles
				UseShader:(ProjectedLight3DVCol)
					SetSampler(TexSamp1,$CLOUDSHADOW)
					Layer(Ground)
				{
					##IA
					Batch:(BatchedStandWT2Cars)
						Blend(ONE,INV_IMAGE_ALPHA)
					{
						//Back
						M_Vehicle:(-1840,-3050,Car,Car,0,Blue)
						M_Vehicle:(-2030,-3050,Car,Car,-182,Red)
						M_Vehicle:(-2200,-3050,Car,Car,0,Cyan)
						//Front
