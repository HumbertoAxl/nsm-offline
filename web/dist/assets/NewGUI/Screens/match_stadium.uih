						M_Vehicle:(1380,-3600,Car,Car,0,Black)		
						M_Vehicle:(1210,-3600,Car,Car,0,White)
						M_Vehicle:(860,-3600,Car,Car,180,Blue)
						M_Vehicle:(550,-3600,Car,Car,0,Orange)
						M_Vehicle:(-150,-3600,Car,Car,0,Blue)
						M_Vehicle:(-470,-3600,Car,Car,170,White)					
					}
					Batch:(BatchedStandWT6Vans)
						Blend(ONE,INV_IMAGE_ALPHA)
					{
						//Front
						M_Vehicle:(220,-3600,Van,Van,0,Red)

						//RightSide
						M_Vehicle:(-4300,550,Van,Van,90,Red)
						M_Vehicle:(-4960,1630,Van,Van,95,White)
						M_Vehicle:(-4960,2270,Van,Van,-92,Green)
					}
					##P4N
					Batch:(BatchedStandWT6CarsHI)
						Blend(ONE,INV_IMAGE_ALPHA)
