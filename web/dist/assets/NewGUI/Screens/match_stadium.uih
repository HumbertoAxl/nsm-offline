//---------------------------------------------------------------------------------------------------------------------Goal

Macro:(M_Goal,?PX?,?PY?,?PZ?,?RZ?,?SCALE?,?REVSHADOW?,?LAYER?)
	Rect:()
		if(shell(GameScreen) = "match_interval" and(twk(MatchInterval,FormationCam) > 0 ))
		<
			.set(gel.vis,0)
		>
	{
		UseShader:(Static3D)
			SetUniform4F(SpecParams,0.7)
		{
			Locator:((?PX?,?PY?,?PZ?),(0,0,?RZ?),(?SCALE?,?SCALE?,?SCALE?))
			{
				UseShader:(ZSafeSprite)
					Layer(ZSprite)
				{
					If:(?REVSHADOW?=1)
						
						Draw:(GoalShadow2Rev,250,-225,434,212,,#FFFFFF50)
							.set(gel.vis,twk(Facilities,Night) = 0)
							Scale(-1.32,1.48)
						Draw:(GoalShadowNight,320,-225,492,333,,#FFFFFF50)
							.set(gel.vis,twk(Facilities,Night) = 1)
							Scale(-1.32,1.48)
					Else
						Draw:(GoalShadow2,-250,260,434,231,180,#FFFFFF50)
							.set(gel.vis,twk(Facilities,Night) = 0)
							Scale(-1.32,1.48)
						Draw:(GoalShadowNight,320,-230,492,333,,#FFFFFF50)
							.set(gel.vis,twk(Facilities,Night) = 1)
							Scale(-1.32,1.48)
					EndIf
				}

				DrawStaticModel:(GoalPosts,GoalPostsTexture)
					Layer(?LAYER?)
				DrawStaticModel:(GoalNet,GoalNetTexture)
					Layer(?LAYER?)
					Blend(ONE,INV_IMAGE_ALPHA)
			}
		}
	}
EndM