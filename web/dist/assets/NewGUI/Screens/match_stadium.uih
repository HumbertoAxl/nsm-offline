					{
						//Rightside Far
						M_Vehicle_HI:(-5995,-2730,Car1_Type1,Car,90)
						M_Vehicle_HI:(-6000,-2360,Car2_Type2,Car,-95)
						M_Vehicle_HI:(-6000,-2030,Car3_Type3,Car,-90)
						M_Vehicle_HI:(-5995,-1700,Car1_Type2,Car,90)
						M_Vehicle_HI:(-6005,-1470,Car1_Type3,Car,90)
						M_Vehicle_HI:(-6000,-1150,Car3_Type1,Car,90)

						M_Vehicle_HI:(-5995,-290,Car1_Type1,Car,90)
						M_Vehicle_HI:(-6000,50,Car2_Type2,Car,-95)
						M_Vehicle_HI:(-6000,405,Car3_Type1,Car,-90)
						M_Vehicle_HI:(-5995,715,Car1_Type2,Car,-90)
						M_Vehicle_HI:(-6005,900,Car2_Type3,Car,95)
						M_Vehicle_HI:(-6000,1240,Car1_Type3,Car,90)
						
						//Rightside Middle
						M_Vehicle_HI:(-4995,-3730,Car1_Type1,Car,-90)
						M_Vehicle_HI:(-5000,-3360,Car2_Type2,Car,-95)
						M_Vehicle_HI:(-5000,-3030,Car2_Type1,Car,90)
						M_Vehicle_HI:(-4995,-2700,Car1_Type3,Car,90)
						M_Vehicle_HI:(-5005,-2470,Car2_Type1,Car,-90)
						M_Vehicle_HI:(-5000,-2150,Car3_Type2,Car,90)

						M_Vehicle_HI:(-4995,-1330,Car1_Type3,Car,-90)
						M_Vehicle_HI:(-5000,-950,Car2_Type1,Car,95)
						M_Vehicle_HI:(-5000,-635,Car1_Type2,Car,90)
						M_Vehicle_HI:(-4995,-315,Car2_Type1,Car,-90)
						M_Vehicle_HI:(-5005,-100,Car1_Type2,Car,-95)
						M_Vehicle_HI:(-5000,240,Car3_Type1,Car,-90)

						//Rightside Near
						M_Vehicle_HI:(-4295,-2700,Car1_Type2,Car,-90)
						M_Vehicle_HI:(-4300,-2160,Car2_Type2,Car,-92)
						
						//Front
						M_Vehicle_HI:(1900,-3600,Car3_Type1,Car,180)
						M_Vehicle_HI:(1745,-3600,Car1_Type3,Car,0)
						M_Vehicle_HI:(1380,-3600,Car2_Type1,Car,0)		
						M_Vehicle_HI:(1210,-3600,Car1_Type2,Car,0)
						M_Vehicle_HI:(860,-3600,Car2_Type1,Car,180)
						M_Vehicle_HI:(550,-3600,Car3_Type2,Car,0)
						M_Vehicle_HI:(-150,-3600,Car1_Type3,Car,0)
						M_Vehicle_HI:(-470,-3600,Car2_Type3,Car,170)
					}
					Batch:(BatchedStandWT6VansHI)
						Blend(ONE,INV_IMAGE_ALPHA)
						M_TextureSelect:(NSM_VanSheet_HI)
					{
						//Front
						M_Vehicle_HI:(220,-3600,Van1_Type1,Van,0)

						//RightSide
						M_Vehicle_HI:(-4960,1630,Van1_Type2,Van,95)
						M_Vehicle_HI:(-4960,2270,Van1_Type1,Van,-92)
					}
					
					//Batch:(BatchedStandWT6CoachesHI)
						//Blend(ONE,INV_IMAGE_ALPHA)
					//{
						//Left
						M_Coach:(3050,-4050,Coach_HI,NSM_CoachSheet_HI,90,0.8)

