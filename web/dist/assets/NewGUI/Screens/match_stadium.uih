Macro:(M_PitchMow,?MOWTYPE?,?PITCHLEVEL?)
	Draw:(LowerPitchPattern?MOWTYPE?,34,20,2990,4260,,#FFFFFFFF)
		Handle(0.5,0.5)
		if(twk(FacilityView,Focused) = "Pitch")
		<
			if(twk(Facilities,PitchLevel) = 6)
			<
				if(twk(FacilityUpgrade,FacilityCurrentLevel) = 6)
				<
					set(gel.vis,twk(Pitch,PitchPattern)=?MOWTYPE?)
				>
				else
				<
					set(gel.vis,twk(Facilities,PitchLevelPreview)=?PITCHLEVEL?)
				>
			>
			elif(twk(FacilityUpgrade,FacilityCurrentLevel) >= 5)
			<
				set(gel.vis,twk(Pitch,PitchPattern)=?MOWTYPE?)
			>
			else
			<
				set(gel.vis,twk(Facilities,PitchLevelPreview)=?PITCHLEVEL?)
			>>
		>
		else
		<
			set(gel.vis,twk(Pitch,PitchPattern)=?MOWTYPE?)
		>
EndM

Macro:(M_3DPitchHome,?SCALE?)
	Locator:((0,0,0),(0,0,-90),(?SCALE?,?SCALE?,?SCALE?))
		Layer(Pitch)
	{
		UseShader:(ProjectedLight3DPitch)
			SetSampler(TexSamp1,$CLOUDSHADOW)
			##P4N
				SetUniform1F(tileScale,0.5)
			##IA
				SetUniform1F(tileScale,1)
			##*
			float(%PITCHLEVEL)
			if(twk(FacilityView,Focused) = "Pitch")
			<
				set(%PITCHLEVEL,twk(Facilities,PitchLevelPreview))
				
			>
			else
			<
				set(%PITCHLEVEL,twk(Facilities,PitchLevel))
			>
				if(%PITCHLEVEL = 1)
				<
					##P4N
					if(Player.weatherSeason = 3)
					<
						SetSampler(TexSamp2,pitch_mottle_1_Winter)
					>
					else
					<
						SetSampler(TexSamp2,pitch_mottle_1)
					>
					##IA
						SetSampler(TexSamp2,pitch_mottle_1)
					##*
				>
				elif(%PITCHLEVEL = 2)
				<
					##P4N
					if(Player.weatherSeason = 3)
					<
						SetSampler(TexSamp2,pitch_mottle_2_Winter)
					>
					else
					<
						SetSampler(TexSamp2,pitch_mottle_2)
					>
					##IA
						SetSampler(TexSamp2,pitch_mottle_2)
					##*
				>
				elif(%PITCHLEVEL = 3)
				<
					##P4N
					if(Player.weatherSeason = 3)
					<
						SetSampler(TexSamp2,pitch_mottle_3_Winter)
					>
					else
					<
						SetSampler(TexSamp2,pitch_mottle_3)
					>
					##IA
						SetSampler(TexSamp2,pitch_mottle_3)
					##*
				>
				elif(%PITCHLEVEL = 4)
				<
					##P4N
					if(Player.weatherSeason = 3)
					<
						SetSampler(TexSamp2,pitch_mottle_4_Winter)
					>
					else
					<
						SetSampler(TexSamp2,pitch_mottle_4)
					>
					##IA
						SetSampler(TexSamp2,pitch_mottle_4)
					##*
				>
				elif(%PITCHLEVEL = 5)
				<
					##P4N
					if(Player.weatherSeason = 3)
					<
						SetSampler(TexSamp2,pitch_mottle_5_Winter)
					>
					else
					<
						SetSampler(TexSamp2,pitch_mottle_5)
					>
					##IA
						SetSampler(TexSamp2,pitch_mottle_5)
					##*
				>
				elif(%PITCHLEVEL = 6)
				<
					##P4N
					if(Player.weatherSeason = 3)
					<
						SetSampler(TexSamp2,pitch_mottle_6_Winter)
					>
					else
					<
						SetSampler(TexSamp2,pitch_mottle_6)
					>
					##IA
						SetSampler(TexSamp2,pitch_mottle_6)
					##*
				>>>>>>
		{
			Locator:((0,0,0),(0,0,90),(1,1,1))
			{
				DrawStaticModel:(Stadium_Pitch,GrassTexture)
			}
		}
		
		UseShader:(default)
		{
			//-----------------------------------------------------------Pitch Mows
			//Hor 
			M_PitchMow:(1,2)

			//Ver
			M_PitchMow:(2,3)
			
			//Cheque
			M_PitchMow:(3,4)
			
			//Diag
			M_PitchMow:(4,5)
			
			//Circles
			M_PitchMow:(5,6)

			//Star
			M_PitchMow:(6,7)

			//Arcs
			M_PitchMow:(7,7)

			//Ball
			M_PitchMow:(8,7)
		}

		
		UseShader:(Simple3D)
		{
			//-----------------------------------------------------------Pitch Lines
			Locator:((0,0,-1),(0,0,0),(1,1,1))
			{
				DrawStaticModel:(Stadium_PitchLines_Lv_1,Stadium_PitchLines)
					Blend(ONE,INV_IMAGE_ALPHA)
			}
		} 

		//Bins
		UseShader:(ProjectedLight3DVCol)
			SetSampler(TexSamp1,$CLOUDSHADOW)
			Layer(Ground)
		{
			Rect:()

				set(gel.vis,twk(Facilities,PitchLevelVisible) oneof(0,1,2,3))
				
			{
				Locator:((0,0,0),(0,0,90),(0.98,0.98,0.99))
				{
					DrawStaticModel:(Stadium_Bins_Lv_1,Stadium_Lv_3)
						M_TextureSelectW:()
				}
			}
			//-------------------------------------------------Basic Dugout Tier 2 and 3
			Rect:()

				set(gel.vis,twk(Facilities,PitchLevelVisible) oneof(2,3))

			{	
				//Dugout Shadow
				Locator:((0,0,-1),(0,0,90),(1,1,1))
				{
					UseShader:(Simple3DNZW)
						Layer(Shadows)
					{
						Rect:()
							.set(gel.vis,twk(Facilities,Night) = 0)
						{
							DrawStaticModel:(Stadium_Dugout_Shadow_Lv_1,WallShadow)
								Blend(ONE,INV_IMAGE_ALPHA)
						}
					}
				}
					
				Locator:((0,0,0),(0,0,90),(1,1,1))
				{
					DrawStaticModel:(Stadium_Dugout_Lv_1,Stadium_Lv_3)
						Blend(ONE,INV_IMAGE_ALPHA)
						//M_TextureSelectW:()
				}
				
			}
			//---------------------------------------------------Standard Hoardings level 1 and 2
			Rect:()

				set(gel.vis,twk(Facilities,PitchLevelVisible)oneof(1,2))
			{
				//Adboard Shadow
				Locator:((0,0,-1),(0,-90,90),(1,1,1))
				{
					UseShader:(Simple3DNZW)
						Layer(Shadows)
					{
						Rect:()
							.set(gel.vis,twk(Facilities,Night) = 0)
						{
							DrawStaticModel:(Stadium_SidelineAds_Shadow_Lv_1,WallShadow)
								Blend(ONE,INV_IMAGE_ALPHA)
						}
					}
				}
				
				Locator:((0,0,0),(0,-90,90),(1,1,1))
				{
					DrawStaticModel:(Stadium_SidelineAds_A_Lv_1,$Pitch_Hoarding1)
					DrawStaticModel:(Stadium_SidelineAds_B_Lv_1,$Pitch_Hoarding2)
				}
			}

			//---------------------------------------------------Standard Hoardings level 3 and 4
			Rect:()
				set(gel.vis,twk(Facilities,PitchLevelVisible)oneof(3,4))	
			{
				//Adboard Shadow
				UseShader:(Simple3DNZW)
					Layer(Shadows)
				{
					Rect:()
						.set(gel.vis,twk(Facilities,Night) = 0)
					{
						Locator:((0,0,0),(0,-90,90),(1,1,1))
						{
							DrawStaticModel:(Stadium_SidelineAds_Shadow_Lv_2,WallShadow)
								Blend(ONE,INV_IMAGE_ALPHA)
						}
					}
				}

				Locator:((0,0,0),(0,-90,90),(1,1,1))
				{
					DrawStaticModel:(Stadium_SidelineAds_A_Lv_2,$Pitch_Hoarding1)
					DrawStaticModel:(Stadium_SidelineAds_B_Lv_2,$Pitch_Hoarding2)
					DrawStaticModel:(Stadium_SidelineAds_C_Lv_2,$Pitch_Hoarding3)
				}				

			}
			//---------------------------------------------------Standard Hoardings level 5 and 6
			Rect:()
				set(gel.vis,twk(Facilities,PitchLevelVisible)oneof(5,6))			
			{
				//Adboard Shadow
				UseShader:(Simple3DNZW)
					Layer(Shadows)
				{
					Rect:()
						.set(gel.vis,twk(Facilities,Night) = 0)
					{
						Locator:((0,0,-1),(0,-90,90),(1,1,1))
						{
							DrawStaticModel:(Stadium_SidelineAds_Shadow_Lv_3,WallShadow)
								Blend(ONE,INV_IMAGE_ALPHA)
						}
					}
				}
		
				Locator:((0,0,0),(0,-90,90),(1,1,1))
				{
					DrawStaticModel:(Stadium_SidelineAds_A_Lv_3,$Pitch_HoardingDIG1)
					DrawStaticModel:(Stadium_SidelineAds_Back_Lv_3,Adboard_Back)
				}
			}


		}

		UseShader:(ProjectedLight3DVColOneBit)
			Layer(OneBit)
		{
			//---------------------------------------------------North and South end Pitch Drawn Ads
			Rect:()
				set(gel.vis,twk(Facilities,PitchLevelVisible)oneof(5,6))
				Layer(OneBit)
			{	
				//SouthEast
				Locator:((-950,-2020,-5),(0,0,-90),(0.5,0.5,0.5))
				{
					DrawStaticModel:(Ad_Pitch,$Ad_Pitch)
					DrawStaticModel:(Ad_Pitch_Side,White)
				}
				//SouthWest
				Locator:((950,-2020,-5),(0,0,-90),(0.5,0.5,0.5))
				{
					DrawStaticModel:(Ad_Pitch,$Ad_Pitch)
					DrawStaticModel:(Ad_Pitch_Side,White)
				}
				//NorthWest
				Locator:((950,2020,-5),(0,0,90),(0.5,0.5,0.5))
				{
					DrawStaticModel:(Ad_Pitch,$Ad_Pitch)
					DrawStaticModel:(Ad_Pitch_Side,White)
				}
				//NorthEast
				Locator:((-950,2020,-5),(0,0,90),(0.5,0.5,0.5))
				{
					DrawStaticModel:(Ad_Pitch,$Ad_Pitch)
					DrawStaticModel:(Ad_Pitch_Side,White)
				}
			}
		}


		UseShader:(ProjectedLight3DVColOneBit)
				SetSampler(TexSamp1,$CLOUDSHADOW)
		{
			Rect:()
				set(gel.vis,twk(Facilities,PitchLevelVisible)oneof(1,2))
				Layer(OneBit)
			{	
				//--------------------------------------------------litter level 1 and 2
				DrawStaticModel:(Stadium_Litter_Lv_1,Stadium_Litter_Lv_1)
					Blend(ONE,INV_IMAGE_ALPHA)
					M_DayNightLitter:()	
			}
		}

		Rect:() 
			set(gel.vis,not(shell(GameScreen) oneof(tapball)))
		{
			//CornerFlagsShadows
			UseShader:(Simple3DNZW)
				Layer(Shadows)
			{
				Locator:((-35,0,0),(0,0,90),(1,1,1))
				{
					DrawStaticModel:(Stadium_CornerFlags_Shadows_Lv_1,WallShadow)
						Blend(ONE,INV_IMAGE_ALPHA)
				}
			}

			//CornerFlags
			UseShader:(ProjectedLight3DVCol)
				SetSampler(TexSamp1,$CLOUDSHADOW)
			{
				Locator:((-35,0,0),(0,0,90),(1,1,1))
				{
					##IA
					DrawStaticModel:(Stadium_CornerFlags_Lv_1,GenBase)
						Layer(Ground)
					##P4N
					DrawStaticModel:(Stadium_CornerFlags_Lv_1,Buildings_HI)
						Layer(Ground)
					##*
				}
			}

			//-----------------------------------------------------------Goals
			Rect:()
				set(gel.vis,not(shell(GameScreen) oneof("matchengine","tapball")))
			{
				M_Goal:(0,1950,0,0,1,1,AboveText)
				M_Goal:(0,-1950,0,180,1,,AboveText)
			}
		}
	
	}
		
EndM


Macro:(M_StadiumFadeCollisionBox,?POSX?,?POSY?,?POSZ?,?ROTX?,?ROTY?,?ROTZ?,?SCALEX?,?SCALEY?,?SCALEZ?,?STAND?)
	Locator:((?POSX?,?POSY?,?POSZ?),(?ROTX?,?ROTY?,?ROTZ?),(?SCALEX?,?SCALEY?,?SCALEZ?))
	{
		UseShader:(VertexLitFaded)
			SetUniform1F(Fade,%currentFade?STAND?)
		{
			DrawCollisionModel:(BoxCollider,)
				Blend(ONE,INV_IMAGE_ALPHA)
				StadiumModelFade(%targetFade?STAND?)
		}
	}
EndM


Macro:(M_LowerStadiumHome,?REF?,?SCALE?,?USE_COLLISION?)
	Locator:((0,0,0),(0,0,-90),(?SCALE?,?SCALE?,?SCALE?))
		Layer(Ground)
		float(%currentFadeN,%currentFadeS,%currentFadeE,%currentFadeW,%currentFadeC,%currentFadeA,%currentFadeFE,%currentFadeFW)
		float(%targetFadeN,%targetFadeS,%targetFadeE,%targetFadeW,%targetFadeC,%targetFadeA,%targetFadeFE,%targetFadeFW)
		init(%currentFadeN,1)
		init(%currentFadeS,1)
		init(%currentFadeE,1)
		init(%currentFadeW,1)
		init(%currentFadeC,1)
		init(%currentFadeA,1)
		init(%currentFadeFE,1)
		init(%currentFadeFW,1)
		init(%targetFadeN,1)
		init(%targetFadeS,1)
		init(%targetFadeE,1)
		init(%targetFadeW,1)
		init(%targetFadeC,1)
		init(%targetFadeA,1)
		init(%targetFadeFE,1)
		init(%targetFadeFW,1)
		frlerp(%currentFadeN,%targetFadeN,0.1)
		if(abs(%currentFadeN - %targetFadeN) <= 0.1)
		<
			set(%currentFadeN,%targetFadeN)
		>
		frlerp(%currentFadeS,%targetFadeS,0.1)
		if(abs(%currentFadeS - %targetFadeS) <= 0.1)
				<
			set(%currentFadeS,%targetFadeS)
		>
		frlerp(%currentFadeE,%targetFadeE,0.1)
		if(abs(%currentFadeE - %targetFadeE) <= 0.1)
		<
			set(%currentFadeE,%targetFadeE)
		>
		frlerp(%currentFadeW,%targetFadeW,0.1)
		if(abs(%currentFadeW - %targetFadeW) <= 0.1)
		<
			set(%currentFadeW,%targetFadeW)
		>
		frlerp(%currentFadeC,%targetFadeC,0.1)
		if(abs(%currentFadeC - %targetFadeC) <= 0.1)
		<
			set(%currentFadeC,%targetFadeC)
		>
		frlerp(%currentFadeA,%targetFadeA,0.1)
		if(abs(%currentFadeA - %targetFadeA) <= 0.1)
		<
			set(%currentFadeA,%targetFadeA)
		>
		frlerp(%currentFadeFE,%targetFadeFE,0.1)
		if(abs(%currentFadeFE - %targetFadeFE) <= 0.1)
		<
			set(%currentFadeFE,%targetFadeFE)
		>
		frlerp(%currentFadeFW,%targetFadeFW,0.1)
		if(abs(%currentFadeFW - %targetFadeFW) <= 0.1)
		<
			set(%currentFadeFW,%targetFadeFW)
		>
		set(%targetFadeN,1)
		set(%targetFadeS,1)
		set(%targetFadeE,1)
		set(%targetFadeW,1)
		set(%targetFadeC,1)
		set(%targetFadeA,1)
		set(%targetFadeFE,1)
		set(%targetFadeFW,1)
	{
		M_CrowdInit:()

		//Stadium Selection Hint
		Rect:()
			float(%show)
			set(%show,1)
			set(%show,%show and (twk(Facilities,PitchStandNLevel)=0))
			set(%show,%show and (twk(Facilities,PitchStandSLevel)=0))
			set(%show,%show and (twk(Facilities,PitchStandELevel)=1))
			set(%show,%show and (twk(Facilities,PitchStandWLevel)=0))
			set(%show,%show and (twk(Facilities,PitchLevel)=1))
			set(%show,%show and (twk(PitchStandNConstruction,CompletionTurn)<=twk(Construction,Turn)))
			set(%show,%show and (twk(PitchStandSConstruction,CompletionTurn)<=twk(Construction,Turn)))
			set(%show,%show and (twk(PitchStandEConstruction,CompletionTurn)<=twk(Construction,Turn)))
			set(%show,%show and (twk(PitchStandWConstruction,CompletionTurn)<=twk(Construction,Turn)))
			set(%show,%show and (twk(PitchConstruction,CompletionTurn)<=twk(Construction,Turn)))

			set(gel.vis,%show)
		{
			//?POSX?,?POSY?,?POSZ?,?VAR?,?NAME?,?SCALEX?,?SCALEY?,?TX?,?TY?,?TROT?,?IMAGE?,?IMAGESIZEX?,?IMAGESIZEY?,?IMAGEPOSY?,?TANG?)
			

			Rect:()
			set(gel.vis,(twk(ControllerInput,Enabled) = 0))
			{
				//Stadium Selection Hint W
				M_StadiumAreaSelection:(1000,10,-2,1,WestStand,2.5,18.3,1150,-450,0,Stadium,420,350,,90)
			
				//Stadium Selection Hint S
				M_StadiumAreaSelection:(-1295,-1335,-2,1,SouthStand,2.9,13,-1450,-800,90,Stadium,450,450,,-90)
			
				//Stadium Selection Hint N
				M_StadiumAreaSelection:(-1320,1370,-2,1,NorthStand,2.9,13,-1450,1800,-90,Stadium,450,450,,-90)
			}
				//Stadium Selection Hint Pitch
				M_AreaSelection:(0,0,-2,1,Pitch,13,19,0,400,-90,Stadium,620)
				
			
		}

