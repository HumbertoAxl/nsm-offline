		UseShader:(ProjectedLight3DVCol)
			Layer(Ground)
			SetSampler(TexSamp1,$CLOUDSHADOW)
		{
			//------------------------------Stadium Construction Phases
			Rect:()
				//.set(gel.vis,shell(GameScreen) = "matchengine")
				.set(twk(Populated,PitchStandE),1)
				.set(twk(Populated,PitchStandW),1)
				.set(twk(Populated,PitchStandS),1)
				.set(twk(Populated,PitchStandN),1)
				.set(twk(Populated,PitchCorners),1)
				set(gel.vis,twk(Match,PlayerAtHome) = 1 and(twk(Facilities,PitchStandNLevel) !=6 and(twk(Facilities,PitchStandELevel) !=6) and(twk(Facilities,PitchStandSLevel) !=6 and(twk(Facilities,PitchStandWLevel) !=6))))
			{			
				Locator:((0,0,0),(0,0,90),(1,1,1))
				{
					If:(?HOMEORMATCH?=HOME)
						//----------North Stand construction tiers

							Rect:()
								M_FacilityConstructionController:(PitchStandN,1,Yes)
								{	
								M_StandNConstruction1:(0)
								M_StandNConstruction1:(1)
								M_StandNConstruction1:(2)
								M_StandNConstruction1:(3)
								M_StandNConstruction4:(4)
								M_StandNConstruction5:(5)
							}
						
							Rect:()
								M_FacilityConstructionController:(PitchStandS,1,Yes)
							{
								M_StandSConstruction1:(0)
								M_StandSConstruction1:(1)
								M_StandSConstruction1:(2)
								M_StandSConstruction1:(3)
								M_StandSConstruction4:(4)
								M_StandSConstruction5:(5)
							}

							Rect:()
								M_FacilityConstructionController:(PitchStandW,1,Yes)
							{
								M_StandWConstruction1:(0)
								M_StandWConstruction1:(1)
								M_StandWConstruction1:(2)
								M_StandWConstruction1:(3)
								M_StandWConstruction4:(4)
								M_StandWConstruction4:(5)
							}
						
							Rect:()
								M_FacilityConstructionController:(PitchStandE,1,Yes)
							{
								Rect:() // Level 0
								M_StandEConstruction1:(1)
								M_StandEConstruction1:(2)
								M_StandEConstruction1:(3)
								M_StandEConstruction4:(4)
								M_StandEConstruction4:(5)
							}
							Rect:()
								M_FacilityConstructionController:(PitchCorners,1,Yes)
							{
								Rect:() // Level 0
								Rect:() // Level 1
								M_PitchCornersConstruction3:(2)
								M_PitchCornersConstruction3:(3)
								M_PitchCornersConstruction3:(4)
								M_PitchCornersConstruction5:(5)
							}					
						
					Else  //Use the cheaper match version

						//----------North Stand construction tiers
						UseShader:(ProjectedLight3DVColFaded)
							SetSampler(TexSamp1,$CLOUDSHADOW)

						{
							Rect:()
								M_FacilityConstructionController:(PitchStandN,1,Yes)
								SetUniform1F(Fade,%currentFadeN)
							{	
								M_MatchStandNConstruction1:(0)
								M_MatchStandNConstruction1:(1)
								M_MatchStandNConstruction1:(2)
								M_MatchStandNConstruction1:(3)
								M_MatchStandNConstruction4:(4)
								M_MatchStandNConstruction5:(5)
							}
						
							Rect:()
								M_FacilityConstructionController:(PitchStandS,1,Yes)
								SetUniform1F(Fade,%currentFadeS)
							{
								M_MatchStandSConstruction1:(0)
								M_MatchStandSConstruction1:(1)
								M_MatchStandSConstruction1:(2)
								M_MatchStandSConstruction1:(3)
								M_MatchStandSConstruction4:(4)
								M_MatchStandSConstruction5:(5)
							}

							Rect:()
								M_FacilityConstructionController:(PitchStandW,1,Yes)
								SetUniform1F(Fade,%currentFadeW)
							{
								M_MatchStandWConstruction1:(0)
								M_MatchStandWConstruction1:(1)
								M_MatchStandWConstruction1:(2)
								M_MatchStandWConstruction1:(3)
								M_MatchStandWConstruction4:(4)
								M_MatchStandWConstruction4:(5)
							}
						
							Rect:()
								M_FacilityConstructionController:(PitchStandE,1,Yes)
								SetUniform1F(Fade,%currentFadeE)
							{
								Rect:() // Level 0
								M_MatchStandEConstruction1:(1)
								M_MatchStandEConstruction1:(2)
								M_MatchStandEConstruction1:(3)
								M_MatchStandEConstruction4:(4)
								M_MatchStandEConstruction4:(5)
							}
							Rect:()
								M_FacilityConstructionController:(PitchCorners,1,Yes)
								SetUniform1F(Fade,%currentFadeC)
							{
								Rect:() // Level 0
								Rect:() // Level 1
								M_MatchPitchCornersConstruction3:(2)
								M_MatchPitchCornersConstruction3:(3)
								M_MatchPitchCornersConstruction3:(4)
								M_MatchPitchCornersConstruction5:(5)
							}					
						}
					EndIf
				}
			}
			
			Import:(stand_east.uih)
			Import:(stand_south.uih)
			Import:(stand_west.uih)
			Import:(stand_north.uih)
			Import:(stand_corners.uih)

			//----------------------------------------------------------------------Single upgrade Tier 6
			Rect:()
				set(gel.vis,twk(Facilities,PitchStandNLevelVisible)= 6)
			{
				//----------------------------------------------------------------Shadow ALL
				Rect:()
					.set(gel.vis,twk(Facilities,Night) = 0)
				{
					Locator:((0,0,3),(0,0,90),(1,1,1))
					{
						UseShader:(Simple3DNZW)
							Layer(Shadows)
						{
							DrawStaticModel:(Stadium_Shadow_Lv_6,Stadium_T6_Shadows)
								Blend(ONE,INV_IMAGE_ALPHA)
						}
					}
				}
				Locator:((0,0,0),(0,0,90),(1,1,1))
				{
					//----------------------------------------------------------------Day Assets
					Rect:() $HIDE
						set(gel.vis,twk(Facilities,Night) = 0)
					{
						//Seats Base Tier
						DrawStaticModel:(Stadium_Outer_Lv_6,Stadium_Lv_6)
							Blend(ONE,INV_IMAGE_ALPHA)
						DrawStaticModel:(Stadium_Inner_Lv_6,Stadium_Lv_6)
							Blend(ONE,INV_IMAGE_ALPHA)
					}

					//----------------------------------------------------------------Night Assets
					##P4N
					Rect:() $HIDE
						set(gel.vis,twk(Facilities,Night) = 1)
					{
						//Seats Base Tier
						DrawStaticModel:(Stadium_Inner_Lv_6_Night, Stadium_Lv_6)
							Blend(ONE,INV_IMAGE_ALPHA)
							M_TextureSelectW:()
						DrawStaticModel:(Stadium_Outer_Lv_6_Night,Stadium_Lv_6)
							Blend(ONE,INV_IMAGE_ALPHA)
							M_TextureSelectW:()
					}
					##*
				}

				//----------------------------------------------------------------Lower Ad Ring ALL
				Locator:((0,0,0),(0,-90,90),(1,1,1))
				{	
					DrawStaticModel:(Stadium_Inner_Ad_A_Lv_6,$Pitch_Hoarding2)
						Blend(ONE,INV_IMAGE_ALPHA)
					DrawStaticModel:(Stadium_Inner_Ad_B_Lv_6,$Pitch_Hoarding3)
						Blend(ONE,INV_IMAGE_ALPHA)
					DrawStaticModel:(Stadium_Inner_Ad_C_Lv_6,$Pitch_Hoarding1)
						Blend(ONE,INV_IMAGE_ALPHA)
				}

				//-----------------------------------------------------------------Roof
				Rect:()
					if(shell(GameScreen) != "matchengine" or(twk(Pitch,Scale) < 1.85))
					<
						set(gel.vis,1)
					>
					else
					<
						set(gel.vis,0)
					>
					strvar(%rlayer)
					if(%currentFadeA <1.0)
					<
						set(%rlayer,Text)
					>
					else
					<
						set(%rlayer,RoofSolid)
					>
				{
					//Roof n Ads
					UseShader:(ProjectedLight3DVColFaded)
    					SetSampler(TexSamp1,$CLOUDSHADOW)
    					SetUniform1F(Fade,%currentFadeA)
    					set(gel.layer,%rlayer)
					{
						Locator:((0,0,0),(0,0,90),(1,1,1))
						{
							
							//---------------------------------------------------------------Day Assets
							Rect:() $HIDE
							set(gel.vis,twk(Facilities,Night) = 0)
							{
								//Mid
								DrawStaticModel:(Stadium_Outer_Mid_Lv_6,Stadium_Lv_6)
									Blend(ONE,INV_IMAGE_ALPHA)
								DrawStaticModel:(Stadium_Inner_Mid_Lv_6,Stadium_Lv_6)
									Blend(ONE,INV_IMAGE_ALPHA)
								//Roof
								DrawStaticModel:(Stadium_Outer_Roof_Lv_6,Stadium_Lv_6)
									Blend(ONE,INV_IMAGE_ALPHA)
								DrawStaticModel:(Stadium_Inner_Roof_Lv_6,Stadium_Lv_6)
									Blend(ONE,INV_IMAGE_ALPHA)
							}

							//Signs
							DrawStaticModel:(Stadium_Signs_Lv_6,Stadium_Adverts_Lv_3)
								Blend(ONE,INV_IMAGE_ALPHA)
								M_TextureSelectW:()
						
							//---------------------------------------------------------------Night Assets
							##P4N
							Rect:() $HIDE
								set(gel.vis,twk(Facilities,Night) = 1)
							{
								//Mid
								DrawStaticModel:(Stadium_Outer_Mid_Lv_6_Night,Stadium_Lv_6)
									Blend(ONE,INV_IMAGE_ALPHA)
									M_TextureSelectW:()
								DrawStaticModel:(Stadium_Inner_Mid_Lv_6_Night,Stadium_Lv_6)
									Blend(ONE,INV_IMAGE_ALPHA)
									M_TextureSelectW:()
								//Roof
								DrawStaticModel:(Stadium_Outer_Roof_Lv_6_Night,Stadium_Lv_6)
									Blend(ONE,INV_IMAGE_ALPHA)
									M_TextureSelectW:()
								DrawStaticModel:(Stadium_Inner_Roof_Lv_6_Night,Stadium_Lv_6)
									Blend(ONE,INV_IMAGE_ALPHA)
									M_TextureSelectW:()
								
								//Floodlights
								UseShader:(Simple3DNZW)
									Layer(RoofSolid)
								{
									Rect:()
										.set(gel.vis,(twk(Facilities,Night) = 1) and(shell(GameScreen) !="matchengine"))
									{
										DrawStaticModel:(Stadium_Roof_Lights_Lv_6_Night,Floodlight_Beam)
											Blend(ONE,INV_IMAGE_ALPHA)
									

										DrawStaticModel:(Stadium_LightGlow_Lv_6,Floodlight_Glow)
											Blend(ONE,INV_IMAGE_ALPHA)
									}
								}
							}
							##*
						}

						//Upper Ad Ring
						Locator:((0,0,0),(0,-90,90),(1,1,1))
						{
							DrawStaticModel:(Stadium_Inner_Roof_Ad_A_Lv_6,$Pitch_Hoarding1)
								Blend(ONE,INV_IMAGE_ALPHA)
							DrawStaticModel:(Stadium_Inner_Roof_Ad_B_Lv_6,$Pitch_Hoarding2)
								Blend(ONE,INV_IMAGE_ALPHA)
							DrawStaticModel:(Stadium_Inner_Roof_Ad_C_Lv_6,$Pitch_Hoarding3)
								Blend(ONE,INV_IMAGE_ALPHA)
						}
					}
				}

			
				//Front Sign - colour bg name and badge
				//POSX,POSY,POSZ,ROTX,ROTY,ROTZ,BGW,BGH,BADGEX,BADGEY,BADGESIZE,TEXTX,TEXTY,TEXTW,FONTSIZE,FADE1X,FADE1Y,FADE1W,FADE1H,FADE2X,FADE2Y,FADE2W,FADE2H,SHADER
				M_StadTeamNameAndBadge:(3025,457,-400,0,-90,-90,827,90,80,44,85,475,7,680,KNUL64,1,-1,-50,829,35,-1,50,829,45,ZSafeSprite,,40)
					Layer(ZSprite)

				Rect:()
					set(gel.vis,(shell(GameScreen) != "matchengine" or(twk(Pitch,Scale) < 1.85)))
				{
					//Team Badge Left front
					M_StadTeamBadge:(3105,60,-1030,0,-90,-90,330,ZSafeSprite,A)	
						Layer(ZSprite)		

					//Roof Sign South- colour bg name and badge
					Locator:((-650,-3365,-1630),(3,0,0),(1,1,1))
						set(gel.vis,%currentFadeA =1)
					{
						UseShader:(ZSafeSprite)
						{
							//TeamBadge	Home
							Draw:($STADBADGESURF,-260,240,370,370,,#FFFFFFFFFFFFFFFF)
								Blend(ONE,INV_IMAGE_ALPHA)
								Handle(0.5,0.5)
								Layer(ZSprite)
						}
						//TeamName
						UseShader:(ZSafeGradient)
							SetUniformColour(gradbot,#606060FF)
							SetUniformColour(gradtop,twk(Player,HomeShirtCol1))
							SetUniform4F(gradposfade,120,260,%currentFadeA)
						{
							M_Text:(NEW STAR FC,950,145,,200,C,C,Text,Outline,Upper,0,0,#00000000,NoItalics,#FFFFFFFF,ref)
								.set(gel.text,(twk(Player,TeamName)))
								M_Style:(Outline,#BBBBBB60)
								.set(gel.scale,min(1,300/%gfw))
								FontScale(6,7.5)
						}								
					}

					// Roof Sign North- Stad Name
					Rect:()
						set(gel.vis,(twk(Match,PlayerAtHome)=1) and (%currentFadeA =1))
					{
						Locator:((650,3465,-1630),(-3,0,180),(1,1,1))
						{
							//StadName
							UseShader:(ZSafeGradient)
								SetUniformColour(gradbot,#606060FF)
								SetUniformColour(gradtop,twk(Player,HomeShirtCol1))
								SetUniform4F(gradposfade,120,260,%currentFadeA)
							{
								M_Text:(NEW STAR FC,650,145,,200,C,C,Text,Outline,Upper,0,0,#00000000,NoItalics,#FFFFFFFF,ref)
									.set(gel.text,(twk(Player,StadiumName)))
									M_Style:(Outline,#BBBBBB60)
									.set(gel.scale,min(1,300/%gfw))
									FontScale(6,7.5)
							}							
						}
					}
