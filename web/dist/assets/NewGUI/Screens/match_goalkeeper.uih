M_GoalkeeperAnimCustomName:(DiveLow_Dive,DiveLow,39,Clamp,0,17)
M_GoalkeeperAnimCustomName:(DiveLow_GetUp,DiveLow,51,Clamp,17,41)
M_GoalkeeperAnim:(JumpUpFall,84,Clamp,3,41)
M_GoalkeeperAnim:(JumpUpDown,64,Clamp,4,19)
M_GoalkeeperAnim:(JumpUpDownFail,64,Clamp,4,19)
