Import:(match_common.uih)
Import:(match_goalkeeperTexture.uih)

AnimModel:(GoalkeeperModel,Goalkeeper)


Macro:(M_GoalkeeperAnim,?SEQNAME?,?ANIMLENGTH?,?ANIMTYPE?,?SEQSTART?,?SEQEND?)
	Animation:(?ANIMLENGTH?,?ANIMTYPE?) ref:Goalkeeper?SEQNAME?
	{
		ModelSequence:(GoalkeeperModel,?SEQNAME?,?SEQSTART?,?SEQEND?) ref:?SEQNAME?
	}
EndM
Macro:(M_GoalkeeperAnimCustomName,?ANIMNAME?,?SEQNAME?,?ANIMLENGTH?,?ANIMTYPE?,?SEQSTART?,?SEQEND?)
	Animation:(?ANIMLENGTH?,?ANIMTYPE?) ref:Goalkeeper?ANIMNAME?
	{
		ModelSequence:(GoalkeeperModel,?SEQNAME?,?SEQSTART?,?SEQEND?) ref:?ANIMNAME?
	}
EndM


M_GoalkeeperAnim:(Run,42,Loop,0,15)
M_GoalkeeperAnim:(StandCasual,90,Loop,0,19)
M_GoalkeeperAnim:(StandReady,60,Loop,0,15)
M_GoalkeeperAnim:(StandCollectKnees,50,Clamp,0,21)
M_GoalkeeperAnim:(StandWithBall,90,Loop,0,15)
