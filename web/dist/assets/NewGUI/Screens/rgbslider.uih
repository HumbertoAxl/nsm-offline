Macro:(M_ColourPickerButton,?CAT?,?TWK?,?MSG?,?COLOUR?,?REFPREFIX?)  
    Rect:(0,0,[@W/13],[@W/13]) ref:?REFPREFIX??COLOUR?
        colvar(%colour)
        init(%colour,#?COLOUR?)
        if(%parentPressed)
        <
            Press()
            <
                :Message(?MSG?,#?COLOUR?)
            >
        >
        CTRLPress(?BTNOK?)
        <
            :Message(?MSG?,#?COLOUR?)
        >
        CTRLSelect(CTRLKitColourPicker,-12,-12,[@W/13],[@W/13])
    {
        Draw:(White,0,0,[@W/13],[@W/13],,#?COLOUR?FFFFFFFF)

        Rect:()
            set(gel.vis,(twk(?CAT?,?TWK?) = #?COLOUR?) and(twk(ControllerInput,Enabled) = 0))
            Layer(AboveText)
        {
            Draw:(White,0,0,[@W/13],3,,#404040FF)
            Draw:(White,0,0,3,[@W/13],,#404040FF)
            Draw:(White,0,[@W/13]-3,[@W/13],3,,#404040FF)
            Draw:(White,[@W/13]-3,0,3,[@W/13],,#404040FF)

            Draw:(White,1,1,[@W/13]-3,1,,#FFFFFFFF)
            Draw:(White,1,1,1,[@W/13]-3,,#FFFFFFFF)
            Draw:(White,1,[@W/13]-2,[@W/13]-3,1,,#FFFFFFFF)
            Draw:(White,[@W/13]-2,1,1,[@W/13]-2,,#FFFFFFFF)
        }
    } 
EndM


Macro:(M_GoalieColourPickerButton,?CAT?,?TWK?,?MSG?,?COLOUR?,?REFPREFIX?)  
    Rect:(0,0,[@W/6],[@W/6]) ref:?REFPREFIX??COLOUR?
        colvar(%colour)
        init(%colour,#?COLOUR?)
        if(%parentPressed)
        <
            Press()
            <
               :Message(?MSG?,#?COLOUR?)
            >
        >
         CTRLPress(?BTNOK?)
        <
            :Message(?MSG?,#?COLOUR?)
        >
        CTRLSelect(CTRLGoalieColourPicker,-26,-26,@W,@H)
    {
        Draw:(White,0,0,[@W/6],[@W/6],,#?COLOUR?FFFFFFFF)

        Rect:()
            set(gel.vis,(twk(?CAT?,?TWK?) = #?COLOUR?) and(twk(ControllerInput,Enabled) = 0))
            Layer(AboveText)
        {
            Draw:(White,0,0,[@W/6],3,,#404040FF)
            Draw:(White,0,0,3,[@W/6],,#404040FF)
            Draw:(White,0,[@W/6]-3,[@W/6],3,,#404040FF)
            Draw:(White,[@W/6]-3,0,3,[@W/6],,#404040FF)

            Draw:(White,1,1,[@W/6]-3,1,,#FFFFFFFF)
            Draw:(White,1,1,1,[@W/6]-3,,#FFFFFFFF)
            Draw:(White,1,[@W/6]-2,[@W/6]-3,1,,#FFFFFFFF)
            Draw:(White,[@W/6]-2,1,1,[@W/6]-2,,#FFFFFFFF)
        }
    } 
EndM


Macro:(M_ColourPickerGrid,?X?,?Y?,?W?,?H?,?CAT?,?TWK?,?MSG?,?REF?)
