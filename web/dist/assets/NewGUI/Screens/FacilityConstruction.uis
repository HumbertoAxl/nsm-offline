Macro:(M_ConstructionLevel1Exp,?VAR?,?NUM?,?FACNUM?)
		float(%level0Constructed)
		// Loaded back into the screen whilst Level 0 to 1 Construction was underway - turn it off
		.if(twk(?VAR?Construction,LastConstructionLevel) = 0 and(twk(Facilities,?VAR?Level) = ?NUM?) and(twk(?VAR?Construction,UnderConstruction) = 1))
		<
			set(%level0Constructed,2)
		>


		if(%level0Constructed = 1)
		<
			Delay(3)
			set(%level0Constructed,2)
		>


		if(shell(Facility) != "")
		<
			set(gel.vis,twk(?VAR?Construction,LastConstructionLevel)=?NUM? and(twk(Facilities,?VAR?Level) = ?NUM?))
		>
		else
		<
			if(%level0Constructed = 0 and(twk(?VAR?Construction,LastConstructionLevel) = 0 and(twk(Facilities,?VAR?Level) = ?NUM?)))
			<
				.set(%level0Constructed,1)
			>

			if(%level0Constructed >= 1)
			<
				:set(twk(?VAR?Construction,TimeRemaining),1)
				set(gel.vis,twk(Facilities,?VAR?Level) = ?NUM?)
				
				if(twk(Home,CurrentFacility) = ?FACNUM?)
				<
					if(%level0Constructed >= 2)
					<
						set(twk(?VAR?Construction,LastConstructionLevel),?NUM?)
						set(twk(?VAR?Construction,UnderConstruction),0)
						set(twk(?VAR?Construction,TimeRemaining),0)
						// After we're gone through all the states reset it to 0
						set(%level0Constructed,0)
					>
				>
			>
			else
			<
				set(gel.vis,twk(Facilities,?VAR?Level) = ?NUM?)
			>
		>
EndM

Macro:(M_CheckShowCars,?VAR?)
	if(twk(?VAR?Construction,CompletionTurn) <= twk(Construction,Turn))
	<
		if((%conanim<=0))
		<
			set(gel.vis,1)
		>
		else
		<
			set(gel.vis,0)
		>
	>
	else
	<
		set(gel.vis,0)
	>
EndM

Macro:(M_CheckShowConstruction,?VAR?,?NUM?)
	if(shell(Facility)!= "")
	<
		set(gel.vis,twk(?VAR?Construction,LastConstructionLevel)=?NUM? and(twk(Facilities,?VAR?Level) = ?NUM?))
	>
	else
	<
		set(gel.vis,twk(Facilities,?VAR?Level) = ?NUM? and(twk(Match,PlayerAtHome) = 1))
	>
	set(gel.vis,gel.vis and (%conanim>0))
EndM

Macro:(M_FacilityConstructionController,?VAR?,?FOCUS?,?POPULATED?)
	float(%conanim,%hadfocus,%in,%out,%crowdvis,%initial)
	.set(twk(?VAR?ConstructionNoLocal,DoInitialHomeSetup),1)
	if(twk(?VAR?ConstructionNoLocal,DoInitialHomeSetup) = 1)
	<
		set(twk(?VAR?ConstructionNoLocal,DoInitialHomeSetup),0)
		// AC: Determine state as we first enter the screen
		set(%conanim,0)
		set(%hadfocus,0)
		set(twk(?VAR?Construction,Alert),0)
		if(twk(?VAR?Construction,CompletionTurn)>twk(Construction,Turn))<
			//AC: Need to see construction in progress
			set(%conanim,3)
		>
		if(twk(?VAR?Construction,LastConstructionLevel)<twk(Facilities,?VAR?Level))<
			if(twk(?VAR?Construction,CompletionTurn)=twk(Construction,Turn))<
				//AC: Need to see construction in progress
				set(%conanim,3)
				set(twk(?VAR?Construction,Alert),1)
			>
			if(twk(?VAR?Construction,CompletionTurn)<=twk(Construction,Turn))<
				//AC: Construction is complete, either just now or in the past.
				set(twk(?VAR?Construction,LastConstructionLevel),twk(Facilities,?VAR?Level))
				set(%in,-1)
				set(%out,1)
			>
		>
	>

	if(twk(Home,CurrentFacility)=?FOCUS?)<
		//AC: Ok, we're looking at the facility
		set(%hadfocus,1)
	>

	if(%hadfocus)<
		if((twk(?VAR?Construction,LastConstructionLevel)<twk(Facilities,?VAR?Level)) or (twk(?VAR?Construction,CompletionTurn)>twk(Construction,Turn)))<
			set(%in,1)
			set(%out,-1)
			add(%conanim,0.02)
			if(%conanim>3)<
				set(%conanim,3)
				if(twk(?VAR?Construction,CompletionTurn)<=twk(Construction,Turn))<
					set(twk(?VAR?Construction,LastConstructionLevel),twk(Facilities,?VAR?Level))
					set(%hadfocus,0)	// Reset %hadfocus, so that we only see the construction come down if we're still actually looking.
				>
			>
		>else<
			set(twk(?VAR?Construction,Alert),0)
			set(%in,-1)
			set(%out,1)
			set(%conanim,max(%conanim-0.02,0))
		>
	>
	// Copy %conanim into global scratch values so that our children don't need variable maps.
	set(%gfc,%conanim)
	set(%gfi,%in)
	set(%gfo,%out)
	selectchild(twk(Facilities,?VAR?LevelVisible))
	If:("?POPULATED?"="Yes")
	if((twk(Facilities,?VAR?LevelVisible)=twk(Facilities,?VAR?Level)) and (%conanim>0))<
		set(twk(Populated,?VAR?),0)
	>else<
		set(twk(Populated,?VAR?),1)
	>
	EndIf
EndM



Macro:(M_ConstructionBaseScale_new,?SCALETOX?,?SCALETOY?,?DELAY?)
	
	set(%gfs,curve(clamp(%gfc,0,1),%gfi,%gfo))
	set(gel3d.scalex,lerp(0,?SCALETOX?,%gfs))
	set(gel3d.scaley,lerp(0,?SCALETOY?,%gfs))
	set(gel3d.scalez,%gfs)

EndM

Macro:(M_ConstructionBase_new,?POSX?,?POSY?,?POSZ?,?ROTX?,?ROTY?,?ROTZ?,?SCALE1?,?SCALE2?,?DELAY?)
	Locator:((?POSX?,?POSY?,?POSZ?),(?ROTX?,?ROTY?,?ROTZ?),(1,1,1))
		M_ConstructionBaseScale_new:(?SCALE1?,?SCALE2?,?DELAY?)
	{
		DrawStaticModel:(Construction_Rubble_A,Construction_Rubble)
			M_TextureSelect:()
		DrawStaticModel:(Construction_Rubble_B,Construction_Rubble_Fade)
			Blend(ONE,INV_IMAGE_ALPHA)
			M_TextureSelect:()
	}
	
EndM


//Construction Object macro
Macro:(M_ConstructionObjPop_new,?POSX?,?POSY?,?POSZ?,?ROT?,?PACK?,?OBJCURVE?,?OBJMESH?,?OBJTEX?,?SHADCURVE?,?DELAY?,?SPEED?,?SHADSCALEX?,?SHADSCALEY?)
	Rect:()
		set(%gff,clamp((%gfc-(?DELAY?))*?SPEED?,0,1))
	{
		Locator:((?POSX?,?POSY?,?POSZ?),(90,0,0))
		{
			Locator:((0,0,0),(0,0,0),(1,1,1))
		 		FollowCurve(?PACK?,?OBJCURVE?,%gff,true)
			{	
			 	//Object
			 	Locator:((0,0,0),(-90,0,?ROT?),(0.01,0.01,0.01))	
				{
					UseShader:(ProjectedLight3DVColOneBit)
						Layer(OneBit)
					{
						DrawStaticModel:(?OBJMESH?,?OBJTEX?)
							Blend(ONE,INV_IMAGE_ALPHA)
							M_TextureSelect:()
					}
				}
			}
			
			If:(?SHADSCALEX?>0)
				Locator:((0,0,0),(0,0,0),(1,1,1))
			 		FollowCurve(?PACK?,?SHADCURVE?,%gff,true)
				{	
					//Shadow
					Locator:((0,-0.03,0),(-90,0,?ROT?),(0.0?SHADSCALEX?,0.0?SHADSCALEY?,0.01))	
					{
						UseShader:(Simple3DNZW)
							Layer(Shadows)
						{
							DrawStaticModel:(Construction_Dirt_Base,Construction_Shadow)
								Blend(ONE,INV_IMAGE_ALPHA)
						}
					}
				}
			EndIf
		}
	}
EndM




