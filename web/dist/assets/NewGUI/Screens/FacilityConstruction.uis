//-----------------------------------------------------------------------------Animations


//------------------------------------------------Facility SelectionIndicator

Img:(StadiumSection_Highlight,NewGUI/UI/StadiumSection_Highlight.png)

Animation:(119,Loop) ref:SelectMePulse
{
 	//FullShrinkRing1
	During:(0,59)
	{
        Draw:(StadiumSection_Highlight,0,0,1,1,0,#20FF20FF)
 			Handle(0.5,0.5)
 			TweenSize(250,250,0.5,0.5,,)
 			TweenCol(#DDFFDD10)
    }

    //FullShrinkRing2
   	During:(60,119)
    {
    	Draw:(StadiumSection_Highlight,0,0,1,1,0,#20FF20FF)
          	Handle(0.5,0.5)
          	TweenSize(250,250,0.5,0.5,,)
          	TweenCol(#DDFFDD10)
    }
}

Animation:(119,Loop) ref:SelectMeStandPulse
{
 	During:(0,119)
	{
		Draw:(White,0,0,250,250,,#AADDAA30)
			Handle(0.5,0.5)
	}
        
 	//FullShrinkRing1
	During:(0,59)
	{
      	Draw:(StadiumSection_Highlight,0,0,80,120,0,#20FF2060)
 			Handle(0.5,0.5)
 			TweenSize(250,250,0.5,0.5,,)
 			TweenCol(#DDFFDD00)

      	Draw:(StadiumSection_Highlight,0,0,250,250,0,#20FF20FF)
 			Handle(0.5,0.5)
 			TweenCol(#DDFFDD10)
    }

    //FullShrinkRing2
   	During:(60,119)
    {
    	Draw:(StadiumSection_Highlight,0,0,80,120,0,#20FF2060)
          	Handle(0.5,0.5)
          	TweenSize(250,250,0.5,0.5,,)
          	TweenCol(#DDFFDD00)

    	Draw:(StadiumSection_Highlight,0,0,250,250,0,#DDFFDD10)
          	Handle(0.5,0.5)
          	TweenCol(#20FF20FF)
    }
}





//-----------------------------------------------------------------------------------MACROS

Macro:(M_AreaSelection,?POSX?,?POSY?,?POSZ?,?VAR?,?NAME?,?SCALEX?,?SCALEY?,?TX?,?TY?,?TROT?,?IMAGE?,?IMAGESIZE?)
	Rect:() $HIDE
		if((shell(GameScreen)="home") and(twk(Ftue,Step) >= 103))
		<
			if("?NAME?" oneof("ClubShop","FitnessCentre","MedicalUnit","ScoutsOffice","TrainingGround","YouthAcademy"))
			<
				set(gel.vis,(twk(FacilityView,Focused)!="?NAME?") and(twk(?NAME?Construction,LastConstructionLevel)=0) and(twk(?NAME?Construction,CompletionTurn)<=twk(Construction,Turn)))
			>
			elif("?NAME?"="Pitch")
			<
				set(gel.vis,not(twk(FacilityView,Focused) oneof("PitchStandN","PitchStandE","PitchStandS","PitchStandW","PitchCorners","Pitch")))
			>
			else
			<
				set(gel.vis,false)
			>>
		>
	{
		UseShader:(Default3D)
   		{
			Locator:((?POSX?,?POSY?,?POSZ?),(0,0,0),(1,1,1))
			{	
				AnimInstance:(0,0,SelectMePulse)
					set(gel.anim.speed,0.55)
					Scale(?SCALEX?,?SCALEY?)
			}

			Locator:((?POSX?,?POSY?,-5),(0,0,?TROT?),(1,1,1))
				PulseAlpha(1,0,0.39,0.39,1,0.5,0.5)
			{
				
				Rect:(,,,,,#FFFFFFFFFFFFFFFF)
				##P4N
					if((Player.weatherSeason = 3) and(twk(Facilities,Night) = 0))
					<
						set(gel.colour,#1E3146FFFFFFFFFF)
					>
					else
					<
						set(gel.colour,#FFFFFFFFFFFFFFFF)
					>
				##IA
					set(gel.colour,#FFFFFFFFFFFFFFFF)
				##*
				{
					Draw:(Icon_Home_?IMAGE?,?TX?,?TY?-400,?IMAGESIZE?,?IMAGESIZE?,0,#FFFFFFFFFFFFFFFF)
						Handle(0.5,0.5)

					M_Text:(facilities_?NAME?,?TX?,?TY?+100,0,0,C,C,TextLoc,KNUL64,Upper,1,0,#FFFFFFFF,NoItalics,#FFFFFFFF,ref)
						Scale(3.5,3.5)


					M_Text:(facility_Press,?TX?,?TY?+400,0,0,C,C,TextLoc,KNUL35,Upper,1,0,#FFFFFFFF,NoItalics,#FFFFFFFF,ref)
						Scale(6,6)
						if(twk(ControllerInput,Enabled) = 1)
						<
							set(gel.vis,(twk(Home,CurrentFacility)=?VAR?) and(twk(Home,CurrentFacility) = twk(Home,CurrentHighlightFacility)))
							set(gel.text,loc(facility_Press))
						>
						else
						<
							:set(gel.vis,1)
							set(gel.text,loc(facility_Tap))
						>
				}
			}
		}
	}
EndM

Macro:(M_StadiumAreaSelection,?POSX?,?POSY?,?POSZ?,?VAR?,?NAME?,?SCALEX?,?SCALEY?,?TX?,?TY?,?TROT?,?IMAGE?,?IMAGESIZEX?,?IMAGESIZEY?,?IMAGEPOSY?,?TANG?)
	Rect:()
		set(gel.vis,not(twk(FacilityView,Focused) oneof("PitchStandN","PitchStandE","PitchStandS","PitchStandW","PitchCorners","Pitch")) and(twk(Ftue,Step) >=103) and(shell(GameScreen) = "home"))
	{
		Locator:((?POSX?,?POSY?,-5),(0,0,?TROT?),(1,1,1))
			PulseAlpha(1,0,0.39,0.39,1,0.5,0.5)
		{
			UseShader:(Default3D)
   			{
				Locator:((?POSX?,?POSY?,?POSZ?),(0,0,0),(1,1,1))
				{	
					AnimInstance:(0,0,SelectMeStandPulse)
						set(gel.anim.speed,0.55)
						Scale(?SCALEX?,?SCALEY?)
				}

				M_Text:(home_map_TAP,?POSX?,?POSY?,0,0,C,C,TextLoc,KNUL40,Upper,1,0,#FFFFFFFF,NoItalics,#FFFFFFFF,ref)	
					Scale(6,6)
					Angle(?TANG?)
				##P4N
					if((Player.weatherSeason = 3) and(twk(Facilities,Night) = 0))
					<
						set(gel.colour,#1E3146FFFFFFFFFF)
					>
					else
					<
						set(gel.colour,#FFFFFFFFFFFFFFFF)
					>
				##IA
					set(gel.colour,#FFFFFFFFFFFFFFFF)
				##*
			}
		}
	}
EndM

//--------------------------------------------------------------------------------------------------------------------------



Macro:(M_ConScale,?VAR?,?SPEED?,?DELAY?)
	Rearmable()

	:if(twk(?VAR?Construction,TimeRemaining) > 0 and(twk(?VAR?Construction,UnderConstruction) = 0))
	<
		set(%FCURVE,0)
	>
	:elif(twk(?VAR?Construction,TimeRemaining) > 0)
	<
		set(%FCURVE,1)
	>
	:elif(twk(?VAR?Construction,TimeRemaining) = 0 and(twk(?VAR?Construction,UnderConstruction) = 1))
	<
		set(%FCURVE,1)
	>
	:elif(twk(?VAR?Construction,TimeRemaining) = 0)
	<
		set(%FCURVE,0)
	>>>>

	if(twk(?VAR?Construction,TimeRemaining) > 0)
	<
		:Delay(?DELAY?)
		add(%FCURVE,?SPEED?)
		if(%FCURVE>1)
		<
			set(%FCURVE,1)
		>
	>
	else
	<
		if(twk(?VAR?Construction,UnderConstruction) = 0)
		<
			:Delay(?DELAY?)
			sub(%FCURVE,?SPEED?)
			if(%FCURVE<0)
			<
				set(%FCURVE,0)
			>
		>
	>
	set(gel.vis,%FCURVE>0)
EndM



//Construction Object macro
Macro:(M_ConstructionObjPop,?POSX?,?POSY?,?POSZ?,?ROT?,?PACK?,?OBJCURVE?,?OBJMESH?,?OBJTEX?,?SHADCURVE?,?DELAY?,?SPEED?,?VAR?,?SHADSCALEX?,?SHADSCALEY?)
	Rect:()
		float(%FCURVE)
		M_ConScale:(?VAR?,?SPEED?,?DELAY?)		
	{
		Locator:((?POSX?,?POSY?,?POSZ?),(90,0,0))
		{
			Locator:((0,0,0),(0,0,0),(1,1,1))
		 		FollowCurve(?PACK?,?OBJCURVE?,%FCURVE,true)
			{	
			 	//Object
			 	Locator:((0,0,0),(-90,0,?ROT?),(0.01,0.01,0.01))	
				{
					DrawStaticModel:(?OBJMESH?,?OBJTEX?)
						Blend(ONE,INV_IMAGE_ALPHA)
						M_TextureSelect:()
				}
			}
			
			Locator:((0,0,0),(0,0,0),(1,1,1))
		 		FollowCurve(?PACK?,?SHADCURVE?,%FCURVE,true)
			{	
				//Shadow
				Locator:((0,-0.03,0),(-90,0,?ROT?),(0.0?SHADSCALEX?,0.0?SHADSCALEY?,0.01))	
				{
					UseShader:(Simple3DNZW)
						Layer(Shadows)
					{
						DrawStaticModel:(Construction_Dirt_Base,Construction_Shadow)
							Blend(ONE,INV_IMAGE_ALPHA)
					}
				}
			}
		}
	}
EndM

Macro:(M_ScaffoldLow,?POSX?,?POSY?,?POSZ?,?ROT?,?TYPE?)
		Locator:(?POSX?,?POSY?,?POSZ?,?ROT?,-90,90)
			//Layer(AboveSky)
		{
			DrawStaticModel:(Construction_Scaffold_?TYPE?_Low,Construction_Scaffold)
				Blend(ONE,INV_IMAGE_ALPHA)
				M_TextureSelect:()
		}
EndM


Macro:(M_ConstructionCranePop,?POSX?,?POSY?,?POSZ?,?ROT?,?PACK?,?OBJCURVE?,?OBJMESHA?,?OBJMESHB?,?OBJTEXA?,?OBJTEXB?,?DELAY?,?SPEED?,?VAR?,?VAL?)
	Rect:()
		Layer(AboveSky)
		float(%FCURVE)
	{
		Locator:((?POSX?,?POSY?,?POSZ?),(90,0,0))
		{
			Locator:((0,0,0),(0,0,0),(1,1,1))
				set(gel.vis,?VAL?)
		 		FollowCurve(ConstructionPop,Shadowpop,%FCURVE,true)
			{	
				//Shadow
				Locator:((-3.8,-0.03,-3.7),(-90,0,180),(0.024,0.024,0.01))	
				{
					UseShader:(Simple3D)
					{
						DrawStaticModel:(Construction_Dirt_Base,Crane_Shadow)
							Blend(ONE,INV_IMAGE_ALPHA)
					}
				}
			}

			Locator:((0,0,0),(0,0,0),(1,1,1))
				M_ConScale:(?VAR?,?SPEED?,?DELAY?)		
		 		FollowCurve(?PACK?,?OBJCURVE?,%FCURVE,true)
			{	
			 	//Object
			 	Locator:((0,0,0),(-90,0,?ROT?),(0.01,0.01,0.01))	
				{
			 		UseShader:(ProjectedLight3DVCol)
						SetSampler(TexSamp1,$CLOUDSHADOW)
					{
						DrawStaticModel:(?OBJMESHA?,?OBJTEXA?)
							Blend(ONE,INV_IMAGE_ALPHA)
							M_TextureSelect:()
						DrawStaticModel:(?OBJMESHB?,?OBJTEXB?)
							Blend(ONE,INV_IMAGE_ALPHA)
							M_TextureSelect:()
					}
				}
			}
		}
	}
EndM


Macro:(M_ConstructionTweaks,?VAR?,?FACNUM?)
	Rect:()
		if(twk(?VAR?Construction,TimeRemaining) > 0)
		<
			:if(twk(?VAR?Construction,UnderConstruction) = 0)
			<
				set(twk(?VAR?Construction,UnderConstruction),1)
			>
		>
		else
		<
			if(twk(Home,CurrentFacility) = ?FACNUM?)
			<
				:if(twk(?VAR?Construction,UnderConstruction) = 1)
				<
					set(twk(?VAR?Construction,UnderConstruction),0)
				>
			>
		>
EndM

Macro:(M_ScaffoldScale,?VAR?,?SCALETOX?,?SCALETOY?,?SCALETOZ?,?DELAY?,?SPEED?)
	Rearmable()

	:if(twk(?VAR?Construction,TimeRemaining) > 0 and(twk(?VAR?Construction,UnderConstruction) = 0))
	<
		set(gel3d.scalex,1)
		set(gel3d.scaley,0)
		set(gel3d.scalez,0)
	>
	:elif(twk(?VAR?Construction,TimeRemaining) > 0)
	<
		set(gel3d.scalex,1)
		set(gel3d.scaley,1)
		set(gel3d.scalez,1)
	>
	:elif(twk(?VAR?Construction,TimeRemaining) = 0 and(twk(?VAR?Construction,UnderConstruction) = 1))
	<
		set(gel3d.scalex,1)
		set(gel3d.scaley,1)
		set(gel3d.scalez,1)
	>
	:elif(twk(?VAR?Construction,TimeRemaining) = 0)
	<
		set(gel3d.scalex,1)
		set(gel3d.scaley,0)
		set(gel3d.scalez,0)
	>>>>

	if(twk(?VAR?Construction,TimeRemaining) > 0)
	<
		:Delay(?DELAY?)
		frlerp(gel3d.scalex,1,?SPEED?)
		frlerp(gel3d.scaley,1,?SPEED?)
		frlerp(gel3d.scalez,1,?SPEED?)
	>
	else
	<
		if(twk(?VAR?Construction,UnderConstruction) = 0)
		<
			:Delay(?DELAY?)
			frlerp(gel3d.scalex,1,?SPEED?)
			frlerp(gel3d.scaley,0,?SPEED?)
			frlerp(gel3d.scalez,0,?SPEED?)
		>
	>
EndM

Macro:(M_ConstructionBaseScale,?VAR?,?SCALETOX?,?SCALETOY?,?DELAY?,?SPEED?)
	Rearmable()

	:if(twk(?VAR?Construction,TimeRemaining) > 0 and(twk(?VAR?Construction,UnderConstruction) = 0))
	<
		set(gel3d.scalex,0)
		set(gel3d.scaley,0)
		set(gel3d.scalez,0)
	>
	:elif(twk(?VAR?Construction,TimeRemaining) > 0)
	<
		set(gel3d.scalex,?SCALETOX?)
		set(gel3d.scaley,?SCALETOY?)
		set(gel3d.scalez,1)
	>
	:elif(twk(?VAR?Construction,TimeRemaining) = 0 and(twk(?VAR?Construction,UnderConstruction) = 1))
	<
		set(gel3d.scalex,?SCALETOX?)
		set(gel3d.scaley,?SCALETOY?)
		set(gel3d.scalez,1)
	>
	:elif(twk(?VAR?Construction,TimeRemaining) = 0)
	<
		set(gel3d.scalex,0)
		set(gel3d.scaley,0)
		set(gel3d.scalez,0)
	>>>>

	if(twk(?VAR?Construction,TimeRemaining) > 0)
	<
		:Delay(?DELAY?)
		frlerp(gel3d.scalex,?SCALETOX?,?SPEED?)
		frlerp(gel3d.scaley,?SCALETOY?,?SPEED?)
		frlerp(gel3d.scalez,1,?SPEED?)
	>
	else
	<
		if(twk(?VAR?Construction,UnderConstruction) = 0)
