Macro:(M_ConstructionCranePop_new,?POSX?,?POSY?,?POSZ?,?ROT?,?PACK?,?OBJCURVE?,?OBJMESHA?,?OBJMESHB?,?OBJTEXA?,?OBJTEXB?,?DELAY?,?SPEED?,?VAL?)
	Rect:()
		Layer(AboveSky)
		set(%gff,clamp((%gfc-(?DELAY?))*?SPEED?,0,1))
	{
		Locator:((?POSX?,?POSY?,?POSZ?),(90,0,0))
		{
			Locator:((0,0,0),(0,0,0),(1,1,1))
				set(gel.vis,?VAL?)
		 		FollowCurve(ConstructionPop,Shadowpop,%gff,true)
			{	
				//Shadow
				Locator:((-3.8,-0.03,-3.7),(-90,0,180),(0.024,0.024,0.01))	
				{
					UseShader:(Simple3DNZW)
						Layer(Shadows)
					{
						DrawStaticModel:(Construction_Dirt_Base,Crane_Shadow)
							Blend(ONE,INV_IMAGE_ALPHA)
					}
				}
			}

			Locator:((0,0,0),(0,0,0),(1,1,1))
		 		FollowCurve(?PACK?,?OBJCURVE?,%gff,true)
			{	
			 	//Object
			 	Locator:((0,0,0),(-90,0,?ROT?),(0.01,0.01,0.01))	
				{
			 		UseShader:(ProjectedLight3DVColOneBit)
			 			Layer(OneBit)
						SetSampler(TexSamp1,$CLOUDSHADOW)
					{
						DrawStaticModel:(?OBJMESHA?,?OBJTEXA?)
							Blend(ONE,INV_IMAGE_ALPHA)
							M_TextureSelect:()
							
						DrawStaticModel:(?OBJMESHB?,?OBJTEXB?)
							Blend(ONE,INV_IMAGE_ALPHA)
							M_TextureSelect:()
					}
				}
			}
		}
	}
EndM