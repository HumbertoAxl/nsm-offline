//--------------------------------------------------------------------------------------------------TEST STUFF
Macro:(M_ConstructionBase,?POSX?,?POSY?,?POSZ?,?ROTX?,?ROTY?,?ROTZ?,?SCALE1?,?SCALE2?,?DELAY?,?SPEED?,?VAR?,?NUM?)
	Rect:()
	set(gel.vis,twk(Facilities,?VAR?Level)=?NUM? and(twk(?VAR?Construction,TimeRemaining) > 0))
	{
		// Rect:() $HIDE
		// {
		// 	Instance:(AchievementEmitter,?POSX?,?POSY?)
		// } 
