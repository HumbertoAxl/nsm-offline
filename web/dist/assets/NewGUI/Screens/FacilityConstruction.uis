			M_ConstructionBaseScale:(?VAR?,?SCALE1?,?SCALE2?,?DELAY?,?SPEED?)
			{
				UseShader:(ProjectedLight3DVCol)
					SetSampler(TexSamp1,$CLOUDSHADOW)
				{
						Rect:()
						Layer(AboveSky)
						{
							DrawStaticModel:(Construction_Rubble_A,Construction_Rubble)
								M_TextureSelect:()
							
							DrawStaticModel:(Construction_Rubble_B,Construction_Rubble_Fade)
						 		Blend(ONE,INV_IMAGE_ALPHA)
						 		M_TextureSelect:()

						}
				}
			}
	}
EndM


