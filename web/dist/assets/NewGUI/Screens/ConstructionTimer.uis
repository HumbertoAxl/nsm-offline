//-----------------Analog
Img:(Construction_Timer_Glass,NewGUI/UI/Timer/Construction_Timer_Glass.png)
Img:(Construction_Timer_Needle,NewGUI/UI/Timer/Construction_Timer_Needle.png)
Img:(Construction_Timer_Integers,NewGUI/UI/Timer/Construction_Timer_Integers.png)

