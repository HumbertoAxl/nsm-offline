Img:(DigNumber_1,NewGUI/UI/Timer/DigNumber_1.png) FORCE
Img:(DigNumber_2,NewGUI/UI/Timer/DigNumber_2.png) FORCE
Img:(DigNumber_3,NewGUI/UI/Timer/DigNumber_3.png) FORCE
Img:(DigNumber_4,NewGUI/UI/Timer/DigNumber_4.png) FORCE
Img:(DigNumber_5,NewGUI/UI/Timer/DigNumber_5.png) FORCE
