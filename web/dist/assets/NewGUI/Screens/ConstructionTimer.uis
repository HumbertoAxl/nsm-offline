				>
				elif(twk(Facilities,MedicalUnitLevel) = 3)
				<
					:set(gel3d.x,-13500)
					:set(gel3d.y,-5747)
					:set(gel3d.z,-2000)
				>
				elif(twk(Facilities,MedicalUnitLevel) = 4)
				<
					:set(gel3d.x,-13570)
					:set(gel3d.y,-5900)
					:set(gel3d.z,-2000)
				>
				elif(twk(Facilities,MedicalUnitLevel) = 5)
				<
					:set(gel3d.x,-13350)
					:set(gel3d.y,-5850)
					:set(gel3d.z,-2000)
				>>>>>
			EndIf
			If:(?VAR?="ScoutsOffice")
				if(twk(Facilities,ScoutsOfficeLevel) = 0)
				<
					:set(gel3d.x,-10650)
					:set(gel3d.y,8780)
					:set(gel3d.z,-2000)
				>
				if(twk(Facilities,ScoutsOfficeLevel) = 1)
				<
					:set(gel3d.x,-10650)
					:set(gel3d.y,8780)
					:set(gel3d.z,-2000)
				>
				elif(twk(Facilities,ScoutsOfficeLevel) = 2)
				<
					:set(gel3d.x,-10480)
					:set(gel3d.y,8750)
					:set(gel3d.z,-2000)
				>
				elif(twk(Facilities,ScoutsOfficeLevel) = 3)
				<
					:set(gel3d.x,-10380)
					:set(gel3d.y,8790)
					:set(gel3d.z,-2000)
				>
				elif(twk(Facilities,ScoutsOfficeLevel) = 4)
				<
					:set(gel3d.x,-10302)
					:set(gel3d.y,8965)
					:set(gel3d.z,-2000)
				>
				elif(twk(Facilities,ScoutsOfficeLevel) = 5)
				<
					:set(gel3d.x,-10135)
					:set(gel3d.y,9060)
					:set(gel3d.z,-2000)
				>>>>>
			EndIf
			If:(?VAR?="ClubShop")
				if(twk(Facilities,ClubShopLevel) = 0)
				<
					:set(gel3d.x,-1300)
					:set(gel3d.y,-8250)
					:set(gel3d.z,-2000)
				>
				if(twk(Facilities,ClubShopLevel) = 1)
				<
					:set(gel3d.x,-1300)
					:set(gel3d.y,-8250)
					:set(gel3d.z,-2000)
				>
				elif(twk(Facilities,ClubShopLevel) = 2)
				<
					:set(gel3d.x,-1457)
					:set(gel3d.y,-8223)
					:set(gel3d.z,-2000)
				>
				elif(twk(Facilities,ClubShopLevel) = 3)
				<
					:set(gel3d.x,-1460)
					:set(gel3d.y,-8300)
					:set(gel3d.z,-2000)
				>
				elif(twk(Facilities,ClubShopLevel) = 4)
				<
					:set(gel3d.x,-770)
					:set(gel3d.y,-8930)
					:set(gel3d.z,-2000)
				>
				elif(twk(Facilities,ClubShopLevel) = 5)
				<
					:set(gel3d.x,-770)
					:set(gel3d.y,-8905)
					:set(gel3d.z,-2000)
				>>>>>
			EndIf
			If:(?VAR?="PitchStandN")
				if(twk(Facilities,PitchStandNLevel) oneof(0,1,2,3,4))
				<
					:set(gel3d.x,2800)
					:set(gel3d.y,0)
					:set(gel3d.z,-2000)
				>
				if(twk(Facilities,PitchStandNLevel) =5)
				<
					:set(gel3d.x,0)
					:set(gel3d.y,0)
					:set(gel3d.z,-2000)
				>
			EndIf
			If:(?VAR?="PitchStandE")
				if(twk(Facilities,PitchStandELevel) oneof(1,2,3,4))
				<
					:set(gel3d.x,0)
					:set(gel3d.y,2000)
					:set(gel3d.z,-2000)
				>
				if(twk(Facilities,PitchStandELevel) =5)
				<
					:set(gel3d.x,0)
					:set(gel3d.y,0)
					:set(gel3d.z,-2000)
				>
			EndIf
			If:(?VAR?="PitchStandS")
				if(twk(Facilities,PitchStandSLevel) oneof(0,1,2,3,4))
				<
					:set(gel3d.x,-2800)
					:set(gel3d.y,0)
					:set(gel3d.z,-2000)
				>
				if(twk(Facilities,PitchStandSLevel) =5)
				<
					:set(gel3d.x,0)
					:set(gel3d.y,0)
					:set(gel3d.z,-2000)
				>
			EndIf
			If:(?VAR?="PitchStandW")
				if(twk(Facilities,PitchStandWLevel) oneof(0,1,2,3,4))
				<
					:set(gel3d.x,0)
					:set(gel3d.y,-2000)
					:set(gel3d.z,-2000)
				>
				if(twk(Facilities,PitchStandWLevel) =5)
				<
					:set(gel3d.x,0)
					:set(gel3d.y,0)
					:set(gel3d.z,-2000)
				>
			EndIf
			If:(?VAR?="PitchCorners")
				if(twk(Facilities,PitchCornersLevel) oneof(2,3,4))
				<
					:set(gel3d.x,2800)
					:set(gel3d.y,-2200)
					:set(gel3d.z,-2000)
				>
			EndIf
			float(%t)
			add(%t,FrameTime*?SPD2?)
			set(gel3d.rotz,-(twk(Cam,RZ)))
			set(gel3d.z,lerp(-1600,-1650,[sin(%t)+1]/2))
			Euler(RYP)
			{
				UseShader:(ProjectedLight3DVCol)
					SetSampler(TexSamp1,$CLOUDSHADOW)
				{
					Locator:(0,0,0,0,180,0)
					{
						DrawStaticModel:(Construction_Timer_Digital,$ConTimerDig?VAR?)
							Layer(AboveSky)
					}
				}
			}
	}
EndM