				M_CTRLButtonExtra:(X,false)
				set(%disabled,twk(MeetingPerson,DevelopmentConcernsVal) <= 10)
				if(%clicked)
				<
					.set(twk(Message,State),"closing")
				>

			M_Button:(@C+140,@B-33,250,50,Button_SilverSliced,,0,0,0,0,#FFFFFFFF,message.btn_Option3,ref,loc(profile_player_CONCERNS_CONTRACT),0,3,C,C,Text,KNUL22,Upper,0,0,#00000000,NoItalics,#252525FF,textref,,,%hinttxt3)
				M_CTRLButtonExtra:(?BTNCAN?,false)
				set(%disabled,twk(MeetingPerson,ContractConcernsVal) <= 10)
				if(%clicked)
				<
					.set(twk(Message,State),"closing")
				>

			M_Button:(@C+421,@B-33,250,50,Button_SilverSliced,,0,0,0,0,#FFFFFFFF,message.btn_Option4,ref,loc(profile_player_CONCERNS_FORM),0,3,C,C,Text,KNUL22,Upper,0,0,#00000000,NoItalics,#252525FF,textref,,,%hinttxt4)
				M_CTRLButtonExtra:(?BTNOK?,false)
				set(%disabled,twk(MeetingPerson,FormConcernsVal) <= 10)
