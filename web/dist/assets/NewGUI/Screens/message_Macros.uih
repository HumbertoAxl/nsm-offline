//------------------------------------------------------------------------ENERGY UPSELL TEMPLATE
Macro:(M_Body_EnergyUpsell) 
	Rect:() ref:Root
		.set(twk(Header,ScreenTitle),loc(upsell_NRG_MAINHEADER))
		:Post(UI_Swoosh)
	{
		// Corner Upsell
		Rect:()
			.set(gel.y,581+[@z/2]-140)
		{
			Draw:(BannerFade_L,@f,20,@w,120,,#576D78FFFFFFFFFF)
			Draw:(UpSell_BannerLines,@f+@w,102,1000+@y,19)
				Handle(1,0)

			M_Text:(upsell_NRG_HEADER,@s-240-100,50,0,0,R,C,TextLoc,BEBAS38,Upper,1,0,#FFFFFFFF,Italics,#FFFFFF00,UpsellTitle)
				CharacterSpacing(1)
				Delay(0.3)
				frlerp(gel.x,@s-240,0.15)
				PulseAlpha(0.1,1,0.75,0.75)

			M_Text:(upsell_NRG_INFO,@s-246-100,83,0,0,R,C,TextLoc,KNUL25,,0,0,#00000000,Italics,#FFFFFF00,UpsellDescription)
				Delay(0.5)
				frlerp(gel.x,@s-246,0.15)
				frlerp(gel.alpha,1,0.05)

			// Pressable Upsell Image
			Rect:(@s-126+300,32,220,220)
				frlerp(gel.x,@s-126,0.15)
				Press()
				<
					set(gel.scale,1.04)
				>
				else
				<
					frlerp(gel.scale,1,0.1)
				>
				Click(message.btn_Ok)
				Handle(0.5,0.5)
			{{
				Draw:(UpSell_Cards_Energy,5,0,250,250) ref:UpsellImage
					Handle(0.5,0.5)
			}}
		}

		M_MessageHeader_Club:(,(twk(Player,TeamName)))
		Draw:(FTUESimon,175,295,650,650)
			Handle(0.5,0.5)
		M_Text:(MSGINSTANT_ASSISTANT_LOWENERGY,380,197,[742+@y],235,L,C,TextBoxAtt,KNUL30,,0,0,#00000000,NoItalics,#252525FF,ref)
	}
EndM

