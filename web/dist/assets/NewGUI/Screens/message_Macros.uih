Macro:(M_Body_ATTConsent)
    Rect:() ref:Root
        .set(twk(Header,ScreenTitle),loc(Consent_HEADER))
        :Post(UI_Swoosh)
    {
        Draw:(FTUESimon,175,295,650,650)
            Handle(0.5,0.5)
        M_Text:(Consent_TITLE,380,22,[742+@y],235,L,C,TextBoxAtt,KNUL30,Upper,1,0,#252525FF,NoItalics,#252525FF,ref)
        M_Text:(,380,207,[742+@y],235,L,C,TextBoxAtt,KNUL30,,0,0,#00000000,NoItalics,#252525FF,ref)
            set(gel.text,loc("Consent_TEXT_ATT_"::twk(Consent,ATTFlowScreen)))
            LineSpacing(1.1)
