Macro:(M_MessageFace,?CARDX?,?CARDY?,?CHARX?,?CHARY?)
	Rect:()	$HIDE ref:CardFace
	{
		Draw:(Generic_Player_Shadow,?CARDX?-12,?CARDY?+75,,,,#FFFFFF60)
		
		Rect:(?CARDX?+180,?CARDY?+200) 
			Card_Face_HD(Message_Face)
			Scale(1.3,1.3)
	}
	Rect:(?CHARX?,?CHARY?,@W,@H) $HIDE ref:CharacterFace
	{{
		Draw:(Character_Reporter,175,295,650,650) ref:CharacterFace
			Handle(0.5,0.5)
	}}
EndM

