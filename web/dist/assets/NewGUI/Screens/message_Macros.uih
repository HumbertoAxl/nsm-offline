			set(%hinttxt2,loc(settings_OKButton)::"  ")
		>
		else
		<
			set(%hinttxt1,"")
			set(%hinttxt2,"")
		>
	{{
		M_Button:(@L+120,@B-33,180,50,Button_RedSliced,,0,0,0,0,#FFFFFFFF,link,ref,loc(generic_NO),0,3,C,C,Text,KNUL22,Upper,0,0,#00000000,NoItalics,#FFFFFFFF,textref,,,%hinttxt1)
			set(%disabled,%selectedOption = 2)
			if(%selectedOption = 0)
			<
				M_CTRLButtonExtra:(?BTNCAN?,false)
				if(%clicked)
				<
					.set(%selectedOption,1)
					.Message(message.btn_Option1)
				>
			>

		M_Button:(@R-120,@B-33,180,50,Button_GreenSliced,,0,0,0,0,#FFFFFFFF,link,ref,loc(generic_YES),0,3,C,C,Text,KNUL22,Upper,0,0,#00000000,NoItalics,#FFFFFFFF,textref,,,%hinttxt2)
			set(%disabled,%selectedOption = 1)
			if(%selectedOption = 0)
			<
				M_CTRLButtonExtra:(?BTNOK?,false)
				if(%clicked)
				<
					.set(%selectedOption,2)
					.Message(message.btn_Option2)
				>
			>
	}}
EndM

//--------------------------------------------------------------------------REWARDED AD TEMPLATE
Macro:(M_Body_RewardedAd)
	Rect:() ref:Root
		.set(twk(Header,ScreenTitle),loc(rewardedad_HEADER))
	{
		// Corner Upsell
		Rect:() $HIDE ref:RetriesUpsell
			.set(gel.y,581+[@z/2]-140)
		{
			Draw:(BannerFade_L,@f,20,@w,120,,#576D78FFFFFFFFFF)
			Draw:(UpSell_BannerLines,@f+@w,102,1000+@y,19)
				Handle(1,0)

			M_Text:(upsell_RETRIES_HEADER,@s-240-100,50,0,0,R,C,TextLoc,BEBAS38,Upper,1,0,#FFFFFFFF,Italics,#FFFFFF00,ref)
				CharacterSpacing(1)
				Delay(0.3)
				frlerp(gel.x,@s-240,0.15)
				PulseAlpha(0.1,1,0.75,0.75)

			M_Text:(upsell_RETRIES_INFO,@s-246-100,83,0,0,R,C,TextLoc,KNUL25,,0,0,#00000000,Italics,#FFFFFF00,ref)
				Delay(0.5)
				frlerp(gel.x,@s-246,0.15)
				frlerp(gel.alpha,1,0.05)

			// Pressable Upsell Image
			Rect:(@s-126+300,32,220,220)
				frlerp(gel.x,@s-126,0.15)
				Press()
				<
					set(gel.scale,1.04)
				>
				else
				<
					frlerp(gel.scale,1,0.1)
				>
				Click(message.btn_Option2)
				Handle(0.5,0.5)
			{{
				Draw:(UpSell_Retries,5,0,250,250)
					Handle(0.5,0.5)
			}}
		}

		M_MessageHeader:()
		M_MessageFace:(0,0,0,0)
		M_CurrentTextTitle:(Offset)
	}
EndM

