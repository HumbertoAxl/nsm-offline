//---------------------------------------------------------------NEW ASSISTANT OVERVIEW TEMPLATE
Macro:(M_Body_Overview)
	Rect:() ref:Root
		.set(twk(Header,ScreenTitle),loc(resume_HEADER))
		:Post(UI_Swoosh)
		float(%cycle)
		set(%cycle,(%cycle+(FrameTime*0.15)) fmod 120)
	{
		// Corner Upsells
		Rect:() $HIDE ref:CornerUpsellRoot
			.set(gel.y,581+[@z/2]-140)
		{
			Draw:(BannerFade_L,@f,20,@w,120,,#576D78FFFFFFFFFF)
			Draw:(UpSell_BannerLines,@f+@w,102,1000+@y,19)
				Handle(1,0)

			Rect:()
			{
				// Upsell Header
				M_Text:(,@s-240-100,50,0,0,R,C,TextLoc,BEBAS38,Upper,1,0,#FFFFFFFF,Italics,#FFFFFF00,UpsellTitle)
					CharacterSpacing(1)
					Delay(0.3)
					frlerp(gel.x,@s-240,0.15)
					PulseAlpha(0.1,1,0.75,0.75)

				// Upsell Info
				M_Text:(,@s-246-100,83,0,0,R,C,TextLoc,KNUL25,,0,0,#00000000,Italics,#FFFFFF00,UpsellDescription)
					Delay(0.5)
					frlerp(gel.alpha,1,0.1)
					frlerp(gel.x,@s-246,0.15)

				// Pressable Upsell Image
				Rect:(@s-126+300,32,220,220)
					frlerp(gel.x,@s-126,0.15)
					Press()
					<
						set(gel.scale,1.04)
					>
					else
					<
						frlerp(gel.scale,1,0.1)
					>
					Click(message.btn_Ok)
					Handle(0.5,0.5)
				{{
					Draw:(UpSell_Cards_Energy,5,0,250,250) ref:UpsellImage
						Handle(0.5,0.5)
				}}

			}
		}


		Rect:() ref:NonUpsellRoot
		{
			// Data page 1
			Rect:(390,400,690+@y,1,,#FFFFFF00FFFFFFFF)
				frlerp(gel.alpha,(%cycle < 60),0.1)
			{{
				Tile:(White,-10,-20,@W+20,1,,#0000001AFFFFFFFF)
					Copies(1,5)
					Spacing(0,40)

				// Columns swapped for LTR
				Rect:()
				 .set(gel.vis,twk(Settings,UsingLTRText))
				{
					M_Text:(resume_POSITION,@R,0,0,0,R,C,TextLoc,KNUL25,,0,0,#00000000,NoItalics,#505050FF,ref)
					M_Text:(resume_CUPS,@R,40,0,0,R,C,TextLoc,KNUL25,,0,0,#00000000,NoItalics,#505050FF,ref)
					M_Text:(resume_NEXT,@R,80,0,0,R,C,TextLoc,KNUL25,,0,0,#00000000,NoItalics,#505050FF,ref)
					M_Text:(resume_WINDOW,@R,120,0,0,R,C,TextLoc,KNUL25,,0,0,#00000000,NoItalics,#505050FF,ref)

					M_Text:(,0,0,0,0,L,C,Text,KNUL25,,1,0,#252525FF,NoItalics,#252525FF,ref,Overview,LeaguePosDesc)
					M_Text:(,0,40,0,0,L,C,Text,KNUL25,,1,0,#252525FF,NoItalics,#252525FF,ref,Overview,CupCompetitions)
					M_Text:(,0,80,0,0,L,C,Text,KNUL25,,1,0,#252525FF,NoItalics,#252525FF,ref,Overview,NextFixture)
					M_Text:(,0,120,0,0,L,C,Text,KNUL25,,1,0,#252525FF,NoItalics,#252525FF,ref,Overview,TransferWindowStatusInfo)
				}

				Rect:()
				 .set(gel.vis,twk(Settings,UsingLTRText)=0)
				{
					M_Text:(resume_POSITION,0,0,0,0,L,C,TextLoc,KNUL25,,0,0,#00000000,NoItalics,#505050FF,ref)
					M_Text:(resume_CUPS,0,40,0,0,L,C,TextLoc,KNUL25,,0,0,#00000000,NoItalics,#505050FF,ref)
					M_Text:(resume_NEXT,0,80,0,0,L,C,TextLoc,KNUL25,,0,0,#00000000,NoItalics,#505050FF,ref)
					M_Text:(resume_WINDOW,0,120,0,0,L,C,TextLoc,KNUL25,,0,0,#00000000,NoItalics,#505050FF,ref)

					M_Text:(,@R,0,0,0,R,C,Text,KNUL25,,1,0,#252525FF,NoItalics,#252525FF,ref,Overview,LeaguePosDesc)
					M_Text:(,@R,40,0,0,R,C,Text,KNUL25,,1,0,#252525FF,NoItalics,#252525FF,ref,Overview,CupCompetitions)
					M_Text:(,@R,80,0,0,R,C,Text,KNUL25,,1,0,#252525FF,NoItalics,#252525FF,ref,Overview,NextFixture)
					M_Text:(,@R,120,0,0,R,C,Text,KNUL25,,1,0,#252525FF,NoItalics,#252525FF,ref,Overview,TransferWindowStatusInfo)
				}

			}}
			

			// Data page 2
			Rect:(390,400,690+@y,1,,#FFFFFF00FFFFFFFF)
				frlerp(gel.alpha,(60 < %cycle < 120),0.1)
			{{
				Tile:(White,-10,-20,@W+20,1,,#0000001AFFFFFFFF)
					Copies(1,5)
					Spacing(0,40)

				// Columns swapped for LTR
				Rect:()
				 .set(gel.vis,twk(Settings,UsingLTRText))
				{
					M_Text:(resume_TOPSCORER,@R,0,0,0,R,C,TextLoc,KNUL25,,0,0,#00000000,NoItalics,#505050FF,ref)
					M_Text:(resume_MOSTASST,@R,40,0,0,R,C,TextLoc,KNUL25,,0,0,#00000000,NoItalics,#505050FF,ref)
					M_Text:(resume_INJURIES,@R,80,0,0,R,C,TextLoc,KNUL25,,0,0,#00000000,NoItalics,#505050FF,ref)
					M_Text:(resume_BANS,@R,120,0,0,R,C,TextLoc,KNUL25,,0,0,#00000000,NoItalics,#505050FF,ref)

					M_Text:(,0,0,0,0,L,C,Text,KNUL25,,1,0,#252525FF,NoItalics,#252525FF,ref,Overview,TopScorers)
					M_Text:(,0,40,0,0,L,C,Text,KNUL25,,1,0,#252525FF,NoItalics,#252525FF,ref,Overview,MostAssists)
					M_Text:(,0,80,0,0,L,C,Text,KNUL25,,1,0,#252525FF,NoItalics,#252525FF,ref,Overview,Injuries)
					M_Text:(,0,120,0,0,L,C,Text,KNUL25,,1,0,#252525FF,NoItalics,#252525FF,ref,Overview,Bans)
				}

				Rect:()
				 .set(gel.vis,twk(Settings,UsingLTRText)=0)
				{
					M_Text:(resume_TOPSCORER,0,0,0,0,L,C,TextLoc,KNUL25,,0,0,#00000000,NoItalics,#505050FF,ref)
					M_Text:(resume_MOSTASST,0,40,0,0,L,C,TextLoc,KNUL25,,0,0,#00000000,NoItalics,#505050FF,ref)
					M_Text:(resume_INJURIES,0,80,0,0,L,C,TextLoc,KNUL25,,0,0,#00000000,NoItalics,#505050FF,ref)
					M_Text:(resume_BANS,0,120,0,0,L,C,TextLoc,KNUL25,,0,0,#00000000,NoItalics,#505050FF,ref)

					M_Text:(,@R,0,0,0,R,C,Text,KNUL25,,1,0,#252525FF,NoItalics,#252525FF,ref,Overview,TopScorers)
					M_Text:(,@R,40,0,0,R,C,Text,KNUL25,,1,0,#252525FF,NoItalics,#252525FF,ref,Overview,MostAssists)
					M_Text:(,@R,80,0,0,R,C,Text,KNUL25,,1,0,#252525FF,NoItalics,#252525FF,ref,Overview,Injuries)
					M_Text:(,@R,120,0,0,R,C,Text,KNUL25,,1,0,#252525FF,NoItalics,#252525FF,ref,Overview,Bans)
				}

			}}
		}

		M_MessageHeader_Club:(,(twk(Player,TeamName)))
		Draw:(White,@f,360,@w,2,,#DD1010FF)
		M_AssistantFace:(AssistantSlotMessage,175,295)

		M_Text:(,380,157,[742+@y],235,L,C,TextBoxAtt,KNUL30,,0,0,#00000000,NoItalics,#252525FF,ref,Overview,Advice)
			LineSpacing(1.1)
	}
EndM

