Macro:(M_Footer_Scandal)
	Rect:() ref:Root
		strvar(%hinttxt1,%hinttxt2,%hinttxt3,%hinttxt4)
		if(twk(ControllerInput,Enabled) = 1)
		<
			set(%hinttxt1,loc(settings_YButton)::"  ")
			set(%hinttxt2,loc(settings_XButton)::"  ")
			set(%hinttxt3,loc(settings_CANButton)::"  ")
			set(%hinttxt4,loc(settings_OKButton)::"  ")
		>
		else
		<
			set(%hinttxt1,"")
			set(%hinttxt2,"")
			set(%hinttxt3,"")
			set(%hinttxt4,"")
		>
	{
		M_Button:(@C-421,@B-33,250,50,Button_SilverSliced,,0,0,0,0,#FFFFFFFF,message.btn_Option1,ref,loc(scandal_CRITICISE),0,3,C,C,Text,KNUL22,Upper,0,0,#00000000,NoItalics,#252525FF,textref,,,%hinttxt1)
			M_CTRLButtonExtra:(Y,false)
			if(%clicked)
			<
				.set(twk(Message,State),"closing")
			>
		
		M_Button:(@C-140,@B-33,250,50,Button_SilverSliced,,0,0,0,0,#FFFFFFFF,message.btn_Option2,ref,loc(scandal_CASHFINE),0,3,C,C,Text,KNUL22,Upper,0,0,#00000000,NoItalics,#252525FF,textref,,,%hinttxt2)
			M_CTRLButtonExtra:(X,false)
			if(%clicked)
			<
				.set(twk(Message,State),"closing")
			>
		
		M_Button:(@C+140,@B-33,250,50,Button_SilverSliced,,0,0,0,0,#FFFFFFFF,message.btn_Option3,ref,loc(scandal_TRAINING),0,3,C,C,Text,KNUL22,Upper,0,0,#00000000,NoItalics,#252525FF,textref,,,%hinttxt3)
			M_CTRLButtonExtra:(?BTNCAN?,false)
			if(%clicked)
			<
				.set(twk(Message,State),"closing")
			>
		
		M_Button:(@C+421,@B-33,250,50,Button_SilverSliced,,0,0,0,0,#FFFFFFFF,message.btn_Option4,ref,loc(scandal_IGNORE),0,3,C,C,Text,KNUL22,Upper,0,0,#00000000,NoItalics,#252525FF,textref,,,%hinttxt4)
			M_CTRLButtonExtra:(?BTNOK?,false)
			if(%clicked)
			<
				.set(twk(Message,State),"closing")
			>
	}
EndM

//-----------------------------------------------------------------------------INCIDENT TEMPLATE
Macro:(M_Body_Incident)
	Rect:() ref:Root
		.set(twk(Header,ScreenTitle),loc(incident_HEADER))
	{
		M_MessageHeader:()
		M_MessageFace:(0,0,0,0)
		M_CurrentTextTitle:(Offset)

		M_Text:(generic_HAPPINESS,@C-108+[@y/2],420,0,0,C,C,TextLoc,KNUL23,Upper,0,0,#00000000,NoItalics,#505050FF,ref)
		M_MoraleWheel:(@C-160+[@y/2],440,Message,ExtraVar1)
			Scale(1.6,1.6)

		PushOrigin:(@C+20+[@y/2],470)
			Draw:(Icon_Energy,3,0,50,50)
				// Raw or Rookie
				if(twk(Message,ExtraVar3) = 1)
				<
					set(gel.colour,#009DFDFFFFFFFFFF)
				> // Retiring
				elif(twk(Message,ExtraVar3) = 2)
				<
					set(gel.colour,#BBBBBBFFFFFFFFFF)
				>
				else
				<
					set(gel.colour,#369900FFFFFFFFFF)
				>>
			
			// Energy Bar
			Rect:(55,13,235,20)
			{{
				Draw:(White,-2,-2,@W+4,@H+4,,#FFFFFF80)
				Draw:(White,0,0,@W,@H,,#252525FFFFFFFFFF)
				
				Draw:(White,0,0,@W,@H)
					.set(gel.scalex,twk(Message,ExtraVar2)/100)
					frlerp(gel.scalex,twk(Message,ExtraVar2)/100,0.1)
					if(gel.scalex >= 0.75)
			        <
			        	set(gel.colour,#42BB00FFFFFFFFFF)
			        >
			        else
			        <
			            if(gel.scalex >= 0.50)
			            <
			            	set(gel.colour,#E0DE10FFFFFFFFFF)
			            >
			            else
			            <
			        		if(gel.scalex >= 0.25)
			           		<
			            		set(gel.colour,#E09E11FFFFFFFFFF)
			            	>
			            	else
			            	<
			            		set(gel.colour,#DD1010FFFFFFFFFF)
			            	>
			            >
					>
				Draw:(White,0,@M,@W,@H/2,,#00000015)
				Draw:(White,[@W*0.25],0,1,@H,,#FFFFFFFF)
				Draw:(White,[@W*0.5],0,1,@H,,#FFFFFFFF)
				Draw:(White,[@W*0.75],0,1,@H,,#FFFFFFFF)
			}}

			M_Text:(generic_ENERGY,174,-10,0,0,C,C,TextLoc,KNUL23,Upper,0,0,#00000000,NoItalics,#505050FF,ref)

		PopOrigin
	}
EndM

Macro:(M_Footer_Incident)
	Rect:() ref:Root
		float(%selectedOption)
		strvar(%hinttxt1,%hinttxt2,%hinttxt3)
		if(twk(ControllerInput,Enabled) = 1)
		<
			set(%hinttxt1,loc(settings_XButton)::"  ")
			set(%hinttxt2,loc(settings_CANButton)::"  ")
			set(%hinttxt3,loc(settings_OKButton)::"  ")
		>
		else
		<
			set(%hinttxt1,"")
			set(%hinttxt2,"")
			set(%hinttxt3,"")
		>
	{
		M_Button:(@C-280,@B-33,250,50,Button_SilverSliced,,0,0,0,0,#FFFFFFFF,link,ref,loc(scandal_CASHFINE),0,3,C,C,Text,KNUL22,Upper,0,0,#00000000,NoItalics,#252525FF,textref,,,%hinttxt1)
			set(%disabled,%selectedOption oneof(2,3))
			if(%selectedOption = 0)
			<
				M_CTRLButtonExtra:(X,false)
				if(%clicked)
				<
					.set(%selectedOption,1)
					.Message(message.btn_Option1)
				>
			>
		
		M_Button:(@C,@B-33,250,50,Button_SilverSliced,,0,0,0,0,#FFFFFFFF,link,ref,loc(scandal_TRAINING),0,3,C,C,Text,KNUL22,Upper,0,0,#00000000,NoItalics,#252525FF,textref,,,%hinttxt2)
			set(%disabled,%selectedOption oneof(1,3))
			if(%selectedOption = 0)
			<
				M_CTRLButtonExtra:(?BTNCAN?,false)
				if(%clicked)
				<
					.set(%selectedOption,2)
					.Message(message.btn_Option2)
				>
			>

		M_Button:(@C+280,@B-33,250,50,Button_SilverSliced,,0,0,0,0,#FFFFFFFF,link,ref,loc(scandal_IGNORE),0,3,C,C,Text,KNUL22,Upper,0,0,#00000000,NoItalics,#252525FF,textref,,,%hinttxt3)
			set(%disabled,%selectedOption oneof(1,2))
			if(%selectedOption = 0)
			<
				M_CTRLButtonExtra:(?BTNOK?,false)
				if(%clicked)
				<
					.set(%selectedOption,3)
					.Message(message.btn_Option3)
				>
			>
	}
EndM

//------------------------------------------------------------------------------REQUEST TEMPLATE
Macro:(M_Body_Request)
	Rect:() ref:Root
		.set(twk(Header,ScreenTitle),loc(request_HEADER))
	{
		M_MessageHeader:()
		M_MessageFace:(0,0,0,0)
		M_CurrentTextTitle:(Offset)

		M_Text:(generic_HAPPINESS,@C-108+[@y/2],420,0,0,C,C,TextLoc,KNUL23,Upper,0,0,#00000000,NoItalics,#505050FF,ref)
		M_MoraleWheel:(@C-160+[@y/2],440,Message,ExtraVar1)
			Scale(1.6,1.6)

		PushOrigin:(@C+20+[@y/2],470)
			Draw:(Icon_Energy,3,0,50,50)
				// Raw or Rookie
				if(twk(Message,ExtraVar3) = 1)
				<
					set(gel.colour,#009DFDFFFFFFFFFF)
				> // Retiring
				elif(twk(Message,ExtraVar3) = 2)
				<
					set(gel.colour,#BBBBBBFFFFFFFFFF)
				>
				else
				<
					set(gel.colour,#369900FFFFFFFFFF)
				>>
			
			// Energy Bar
			Rect:(55,13,235,20)
			{{
				Draw:(White,-2,-2,@W+4,@H+4,,#FFFFFF80)
				Draw:(White,0,0,@W,@H,,#252525FFFFFFFFFF)
				
				Draw:(White,0,0,@W,@H)
					.set(gel.scalex,twk(Message,ExtraVar2)/100)
					frlerp(gel.scalex,twk(Message,ExtraVar2)/100,0.1)
					if(gel.scalex >= 0.75)
			        <
			        	set(gel.colour,#42BB00FFFFFFFFFF)
			        >
			        else
			        <
			            if(gel.scalex >= 0.50)
			            <
			            	set(gel.colour,#E0DE10FFFFFFFFFF)
			            >
			            else
			            <
			        		if(gel.scalex >= 0.25)
			           		<
			            		set(gel.colour,#E09E11FFFFFFFFFF)
			            	>
			            	else
			            	<
			            		set(gel.colour,#DD1010FFFFFFFFFF)
			            	>
			            >
					>
				Draw:(White,0,@M,@W,@H/2,,#00000015)
				Draw:(White,[@W*0.25],0,1,@H,,#FFFFFFFF)
				Draw:(White,[@W*0.5],0,1,@H,,#FFFFFFFF)
				Draw:(White,[@W*0.75],0,1,@H,,#FFFFFFFF)
			}}

			M_Text:(generic_ENERGY,174,-10,0,0,C,C,TextLoc,KNUL23,Upper,0,0,#00000000,NoItalics,#505050FF,ref)
			
		PopOrigin
	}
EndM

Macro:(M_Footer_Request)
	Rect:(@o,@T,@s,@H) ref:Root
