Macro:(M_Button_ATT,?Index?,?Text?,?Msg?,?ButtStyle?) 
	M_Button:(@R-170-(?Index?*(280+10)),@B-33,280,50,?ButtStyle?,,0,0,0,0,#FFFFFFFF,message.null,ref,loc(?Text?),0,3,C,C,Text,KNUL22,Upper,0,0,#00000000,NoItalics,#FFFFFFFF,textref,,,)
	if(%clicked)
	<
		:Post(?Msg?)
	>
EndM

Macro:(M_Footer_ATTConsent)
    Rect:(@o,@T,@s,@H) ref:Root
    {{
        Rect:()
            // Info, Continue to game
            set(gel.vis,(twk(Consent,ATTFlowScreen) oneof(6)))
        {
            // NOTE FOR CHRIS: If you wana rearange the buttons, just change the first number (0,1,2) on two of them
            M_Button_ATT:(1,Consent_MORE_INFO,privacy.btn_MoreInfo,Button_GreenSliced)
            M_Button_ATT:(0,Consent_CONTINUE_TOGAME,privacy.btn_ContinueToGame,Button_GreenSliced)
        }

        Rect:()
            // Allow Tracking (global), Info, Continue to game
            set(gel.vis,(twk(Consent,ATTFlowScreen) oneof(5,3)))
        {
            M_Button_ATT:(2,Consent_ALLOW_TRACK_GLO,privacy.btn_AllowTrackGlobal,Button_GreenSliced)
            M_Button_ATT:(1,Consent_MORE_INFO,privacy.btn_MoreInfo,Button_GreenSliced)
            M_Button_ATT:(0,Consent_CONTINUE_TOGAME,privacy.btn_ContinueToGame,Button_GreenSliced)
        }

        Rect:()
            // Allow Tracking (app), Info, Continue to game
            set(gel.vis,(twk(Consent,ATTFlowScreen) oneof(7)))
        {
            M_Button_ATT:(2,Consent_CONTINUE_TOGAME_M7,privacy.btn_ContinueToGame,Button_GreenSliced)
            M_Button_ATT:(1,Consent_MORE_INFO,privacy.btn_MoreInfo,Button_GreenSliced)
            M_Button_ATT:(0,Consent_ALLOW_TRACK_APP,privacy.btn_AllowTrackApp,Button_GreenSliced)
        }
        
        Rect:()
            // Info, Continue to ATT
            set(gel.vis,(twk(Consent,ATTFlowScreen) oneof(4)))
        {
            M_Button_ATT:(1,Consent_MORE_INFO,privacy.btn_MoreInfo,Button_GreenSliced)
            M_Button_ATT:(0,Consent_CONTINUE_TOATT,privacy.btn_ContinueToATT,Button_GreenSliced)
        }
        
        Rect:()
            // Continue to game, Info, Allow Tracking (app)
            set(gel.vis,(twk(Consent,ATTFlowScreen) oneof(8)))
        {
            M_Button_ATT:(2,Consent_CONTINUE_TOPAUSE,privacy.btn_ContinueToGame,Button_GreenSliced)
            M_Button_ATT:(1,Consent_MORE_INFO,privacy.btn_MoreInfo,Button_GreenSliced)
            M_Button_ATT:(0,Consent_MANAGE_TRACKING,privacy.btn_ManageTracking,Button_GreenSliced)
        }
        
        Rect:()
            // Allow Tracking (app), Info, Continue to game
            set(gel.vis,(twk(Consent,ATTFlowScreen) oneof(9)))
        {
            M_Button_ATT:(2,Consent_MANAGE_TRACKING,privacy.btn_ManageTracking,Button_GreenSliced)
            M_Button_ATT:(1,Consent_MORE_INFO,privacy.btn_MoreInfo,Button_GreenSliced)
            M_Button_ATT:(0,Consent_CONTINUE_TOPAUSE,privacy.btn_ContinueToGame,Button_GreenSliced)
        }

      
    }}
EndM

