			set(%hinttxt4,loc(settings_OKButton)::"  ")
		>
		else
		<
			set(%hinttxt1,"")
			set(%hinttxt2,"")
			set(%hinttxt3,"")
			set(%hinttxt4,"")
		>
	{
		M_Button:(@C-421,@B-33,250,50,Button_SilverSliced,,0,0,0,0,#FFFFFFFF,message.btn_Option1,ref,"0",0,3,C,C,Text,KNUL22,Upper,0,0,#00000000,NoItalics,#252525FF,textref,,,%hinttxt1)
			M_CTRLButtonExtra:(Y,false)
			if(%matchCount = 1)
			<
				set(gel.x,@C-140)
			>
			else
			<
				set(gel.x,@C-421)
			>
			if(%clicked)
			<
				.set(twk(Message,State),"closing")
			>

		M_Button:(@C-140,@B-33,250,50,Button_SilverSliced,,0,0,0,0,#FFFFFFFF,message.btn_Option2,ref,"1",0,3,C,C,Text,KNUL22,Upper,0,0,#00000000,NoItalics,#252525FF,textref,,,%hinttxt2)
			M_CTRLButtonExtra:(X,false)
			set(gel.vis,%matchCount >= 1)
			if(%matchCount = 1)
			<
				set(gel.x,@C+140)
			>
			else
			<
				set(gel.x,@C-140)
			>
			if(%clicked)
			<
				.set(twk(Message,State),"closing")
			>

		M_Button:(@C+140,@B-33,250,50,Button_SilverSliced,,0,0,0,0,#FFFFFFFF,message.btn_Option3,ref,"2",0,3,C,C,Text,KNUL22,Upper,0,0,#00000000,NoItalics,#252525FF,textref,,,%hinttxt3)
			M_CTRLButtonExtra:(?BTNCAN?,false)
			set(gel.vis,%matchCount >= 2)
			if(%clicked)
			<
				.set(twk(Message,State),"closing")
			>

		M_Button:(@C+421,@B-33,250,50,Button_SilverSliced,,0,0,0,0,#FFFFFFFF,message.btn_Option4,ref,"3",0,3,C,C,Text,KNUL22,Upper,0,0,#00000000,NoItalics,#252525FF,textref,,,%hinttxt4)
			M_CTRLButtonExtra:(?BTNOK?,false)
			set(gel.vis,%matchCount >= 3)
			if(%clicked)
			<
				.set(twk(Message,State),"closing")
			>
	}
EndM

