//----------------------------------------------------------------------------------MACROS
Macro:(M_MessageDialogOPEN)
	Rect:(@L,@T,@W,@H)	
		Click()

	Dissolve:(@o,@M-60,@s,36) ref:DialogRoot
		float(%dissolveAlpha,%action)
		inittwk(twk(Message,State),"opening")
		float(%px,%py,%pw,%ph)

		.set(%px,gel.gx)
		.set(%py,gel.gy-gel.hy)
		.set(%pw,gel.w)
		.set(%ph,gel.h)

		if(twk(Message,State) = "opening")
		<
			frlerp(gel.h,@h-150,0.15)
			:Post(UI_Swoosh)
		>
		elif(twk(Message,State) = "closing")
		<
			frlerp(gel.h,36,0.3)
		>>

		set(gel.hy,[gel.h/2]-50)

		set(%px,gel.gx)
		set(%py,gel.gy-gel.hy)
		.set(%pw,gel.w)
		set(%ph,gel.h)

		if(twk(Message,State) = "closing")
		<
			.set(twk(Message,State),"closing")
			frlerp(gel.alpha,0,0.3)
			if(gel.alpha < 0.05)
			<
				.set(gel.alpha,0)
				if(%action = 0)
				<
					.Message(message.btn_Cancel)
				>
				if(%action = 1)
				<
					.Message(message.btn_Ok)
				>
			>	
		>
		set(%dissolveAlpha,gel.alpha)
	{{

		// Top Bar
		Rect:()
			Layer(AboveText)
			LockLayer()
			set(gel.gy,%py)
		{
			Draw:(White,@f,0,@w,34,,#CC1618FF)

			Draw:(Dialog_Top,@f,0,@w,38)
			Draw:(Dialog_Hexagons,@f+@w-297,0,,34,,#00000020)
		}

		// Bottom Bar
		Rect:()
			Layer(AboveText)
			set(gel.gy,%py+%ph)
		{
			// Bottom
			Draw:(White,@f,0,@w,2,,#CC1618FF)
				Handle(0,1)
			Draw:(Dialog_Bottom,@f,4,@w,6)
				Handle(0,1)
		}


		Clip:(@f,@T,@w,@H)
			set(gel.gy,%py)
			set(gel.h,%ph)
		{
			Rect:(0,0,@W,@h-135)
				set(gel.gy,@t)
			{{
				// Content Window Area
				Rect:(0,100,@W,@H)
				{{

EndM

Macro:(M_MessageDialogCLOSE)
				}}
			}}
		}
	}}
EndM

// Notes
// 0 gives you the left of adjusted width screen
// @s gives you the right of adjusted width screen
// @f gives you the full left of any screen
// @f+@w gives you the full right of any screen
// Width = [1152 - XPos:380 - Right buffer:30] = 742 + additional widescreen space:@y

Macro:(M_MessageContainer)
	// THE DIALOG
	Rect:() ref:Container
		strvar(%title,%message)
		.set(twk(Header,ScreenTitle),%title)
	{
		M_MessageDialogOPEN:()
			
			//Background 
			If:(@w>1366)
			 	Draw:(Msg_Background,@C,0,@w,680,,#CCCCEE40)
			 		Handle(0.5,0)
			 		Additive()
			Else
			 	Draw:(Msg_Background,@C,0,,680,,#CCCCEE40)
			 		Handle(0.5,0)
			 		Additive()
			EndIf

			// Top and bottom fades
			Draw:(Dialog_Fade,@f,0,@w,120,,#FFFFFFAA)
			Draw:(Dialog_Fade,@f,@B-50,@w,-120,,#FFFFFFAA)

			// Centre text fade
			Draw:(Dialog_Fade,@f,@M-75,@w,-50,,#FFFFFFAA)
			Draw:(White,@f,@M-75,@w,150,,#FFFFFFAA)
			Draw:(Dialog_Fade,@f,@M+75,@w,50,,#FFFFFFAA)

			Rect:(0,-@t)
			{{
				Rect:() ref:Body
			}}
		M_MessageDialogCLOSE:()

		// Footer reference outside as the dialog contains clipped content
		Rect:() ref:Footer
	}
EndM

//--------------------------------------------------------------------COMMON CONTENT: TEXT & BUTTONS
Macro:(M_CurrentTextTitle,?ALIGN?,?X?,?Y?)
	If:(?ALIGN?=Offset)
		M_Text:(,380,197,[742+@y],235,A,C,TextBoxAtt,KNUL30,,0,0,#00000000,NoItalics,#252525FF,ref)
			inherit(%message)
			.set(gel.text,%message)
			LineSpacing(1.1)
	EndIf
	If:(?ALIGN?=Positioned)
		M_Text:(,?X?,?Y?,@s-200,0,C,C,TextBoxAtt,KNUL30,,0,0,#00000000,NoItalics,#252525FF,ref)
			inherit(%message)
			.set(gel.text,%message)
			LineSpacing(1.1)
	EndIf
EndM

Macro:(M_MessageHeader)
	Rect:() ref:HeaderHook
EndM

Macro:(M_MessageHeader_News)
	Rect:() ref:Root
	{
		Draw:(Fade_Up,@f,23,@w,7)
		Draw:(Fade_Down,@f,130,@w,7)
		Draw:(White,@f,30,@w,100)

		Rect:()
			set(gel.vis,twk(Player,StarLevel) < 5)
		{
			Draw:(MSG_News_NSAdvertiser_Left,0,30,,100,,#00000060)
			Draw:(MSG_News_NSAdvertiser_Right,@s-503,30,,100)
		}
		Rect:()
			set(gel.vis,(twk(Player,StarLevel) >= 5) and(twk(Player,StarLevel)<10))
		{
			Draw:(White,@f,30,@w,100,,#3351A8FF)
			Draw:(MSG_News_NSPost_Left,0,30,,100,,#2A3F84FF)
			Draw:(MSG_News_NSPost_Right,@s-503,30,,100)
		}
		Rect:()
			set(gel.vis,twk(Player,StarLevel)>=10)
		{
			Draw:(White,@f,30,@w,100,,#CC0000FF)
			Draw:(MSG_News_NSN_Left,0,30,,100,,#00000060)
			Draw:(MSG_News_NSN_Right,@s-503,30,,100)
		}
	}
EndM

Macro:(M_MessageHeader_Construction)
	Rect:() ref:Root
	{
		Draw:(Fade_Up,@f,23,@w,7)
		Draw:(Fade_Down,@f,130,@w,7)
		Draw:(White,@f,30,@w,100,,#343434FF)
		Draw:(MSG_News_NSConstruction_Left,0,30,,100,,#FFFFFF60)
		Draw:(MSG_News_NSConstruction_Right,@s-503,30,,100)
	}
EndM


Macro:(M_MessageHeader_Club,?COL?,?TEXT?,?TEXTCOL?)
	Rect:() ref:Root
	{
		Draw:(Fade_Up,@f,25,@w,5)
		Draw:(Fade_Down,@f,130,@w,5)

		// Right side team coloured fade
		Draw:(White,@f,30,@w,100)
		If:("?COL?" != "")
			.set(gel.colour,#?COL?FF)
		Else
			.set(gel.colour,twk(Player,HomeShirtCol1))
		EndIf
		Draw:(White,135,30,-1000,100)
		Draw:(Fade_Right,135,30,1000,100)
		Draw:(Banner_Star,@s,30,,100,,#FFFFFF20)
			Handle(1,0)

		M_Badge:(@s-75,80,HD,0.85,HeaderBadge)
		M_Text:(,@s-148,80,0,0,R,C,Text,KNUL40,,1,0,?TEXTCOL?,NoItalics,?TEXTCOL?,ref)
			.set(gel.text,LTR(?TEXT?))
			if("?COL?" = "")
			<
				.set(gel.colour,twk(Player,TeamTextCol))
			>
	}
EndM

Macro:(M_Buttons_OkayCustom,?X?,?CTRLBUTTON?)
	Rect:(@o,@T,@s,@H)
		strvar(%hinttxt)
		if(twk(ControllerInput,Enabled) = 1)
		<
			set(%hinttxt,loc(settings_?CTRLBUTTON?Button)::"  ")
		>
		else
		<
			set(%hinttxt,"")
		>
	{{
		M_Button:(?X?,@B-33,180,50,Button_GreenSliced,,0,0,0,0,#FFFFFFFF,message.btn_Ok,ref,loc(generic_OKAY),0,3,C,C,Text,KNUL22,Upper,0,0,#00000000,NoItalics,#FFFFFFFF,textref,,,%hinttxt)
			M_CTRLButtonExtra:(?CTRLBUTTON?,false)
			if(%clicked)
			<
				.set(twk(Message,State),"closing")
				.set(%action,1)
			>
	}}
EndM
Macro:(M_Buttons_Okay)
	M_Buttons_OkayCustom:(@R-120,?BTNOK?)
EndM

