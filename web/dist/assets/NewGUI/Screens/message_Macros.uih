Macro:(M_Body_RateTheApp) 
	Rect:() ref:Root
		.set(twk(Header,ScreenTitle),loc(rate_HEADER))
		:Post(UI_Swoosh)
	{
		Draw:(FTUESimon,175,295,650,650)
			Handle(0.5,0.5)
		
		Rect:(520,300)
		{{
			//Small Stars 
			Draw:(Card_Star5,5,20,74,74)
			Draw:(Card_Star3,10,25,64,64)
			Draw:(Card_Star5,255,20,74,74)
			Draw:(Card_Star3,260,25,64,64)
			//Medium Stars
			Draw:(Card_Star5,50,10,94,94)
			Draw:(Card_Star3,55,15,84,84)
			Draw:(Card_Star5,190,10,94,94)
			Draw:(Card_Star3,195,15,84,84)
			//Big Star
			Draw:(Card_Star5,110,0,114,114)
			Draw:(Card_Star3,115,5,104,104)
		}}

		M_Text:(RATE_THE_APP,380,47,[742+@y],235,L,C,TextBoxAtt,KNUL30,Upper,1,0,#252525FF,NoItalics,#252525FF,ref)
		M_Text:(RATE_THE_APP_DESC,380,217,[742+@y],0,L,T,TextBoxAtt,KNUL30,,0,0,#00000000,NoItalics,#252525FF,ref)
			LineSpacing(1.1)

		Rect:()
				set(gel.vis,twk(RateAppConfig,DebugHints))
		{
			M_Text:(,380,70,[742+@y],235,L,C,TextBoxAtt,KNUL30,Upper,1,0,#252525FF,NoItalics,#252525FF,ref)
				.set(gel.text,"Reason: " :: twk(RateAppData,ActiveRequestReason))
			// M_Text:(,10,85,0,0,L,C,TextLoc,KNUL25,,0,0,#00000000,NoItalics,#505050FF,ref)
		}
	}
EndM

