				<
					set(gel.layer,AboveText)
				>
				else
				<
					set(gel.layer,Ground)
				>
			{
				//NE
				M_ScaffoldLow:(2945,2130,0,-90,4X4)
				//NW
				M_ScaffoldLow:(2945,-2150,0,-90,4X4)
				//SE
				M_ScaffoldLow:(-2895,2130,0,-90,4X4)
				//SW
				M_ScaffoldLow:(-2895,-2150,0,-90,4X4)
			}
		}
