Define:(?HOMEORMATCH?=MATCH)

//----------------------------------------------------------------------------------------------------------------------------WEST STAND MACROS
Macro:(M_MatchStandWConstruction1,?NUM?)
	Rect:() // Visibility set by tier selector
	{
		Rect:() $HIDE
			M_CheckShowConstruction:(PitchStandW,?NUM?)
		{

			// Lower poly single mesh match version
			Rect:()
				if(%currentFadeW <1.0)
				<
					set(gel.layer,AboveText)
				>
				else
				<
					set(gel.layer,Ground)
				>
			{
				M_ScaffoldLow:(25,-2075,0,180,3X19)
			}

		}
	}
EndM


Macro:(M_MatchWConstruction4,?NUM?)
	Rect:() // Visibility set by tier selector
	{
		Rect:() $HIDE
			M_CheckShowConstruction:(PitchStandW,?NUM?)
			
		{
			//Lower poly single mesh match version
			Rect:()
				if(%currentFadeW <1.0)
				<
					set(gel.layer,AboveText)
				>
				else
				<
					set(gel.layer,Ground)
				>
			{
				M_ScaffoldLow:(25,-2475,0,180,5X19X9)
			}

		}
	}
EndM







