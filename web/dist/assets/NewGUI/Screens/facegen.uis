//-------------------------------------------------------------------------------------------IMPORTS
Import:(Core.uih)
//
Import:(cards.uih)
//----------------------------------------------------------------------------------LOCAL IMAGE DEFS
//---------------------------------------------------------------------------------------------SETUP
//----------------------------------------------------------------------------------------ANIMATIONS
//--------------------------------------------------------------------------------------------MACROS
Macro:(M_CardFaceGenSlot,?X?,?Y?,?ID?,?FILTER?,?COMBINATION?)
	Cull:(?X?,?Y?,?CARD_W?,?CARD_H?)	
		Handle(0.5,0.5)
	{{

		Rect:(0,0,?CARD_W?,?CARD_H?)
			Handle(0.5,0.5)
		{{
			Draw:(RoundedPanel,0,0,@W+8,@H+8,,#00ffff)
				Handle(0.5,0.5)
				Card_Highlight(?ID?)
			
		}}
			Card_Slot(?ID?,?FILTER?,?COMBINATION?)
			Scale(1.2,1.2)

		
		Rect:(-@W/2,-@H/2,@W*2,@H*2) $HIDE ref:?ID?Info
		{{
			Draw:(White,0,0,@W,@H,,#00000088)
			
			TextBox:("Comp1|Comp2|Comp3",0,0,@W,@H,C) ref:?ID?Info
				FontSize(2)
		}}
			Scale(0.5,0.5)


		Draw:(White,-55,-15,15,15)
			Click(facegen.showinfo,?ID?)
		
		Draw:(White,-55,0,15,15)
			Click(facegen.showedit,?ID?)
	
	}}

EndM
//-------------------------------------------------------------------------------------------CONTENT








