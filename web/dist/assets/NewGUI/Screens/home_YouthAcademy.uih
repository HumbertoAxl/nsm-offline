				Rect:()
				{
					//Base
					##IA
					DrawStaticModel:(Youth_Academy_Base_Lv_6,GenBase)
					##P4N
					DrawStaticModel:(Youth_Academy_Base_HI_Lv_6,Base_HI)
						M_TextureSelectW:()
					##*

					Locator:((11630,11490,0),(0,0,0),(1,1,1))
					{
						//Building
						DrawStaticModel:(Youth_Academy_Lv_6,Youth_06)
							M_TextureSelectW:()

						//Front Sign
						//?POSX?,?POSY?,?POSZ?,?ROTX?,?ROTY?,?ROTZ?,?BGW?,?BGH?,?TEXTX?,?TEXTY?,?TEXTW?,?FONTSIZE?,?FSCALE?,?FADE1X?,?FADE1Y?,?FADE1W?,?FADE1H?,?FADE2X?,?FADE2Y?,?FADE2W?,?FADE2H?,?SHADER?
						M_TeamName:(-355,-190,-170,-90,-90,-90,665,80,360,0,645,KNUL64,1.2,-1,-50,829,35,-1,50,829,45,ZSafeSprite,,40)
							Layer(ZSprite)

						//Front Badge
						M_StadTeamBadge:(175,-205,-500,-90,-90,-90,250,ZSafeSprite,)
							Layer(ZSprite)

						//Side Badge
						M_StadTeamBadge:(1710,115,-500,0,-90,-90,320,ZSafeSprite,)
							Layer(ZSprite)
					}
					
					UseShader:(Static3D)
						SetUniform4F(SpecParams,0.7)
					{
						Locator:((0,0,-1),(0,0,90),(1,1,1))
						{
							//Pitch Lines
							DrawStaticModel:(Youth_Academy_Lines_Lv_6,Facility_PitchLines)
								Blend(ONE,INV_IMAGE_ALPHA)
								M_TextureSelectW:()
						}
					}
					
					//Extra
					DrawStaticModel:(Youth_Academy_Extra_Lv_6,Youth_06)

					//Ads
					DrawStaticModel:(Youth_Academy_Ads_Lv_6,Stadium_Adboards_Lv_3)
						M_TextureSelectW:()

					// Transparency Content
					UseShader:(Simple3DNZW)
						Layer(Shadows)
					{
						Locator:((11630,11490,0),(0,0,0),(1,1,1))
						{
							//Building Shadow
							DrawStaticModel:(Youth_Academy_Shadow_Lv_6,Youth_06_Shadow)
								Blend(ONE,INV_IMAGE_ALPHA)
						}

						//Litter
						Locator:((0,0,-1),(0,0,0),(1,1,1))
						{	
							##IA
							DrawStaticModel:(Youth_Academy_Litter_Lv_6,Stadium_Litter_Lv_1)
								Blend(ONE,INV_IMAGE_ALPHA)
							##P4N
							DrawStaticModel:(Youth_Academy_Litter_HI_Lv_6,Stadium_Litter_Lv_1)
								Blend(ONE,INV_IMAGE_ALPHA)
								M_DayNightLitter:()	
							##*
						}

						//Fence
						DrawStaticModel:(Youth_Academy_Fence_Lv_6,Fence_Netting)
							Blend(ONE,INV_IMAGE_ALPHA)
							M_TextureSelectW:()
						//Nets
						DrawStaticModel:(Youth_Academy_Nets_Lv_6,GoalNetTexture)
							Blend(ONE,INV_IMAGE_ALPHA)
					}

					//Tree Shadows
					UseShader:(Simple3DNZW)
						Layer(Shadows)
					{
						##IA
						DrawStaticModel:(Youth_Academy_Trees_Shadow_Lv_6,GenTrees)
							Blend(ONE,INV_IMAGE_ALPHA)
						##P4N
						DrawStaticModel:(Youth_Academy_Trees_Shadow_HI_Lv_6,Trees_HI)
							Blend(ONE,INV_IMAGE_ALPHA)
							M_TextureSelectW:()
						##*
					}

					//Trees STANDARD
					##IA
					UseShader:(ProjectedLight3DVColOneBit)
						Layer(OneBit)
						SetSampler(TexSamp1,$CLOUDSHADOW)
					{
						DrawStaticModel:(Youth_Academy_Trees_Lv_6,GenTrees)
							Blend(ONE,INV_IMAGE_ALPHA)
					}
					//Trees HIGH DETAIL
					##P4N
					UseShader:(ProjectedLight3DVColOneBit_Alt)
						SetSampler(TexSamp1,$CLOUDSHADOW)
						Layer(OneBit)
					{
						DrawStaticModel:(Youth_Academy_Trees_HI_Lv_6,Trees_HI)
							Blend(ONE,INV_IMAGE_ALPHA)
							M_TextureSelectW:()
					}
					##*
					//Vehicles
					Rect:()
						Layer(Ground)
						M_CheckShowCars:(YouthAcademy)
					{
						##IA
						Batch:(BatchedYouthAcademyT6Cars)
							Blend(ONE,INV_IMAGE_ALPHA)
	    				{
	    					//Right Side				
	  						M_Vehicle:(15155,11665,Car,Car,90,Green)
	  						M_Vehicle:(15155,11300,Car,Car,-92,Black)
	  						M_Vehicle:(15155,11140,Car,Car,-92,Red)
	    					//Left Side
							M_Vehicle:(14555,11505,Car,Car,90,Orange)
	    					M_Vehicle:(14555,11130,Car,Car,-90,Purple)
	    					M_Vehicle:(14555,10980,Car,Car,90,Cyan)
	    				}
		  				M_Vehicle:(14580,10610,Van,Van,-90,Yellow)
		  				##P4N
						Batch:(BatchedYouthAcademyT6CarsHI)
							Blend(ONE,INV_IMAGE_ALPHA)
							M_TextureSelect:(NSM_CarSheet_HI)
	    				{
	    					//Right Side				
	  						M_Vehicle_HI:(15155,11665,Car2_Type1,Car,90)
	  						M_Vehicle_HI:(15155,11300,Car3_Type2,Car,-92)
	  						M_Vehicle_HI:(15155,11140,Car1_Type3,Car,-92)
	    					//Left Side
							M_Vehicle_HI:(14555,11505,Car3_Type1,Car,90)
	    					M_Vehicle_HI:(14555,11130,Car1_Type3,Car,-90)
	    					M_Vehicle_HI:(14555,10980,Car3_Type3,Car,90)
	    				}
		  				M_Vehicle_HI_Single:(14580,10610,Van1_Type2,Van,-90)
		  				##*
  					}
  					

					M_FacilitySectionHotArea:(11645,11830,0,7.9,4.2,5.9,0,0,0,15,YouthAcademy,6,?YOUTH_ACADEMY_SHOW_COLLIDERS?)
					M_FacilitySectionHotArea:(12990,11480,0,2.8,7,5.9,0,0,0,15,YouthAcademy,6,?YOUTH_ACADEMY_SHOW_COLLIDERS?)
					M_FacilitySectionHotArea:(10265,11480,0,2.9,7,5.9,0,0,0,15,YouthAcademy,6,?YOUTH_ACADEMY_SHOW_COLLIDERS?)
					M_YouthConstruction6:()
				}
			}
		} 
	}
EndM

