##*


//Make This Define Equal to a Texture to show the colliders for the youth academy
Define:(?YOUTH_ACADEMY_SHOW_COLLIDERS?=) 



//----------------------------------Medical Unit Macro
Macro:(M_YouthAcademy,?SCALE?)
	Locator:((0,0,0),(0,0,0),(?SCALE?,?SCALE?,?SCALE?))
		Unload(Youth_01_Shadow,Youth_02_Shadow,Youth_03_Shadow,Youth_04_Shadow,Youth_05_Shadow,Youth_06_Shadow)
		Unload(Youth_01,Youth_02,Youth_03,Youth_04,Youth_05,Youth_06)
	{
		UseShader:(ProjectedLight3DVCol)
			SetSampler(TexSamp1,$CLOUDSHADOW)
		{
			Rect:()
				Layer(Ground)
				M_FacilityConstructionController:(YouthAcademy,6)
			{
				//-----------------------------------------------------Tier 0
				Rect:()
				{
					##IA
					DrawStaticModel:(Youth_Academy_Base_Lv_0,GenBase)
					##P4N
					DrawStaticModel:(Youth_Academy_Base_HI_Lv_0,Base_HI)
						M_TextureSelectW:()
					##*
					
					//Youth Academy Selection Hint
					M_AreaSelection:(11500,9200,-2,6,YouthAcademy,37,27,0,0,180,Youth,575)
					
					//Tree Shadows
					UseShader:(Simple3DNZW)
						Layer(Shadows)
					{
						##IA
						DrawStaticModel:(Youth_Academy_Trees_Shadow_Lv_0,GenTrees)
							Blend(ONE,INV_IMAGE_ALPHA)
						##P4N
						DrawStaticModel:(Youth_Academy_Trees_Shadow_HI_Lv_0,Trees_HI)
							Blend(ONE,INV_IMAGE_ALPHA)
							M_TextureSelectW:()
						##*
					}

					//Trees STANDARD
					##IA
					UseShader:(ProjectedLight3DVColOneBit)
						Layer(OneBit)
						SetSampler(TexSamp1,$CLOUDSHADOW)
					{
						DrawStaticModel:(Youth_Academy_Trees_Lv_0,GenTrees)
							Blend(ONE,INV_IMAGE_ALPHA)
					}
					//Trees HIGH DETAIL
					##P4N
					UseShader:(ProjectedLight3DVColOneBit_Alt)
						SetSampler(TexSamp1,$CLOUDSHADOW)
						Layer(OneBit)
					{
						DrawStaticModel:(Youth_Academy_Trees_HI_Lv_0,Trees_HI)
							Blend(ONE,INV_IMAGE_ALPHA)
							M_TextureSelectW:()
					}
					##*	

					M_FacilitySectionHotArea:(11500,9200,0,36,28,15,0,0,0,15,YouthAcademy,6,?YOUTH_ACADEMY_SHOW_COLLIDERS?)
					M_YouthConstruction01:(0)
				}

				//-----------------------------------------------------Tier 1
				Rect:()
				{
					//Base
					##IA
					DrawStaticModel:(Youth_Academy_Base_Lv_1,GenBase)
					##P4N
					DrawStaticModel:(Youth_Academy_Base_HI_Lv_1,Base_HI)
						M_TextureSelectW:()
					##*
					
					Locator:((11457,11985,0),(0,0,0),(1,1,1))
						//set(gel.vis,twk(YouthAcademyConstruction,LastConstructionLevel) != 0)
					{
						//Building Shadow
						DrawStaticModel:(Youth_Academy_Shadow_Lv_1,Youth_01_Shadow)
							Blend(ONE,INV_IMAGE_ALPHA)

						//Building
						DrawStaticModel:(Youth_Academy_Lv_1,Youth_01)
							M_TextureSelectW:()

						//Railing
						DrawStaticModel:(Youth_Academy_Railing_Lv_1,Scout_01_RAILING)
							Blend(ONE,INV_IMAGE_ALPHA)

						//Side Badge
						M_StadTeamBadge:(520,150,-120,0,-90,-90,180,ZSafeSprite,)
							Layer(ZSprite)
					}
					
						
					UseShader:(Static3D)
						SetUniform4F(SpecParams,0.7)
					{
						Locator:((0,0,-1),(0,0,90),(1,1,1))
						{
							//Pitch Lines
							DrawStaticModel:(Youth_Academy_Lines_Lv_1,Facility_PitchLines)
								Blend(ONE,INV_IMAGE_ALPHA)
								M_TextureSelectW:()
						}
					}

					Locator:((0,0,-1),(0,0,0),(1,1,1))
					{	
						//Litter
						##IA
						DrawStaticModel:(Youth_Academy_Litter_Lv_1,Stadium_Litter_Lv_1)
							Blend(ONE,INV_IMAGE_ALPHA)
						##P4N
						DrawStaticModel:(Youth_Academy_Litter_HI_Lv_1,Stadium_Litter_Lv_1)
							Blend(ONE,INV_IMAGE_ALPHA)
							M_DayNightLitter:()	
						##*
					}
					
					//Extra
					DrawStaticModel:(Youth_Academy_Extra_Lv_1,Youth_01)	
						M_TextureSelectW:()
						

					//Tree Shadows
					UseShader:(Simple3DNZW)
						Layer(Shadows)
					{
						##IA
						DrawStaticModel:(Youth_Academy_Trees_Shadow_Lv_1,GenTrees)
							Blend(ONE,INV_IMAGE_ALPHA)
						##P4N
						DrawStaticModel:(Youth_Academy_Trees_Shadow_HI_Lv_1,Trees_HI)
							Blend(ONE,INV_IMAGE_ALPHA)
							M_TextureSelectW:()
						##*
					}

					//Trees STANDARD
					##IA
					UseShader:(ProjectedLight3DVColOneBit)
						Layer(OneBit)
						SetSampler(TexSamp1,$CLOUDSHADOW)
					{
						DrawStaticModel:(Youth_Academy_Trees_Lv_1,GenTrees)
							Blend(ONE,INV_IMAGE_ALPHA)
					}
					//Trees HIGH DETAIL
					##P4N
					UseShader:(ProjectedLight3DVColOneBit_Alt)
						SetSampler(TexSamp1,$CLOUDSHADOW)
						Layer(OneBit)
					{
						DrawStaticModel:(Youth_Academy_Trees_HI_Lv_1,Trees_HI)
							Blend(ONE,INV_IMAGE_ALPHA)
							M_TextureSelectW:()
					}
					##*
					//Vehicles
					Rect:()
						Layer(Ground)
						M_CheckShowCars:(YouthAcademy)
					{
						##IA
						Batch:(BatchedYouthAcademyT1Cars)
							Blend(ONE,INV_IMAGE_ALPHA)
	    				{
	    					//Left Side				
	  						M_Vehicle:(14575,10970,Car,Car,92,Cyan)
	    					//Right Side
	    					M_Vehicle:(14580,10625,Car,Car,-90,Red)
	    					
	    				}
		  				M_Vehicle:(15175,11300,Van,Van,92,Yellow)
		  				##P4N
						Batch:(BatchedYouthAcademyT1CarsHI)
							Blend(ONE,INV_IMAGE_ALPHA)
							M_TextureSelect:(NSM_CarSheet_HI)
	    				{
	    					//Left Side				
	  						M_Vehicle_HI:(14575,10970,Car1_Type1,Car,92)
	    					//Right Side
	    					M_Vehicle_HI:(14580,10625,Car2_Type3,Car,-90)
	    					
	    				}
		  				M_Vehicle_HI_Single:(15175,11300,Van1_Type2,Van,92)
		  				##*
  					}
  						
					
					M_FacilitySectionHotArea:(11450,12000,0,4.1,2.8,2.1,0,0,0,15,YouthAcademy,6,?YOUTH_ACADEMY_SHOW_COLLIDERS?)
					M_FacilitySectionHotArea:(11450,11600,0,3,0.4,0.5,0,0,0,15,YouthAcademy,6,?YOUTH_ACADEMY_SHOW_COLLIDERS?)
					M_YouthConstruction01:(1)
				}
				
				//-----------------------------------------------------Tier 2
				Rect:()
				{
					//Base
					##IA
					DrawStaticModel:(Youth_Academy_Base_Lv_2,GenBase)
					##P4N
					DrawStaticModel:(Youth_Academy_Base_HI_Lv_2,Base_HI)
						M_TextureSelectW:()
					##*
					
					Locator:((11816,11695,0),(0,0,0),(1,1,1))
					{
						//Building
						DrawStaticModel:(Youth_Academy_Lv_2,Youth_02)
							M_TextureSelectW:()

						//Front Sign
						//?POSX?,?POSY?,?POSZ?,?ROTX?,?ROTY?,?ROTZ?,?BGW?,?BGH?,?TEXTX?,?TEXTY?,?TEXTW?,?FONTSIZE?,?FSCALE?,?FADE1X?,?FADE1Y?,?FADE1W?,?FADE1H?,?FADE2X?,?FADE2Y?,?FADE2W?,?FADE2H?,?SHADER?
						M_TeamName:(843,210,-210,0,-90,-90,715,80,360,0,705,KNUL64,1.2,-1,-50,829,35,-1,50,829,45,ZSafeSprite,,40,,40)
