//-------------------------------------------------------------------------------------------IMPORTS
Import:(Core.uih)
Import:(cards.uih)
//----------------------------------------------------------------------------------LOCAL IMAGE DEFS
//---------------------------------------------------------------------------------------------SETUP
Rect:()
	.set(twk(EndSeason,ClubAwardsScroll),0)
	.set(twk(EndSeason,ClubAwardsScrollVel),0)

// Audio
Rect:()
	set(twk(Audio,SuppressAllAmbient),1)
	
//----------------------------------------------------------------------------------------ANIMATIONS
//--------------------------------------------------------------------------------------------MACROS
//-----------------------------------------------------------------------------------------TEMPLATES
Macro:(M_ClubAward,?IMAGE?,?TEXT?,?VAR?,?STAT?)
	Cull:(0,0,280,570)
		CTRLSelect(CTRLBasicSelected,0,-3,27,-535)
	{{
		Draw:(?IMAGE?,@C-200,-45,400,400)

		PushOrigin:(0,270)
			Draw:(Comp_BG,@C-145,0,290,24,,#252525FF)
			M_Text:(?TEXT?,@C-120,12,240,0,C,C,TextLoc,KNUL23,,0,0,#00000000,NoItalics,#FFFFFFFF,ref)
				M_Style:(Outline,#FFFFFF20)
		PopOrigin

		Rect:(@C,365)
			Card_Face(?VAR?)
			Scale(1.2,1.2)

		M_Text:(,@C,490,0,0,C,C,Text,KNUL25,,1,0,#252525FF,NoItalics,#252525FF,ref,EndSeason,?VAR?)

		// Stat Bar
		Rect:()
			if(twk(EndSeason,?STAT?) > 0)
			<
				:set(gel.alpha,1)
			>
			else
			<
				:set(gel.alpha,0.3)
			>
		{
			Draw:(CircleBar_Reflection,@C-30,554,60,20)
			Draw:(Circle_100,@C-25,510,50,50,,#505050FFFFFFFFFF)
		}
		
		M_Text:(,@C,535,0,0,C,C,Text,KNUL35,,1,0,#FFFFFFFF,NoItalics,#FFFFFFFF,ref,EndSeason,?STAT?,DoLTR)
	}}
EndM




//-------------------------------------------------------------------------------------------CONTENT

Dissolve:(@o,@T,@s,@H) ref:DissolveRoot
{{

	// Base line
	Draw:(White,@L,315,@W,1,,#FFFFFF30)

	// Content
	Rect:(@L,@T+50,@W,@H-120) ref:SwipePanels
		SwipePanel(PageSystem,BlockScroll,PageSystem,BlockScrollVel,EndSeason,ClubAwardsScroll,EndSeason,ClubAwardsScrollVel) ref:SwipePanelClubAwards
	{{
		Rect:(30,40,@W-60,@H-40)
		{{
			Rect:(0,0,@W,@H) ref:AwardsList
				SnappingListX(EndSeason,ClubAwardsScroll,@W,EndSeason,ClubAwardsScrollVel,SwipePanels,SwipePanelClubAwards,15,0.1,true) ref:ScrollingList
				ChildrenOffset(321+[@y/3],0) ref:ChildOffset
				CTRLScrollList(ScrollingList) ref:CTRLScrollList
			{
				M_ClubAward:(Trophy_Manager_02,endseason_playeroftheyear,PlayerOfTheYear)
				M_ClubAward:(Trophy_Manager_02,endseason_youngplayeroftheyear,YoungPlayerOfTheYear)
				M_ClubAward:(Trophy_Player_01,endseason_topscorer,TopScorer,StatTopScorer)
				M_ClubAward:(Trophy_Player_02,endseason_mostassists,MostAssists,StatMostAssists)
				M_ClubAward:(Trophy_Player_03,endseason_mostappearances,MostAppearances,StatMostAppearances)
					set(gel.vis,twk(Ftue,FtueSeason)=0)
			}
			M_ScrollIndicatorAltH:(@B-5,@W,EndSeason,ClubAwardsScroll,AwardsList,ScrollingList,SwipePanels,SwipePanelClubAwards)
		}}
		M_SwitchStickHint:(✃,@R-58,@B-41,X)
			CTRLScrollListIcon(AwardsList,CTRLScrollList)
	}}
}}