				//-------------------------------------------------Surrounding World Vehicles North Estates
				
				##IA
				//TrainStandard
				Locator:((22350,-800,-150),(0,0,0),(1,1,1))
				{
					Locator:((0,0,0),(0,0,0),(1,1,1))
						float(%FCURVE2)
						float(%Train2RandDelay)
						float(%MoveTrain2)
						if(%MoveTrain2 = 0)
						<
							//Random delay for train start
							:set(%TrainR2andDelay,frand(20,60))
							:Delay(%Train2RandDelay)
							:set(%MoveTrain2,1)
						>
						if(%MoveTrain2 = 1)
						<
							add(%FCURVE2,0.00025)
							if(%FCURVE2>1)
							<
								set(%FCURVE2,0)
								set(%MoveTrain2,0)
							>
						>
						FollowCurve(Train,TrainTravel,%FCURVE2,true)
					{	
					 	Locator:((0,0,0),(-90,0,0),(1,1,1))
					 	{
					 		M_Train:(0,0,Train,NSM_CoachSheet_HI,0)
						}
					}
				}

				##P4N
				//Train HI
				Locator:((22880,0,-150),(0,0,0),(1,1,1))
				{
					Locator:((0,0,0),(0,0,0),(1,1,1))
						float(%FCURVE)
						float(%TrainRandDelay)
						float(%MoveTrain)
						if(%MoveTrain = 0)
						<
							//Random delay for train start
							:set(%TrainRandDelay,frand(10,80))
							:Delay(%TrainRandDelay)
							:set(%MoveTrain,1)
						>
						if(%MoveTrain = 1)
						<
							add(%FCURVE,0.001)
							if(%FCURVE>1)
							<
								set(%FCURVE,0)
								set(%MoveTrain,0)
							>
						>
						FollowCurve(Train,TrainTravel,%FCURVE,true)
					{	
						Locator:((0,0,0),(-90,0,0),(1.2,1.2,1.2))
				 	 	{
							M_Train:(0,0,Train_HI,NSM_CoachSheet,0)
						}
					}
				}
				
				//TrainStandard
				Locator:((22255,-800,-150),(0,0,0),(1,1,1))
				{
					Locator:((0,0,0),(0,0,0),(1,1,1))
						float(%FCURVE2)
						float(%Train2RandDelay)
						float(%MoveTrain2)
						if(%MoveTrain2 = 0)
