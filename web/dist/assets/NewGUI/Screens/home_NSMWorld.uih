							<
								set(%FCURVE2,0)
								set(%MoveTrain2,0)
							>
						>
						FollowCurve(Train,TrainRun1,%FCURVE2,true)
					{	
					 	Locator:((0,0,0),(-90,0,0),(1,1,1))
					 	{
