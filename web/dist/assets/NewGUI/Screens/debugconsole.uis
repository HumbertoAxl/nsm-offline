Import:(Core.uih)


 M_Text:(,@R-20,100,0,0,R,C,Text,KNUL25,,0,0,#00000000,NoItalics,#FFFFFFFF,ref)
	set(gel.text,"Screen: " :: shell(GameScreen))

 M_Text:(,@R-20,140,0,0,R,C,Text,KNUL25,,0,0,#00000000,NoItalics,#FFFFFFFF,ref)
	set(gel.text,"Dialog: " :: twk(DynamicOverlay,CurrentTopScreen))
	if(twk(DynamicOverlay,CurrentTopScreen) = "")
	<
		:set(gel.alpha,0.5)
	>
	else
	<
		:set(gel.alpha,1)
	>

Macro:(M_ConsoleCommand,?X?,?Y?,?ID?)
	Rect:(?X?,?Y?,@H,20)
	{{
		M_Text:(,0,0,@W-20,20,L,C,Text,KNUL22,,0,0,#00000000,Italics,#FFFFFFFF,ref,Debug,Command?ID?)
			if(twk(Debug,Command?ID?Status) = 0)
			<
				set(gel.colour,#FF0000FF)
			>
			if(twk(Debug,Command?ID?Status) = 1)
			<
				set(gel.colour,#33FF55FF)
			>
			if(twk(Debug,Command?ID?Status) = 2)
			<
				set(gel.colour,#FFFFFF80)
			>
	}}
EndM


//GreyOutEffect
Draw:(White,@L,@T,@W,@H,,#000000BB)
    Click(None)

M_ConsoleCommand:(@L+10,@B-360,15)
M_ConsoleCommand:(@L+10,@B-340,14)
M_ConsoleCommand:(@L+10,@B-320,13)
M_ConsoleCommand:(@L+10,@B-300,12)
M_ConsoleCommand:(@L+10,@B-280,11)
M_ConsoleCommand:(@L+10,@B-260,10)
M_ConsoleCommand:(@L+10,@B-240,9)
M_ConsoleCommand:(@L+10,@B-220,8)
M_ConsoleCommand:(@L+10,@B-200,7)
M_ConsoleCommand:(@L+10,@B-180,6)
M_ConsoleCommand:(@L+10,@B-160,5)
M_ConsoleCommand:(@L+10,@B-140,4)
M_ConsoleCommand:(@L+10,@B-120,3)
M_ConsoleCommand:(@L+10,@B-100,2)
M_ConsoleCommand:(@L+10,@B-80,1)
M_ConsoleCommand:(@L+10,@B-60,0)

Draw:(White,@L+10,@B-35,@W-20,30,,#FFFFFF22)

 M_Text:(">",@L+12,@B-20,40,0,L,C,Text,KNUL22,,0,0,#00000000,Italics,#33FF55FF,ref)
 M_Text:(,@L+30,@B-20,0,0,L,C,Text,KNUL22,,0,0,#00000000,Italics,#33FF55FF,ref,Debug,CurrentCommand)