Macro:(M_SortIndicator,?X?,?Y?,?W?,?H?,?TYPE?,?TEXT?,?TX?,?TY?,?ALIGN?,?TWKCAT?,?CONTEXT?,?SORT_DIRECTION?)
	Rect:(?X?,?Y?,?W?,?H?)
		M_CellPress:()
		func(ClickFunc)
		<
			Post(UI_Select)
			Post(?CONTEXT?.btn_Sort,?TYPE?::"|"::?SORT_DIRECTION?)
		>
		If:(?TYPE? != ?NOSORT?)
			Click()
			<
				call(ClickFunc)
			>
			M_CTRLCellExtra:(?BTNOK?,true,CTRLSquareSelected,0,0,0,0)
		EndIf
		

	{{
		Draw:(White,0,0,@W+1,40,#FFFFFF00)
			Additive()
			if(%pressed)
			<
				frlerp(gel.alpha,0.15,0.25)
			>
			else
			<
				:set(gel.alpha,0)
			>

		Draw:(White,0,3,1,34,,#999999FFFFFFFFFF)
		Draw:(White,@R,3,1,34,,#999999FFFFFFFFFF)

		M_Text:(?TEXT?,?TX?,?TY?,@W,@H,?ALIGN?,C,TextLoc,KNUL20,,0,0,#00000000,NoItalics,#FFFFFFFF,ref)
			set(gel.vis,twk(?TWKCAT?,SortingBy) != ?TYPE?)
			M_Style:(Outline,#FFFFFF20)
		M_Text:(?TEXT?,?TX?,?TY?,@W,@H,?ALIGN?,C,TextLoc,KNUL20,,0,0,#00000000,NoItalics,#FFD800FF,ref)
			set(gel.vis,twk(?TWKCAT?,SortingBy) = ?TYPE?)
			M_Style:(Outline,#FFD80020)
	}}
EndM