//----------------------------------------------------------------------------Stadium
View:(Stadium_Lv_3,256,512)
	M_ONCE:()
{
	Sheet:() 
	{
		Draw:(StadiumSteps,0,0,256,512,,#FFFFFFFFFFFFFFFF)
			set(gel.colour.RGBA,twk(Match,Team1Col))
		Draw:(StadiumSteps,0,2,256,512,,#FFFFFFFFFFFFFFFF)
			set(gel.colour.RGBA,twk(Match,Team1Col))

		//Draw:(Stadium_T3_PrimaryCol,0,0,256,512,,#FFFFFFFFFFFFFFFF)
			//set(gel.colour.RGBA,twk(Match,Team1Col))
	}
}

