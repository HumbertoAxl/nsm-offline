						//Seats And Ads
						Locator:((0,0,0),(0,0,90),(1,1,1))
						{
							DrawStaticModel:(Stadium_Seats_E_Lv_1,Stadium_Lv_3)
								M_TextureSelectW:()
								//Blend(ONE,INV_IMAGE_ALPHA)
						}	
						Locator:((20,0,0),(0,0,90),(1,1,1))
						{		
							DrawStaticModel:(Stadium_StandSign_E_Lv_1,Stadium_Adverts_Lv_3)
								//Blend(ONE,INV_IMAGE_ALPHA)
								M_TextureSelectW:()
						}	
						//Shadows
						UseShader:(Simple3DNZW)
							Layer(Shadows)
						{
							
							Rect:()
								.set(gel.vis,twk(Facilities,Night) = 0)
							{
								Locator:((0,0,-3),(0,0,90),(1,1,1))
								{
									DrawStaticModel:(Stadium_Club_E_Shadow_Lv_2,Stadium_T2_Shadows)
										Blend(ONE,INV_IMAGE_ALPHA)
								}
								Locator:((0,0,-4),(0,0,90),(1,1,1))
								{	
									DrawStaticModel:(Stadium_Seats_E_Shadow_Lv_2,Stadium_T2_Shadows)
										Blend(ONE,INV_IMAGE_ALPHA)
								}
							}
