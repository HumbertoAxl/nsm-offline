							SetSampler(TexSamp1,$CLOUDSHADOW)
							SetUniform1F(Fade,%currentFadeE)
							set(gel.layer,%rlayer)
						{
							DrawStaticModel:(Stadium_Signs_E_Lv_4,Stadium_Adverts_Lv_3)
								Blend(ONE,INV_IMAGE_ALPHA)
								M_TextureSelectW:()

							DrawStaticModel:(Stadium_Roof_E_Lv_4,Stadium_Lv_4)
								Blend(ONE,INV_IMAGE_ALPHA)
								M_TextureSelectW:()
						}
						##P4N
						//Roof Light--------------------------------
						Rect:()
							.set(gel.vis,(twk(Facilities,Night) = 1) and(shell(GameScreen) !="matchengine"))
						{
							UseShader:(Simple3DNZW)
								Layer(AboveSky)
							{
								//Beams	
								DrawStaticModel:(Stadium_Roof_E_Lights_Lv_4,Floodlight_Beam)
									Blend(ONE,INV_IMAGE_ALPHA)
								
								//Glows
								DrawStaticModel:(Stadium_E_LightGlow_Lv_4,Floodlight_Glow) 
									Blend(ONE,INV_IMAGE_ALPHA)
							}
						}
						##*
					}
					M_Crowd_E_4:()
				}

				//Tier 5
				Rect:()
				{
					//Shadow
					Rect:()
						.set(gel.vis,twk(Facilities,Night) = 0)
					{
						Locator:((0,0,-3),(0,0,90),(1,1,1))
						{
							UseShader:(Simple3DNZW)
								Layer(Shadows)
							{
								DrawStaticModel:(Stadium_Seats_E_Shadow_Lv_5,Stadium_T5_Shadows)
									Blend(ONE,INV_IMAGE_ALPHA)
							}

						}
					}
					
					//Seats
					Locator:((0,0,-4),(0,0,90),(1,1,1))
					{
						DrawStaticModel:(Stadium_Seats_E_Lv_5,Stadium_Lv_5)
							Blend(ONE,INV_IMAGE_ALPHA)
							M_TextureSelectW:()

					}

					//Roof
					Locator:((0,0,-4),(0,0,90),(1,1,1))
					{
						//Roof n Ads
						UseShader:(ProjectedLight3DVColFaded)
							SetSampler(TexSamp1,$CLOUDSHADOW)
							SetUniform1F(Fade,%currentFadeE)
							set(gel.layer,%rlayer)
						{	
						
							DrawStaticModel:(Stadium_Roof_E_Lv_5,Stadium_Lv_5)
								Blend(ONE,INV_IMAGE_ALPHA)
								M_TextureSelectW:()	
						}

						DrawStaticModel:(Stadium_Signs_E_Lv_5,Stadium_Adverts_Lv_3)
							M_TextureSelectW:()
					}
					##P4N
					//Roof Light--------------------------------
					Rect:()
						.set(gel.vis,(twk(Facilities,Night) = 1) and(shell(GameScreen) !="matchengine"))
					{
						UseShader:(Simple3DNZW)
							Layer(AboveSky)
						{
							Locator:((0,0,0),(0,0,90),(1,1,1))
							{
							//Beams	
							DrawStaticModel:(Stadium_Roof_E_Lights_Lv_5,Floodlight_Beam)
								Blend(ONE,INV_IMAGE_ALPHA)
							
							//Glows
							DrawStaticModel:(Stadium_E_LightGlow_Lv_5,Floodlight_Glow) 
								Blend(ONE,INV_IMAGE_ALPHA)
							}
						}
					}
					##*
					M_Crowd_E_5:()
				}
			}	
	