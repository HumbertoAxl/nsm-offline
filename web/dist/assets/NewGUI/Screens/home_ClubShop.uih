//Make This Define Equal to a Texture to show the colliders for the club shop
Define:(?CLUB_SHOP_SHOW_COLLIDERS?=) 

//----------------------------------Club Shop Macro
Macro:(M_ClubShop,?SCALE?)
	Locator:((0,0,0),(0,0,0),(?SCALE?,?SCALE?,?SCALE?))
		Unload(Shop_01_Shadow,Shop_02_Shadow,Shop_03_Shadow,Shop_04_Shadow,Shop_05_Shadow,Shop_06_Shadow)
		//Unload(Shop_01,Shop_02,Shop_03,Shop_04,Shop_05,Shop_06)
		Unload(Shop_05_ROOF,Shop_06_ROOF)
	{
		UseShader:(ProjectedLight3DVCol)
			SetSampler(TexSamp1,$CLOUDSHADOW)
		{
			Rect:()
				Layer(Ground)
				M_FacilityConstructionController:(ClubShop,5)
			{
				//-----------------------------------------------------Tier 0
				Rect:()
				{
					//Base
					##IA
					DrawStaticModel:(Club_Shop_Base_Lv_0,GenBase)
					##P4N
					DrawStaticModel:(Club_Shop_Base_HI_Lv_0,Base_HI)
						M_TextureSelectW:()
					##*

					//Club Shop Selection Hint
					M_AreaSelection:(-200,-8700,-2,5,ClubShop,22,25,0,0,-90,Shop,575)

					//Houses
					##IA
					DrawStaticModel:(Club_Shop_Houses_Lv_0,HouseB)
					##P4N
					DrawStaticModel:(Club_Shop_Houses_HI_Lv_0,Buildings_HI)
						M_TextureSelectW:()

					Rect:() $HIDE
						.set(gel.vis,twk(Facilities,Night)=1)
  					{
						DrawStaticModel:(Club_Shop_Houses_Lights_HI_Lv_1,Buildings_HI_Night)
					}
					##*


					//Tree Shadows
					UseShader:(Simple3DNZW)
						Layer(Shadows)
					{
						##IA
						DrawStaticModel:(Club_Shop_Trees_Shadow_Lv_0,GenTrees)
							Blend(ONE,INV_IMAGE_ALPHA)
						##P4N
						DrawStaticModel:(Club_Shop_Trees_Shadow_HI_Lv_0,Trees_HI)
							Blend(ONE,INV_IMAGE_ALPHA)
							M_TextureSelectW:()
						##*
					}

					//Trees STANDARD
					##IA
					UseShader:(ProjectedLight3DVColOneBit)
						Layer(OneBit)
						SetSampler(TexSamp1,$CLOUDSHADOW)
					{
						DrawStaticModel:(Club_Shop_Trees_Lv_0,GenTrees)
							Blend(ONE,INV_IMAGE_ALPHA)
					}
					//Trees HIGH DETAIL
					##P4N
					UseShader:(ProjectedLight3DVColOneBit_Alt)
						SetSampler(TexSamp1,$CLOUDSHADOW)
						Layer(OneBit)
