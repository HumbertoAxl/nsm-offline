//Make This Define Equal to a Texture to show the colliders for the medical unit
Define:(?MEDICAL_UNIT_SHOW_COLLIDERS?=) 


//----------------------------------Medical Unit Macro
Macro:(M_MedicalUnit,?SCALE?)
	Locator:((0,0,0),(0,0,0),(?SCALE?,?SCALE?,?SCALE?))
		Unload(Medical_01_Shadow,Medical_02_Shadow,Medical_03_Shadow,Medical_04_Shadow,Medical_05_Shadow,Medical_06_Shadow)
		Unload(Medical_01,Fitness_02,Medical_03,Fitness_04,Medical_05,Medical_06)
		Unload(Medical_05_ROOF,Medical_06_ROOF)
	{
		UseShader:(ProjectedLight3DVCol)
			SetSampler(TexSamp1,$CLOUDSHADOW)
		{
			
			Rect:()
				Layer(Ground)
				M_FacilityConstructionController:(MedicalUnit,3)
			{
				//-----------------------------------------------------Tier 0
				Rect:()
				{
					//Base
					##IA
					DrawStaticModel:(Medical_Unit_Base_Lv_0,GenBase)
					##P4N
					DrawStaticModel:(Medical_Unit_Base_HI_Lv_0,Base_HI)
						M_TextureSelectW:()
					##*

					//Medical Unit Selection Hint
					M_AreaSelection:(-12000,-7000,-2,3,MedicalUnit,26,27,0,0,-90,Medical,575)

					//Tree Shadows
					UseShader:(Simple3DNZW)
						Layer(Shadows)
					{
						##IA
						DrawStaticModel:(Medical_Unit_Trees_Shadow_Lv_0,GenTrees)
							Blend(ONE,INV_IMAGE_ALPHA)
						##P4N
						DrawStaticModel:(Medical_Unit_Trees_Shadow_HI_Lv_0,Trees_HI)
							Blend(ONE,INV_IMAGE_ALPHA)
							M_TextureSelectW:()
						##*
					}
			
					//Trees STANDARD
					##IA
					UseShader:(ProjectedLight3DVColOneBit)
						Layer(OneBit)
						SetSampler(TexSamp1,$CLOUDSHADOW)
					{
						DrawStaticModel:(Medical_Unit_Trees_Lv_0,GenTrees)
							Blend(ONE,INV_IMAGE_ALPHA)
					}
					//Trees HIGH DETAIL
					##P4N
					UseShader:(ProjectedLight3DVColOneBit_Alt)
						SetSampler(TexSamp1,$CLOUDSHADOW)
						Layer(OneBit)
					{
						DrawStaticModel:(Medical_Unit_Trees_HI_Lv_0,Trees_HI)
							Blend(ONE,INV_IMAGE_ALPHA)
							M_TextureSelectW:()
					}
					##*	

					M_FacilitySectionHotArea:(-12300,-7000,0,25.5,26,10,0,0,0,12,MedicalUnit,3,?MEDICAL_UNIT_SHOW_COLLIDERS?)
					M_MedicalConstruction01:(0)
				}

				//-----------------------------------------------------Tier 1
				Rect:()
				{
					//Base
					##IA
					DrawStaticModel:(Medical_Unit_Base_Lv_1,GenBase)
					##P4N
					DrawStaticModel:(Medical_Unit_Base_HI_Lv_1,Base_HI)
						M_TextureSelectW:()
					##*
					
					//Building
					Locator:((-13195,-5918,0),(0,0,0),(1,1,1))
					{
						DrawStaticModel:(Medical_Unit_Lv_1,Medical_01)
							M_TextureSelectW:()

						//Front Badge
						M_StadTeamBadge:(422,-155,-160,0,-90,-90,125,ZSafeSprite,)
							Layer(ZSprite)
					}
					
					//Building Shadow
					UseShader:(Simple3DNZW)
						Layer(Shadows)
					{
						Locator:((-13195,-5918,0),(0,0,0),(1,1,1))
						{
							DrawStaticModel:(Medical_Unit_Shadow_Lv_1,Medical_01_Shadow)
								Blend(ONE,INV_IMAGE_ALPHA)
						}
					}

					//Tree Shadows
					UseShader:(Simple3DNZW)
						Layer(Shadows)
					{
						##IA
						DrawStaticModel:(Medical_Unit_Trees_Shadow_Lv_1,GenTrees)
							Blend(ONE,INV_IMAGE_ALPHA)
						##P4N
						DrawStaticModel:(Medical_Unit_Trees_Shadow_HI_Lv_1,Trees_HI)
							Blend(ONE,INV_IMAGE_ALPHA)
							M_TextureSelectW:()
						##*
					}

					//Trees STANDARD
					##IA
					UseShader:(ProjectedLight3DVColOneBit)
						Layer(OneBit)
						SetSampler(TexSamp1,$CLOUDSHADOW)
					{
						DrawStaticModel:(Medical_Unit_Trees_Lv_1,GenTrees)
							Blend(ONE,INV_IMAGE_ALPHA)
					}
					//Trees HIGH DETAIL
					##P4N
					UseShader:(ProjectedLight3DVColOneBit_Alt)
						SetSampler(TexSamp1,$CLOUDSHADOW)
						Layer(OneBit)
					{
						DrawStaticModel:(Medical_Unit_Trees_HI_Lv_1,Trees_HI)
							Blend(ONE,INV_IMAGE_ALPHA)
							M_TextureSelectW:()
					}
					##*
					
					//Vehicles
					UseShader:(ProjectedLight3DVCol)
						SetSampler(TexSamp1,$CLOUDSHADOW)
						Layer(Ground)
					{
						Rect:()						
							M_CheckShowCars:(MedicalUnit)
						{
							##IA
							Batch:(BatchedMedicalT1Cars)
								Blend(ONE,INV_IMAGE_ALPHA)
							{
								//Top
								M_Vehicle:(-13650,-8805,Car,Car,180,Orange)
								//Bottom					
								M_Vehicle:(-12930,-8805,Car,Car,0,Blue)
							}
							//Far
							M_Vehicle:(-13640,-8195,Van,Van,180,Red)
							##P4N
							Batch:(BatchedMedicalT1CarsHI)
								Blend(ONE,INV_IMAGE_ALPHA)
								M_TextureSelect:(NSM_CarSheet_HI)
							{
								//Top
								M_Vehicle_HI:(-13650,-8805,Car1_Type1,Car,180)
								//Bottom					
								M_Vehicle_HI:(-12930,-8805,Car3_Type2,Car,0)
							}

							//Ambulance
							M_Ambulance:(-13290,-8195,90,1)

							//Far
							M_Vehicle_HI_Single:(-13640,-8195,Van1_Type1,Van,180)
							##*
						}
					}
						

					M_FacilitySectionHotArea:(-13200,-5900,0,3.5,4.5,3,0,0,0,12,MedicalUnit,3,?MEDICAL_UNIT_SHOW_COLLIDERS?)
					M_MedicalConstruction01:(1)
				}
				
				//-----------------------------------------------------Tier 2
				Rect:()
				{
					//Base
					##IA
					DrawStaticModel:(Medical_Unit_Base_Lv_2,GenBase)
					##P4N
					DrawStaticModel:(Medical_Unit_Base_HI_Lv_2,Base_HI)
						M_TextureSelectW:()
					##*
					
					//Building
					Locator:((-12882,-5578,0),(0,0,0),(1,1,1))
					{
						DrawStaticModel:(Medical_Unit_Lv_2,Medical_02)
							M_TextureSelectW:()

						//Team Name
						//?POSX?,?POSY?,?POSZ?,?ROTX?,?ROTY?,?ROTZ?,?BGW?,?BGH?,?TEXTX?,?TEXTY?,?TEXTW?,?FONTSIZE?,?FSCALE?,?FADE1X?,?FADE1Y?,?FADE1W?,?FADE1H?,?FADE2X?,?FADE2Y?,?FADE2W?,?FADE2H?,?SHADER?
						M_TeamName:(110,253,-345,0,-90,-90,495,90,250,10,485,KNUL64,1.2,-1,-50,829,35,-1,50,829,45,ZSafeSprite,,40)
							Layer(ZSprite)

						//Front Badge
						M_StadTeamBadge:(110,-165,-130,0,-90,-90,125,ZSafeSprite,)
							Layer(ZSprite)
					}

					//Building Shadow
					UseShader:(Simple3DNZW)
						Layer(Shadows)
					{
						Locator:((-12882,-5578,0),(0,0,0),(1,1,1))
						{
							DrawStaticModel:(Medical_Unit_Shadow_Lv_2,Medical_02_Shadow)
								Blend(ONE,INV_IMAGE_ALPHA)
						}
					}

					//Tree Shadows
					UseShader:(Simple3DNZW)
						Layer(Shadows)
					{
						##IA
						DrawStaticModel:(Medical_Unit_Trees_Shadow_Lv_2,GenTrees)
							Blend(ONE,INV_IMAGE_ALPHA)
						##P4N
						DrawStaticModel:(Medical_Unit_Trees_Shadow_HI_Lv_2,Trees_HI)
							Blend(ONE,INV_IMAGE_ALPHA)
							M_TextureSelectW:()
						##*
					}

					//Trees STANDARD
					##IA
					UseShader:(ProjectedLight3DVColOneBit)
						Layer(OneBit)
						SetSampler(TexSamp1,$CLOUDSHADOW)
					{
						DrawStaticModel:(Medical_Unit_Trees_Lv_2,GenTrees)
							Blend(ONE,INV_IMAGE_ALPHA)
					}
					//Trees HIGH DETAIL
					##P4N
					UseShader:(ProjectedLight3DVColOneBit_Alt)
						SetSampler(TexSamp1,$CLOUDSHADOW)
						Layer(OneBit)
					{
						DrawStaticModel:(Medical_Unit_Trees_HI_Lv_2,Trees_HI)
							Blend(ONE,INV_IMAGE_ALPHA)
							M_TextureSelectW:()
					}
					##*

					//Vehicles
					UseShader:(ProjectedLight3DVCol)
						SetSampler(TexSamp1,$CLOUDSHADOW)
						Layer(Ground)
					{
						Rect:()
							M_CheckShowCars:(MedicalUnit)
						{
							##IA
							Batch:(BatchedMedicalT2Cars)
								Blend(ONE,INV_IMAGE_ALPHA)
							{
								//Top
								M_Vehicle:(-13600,-8635,Car,Car,-92,Orange)
								M_Vehicle:(-13600,-8995,Car,Car,-90,Green)
								M_Vehicle:(-13600,-9340,Car,Car,90,Cyan)
								//Bottom					
								M_Vehicle:(-12960,-8825,Car,Car,90,Blue)
								M_Vehicle:(-12960,-9165,Car,Car,-92,Red)
							}
							//Far
							M_Vehicle:(-13640,-8195,Van,Van,0,Yellow)
							
							##P4N
							Batch:(BatchedMedicalT2CarsHI)
								Blend(ONE,INV_IMAGE_ALPHA)
								M_TextureSelect:(NSM_CarSheet_HI)
							{
								//Top
								M_Vehicle_HI:(-13600,-8635,Car1_Type1,Car,-92)
								M_Vehicle_HI:(-13600,-8995,Car2_Type1,Car,-90)
								M_Vehicle_HI:(-13600,-9340,Car1_Type2,Car,90)
								//Bottom					
								M_Vehicle_HI:(-12960,-8825,Car3_Type3,Car,90)
								M_Vehicle_HI:(-12960,-9165,Car2_Type2,Car,-92)
							}

							//Ambulance
							M_Ambulance:(-13290,-8195,90,1)

							//Far
							M_Vehicle_HI_Single:(-13640,-8195,Van1_Type1,Van,0)
							##*
						}
					}
						

					M_FacilitySectionHotArea:(-13300,-5575,0,4.3,7,3.9,0,0,0,12,MedicalUnit,3,?MEDICAL_UNIT_SHOW_COLLIDERS?)
					M_MedicalConstruction2:()
				}
					
				//-----------------------------------------------------Tier 3
				Rect:()
				{
					//Base
					##IA
					DrawStaticModel:(Medical_Unit_Base_Lv_3,GenBase)
					##P4N
					DrawStaticModel:(Medical_Unit_Base_HI_Lv_3,Base_HI)
						M_TextureSelectW:()
					##*

					//Building
					Locator:((-13142,-5747,0),(0,0,0),(1,1,1))
					{
						DrawStaticModel:(Medical_Unit_Lv_3,Medical_03)
							M_TextureSelectW:()

