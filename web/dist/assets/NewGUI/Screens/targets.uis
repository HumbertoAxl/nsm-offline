//-------------------------------------------------------------------------------------------IMPORTS
Import:(Core.uih)
//
Import:(boardtargets_Macros.uih)
//----------------------------------------------------------------------------------LOCAL IMAGE DEFS
//---------------------------------------------------------------------------------------------SETUP
// Audio
Rect:()
	set(twk(Audio,SuppressAllAmbient),1)
	
//----------------------------------------------------------------------------------------ANIMATIONS
//--------------------------------------------------------------------------------------------MACROS
//-----------------------------------------------------------------------------------------TEMPLATES
//-------------------------------------------------------------------------------------------CONTENT

M_NewDialogOPEN:(loc(targets_HEADER),targets)

// ----------------
// ----------------

	Draw:(ColumnHeader,@f,@T+5,@w,44)

	Rect:(30,0,@W-60,@H)
	{{
		// Dividers
		Draw:(Fade_Edged,[@W/3]*1,10,1,32,,#FFFFFFFF)
		Draw:(Fade_Edged,[@W/3]*2,10,1,32,,#FFFFFFFF)
		Draw:(Fade_Edged,[@W/3]*1,80,1,@H-200,,#000000FF)
		Draw:(Fade_Edged,[@W/3]*2,80,1,@H-200,,#000000FF)

		M_BoardTargetPanelLong:(1,[@W/3]*0,0,Readout)
		M_BoardTargetPanelLong:(2,[@W/3]*1,0,Readout)
		M_BoardTargetPanelLong:(3,[@W/3]*2,0,Readout)
	}}

	//Number of matches remaning
	Draw:(White,@f,@B-80,@w,1,,#00000020FFFFFFFF)
	Rect:(@C,@B-38)
		float(%width)
		set(gel.x,@C-[%width/2])
	{{
		Draw:(Icon_Warning,-35,-16,30,30,,#252525FF)
			if(twk(BoardTargets,MatchesRemaining) = 1)
			<
				PulseAlpha(0.25,1,0.5,0.5)
			>
			else
			<
				frlerp(gel.alpha,1,0.05)
			>
		M_Text:(,0,0,0,0,L,C,Text,KNUL28,,0,0,#00000000,NoItalics,#25252500,ref)
			frlerp(gel.alpha,1,0.05)
			if(twk(BoardTargets,MatchesRemaining) > 1)
			<
				.set(gel.text, loc(targets_DEADLINE_PRE1) :: twk(BoardTargets,MatchesRemaining) :: " " :: loc(targets_DEADLINE1))
			>
			else
			<
				.set(gel.text,loc(targets_DEADLINE_PRE2) :: twk(BoardTargets,MatchesRemaining) :: " " :: loc(targets_DEADLINE2))
			>
			set(%width,fmt(strwidth(gel.text,0)*0.64),X)
	}}



// ----------------
// ----------------

M_NewDialogCLOSE:()