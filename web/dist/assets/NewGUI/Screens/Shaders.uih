// 		Handle(0.5,0.5)
//		 // You can spin the graphic to follow the sweep if you want, or not.
// 		set(gel.angle,-%amt*360)
//		 // This does the heavy lifting, setting the centre of the segment and passing through the amount. The last number is how 'hard edged'
//		 // you want the effect. 1000 is super-crisp. Around 100 gives a nice anti-aliased end. 10 gives a soft fadeout, and you'll have 
//	     // to allow amt to go beyond 1.0 to get a completely solid circle.
// 		SetUniform4F(seganim,gel.gx,gel.gy,1-(%amt*2),100)
