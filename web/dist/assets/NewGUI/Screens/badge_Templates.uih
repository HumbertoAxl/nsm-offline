//---------------------------------------------------------------------------------------


Macro:(M_ImageDesignTemplate,?INDEX?,?IMG_ID?,?W?,?H?)
	Rect:() ref:BadgeDesign?INDEX?
	{
		Draw:(?IMG_ID?,0,0,?W?,?H?) ref:HD
			Handle(0.5,0.5)

		Draw:(?IMG_ID?,0,0,?W?,?H?) $HIDE ref:SD
			Handle(0.5,0.5)
	} Template
EndM


// ----------------------------------------------------------- PATTERNS

// Square
M_ImageDesignTemplate:(Square,White,200,200)

// Circle
M_ImageDesignTemplate:(Circle,BadgeMask1,200,200)


// Band
Rect:(0,0,?BADGE_SIZE?,50) ref:BadgeDesignBand
	Handle(0.5,0.5)
{{
	Draw:(White,@L,@T+[[@H-50]/2],@W,50)
}} Template


// Stripes
Rect:(0,0,?BADGE_SIZE?,?BADGE_SIZE?) ref:BadgeDesignStripes
	Handle(0.5,0.5)
{{
	Define:(?BAR_SPACE?=35)
	Define:(?BAR_W?=[?BADGE_SIZE?/4]-[?BAR_SPACE?])
	PushOrigin:(@L,@T)
		Draw:(White,0,0,?BAR_W?,?BADGE_SIZE?)
		Draw:(White,?BAR_W?+?BAR_SPACE?,0,?BAR_W?,?BADGE_SIZE?)
		Draw:(White,[?BAR_W?*2]+[?BAR_SPACE?*2],0,?BAR_W?,?BADGE_SIZE?)
		Draw:(White,[?BAR_W?*3]+[?BAR_SPACE?*3],0,?BAR_W?,?BADGE_SIZE?)
	PopOrigin
}} Template

// DiagonalStripes
Rect:(0,0,?BADGE_SIZE?+140,?BADGE_SIZE?-80) ref:BadgeDesignDiagStripes
	Handle(0.5,0.5)
{{
	Define:(?BAR_SPACE?=50)
	Define:(?BAR_W?=[?BADGE_SIZE?/4]-[?BAR_SPACE?])
	PushOrigin:(@L,@T)
		Draw:(White,0,0,?BAR_W?,?BADGE_SIZE?,45)
		Draw:(White,[?BAR_W?*1.5]+[?BAR_SPACE?*1.5],0,?BAR_W?,?BADGE_SIZE?,45)
		Draw:(White,[?BAR_W?*3]+[?BAR_SPACE?*3],0,?BAR_W?,?BADGE_SIZE?,45)
	PopOrigin
}} Template


// Squares
Define:(?SSIZE?=?BADGE_SIZE?/5)
Rect:(0,0,?BADGE_SIZE?,?BADGE_SIZE?) ref:BadgeDesignSquares
	Handle(0.5,0.5)
{{
	PushOrigin:(@L,@T)
		Draw:(White,0,0,?SSIZE?,?SSIZE?)
		Draw:(White,0,?SSIZE?*2,?SSIZE?,?SSIZE?)
		Draw:(White,0,?SSIZE?*4,?SSIZE?,?SSIZE?)
		
		Draw:(White,?SSIZE?,?SSIZE?,?SSIZE?,?SSIZE?)
		Draw:(White,?SSIZE?,?SSIZE?*3,?SSIZE?,?SSIZE?)

		Draw:(White,?SSIZE?*2,0,?SSIZE?,?SSIZE?)
		Draw:(White,?SSIZE?*2,?SSIZE?*2,?SSIZE?,?SSIZE?)
		Draw:(White,?SSIZE?*2,?SSIZE?*4,?SSIZE?,?SSIZE?)

		Draw:(White,?SSIZE?*3,?SSIZE?,?SSIZE?,?SSIZE?)
		Draw:(White,?SSIZE?*3,?SSIZE?*3,?SSIZE?,?SSIZE?)

		Draw:(White,?SSIZE?*4,0,?SSIZE?,?SSIZE?)
		Draw:(White,?SSIZE?*4,?SSIZE?*2,?SSIZE?,?SSIZE?)
		Draw:(White,?SSIZE?*4,?SSIZE?*4,?SSIZE?,?SSIZE?)
	PopOrigin
}} Template

