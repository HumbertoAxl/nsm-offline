Macro:(M_PrestigeVar,?TYPE?,?VAR?)
	Rearmable() ref:PrestigeRearm
	colvar(%compColour)
	strvar(%bannerImage,%bannerModel,%shieldImage,%trophyImage)
	.set(%compColour,#CC1618FF)
	.set(%bannerImage,"Banner_Default")
	.set(%bannerModel,"Banner_Default")
	.set(%shieldImage,"Shield_Default")
	.set(%trophyImage,"Blank")

	// MANAGERIAL
	:if(?VAR? = 100)
	<
		// Star Manager of Season
		set(%compColour,#252525FF)
		set(%shieldImage,"Blank")
		set(%trophyImage,"Trophy_Manager_01")
	>
	:if(?VAR? = 99)
	<
		// Star Manager of Month
		set(%compColour,#252525FF)
		set(%shieldImage,"Blank")
		set(%trophyImage,"Trophy_Manager_02")
	>

	// CONTINENTAL
	:if(?VAR? = 40)
	<
		set(%compColour,#005696FF)
		set(%bannerImage,"Banner_Continental_01")
		set(%bannerModel,"Shield_Continental_01")
		set(%shieldImage,"Shield_Continental_01")
		set(%trophyImage,"Trophy_Continental_01")
	>
	:if(?VAR? = 35)
	<
		set(%compColour,#CC1618FF)
		set(%bannerImage,"Banner_Continental_02")
		set(%bannerModel,"Shield_Continental_02")
		set(%shieldImage,"Shield_Continental_02")
		set(%trophyImage,"Trophy_Continental_02")
	>
	:if((?VAR? >= 31 and(?VAR? < 90)) and(not(?VAR? oneof(35,40))))
	<
		set(%compColour,#CC1618FF)
		set(%bannerImage,"Banner_Continental_02")
		set(%bannerModel,"Shield_Continental_02")
		set(%shieldImage,"Shield_Continental_02")
		set(%trophyImage,"Trophy_Continental_02")
	>

	// DOMESTIC
	:if(?VAR? = 30)
	<
		set(%compColour,#D69E32FF)
		set(%bannerImage,"Banner_Domestic")
		set(%bannerModel,"Shield_Domestic")
		set(%shieldImage,"Shield_Domestic_01")
		set(%trophyImage,"Trophy_Domestic_01")
	>
	:if(?VAR? = 29)
	<
		set(%compColour,#ADB2B4FF)
		set(%bannerImage,"Banner_Domestic")
		set(%bannerModel,"Shield_Domestic")
		set(%shieldImage,"Shield_Domestic_02")
		set(%trophyImage,"Trophy_Domestic_02")
	>
	:if(?VAR? = 28)
	<
		set(%compColour,#90492AFF)
		set(%bannerImage,"Banner_Domestic")
		set(%bannerModel,"Shield_Continental_01")
		set(%shieldImage,"Shield_Domestic_03")
		set(%trophyImage,"Trophy_Domestic_03")
	>
	// Others
	:if(?VAR? >= 20 and(?VAR? < 28))
	<
		set(%compColour,#90492AFF)
		set(%bannerImage,"Banner_Domestic")
		set(%bannerModel,"Shield_Domestic")
		set(%shieldImage,"Shield_Domestic_03")
		set(%trophyImage,"Trophy_Domestic_03")
	>


	// LEAGUE
	:if(?VAR? oneof(18,19))
	<
		set(%compColour,#6A003AFF)
		set(%bannerImage,"Banner_League_01")
		set(%bannerModel,"Shield_League_01")
		set(%trophyImage,"Trophy_League_01")
		set(%shieldImage,"Shield_League_01")
	>
	:if(?VAR? = 11)
	<
		set(%compColour,#CF112BFF)
		set(%bannerImage,"Banner_League_02")
		set(%bannerModel,"Shield_League_02")
		set(%trophyImage,"Trophy_League_02")
		set(%shieldImage,"Shield_League_02")
	>
	:if(?VAR? = 9)
	<
		set(%compColour,#6BACE6FF)
		set(%bannerImage,"Banner_League_03")
		set(%bannerModel,"Shield_League_03")
		set(%trophyImage,"Trophy_League_03")
		set(%shieldImage,"Shield_League_03")
	>
	:if(?VAR? = 7)
	<
		set(%compColour,#490D67FF)
		set(%bannerImage,"Banner_League_04")
		set(%bannerModel,"Shield_League_04")
		set(%trophyImage,"Trophy_League_04")
		set(%shieldImage,"Shield_League_04")
	>
	:if(?VAR? = 5)
	<
		set(%compColour,#F6A22EFF)
		set(%bannerImage,"Banner_League_05")
		set(%bannerModel,"Shield_League_05")
		set(%trophyImage,"Trophy_League_05")
		set(%shieldImage,"Shield_League_05")
	>
	:if(?VAR? = 3)
	<
		set(%compColour,#27C960FF)
		set(%bannerImage,"Banner_League_06")
		set(%bannerModel,"Shield_League_06")
		set(%trophyImage,"Trophy_League_06")
		set(%shieldImage,"Shield_League_06")
	>
	If:(?TYPE?=CompetitionColour)
		:set(gel.colour,%compColour)
	EndIf
	If:(?TYPE?=BannerImage)
		:set(gel.img,%bannerImage)
	EndIf
	If:(?TYPE?=BannerModel)
		:set(gel.model,%bannerModel)
	EndIf
	If:(?TYPE?=ShieldImage)
		:set(gel.img,%shieldImage)
	EndIf
	If:(?TYPE?=TrophyImage)
		:set(gel.img,%trophyImage)
	EndIf
EndM


Macro:(M_Prestige,?TYPE?)
	M_PrestigeVar:(?TYPE?,(%prestige))
EndM

Macro:(M_PrestigeMatch,?TYPE?)
	M_PrestigeVar:(?TYPE?,(twk(Match,Prestige)))
EndM