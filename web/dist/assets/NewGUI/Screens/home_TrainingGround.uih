//--------------------------------------------------------------------------------Training

//-------------------------------------TIER 4
View:(Training_04,512,512) 
##IA
	M_ONCE:()
##P4N
	if(twk(Facilities,Night) = 0)
	<
		M_ONCE:()
	>
	else
	<
		set(gel.vis,0)
	>
##*
{
	Sheet:()
	{
		Draw:(Training_T4_PrimaryCol,0,0,512,512,,#FFFFFFFFFFFFFFFF)
			set(gel.colour.RGBA,twk(Match,Team1Col))
	}
}
##P4N
View:(Training_04_Night,512,512) 
	if(twk(Facilities,Night) = 1)
	<
		M_ONCE:()
	>
	else
	<
		set(gel.vis,0)
	>
{
	Sheet:()
	{
		Draw:(Training_T4_PrimaryCol,0,0,512,512,,#FFFFFFFFFFFFFFFF)
			set(gel.colour.RGBA,twk(Match,Team1Col))
	}
}
##*


//-------------------------------------TIER 5
View:(Training_05,512,512)
##IA
	M_ONCE:()
##P4N
	if(twk(Facilities,Night) = 0)
	<
		M_ONCE:()
	>
	else
	<
		set(gel.vis,0)
	>
##*
{
	Sheet:()
	{
		Draw:(Training_T5_PrimaryCol,0,0,512,512,,#FFFFFFFFFFFFFFFF)
			set(gel.colour.RGBA,twk(Match,Team1Col))
	}
}
##P4N
View:(Training_05_Night,512,512) 
	if(twk(Facilities,Night) = 1)
	<
		M_ONCE:()
	>
	else
	<
		set(gel.vis,0)
	>
{
	Sheet:()
	{
		Draw:(Training_T5_PrimaryCol,0,0,512,512,,#FFFFFFFFFFFFFFFF)
			set(gel.colour.RGBA,twk(Match,Team1Col))
	}
}
##*


//Make This Define Equal to a Texture to show the colliders for the training ground
Define:(?TRAINING_GROUND_SHOW_COLLIDERS?=) 



//---------------------------------Training Ground Macro
Macro:(M_TrainingGround,?SCALE?)
	Locator:((0,0,0),(0,0,0),(?SCALE?,?SCALE?,?SCALE?))
		Unload(Training_01_Shadow,Training_02_Shadow,Training_03_Shadow,Training_04_Shadow,Training_05_Shadow,Training_06_Shadow)
		Unload(Training_01,Training_02,Training_03,Training_06)
		Unload(Training_06_ROOF)
	{
		UseShader:(ProjectedLight3DVCol)
			SetSampler(TexSamp1,$CLOUDSHADOW)
			Layer(Ground)
		{
			Rect:()
				M_FacilityConstructionController:(TrainingGround,7)
			{	
				//-----------------------------------------------------Tier 0
				Rect:()
				{
					//Base
					##IA
					DrawStaticModel:(Training_Ground_Base_Lv_0,GenBase)
					##P4N
					DrawStaticModel:(Training_Ground_Base_HI_Lv_0,Base_HI)
						M_TextureSelectW:()
					##*

					//Training Ground Selection Hint
					M_AreaSelection:(9200,-800,-2,7,TrainingGround,26,35,0,0,90,Training,575)

					//Houses
					##IA
					DrawStaticModel:(Training_Ground_Houses_Lv_0,HouseA)
					##P4N
					DrawStaticModel:(Training_Ground_Houses_HI_Lv_0,Buildings_HI)
						M_TextureSelectW:()
					##*

					//Tree Shadows
					UseShader:(Simple3DNZW)
						Layer(Shadows)
					{
						##IA
						DrawStaticModel:(Training_Ground_Trees_Shadow_Lv_0,GenTrees)
							Blend(ONE,INV_IMAGE_ALPHA)
						##P4N
						DrawStaticModel:(Training_Ground_Trees_Shadow_HI_Lv_0,Trees_HI)
							Blend(ONE,INV_IMAGE_ALPHA)
							M_TextureSelectW:()
						##*
					}

					//Trees STANDARD
					##IA
					UseShader:(ProjectedLight3DVColOneBit)
						Layer(OneBit)
						SetSampler(TexSamp1,$CLOUDSHADOW)
					{
						DrawStaticModel:(Training_Ground_Trees_Lv_0,GenTrees)
							Blend(ONE,INV_IMAGE_ALPHA)
					}
					//Trees HIGH DETAIL
					##P4N
					UseShader:(ProjectedLight3DVColOneBit_Alt)
						SetSampler(TexSamp1,$CLOUDSHADOW)
						Layer(OneBit)
					{
						DrawStaticModel:(Training_Ground_Trees_HI_Lv_0,Trees_HI)
							Blend(ONE,INV_IMAGE_ALPHA)
							M_TextureSelectW:()
					}
					##*	

					M_FacilitySectionHotArea:(9500,-1000,0,26,33,10,0,0,0,16,TrainingGround,7,?TRAINING_GROUND_SHOW_COLLIDERS?)		

				}


				//-----------------------------------------------------Tier 1
				Rect:()
				{
					//Base
					##IA
					DrawStaticModel:(Training_Ground_Base_Lv_1,GenBase)
					##P4N
					DrawStaticModel:(Training_Ground_Base_HI_Lv_1,Base_HI)
						M_TextureSelectW:()
					##*

					//Houses
					##IA
					DrawStaticModel:(Training_Ground_Houses_Lv_1,HouseA)
					##P4N
					DrawStaticModel:(Training_Ground_Houses_HI_Lv_1,Buildings_HI)
						M_TextureSelectW:()

					Rect:() $HIDE
						.set(gel.vis,twk(Facilities,Night)=1)
  					{
						DrawStaticModel:(Training_Ground_Houses_Lights_HI_Lv_1,Buildings_HI_Night)
					}
					##*
					
					Locator:((11285,-3315,0),(0,0,0),(1,1,1))
						set(gel.vis,(twk(TrainingGroundConstruction,LastConstructionLevel) != 0) or(shell("Facility")!=""))
					{
						//Building Shadow
						DrawStaticModel:(Training_Ground_Shadow_Lv_1,Training_01_Shadow)
							Blend(ONE,INV_IMAGE_ALPHA)

						//Building
						DrawStaticModel:(Training_Ground_Lv_1,Training_01)
							M_TextureSelectW:()

						//Front Sign and badge
						//POSX,POSY,POSZ,ROTX,ROTY,ROTZ,BGW,BGH,BADGEX,BADGEY,BADGESIZE,TEXTX,TEXTY,TEXTW,FONTSIZE,FADE1X,FADE1Y,FADE1W,FADE1H,FADE2X,FADE2Y,FADE2W,FADE2H,SHADER
						M_StadTeamNameAndBadge:(-365,-290,-252,180,-90,-90,670,80,80,38,75,400,2,640,KNUL64,1,-1,-50,829,35,-1,50,829,45,ZSafeSprite,,40)
