Macro:(M_FontSize_KNUL64)
	if((TPlayerClass.languageId=13) or (TPlayerClass.languageId=14))
	<
		M_FontSize_IRAN_SCALED:(1.2)
	>
	else
	<
		set(gel.text.fontsize,1)
		set(gel.text.fontscale,1)
		set(%gfw,strwidth(gel.text,1))
	>
EndM

