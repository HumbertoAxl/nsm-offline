Macro:(M_FontSize_IRAN)
	FontSize(4)
	FontScale(0.5,0.5)
	set(%gfw,strwidth(gel.text,4)*0.5)
EndM


Macro:(M_FontSize_IRAN_SCALED,?SCALE?)
	set(gel.text.fontsize,4)
	set(gel.text.fontscale,?SCALE?)
	set(%gfw,strwidth(gel.text,4)*?SCALE?)
EndM

Macro:(M_FontSize_CASH_IRAN_SCALED,?SCALE?)
	set(gel.text.fontsize,5)
	set(gel.text.fontscale,?SCALE?)
	set(%gfw,strwidth(gel.text,5)*?SCALE?)
EndM



Macro:(M_Text,?TEXT?,?X?,?Y?,?W?,?H?,?HALIGN?,?VALIGN?,?TYPE?,?SIZE?,?CASE?,?SHX?,?SHY?,?SHCOL?,?ITALICISE?,?COL?,?REF?,?CAT?,?VAR?,?DOLTR?)
	PushOrigin:(?X?,?Y?)

		If:(?TYPE?=Text)
			Text:(?TEXT?,0,0,?W?,?H?,?HALIGN?,?VALIGN?,?COL?FFFFFFFF) ref:?REF?
		Else
			If:(?TYPE?=TextLoc)
				TextLoc:(?TEXT?,0,0,?W?,?H?,?HALIGN?,?VALIGN?,?COL?FFFFFFFF) ref:?REF?
			Else
				If:(?TYPE?=TextAtt)
					TextAtt:(?TEXT?,0,0,?W?,?H?,?HALIGN?,?VALIGN?,?COL?FFFFFFFF) ref:?REF?
				Else
					If:(?TYPE?=TextLocAtt)
						TextLocAtt:(?TEXT?,0,0,?W?,?H?,?HALIGN?,?VALIGN?,?COL?FFFFFFFF) ref:?REF?
					Else
						If:(?TYPE?=TextBoxAtt)
							TextBoxAtt:(?TEXT?,0,0,?W?,?H?,?HALIGN?,?VALIGN?,?COL?FFFFFFFF) ref:?REF?
						Else
							TextBox:(?TEXT?,0,0,?W?,?H?,?HALIGN?,?VALIGN?,?COL?FFFFFFFF) ref:?REF?
						EndIf
					EndIf
				EndIf
			EndIf
		EndIf

		If:(?CAT?)
			If:(?DOLTR?=DoLTR)
				set(gel.text,?CASE?(LTR(twk(?CAT?,?VAR?))))
			Else
				set(gel.text,?CASE?(twk(?CAT?,?VAR?)))
			EndIf
		Else
			If:(?CASE?="Upper")
				.ToUpperCase(1)
			EndIf
		EndIf
				
		FontShadow(?SHX?,?SHY?)
		ShadowCol(?SHCOL?000000FF)
		Layer(Text)
	
		Italicise(-0.2)

		£M_FontSize_?SIZE?:()

		If:(?ITALICISE?=NoItalics)
			Italicise(0.0)
		EndIf

	PopOrigin
EndM

Macro:(M_TextMaxWidth,?WIDTH?)
	.set(gel.scale,min(1,?WIDTH?/%gfw))
EndM




// Styles
Macro:(M_Style,?TYPE?,?COL1?)
	FontStyle(?COL1?000000FF,-1,1 ?COL1?000000FF,0,1 ?COL1?000000FF,1,1 ?COL1?000000FF,-1,0 ?COL1?000000FF,1,0 ?COL1?000000FF,-1,-1 ?COL1?000000FF,0,-1 ?COL1?000000FF,1,-1)
EndM

Macro:(M_Style_DoubleOutline,?COL1?,?COL2?)
	FontStyle(?COL1?000000FF,-1,1 ?COL1?000000FF,0,1 ?COL1?000000FF,1,1 ?COL1?000000FF,-1,0 ?COL1?000000FF,1,0 ?COL1?000000FF,-1,-1 ?COL1?000000FF,0,-1 ?COL1?000000FF,1,-1 ?COL2?000000FF,-2,2 ?COL2?000000FF,0,2 ?COL2?000000FF,2,2 ?COL2?000000FF,-2,0 ?COL2?000000FF,2,0 ?COL2?000000FF,-2,-2 ?COL2?000000FF,0,-2 ?COL2?000000FF,2,-2)
EndM

Macro:(M_Style_StarRating)
	M_Style_DoubleOutline:(#FFFFFF35,#00000025)
	CharacterSpacing(1.75)
EndM