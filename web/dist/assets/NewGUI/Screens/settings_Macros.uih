StaticModel:(CreditsBall,CreditsBall)
StaticModel:(CreditsBall_Overlay,CreditsBall_Overlay)
Texture:(CreditsBall_Texture,CreditsBall/CreditsBall.png)
Texture:(CreditsBall_Overlay_Texture,CreditsBall/CreditsBall_Overlay.png,false)

View:(CreditsBall_Overlay_Texture,512,512)
{
Sheet:()
		##4
		##-
		Delay(0.5)
		set(gel.vis,false)
		##*
	{
		Draw:(White,0,10,135,70,,#000000FF)
			Blend(ZERO,ZERO)

		M_Text:(options_CONCEPTBY,-2,57,135,0,C,C,TextBox,KNUL18,,1,0,#808080FF,NoItalics,#808080FF,ref)
			LineSpacing(0.9)
	}
}


Macro:(M_Settings_Credits,?X?,?Y?)
	Rect:(@C,270,540,540)
		Handle(0.5,0.5)
		float(%lastTX,%lastTY,%DX,%DY,%grabbed)
		if(TouchDown)
	    <
	    	:Over()
	    	<
	    		if([[gel.gx-TouchX]*[gel.gx-TouchX]]+[[gel.gy-TouchY]*[gel.gy-TouchY]] < [270*270])
	    		<
	    			set(%grabbed,1)
	    		>
	    	>
	    >
	    else
	    <
    		:set(%grabbed,0)
	    >
	    if(%grabbed)
	    <
	    	:set(%lastTX,TouchX)
	    	:set(%lastTY,TouchY)
			set(%DX,min(15,max(-15,[TouchX-%lastTX]*-0.15)))
			set(%DY,min(15,max(-15,[TouchY-%lastTY]*0.15)))

			set(%lastTX,TouchX)
			set(%lastTY,TouchY)
	    >
	    else
	    <
	    	:Delay(1.5)
	    	add(%DX,0.01)
	    >
    	set(%DX,%DX*0.95)
    	set(%DY,%DY*0.95)
    {
		Camera:((0,0,0),(0,0,0),26.66,(1,1,1),,,) //FIXEDFOV
			PinVP(0,0,0)
		{
			Locator:((0,-450,0),(5,0,180),(80,80,80))
				Layer(Text)
				add(gel3d.rotz,%DX)
				add(gel3d.rotx,%DY)
				set(gel3d.rotx,clamp(gel3d.rotx,-10,15))
				if(not(%grabbed))
				<
					:Delay(1.5)
					frlerp(gel3d.rotx,5,0.01)
				>
			{
				UseShader:(CreditsBall3D)
					SetUniform4F(SpecParams,0.9)
				{
					DrawStaticModel:(CreditsBall,CreditsBall_Texture)
					Locator:((0,0,0),(0,0,0),(1.001,1.001,1.001))
					{
						DrawStaticModel:(CreditsBall_Overlay,CreditsBall_Overlay_Texture)
							Blend(ONE,INV_IMAGE_ALPHA)
					}
				}
			}
			Locator:((0,-450,96),(5,180,180),(80,80,80))
				sub(gel3d.rotz,%DX)
				add(gel3d.rotx,%DY)
				set(gel3d.rotx,clamp(gel3d.rotx,-10,15))
				if(not(%grabbed))
				<
					:Delay(1.5)
					frlerp(gel3d.rotx,5,0.01)
				>
			{
				UseShader:(Simple3D)
				{
					Locator:((0,0,0),(0,0,0),(1,1,1))
					{
						DrawStaticModel:(CreditsBall,CreditsBall_Texture)
						DrawStaticModel:(CreditsBall_Overlay,CreditsBall_Overlay_Texture)
							Blend(ONE,INV_IMAGE_ALPHA)
					}
				}
			}
		}

	}
EndM


Macro:(M_Resolution,?ID?)
	Rect:(0,0,250,100)
		CTRLClick(?BTNOK?)
		<
			if(twk(Player,Resolution) != "?ID?")
			<
				Post(graphics.setResolution,"?ID?")
			>
		>
		Rearmable()
		:if(twk(Player,Resolution) = "?ID?")
		<
			CTRLSetSelected()
		>
	{{
		// Selected Resolution
		Rect:(-125,-40,250,80)
			set(gel.vis,twk(Graphics,Resolution) = "?ID?")
		{{
			Draw:(Button_Shadow,-11,-5,@W+22,@H+21,,#0000001A00000000)
			Draw:(Button_SilverSliced,0,0,@W,@H,,#FFFFFFFF00000000)
			M_Text:(,50,47,150,0,C,C,TextBox,KNUL30,,0,0,#00000040,NoItalics,#000000FF,textref)
				set(gel.text,"?ID?")
			Draw:(Button_Shade,0,@M,@W,[@H/2],,#00000010FFFFFFFF)
		}}

		// Unselected Resolution
		Rect:()
			set(gel.vis,twk(Graphics,Resolution) != "?ID?")
		{
			M_PressOPEN:(0,0,250,80,link,"?ID?",ForwardButtonAudio)
				Draw:(Button_Shadow,-11,-5,@W+22,@H+21,,#0000008000000000)
				Draw:(Button_SilverSliced,0,0,@W,@H,,#FFFFFFFF00000000)
				M_Text:(,50,44,150,0,C,C,TextBox,KNUL25,,0,0,#00000000,NoItalics,#505050FF,textref)
					set(gel.text,"?ID?")
				Draw:(Button_Shade,0,@M,@W,[@H/2],,#00000010FFFFFFFF)

				Draw:(RoundedPanel,0,0,@W,@H,,#FFFFFF00)
					Layer(AboveText)
					Additive()
					if(%pressed)
					<
						set(gel.colour,#60606060)
					>
					else
					<
						frlerp(gel.colour,#00000000,0.05)
					>
			M_PressCLOSE:()
				if(%clicked)
				<
					set(twk(Graphics,Resolution),"?ID?")
					Post(graphics.setResolution,"?ID?")
				>
		}
	}}
		CTRLSelect(CTRLBasicSelected,-125,-50,12,-10)
EndM


Macro:(M_Settings_Fullscreen,?X?,?Y?)
	Rect:(?X?,?Y?,@W,70)
		strvar(%BUTTONTEXT)
		init(%BUTTONTEXT,"")
	{{	
		Draw:(RoundedPanel,0,0,@W,@H,,#FFFFFF60FFFFFFFF)
		M_Text:(options_FULLSCREEN,20,1,240,@H,L,C,TextBox,KNUL25,,0,0,#00000000,NoItalics,#252525FF,ref)

		M_Button:(@R-125,38,210,50,Button_SilverSliced,,0,0,0,0,#FFFFFFFF,,ref,(%BUTTONTEXT),0,3,C,C,Text,KNUL22,Upper,0,0,#00000000,NoItalics,#252525FF,textref)
			if(twk(Graphics,FullScreen) = 1)
			<
				:set(%BUTTONTEXT,loc(generic_YES))
			>
			else
			<
				:set(%BUTTONTEXT,loc(generic_NO))
			>
			M_CTRLButtonExtra:(?BTNOK?,CTRLButtonSelected,3,3,6,6)

			if(%clicked)
			<
				set(twk(Graphics,FullScreen),1-twk(Graphics,FullScreen))
				Post(graphics.setResolution,twk(Graphics,Resolution))
			>
	}}
EndM


Macro:(M_Settings_InvertCamera,?AXIS?,?X?,?Y?)
	Rect:(?X?,?Y?,@W,70)
	{{	
		Draw:(RoundedPanel,0,0,@W,@H,,#FFFFFF60FFFFFFFF)
		M_Text:(options_INVERTCAMERA?AXIS?,20,1,240,@H,L,C,TextBox,KNUL25,,0,0,#00000000,NoItalics,#252525FF,ref)
		M_ToggleCustomOnOff:(@R-125,5,SettingsGlobal,InvertCamera?AXIS?,settings.toggleInvertCamera?AXIS?,ref,1,-1)
	}}
EndM