Macro:(M_LanguageEntry,?ID?,?TYPE?)
	M_PressOPEN:(0,0,510,80,link,Language?ID?,ForwardButtonAudio)
		Draw:(Button_Shadow,-11,-5,@W+22,@H+21,,#0000008000000000)
		Draw:(Button_SilverSliced,0,0,@W,@H,,#FFFFFFFF00000000)
		Draw:(Button_Shade,0,@M,@W,[@H/2],,#00000010FFFFFFFF)

		// Unselected
		Rect:()
			set(gel.vis,twk(Player,Language) != loc(Language?ID?))
		{
			M_Text:(Language?ID?,@C,0,0,@H,C,C,TextLoc,KNUL23,Upper,0,0,#00000000,NoItalics,#606060FF00000000,textref)
				.set(gel.vis,?TYPE?=Text)

			// 300x150 Source Images drawn half scale
			Draw:(Blank,@C-75,@M-40,150,75,,#606060FF00000000)
				set(gel.img,"Language"::?ID?)
				.set(gel.vis,?TYPE?=Image)
		}

		// Selected
		Rect:()
			set(gel.vis,twk(Player,Language) = loc(Language?ID?))
		{
			Draw:(Highlight_Round,0,0,@W,@H,,#FFFFFFAA)

			M_Text:(Language?ID?,@C,0,0,@H,C,C,TextLoc,KNUL28,Upper,1,0,#000000FF,NoItalics,#000000FF00000000,textref)
				.set(gel.vis,?TYPE?=Text)

			// 300x150 Source Images drawn half scale
			Draw:(Blank,@C-75,@M-40,150,75,,#000000FF00000000)
				set(gel.img,"Language"::?ID?)
				.set(gel.vis,?TYPE?=Image)
		}

		Draw:(RoundedPanel,0,0,@W,@H,,#FFFFFF00)
			Layer(AboveText)
			Additive()
			if(%pressed)
			<
				set(gel.colour,#60606060)
			>
			else
			<
				frlerp(gel.colour,#00000000,0.05)
			>
		

	M_PressCLOSE:()
		M_CTRLButtonExtra:(?BTNOK?,true,CTRLButtonSelected,3,3,6,6)
		set(%disabled,twk(Player,Language) = loc(Language?ID?))
		Rearmable()
		:if(twk(Player,Language)=loc(Language?ID?))
		<
			CTRLSetSelected()
		>
		if(%clicked)
		<
			Post(language.setLanguage,?ID?)
		>
EndM


Macro:(M_ClipboardCopy)
	Rect:(@C+80,@T+195,400,300)
		.set(twk(Debug,Clipboard),0)
		set(gel.vis,twk(Debug,Clipboard)>9)
		Layer(AboveText)
		LockLayer()
		Click()
	{{
		Draw:(RoundedPanel,0,0,@W,@H,,#000000EE)
		M_Button:(@C,50,300,50,Button_RedSliced,Blank,14,8,20,40,#FFFFFFFF,link,ref,"Clipboard Save 1",0,3,C,C,Text,KNUL22,Upper,0,0,#00000000,NoItalics,#FFFFFFFF,ref)
			M_CTRLButtonExtra:(?BTNOK?,true,CTRLButtonSelected,3,3,6,6)
			if(%clicked)
			<
				Message(player.savetoclipboard,"0")
			>

		M_Button:(@C,120,300,50,Button_RedSliced,Blank,14,8,20,40,#FFFFFFFF,link,ref,"Clipboard Save 2",0,3,C,C,Text,KNUL22,Upper,0,0,#00000000,NoItalics,#FFFFFFFF,ref)
			M_CTRLButtonExtra:(?BTNOK?,true,CTRLButtonSelected,3,3,6,6)
			if(%clicked)
			<
				Message(player.savetoclipboard,"1")
			>

		M_Button:(@C,190,300,50,Button_RedSliced,Blank,14,8,20,40,#FFFFFFFF,link,ref,"Clipboard Save 3",0,3,C,C,Text,KNUL22,Upper,0,0,#00000000,NoItalics,#FFFFFFFF,ref)
			M_CTRLButtonExtra:(?BTNOK?,true,CTRLButtonSelected,3,3,6,6)
			if(%clicked)
			<
				Message(player.savetoclipboard,"2")
			>
		M_Text:("Click to copy a save to the device's clipboard",0,235,@W-20,0,C,T,TextBox,KNUL23,,0,0,#00000000,NoItalics,#FFFFFFFF,ref)
	}}
EndM


