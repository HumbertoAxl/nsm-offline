Macro:(M_Settings_VersionNumber,?X?,?Y?)
	M_Text:(,?X?,?Y?,0,0,R,C,Text,KNUL20,,0,0,#00000000,NoItalics,#252525FF,textref)
		if(twk(EconomyBalance,Cohort) = "")
		<
			:set(gel.text,loc(options_BUILD) :: (LTR(twk(Settings,VersionNumber) :: "_" :: twk(Cloud,CohortTag))))
			// :set(gel.text,loc(options_BUILD) :: (LTR(twk(Settings,VersionNumber))))
		>
		else
		<
			:set(gel.text,loc(options_BUILD) :: (LTR(twk(Settings,VersionNumber) :: ".12" :: "_" :: twk(EconomyBalance,Cohort))))
		>
EndM


