Macro:(M_ToggleCustomOnOff,?X?,?Y?,?CAT?,?VAR?,?MESSAGE?,?REF?,?ONVALUE?,?OFFVALUE?)
	Rect:(?X?,?Y?,210,60)
		Handle(0.5,0)
		func(ClickFunc)
		<
			Message(?MESSAGE?)
			if(twk(?CAT?,?VAR?) = ?OFFVALUE?)
			<
				Post(UI_Back)
			>
			else
			<
				Post(UI_Select)
			>
		>
		Click()
		<
			call(ClickFunc)
		>
	{{
		Rect:(@R-150,@T,150,@H) ref:?REF?
			CTRLSelect(CTRLBasicSelected,0,0,6,-12)
			CTRLClick(?BTNOK?)
			<	
				callparent(1,ClickFunc)
			>
			CTRLBlock(LEFT,RIGHT)
		{{
			M_Text:(options_OFF,-15,2,0,@H,R,C,TextLoc,KNUL23,,1,0,#252525FF,NoItalics,#252525FF,ref)
				frlerp(gel.alpha,twk(?CAT?,?VAR?)=?OFFVALUE?,0.25)
			M_Text:(options_ON,-15,2,0,@H,R,C,TextLoc,KNUL23,,1,0,#252525FF,NoItalics,#252525FF,ref)
				frlerp(gel.alpha,twk(?CAT?,?VAR?)=?ONVALUE?,0.25)

			Draw:(Button_ToggleBG,0,10,@W,40,,#BCC1C4FFFFFFFFFF)
			Draw:(Button_ToggleBG,0,10,@W,40,,#679F2AFFFFFFFFFF)
				.set(gel.alpha,twk(?CAT?,?VAR?)=?ONVALUE?)
				frlerp(gel.alpha,twk(?CAT?,?VAR?)=?ONVALUE?,0.15)

			Clip:(0,0,@W,50)
			{
				Draw:(Button_Toggle,0,8)
					Scale(0.5,0.5)
					.set(gel.x,[[twk(?CAT?,?VAR?) = ?ONVALUE?] * 74]-12)
					frlerp(gel.x,[[twk(?CAT?,?VAR?) = ?ONVALUE?] * 74]-12,0.25)
			}
		}}
	}}
EndM
Macro:(M_Toggle,?X?,?Y?,?CAT?,?VAR?,?MESSAGE?,?REF?)
	M_ToggleCustomOnOff:(?X?,?Y?,?CAT?,?VAR?,?MESSAGE?,?REF?,1,0)
EndM


Macro:(M_VolumeSlider,?X?,?Y?,?W?,?H?,?CAT?,?TWEAK?,?MSG?,?REF?)
    Rect:(?X?,?Y?,?W?,?H?,,#FFFFFFFFFFFFFFFF) ref:?REF?
    {{
    	Draw:(Button_ToggleBG,0,10,@W,40,,#BCC1C4FFFFFFFFFF)
    	
    	Tile:(Volume_Notch,20,20,1,20,,#00000020)
    		Copies(10,1)
    		Spacing([@W-10]/10,0)

    	Clip:(0,0,@W,@H)
    		set(gel.w,clamp(twk(?CAT?,?TWEAK?)*@W,10,@W-10))
    	{
    		Draw:(Button_ToggleBG,0,10,@W,40,,#679F2AFFFFFFFFFF)
    		Tile:(Volume_Notch,20,20,1,20,,#FFFFFF40)
	    		Copies(10,1)
	    		Spacing([@W-10]/10,0)
    	}

		Rect:(0,10,@W,40) ref:CTRLSelect
			float(%grabbed)
			if(twk(ControllerInput,Enabled) = 0)
			<
				if(TouchDown)
				<
					:set(%grabbed,0)
					:Over()
					<
						set(%grabbed,1)
						Post(UI_Select,0.1)
					>
				>
				else
				<
					set(%grabbed,0)
				>
			>
			CTRLSelect(CTRLBasicSelected)
			if(twk(ControllerInput,Enabled))
			<
				set(%grabbed,0)
				CTRLIsSelected()
				<
					set(%grabbed,abs(JoyX0)>0.5)
				>
				if(%grabbed)
				<
					CTRLBlock(LEFT,RIGHT,UP,DOWN)
				>
			>
		{
			Rect:(25,0,@W-30,40)
				if(%grabbed)
				<
					if(twk(ControllerInput,Enabled))
					<
						if(%grabbed)
						<
							set(twk(?CAT?,?TWEAK?),clamp(twk(?CAT?,?TWEAK?)+[JoyX0*0.03],0,1))
						>
					>
					else
					<
						set(twk(?CAT?,?TWEAK?),clamp([TouchX-gel.gx]/gel.w,0,1))
					>
					Message(?MSG?)
				>
			{{
				Draw:(Button_Volume,0,0,93,128)
					Scale(0.5,0.5)
					Handle(0.5,0)
					set(gel.x,(twk(?CAT?,?TWEAK?)*(@W+15)-15))
					Layer(AboveText3)
			}}
		}
    }}
EndM


