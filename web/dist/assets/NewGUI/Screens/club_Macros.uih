Macro:(M_PerformanceToggle,?X?,?Y?,?ID?,?TEXT?,?TOGGLE?,?COL?)
	Rect:(?X?,?Y?,200,50)
		Handle(0.5,0.5)
		set(gel.y,%yPos)
		add(%yPos,gel.h+13)
	{{
		M_PressOPEN:(0,0,@W,@H,,)
			Draw:(Button_Shadow,-11,-5,@W+22,@H+21,,#00000080000000FF)
			Draw:(Button_SilverSliced,0,0,@W,@H)
			Draw:(Button_Shade,0,@M,@W,[@H/2],,#00000010FFFFFFFF)

			Draw:(White,2,42,@W-4,3,,?COL?)
				set(gel.vis,twk(History,ChartToggle) contains(#?TOGGLE?#))

			M_Text:(?TEXT?,5,0,@W-10,@H,C,C,TextLoc,KNUL18,Upper,0,0,#00000000,NoItalics,#252525FF,ref)
			Draw:(RoundedPanel,0,0,@W,@H,,#FFFFFF00)
				Layer(AboveText)
				Additive()
				if(%pressed)
				<
					set(gel.colour,#60606060)
				>
				else
				<
					frlerp(gel.colour,#00000000,0.05)
				>
		M_PressCLOSE:()
			M_CTRLButtonExtra:(?BTNOK?,true,CTRLButtonSelected,3,3,6,6)
			if(%clicked)
			<
				Message(history.toggleChart,?TOGGLE?)
				Message(history.toggleUpdate)
			>
	}}
EndM





Macro:(M_RelationshipToggle,?X?,?Y?,?ID?,?BOARDTOGGLE?,?FANSTOGGLE?,?PRESSTOGGLE?,?SPONSORTOGGLE?,?BOARDCOL?,?FANSCOL?,?PRESSCOL?,?SPONSORCOL?)
	Rect:(?X?,?Y?,200,50)
		Handle(0.5,0.5)
		set(gel.y,%yPos)
		add(%yPos,gel.h+13)
	{{
		M_PressOPEN:(0,0,@W,@H,,)
			Draw:(Button_Shadow,-11,-5,@W+22,@H+21,,#00000080000000FF)
			Draw:(Button_SilverSliced,0,0,@W,@H)
			Draw:(Button_Shade,0,@M,@W,[@H/2],,#00000010FFFFFFFF)

			M_Text:(Relationships,5,0,@W-10,@H,C,C,TextLoc,KNUL18,Upper,0,0,#00000000,NoItalics,#252525FF000000FF,ref)
			Draw:(RoundedPanel,0,0,@W,@H,,#FFFFFF00)
				Layer(AboveText)
				Additive()
				if(%pressed)
				<
					set(gel.colour,#60606060)
				>
				else
				<
					frlerp(gel.colour,#00000000,0.05)
				>
		M_PressCLOSE:()
			M_CTRLButtonExtra:(?BTNOK?,true,CTRLButtonSelected,3,3,6,6)
			if(%clicked)
			<
				Message(history.toggleChart,?BOARDTOGGLE?)
				Message(history.toggleChart,?FANSTOGGLE?)
				Message(history.toggleChart,?PRESSTOGGLE?)
				Message(history.toggleChart,?SPONSORTOGGLE?)
				Message(history.toggleUpdate)
			>

		Clip:(@L,@T+55,@W,0)
			if(twk(History,ChartToggle) contains(#?BOARDTOGGLE?#) or(twk(History,ChartToggle) contains(#?FANSTOGGLE?#)) or(twk(History,ChartToggle) contains(#?PRESSTOGGLE?#)) or(twk(History,ChartToggle) contains(#?SPONSORTOGGLE?#)))
			<
				frlerp(gel.h,120,0.2)
			>
			else
			<
				frlerp(gel.h,0,0.2)
			>
			add(%yPos,gel.h)
		{{
			Draw:(RoundedPanel,0,0,@W,120,,#FFFFFF99FFFFFFFF)
			M_Text:(,0,0,@W,120,C,C,TextBoxAtt,KNUL18,Upper,0,0,#00000000,NoItalics,#252525FF,ref)
				.set(gel.text,"¬?BOARDCOL?¬"::loc("relationship_2")::"|¬?FANSCOL?¬"::loc("relationship_1")::"|¬?PRESSCOL?¬"::loc("relationship_4")::"|¬?SPONSORCOL?¬"::loc("relationship_3"))
				.ToUpperCase()
				LineSpacing(1.5)
		}}
	}}
EndM

Macro:(M_ResetAllToggle,?X?,?Y?,?ID?)
	Rect:(?X?,?Y?,200,50)
		Handle(0.5,0.5)
		set(gel.y,%yPos)
		add(%yPos,gel.h+20)
	{{
		M_Button:(0,10,200,50,Button_RedSliced,,0,0,0,0,#FFFFFFFF,history.toggleReset,ref,loc(club_DATA_RESET),0,3,C,C,TextLoc,KNUL18,Upper,0,0,#00000000,NoItalics,#FFFFFFFF,textref)
			M_CTRLButtonExtra:(?BTNOK?,true,CTRLButtonSelected,3,3,6,6)
	}}
EndM