// - NEW CARD ANIM AND EMITTERS ------------------------------------------------------------------------------------
// Animation
Animation:(25,Clamp) ref:CardBGFX
{
    During:(0,20)
    {
         //Spinner01 scale in
        Draw:(CardFX_BG,0,0,1000,1000,-50,#FFFFFF00)
            Handle(0.5,0.5)
            TweenSize(600,600,500,500,-1,-1)
            TweenCol(#FFFFFFFF)  
            TweenAngle(360)  
  
        //Spinner02 scale in
        Draw:(CardFX_BG,0,0,1100,1110,0,#FFFFFF00)
            Handle(0.5,0.5)
            TweenSize(700,700,550,550,-1,-1)
            TweenCol(#FFFFFF70)  
            TweenAngle(80)  
    }
    
    During:(14,17)
    {
        //Glow Grow
        Draw:(CardFX_Glow,0,0,0,1,1,#FFFFFF00)
            Handle(0.5,0.5)
                TweenCol(#FFFFFF80)  
            TweenSize(1000,1000,0.5,0.5,-1,-1)
    }

    During:(19,24)
    {
        //Spinner01 scale out
        Draw:(CardFX_BG,0,0,600,600,0,#FFFFFFFF)
            Handle(0.5,0.5)
            TweenSize(1300,1300,300,300,-1,-1)
            TweenCol(#FFFFFF00)  
            TweenAngle(360)
 

        //Spinner02 scale out
        Draw:(CardFX_BG,0,0,700,700,-50,#FFFFFF70)
            Handle(0.5,0.5)
            TweenSize(1450,1450,350,350,-1,-1)
            TweenCol(#FFFFFF00)  
            TweenAngle(80)
    }

  
    During:(16,18)
    {
        //Glow static
        Draw:(CardFX_Glow,0,0,1000,1000,0,#FFFFFF80)
            Handle(0.5,0.5)
    }
    
   
    During:(19,22)
    {
         //Glow Shrink
        Draw:(CardFX_Glow,0,0,1000,1000,0,#FFFFFF80)
            Handle(0.5,0.5)
            TweenCol(#FFFFFF00)  
            TweenSize(0,0,500,500,-1,-1)
    }
}

// Particle
Draw:(Sparkle,0,0,40,40,,#808080FF) ref:Particle_CardSparkle
