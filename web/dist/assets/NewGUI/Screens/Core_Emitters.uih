// - CARD USED ANIM  -----------------------------------------------------------------------------------------------
Img:(CardFX_DROP,NewGUI/Cards/CardFX_DROP.png)
// Animation
Animation:(30,Clamp) ref:CardUSEDFX
{
    During:(0,29)
    {
        Draw:(CardFX_DROP,0,0,5,5,,#00FF0030)
            Handle(0.5,0.5)
            TweenSize(200,230,2.5,2.5)
            TweenCol(#FFFFFF00)
    }
     During:(3,21)
    {
        Draw:(CardFX_DROP,0,0,10,10,,#30FF3060)
            Handle(0.5,0.5)
            TweenSize(300,300,5,5)
            TweenCol(#FFFFFF00)
    }
    During:(0,29)
    {
        //Glow Grow
        Draw:(CardFX_Glow,0,0,15,15,,#DDFFDD30)
            Handle(0.5,0.5)
            TweenCol(#00FF0000)  
            TweenSize(400,400,0.5,0.5,-1,-1)
    }
}

// Particle
Draw:(LightGlow,0,0,40,40,,#808080FF) ref:Particle_UsedCardSpots
    Handle(0.5,0.5)
    Additive()
    Layer(AboveText)
    EmitPlacer()
    EmitSpinner()
    EmitMover()
    EmitLifetime()
    frlerp(gel.alpha,0,0.025)
    frlerp(gel.scale,0,0.05)
{
} Template

// Emitter
Emitter:(EM_CardUsed,Particle_UsedCardSpots) ref:UsedCardSpots

// Template
Rect:() ref:CardUsed
    Lifetime(1)
{
    //Dropped Card FX
    AnimInstance:(0,0,CardUSEDFX,,0.9)

    Instance:(UsedCardSpots,0,0)
} Template
