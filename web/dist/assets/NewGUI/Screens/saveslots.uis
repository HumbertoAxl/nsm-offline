Img:(SaveSlot_Foreground02,NewGUI/UI/SaveSlot/SaveSlot_Foreground_02.png) FORCE Scale:0.5 Volatile:BGSaveSlotViews
Img:(SaveSlot_Foreground03,NewGUI/UI/SaveSlot/SaveSlot_Foreground_03.png) FORCE Scale:0.5 Volatile:BGSaveSlotViews
