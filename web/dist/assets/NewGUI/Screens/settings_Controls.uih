//---------------------------------------------------------------------------------------------------NAVIGATION PS4 PAD
Macro:(M_NavigationControls_PS4)
	Draw:(Controller_PS4,@C,@M,700,,,#FFFFFFFF00000000)
		Handle(0.5,0.5)

	//----------------------------------------------------------------------------Left Controls
	//?X?,?Y?,?LENGTH?,?ANGLE?,?CIRCLEX?,?CIRCLEY?,?CHIDE?
	//LEFT TRIGGER
	M_Settings_ControlLine:(@C-292,@B-515,141,-33,@C-185,@B-445,1)
	M_Settings_ControlEntryNOICON:(@C-570,@B-545,settings_ZoomOutTab)
				
	//LEFT BUMPER
	M_Settings_ControlLine:(@C-292,@B-435,110,-16,@C-195,@B-410,1)	
	M_Settings_ControlEntryNOICON:(@C-570,@B-465,settings_ToggleSelL)
	
	//TouchPad
	M_Settings_ControlLine:(@C-292,@B-355,212,6,@C-85,@B-382,1)
	M_Settings_ControlEntryNOICON:(@C-570,@B-385,settings_OpenHelp)

	//D PAD
	M_Settings_ControlLine:(@C-292,@B-275,85,3,@C-215,@B-285,1)
	M_Settings_ControlEntryNOICON:(@C-570,@B-305,settings_Navigation)

	//LEFT STICK
	M_Settings_ControlLine:(@C-292,@B-195,180,6.5,@C-120,@B-220,1)
	M_Settings_ControlEntryNOICON:(@C-570,@B-225,settings_Navigation)

	//RIGHT STICK
	M_Settings_ControlLine:(@C-292,@B-115,385,11.5,@C+79,@B-198,1)
	M_Settings_ControlEntryNOICON:(@C-570,@B-145,settings_CamScroll)
	

	//-----------------------------------------------------------------------------Right Controls
	//?X?,?Y?,?LENGTH?,?ANGLE?,?CIRCLEX?,?CIRCLEY?,?CHIDE?
	//RIGHT TRIGGER
	M_Settings_ControlLine:(@C+292,@B-515,-138,33,@C+170,@B-445,1)
	M_Settings_ControlEntryNOICON:(@C+290,@B-545,settings_ZoomInTab)
	
	//RIGHT BUMPER
	M_Settings_ControlLine:(@C+292,@B-435,-110,16,@C+180,@B-410,1)
	M_Settings_ControlEntryNOICON:(@C+290,@B-465,settings_ToggleSelR)

	//OPTIONS BUTTON
	M_Settings_ControlLine:(@C+292,@B-355,-175,1.5,@C+110,@B-355,1)
	M_Settings_ControlEntryNOICON:(@C+290,@B-385,settings_OpenSettings)
	
	//TRIANGLE BUTTON
	M_Settings_ControlLine:(@C+292,@B-275,-122,-27.5,@C+180,@B-333,1)
	M_Settings_ControlEntryNOICON:(@C+290,@B-305,settings_GenToggle)
	
If:(twk(Settings,ButtonFlip))
	//CIRCLE BUTTON
	M_Settings_ControlLine:(@C+292,@B-195,-110,-46,@C+205,@B-280,1)
	M_Settings_ControlEntryNOICON:(@C+290,@B-225,settings_Confirm)
	
	//CROSS BUTTON
	M_Settings_ControlLine:(@C+292,@B-105,-180,-50.5,@C+170,@B-250,1)
	M_Settings_ControlEntryNOICON:(@C+290,@B-145,settings_Cancel)
Else
	//CIRCLE BUTTON
	M_Settings_ControlLine:(@C+292,@B-195,-110,-46,@C+205,@B-280,1)
	M_Settings_ControlEntryNOICON:(@C+290,@B-225,settings_Cancel)
	
	//CROSS BUTTON
	M_Settings_ControlLine:(@C+292,@B-105,-180,-50.5,@C+170,@B-250,1)
	M_Settings_ControlEntryNOICON:(@C+290,@B-145,settings_Confirm)
EndIf
	//SQUARE BUTTON
	M_Settings_ControlLine:(@C+292,@B-35,-295,-54.5,@C+115,@B-280,1)
	M_Settings_ControlEntryNOICON:(@C+290,@B-65,settings_GenToggle)
	

EndM

