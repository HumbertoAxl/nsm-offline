##N
Img:(Controller_Switch,NewGUI/UI/Controller/Controller_Switch.png)
##P
Img:(Controller_PC,NewGUI/UI/Controller/Controller_PC.png)
##4
Img:(Controller_PS4,NewGUI/UI/Controller/Controller_PlayStation.png)
##*

Macro:(M_Settings_ControlEntry,?X?,?Y?,?BUTTON?,?TEXT?,?CHAR?)
	Rect:(?X?,?Y?,@W,70)
	{{	
		Draw:(RoundedPanel,0,0,280,@H,,#6F8E9DFFFFFFFFFF)

		Rect:(20,33)
		{{
			##4
				Draw:(Circle_50,-3,-15,27,,,#FFFFFFFFFFFFFFFF)
					set(gel.vis,"?CHAR?" oneof("✂","✃","⛋","⛍","⛊","⛌","⛦"))
				Draw:(White,0,-8,21,19,#FFFFFFFFFFFFFFFF)
					set(gel.vis,"?CHAR?" oneof("⛐","⛑","⛎","⛏"))
			##-
				Draw:(Circle_50,-3,-15,27,,,#FFFFFFFFFFFFFFFF)
					set(gel.vis,"?CHAR?" oneof("✂","✃","⛋","⛍","⛊","⛌","⛦"))
				Draw:(White,0,-10,21,21,#FFFFFFFFFFFFFFFF)
					set(gel.vis,"?CHAR?" oneof("⛐","⛑","⛎","⛏"))
			##*

			M_Text:(?BUTTON?,0,0,0,0,L,C,TextLoc,KNUL25,,1,0,#00000000,NoItalics,#252525FF,ref)

		}}
		M_Text:(?TEXT?,60,0,240,@H,L,C,TextBox,KNUL20,,1,0,#00000000,NoItalics,#FFFFFFFF,ref)
	}}
EndM

Macro:(M_Settings_ControlEntryNOICON,?X?,?Y?,?TEXT?)
	Rect:(?X?,?Y?,@W,70)
	{{	
		Draw:(RoundedPanel,0,0,280,@H,,#6F8E9DFFFFFFFFFF)

		M_Text:(?TEXT?,7,0,265,@H,C,C,TextBox,KNUL20,,1,0,#00000000,NoItalics,#FFFFFFFF,ref)
	}}
EndM


Macro:(M_Settings_ControlLine,?X?,?Y?,?LENGTH?,?ANGLE?,?CIRCLEX?,?CIRCLEY?,?CHIDE?)
	Rect:()
	{	
		Draw:(White_Angle,?X?,?Y?+1,?LENGTH?,4,?ANGLE?,#00000040)
		Draw:(Circle_200,?CIRCLEX?,?CIRCLEY?+1,15,15,,#00000060)
			set(gel.vis,?CHIDE?)
		Draw:(White_Angle,?X?,?Y?,?LENGTH?,4,?ANGLE?,#6F8E9DFF)
		Draw:(Circle_200,?CIRCLEX?,?CIRCLEY?,15,15,,#6F8E9DFF)
			set(gel.vis,?CHIDE?)
	}
EndM

//----------------------------------------------------------------------------------------------------------------------------------SWITCH
//---------------------------------------------------------------------------------------------------NAVIGATION SWITCH PAD
Macro:(M_NavigationControls_Switch)
	Draw:(Controller_Switch,@C,@M,700,,,#FFFFFFFF00000000)
		Handle(0.5,0.5)

	//----------------------------------------------------------------------------------------Left Controls
	//LEFT TRIGGER
	M_Settings_ControlLine:(@C-272,@B-515,132,-17,@C-127,@B-488,0)
	M_Settings_ControlEntry:(@C-550,@B-545,settings_LTrigger,settings_ZoomOutTab,⛐)
				
	//LEFT BUMPER
	M_Settings_ControlLine:(@C-272,@B-435,110,15,@C-180,@B-468,1)	
	M_Settings_ControlEntry:(@C-550,@B-465,settings_LBumper,settings_ToggleSelL,⛎)
	
	//MINUS BUTTON
	M_Settings_ControlLine:(@C-272,@B-355,180,28,@C-114,@B-448,1)
	M_Settings_ControlEntry:(@C-550,@B-385,settings_-Button,settings_OpenHelp,⛥)

	//LEFT STICK
	M_Settings_ControlLine:(@C-272,@B-275,165,36,@C-143,@B-378,1)
	M_Settings_ControlEntry:(@C-550,@B-305,settings_LStick,settings_Navigation,✂)

	//DPAD
	M_Settings_ControlLine:(@C-272,@B-195,175,33,@C-132,@B-296,1)
	M_Settings_ControlEntry:(@C-550,@B-225,settings_Dpad,settings_Navigation,⛯)

	//RIGHT STICK
	M_Settings_ControlLine:(@C-272,@B-115,415,22,@C+102,@B-275,1)
	M_Settings_ControlEntry:(@C-550,@B-145,settings_RStick,settings_CamScroll,✃)
	
	//HOME BUTTON
	// M_Settings_ControlLine:(@C-272,@B-35,425,27,@C+92,@B-231,1)
	// M_Settings_ControlEntry:(@C-550,@B-65,settings_HomeButton,settings_OpenSwitch,⛦)
	
	//---------------------------------------------------------------------------------------Right Controls
	//RIGHT TRIGGER
	M_Settings_ControlLine:(@C+272,@B-515,-132,16,@C+127,@B-488,0)
	M_Settings_ControlEntry:(@C+270,@B-545,settings_RTrigger,settings_ZoomInTab,⛑)
	
	//RIGHT BUMPER
	M_Settings_ControlLine:(@C+272,@B-435,-100,-17,@C+170,@B-468,1)
	M_Settings_ControlEntry:(@C+270,@B-465,settings_RBumper,settings_ToggleSelR,⛏)

	//PLUS BUTTON
	M_Settings_ControlLine:(@C+272,@B-355,-180,-29,@C+104,@B-448,1)
	M_Settings_ControlEntry:(@C+270,@B-385,settings_+Button,settings_OpenSettings,⛤)
	
	//X BUTTON
	M_Settings_ControlLine:(@C+272,@B-275,-185,-47,@C+138,@B-415,1)
	M_Settings_ControlEntry:(@C+270,@B-305,settings_XButton,settings_GenToggle,⛌)

	//A BUTTON
	M_Settings_ControlLine:(@C+272,@B-195,-200,-59,@C+158,@B-378,1)
	M_Settings_ControlEntry:(@C+270,@B-225,settings_OKButton,settings_Confirm,⛊)

	//B BUTTON
	M_Settings_ControlLine:(@C+272,@B-115,-270,-62,@C+135,@B-360,1)
	M_Settings_ControlEntry:(@C+270,@B-145,settings_CANButton,settings_Cancel,⛋)
	
	//Y BUTTON
	M_Settings_ControlLine:(@C+272,@B-35,-380,-63,@C+92,@B-380,1)
	M_Settings_ControlEntry:(@C+270,@B-65,settings_YButton,settings_GenToggle,⛍)
EndM

