Img:(Icon_Target,NewGUI/UI/BoardTargets/Icon_Target.png)

Macro:(M_CircularBarBT,?X?,?Y?,?INDEX?)
    Rect:(?X?,?Y?)
    {{  
    	Rect:()
    	{
        	Draw:(CircleBar_Reflection,0,108,120,40)
	        Draw:(Circle_200,2,2,116,116,,#252525FFFFFFFFFF)
	        UseShader:(Segment)
	        {
	            Draw:(Circle_200,60,60,116,116,,#43C3EDFFFFFFFFFF)
		            Handle(0.5,0.5)
		            float(%amt)
		            //	Setting the tweaks to vars since it seems to have trouble doing a direct >= of string and float tweaks 
		            float(%tProg)
		            float(%tTarg)
		            set(%tProg, twk(BoardTargets,Target?INDEX?Progress))
		            set(%tTarg, twk(BoardTargets,Target?INDEX?Target))
		            if((%tProg) >= (%tTarg))
		            <
		            	set(%amt,1.02)
		            >
		            else
		            <
		            	set(%amt,min(1,(%tProg)/(%tTarg)))
		            >
		            SetUniform4F(seganim,gel.gx,gel.gy,1-(%amt*2),100)
	        }
	        Draw:(CircleBar_Frame120,0,0,120,120,,#505050FFFFFFFFFF)

	        Rect:()
	       	 	set(gel.vis,twk(BoardTargets,Target?INDEX?Completed) = 0)
	        {
		        // Text and reflection
		        M_Text:(,60,58,0,0,C,C,Text,KNUL40,,0,0,#00000000,NoItalics,#FFFFFFFF,ref)
		            set(gel.text,fmt(twk(BoardTargets,Target?INDEX?Progress),X) )
		        Clip:(0,0,120,88)
		        {
		            M_Text:(,60,85,0,0,C,C,Text,KNUL40,,0,0,#00000000,NoItalics,#FFFFFF30,ref)
		                set(gel.text,fmt(twk(BoardTargets,Target?INDEX?Progress),X) :: "")
		                Scale(1,-1)
		        }
		        Draw:(CircleBar_TextMask,17,70,,,,#505050FFFFFFFFFF)
		            Layer(Text)
	        }
		}
			// Should be done with 1:1 assets
			Scale(0.8,0.8)

		// Rosette - outside scale
		Draw:(BoardTargets_Rosette,-1,9,100,100)
			set(gel.vis,twk(BoardTargets,Target?INDEX?Completed) = 1)
    }}
EndM



//Board Target Images
Macro:(M_BoardTargetImage,?X?,?Y?,?INDEX?)
	Draw:(BoardTargets_Win,?X?,?Y?,320,320,,#FFFFFF80000000FF)
		if(twk(BoardTargets,Target?INDEX?ID) = "BOARDTARGET_8")
		<
			// Upgrade Building
			:set(gel.img,"BoardTargets_Building")
		>
		elif(twk(BoardTargets,Target?INDEX?ID) oneof("BOARDTARGET_11","BOARDTARGET_11b","BOARDTARGET_12","BOARDTARGET_12b"))
		<
			// Use a Card 
			:set(gel.img,"BoardTargets_CardBack")
		>
		elif(twk(BoardTargets,Target?INDEX?ID) = "BOARDTARGET_13")
		<
			// Reach Position in League
			:set(gel.img,"BoardTargets_Cup")
		>
		elif(twk(BoardTargets,Target?INDEX?ID) oneof("BOARDTARGET_1","BOARDTARGET_3"))
		<
			// Score Goals
			:set(gel.img,"BoardTargets_GoalCelebration")
		>
		elif(twk(BoardTargets,Target?INDEX?ID) oneof("BOARDTARGET_2","BOARDTARGET_2b"))
		<
			// Keep Clean Sheets
			:set(gel.img,"BoardTargets_Goalie")
		>
		elif(twk(BoardTargets,Target?INDEX?ID) oneof("BOARDTARGET_9","BOARDTARGET_16"))
		<
			// Player Meeting
			:set(gel.img,"BoardTargets_Meeting")
		>
		elif(twk(BoardTargets,Target?INDEX?ID) = "BOARDTARGET_14")
		<
			// Successfull press conference
			:set(gel.img,"BoardTargets_Press")
		>
		elif(twk(BoardTargets,Target?INDEX?ID) = "BOARDTARGET_15")
		<
			// Shortlist players
			:set(gel.img,"BoardTargets_Shortlist")
		>
		elif(twk(BoardTargets,Target?INDEX?ID) = "BOARDTARGET_10")
		<
			// Give a Team Talk
			:set(gel.img,"BoardTargets_Tactics")
		>
		elif(twk(BoardTargets,Target?INDEX?ID) oneof("BOARDTARGET_4","BOARDTARGET_4b","BOARDTARGET_5","BOARDTARGET_5b","BOARDTARGET_6","BOARDTARGET_7"))
		<
			// Win Games
			:set(gel.img,"BoardTargets_Win")
		>>>>>>>>>>
EndM




//Completed Board Target Container
Macro:(M_BoardTargetPanel,?INDEX?,?X?,?Y?,?TYPE?)
	Rect:(?X?,?Y?,[@W/3],@H)
		If:(?TYPE?="NewTarget")
			if(twk(BoardTargets,MatchesRemaining) > 0)
			<
				.set(gel.alpha,0)
				if(twk(BoardTargets,IntroMsgClosed) = 1)
				<
					Delay(1+[?INDEX?*0.3])
					frlerp(gel.alpha,1,0.1)
					:Post(UI_Swoosh)
				>
			>
		EndIf
	{{
		
		// Image
		M_BoardTargetImage:(0,-15,?INDEX?)


		// Target Title Text 		
		M_Text:("Target ?INDEX?",0,15,0,0,L,C,Text,KNUL20,Upper,0,0,#00000000,NoItalics,#FFFFFFFF,ref)
			.set(gel.text,loc(targets_TARGET) :: " " :: ?INDEX?)
			.set(gel.x,@C-[%gfw/2]+12)
		{{
			Draw:(Icon_Target,-38,-20,40,40)
		}}


		//Board Target Desc
		M_Text:("",10,172,@W-140,0,C,C,TextBox,KNUL28,,0,0,#00000000,NoItalics,#252525FF,ref,BoardTargets,Target?INDEX?Desc)
			FontStyle(#C1CFD699000000FF,-1,1 #C1CFD699000000FF,0,1 #C1CFD699000000FF,1,1 #C1CFD699000000FF,-1,0 #C1CFD699000000FF,1,0 #C1CFD699000000FF,-1,-1 #C1CFD699000000FF,0,-1 #C1CFD699000000FF,1,-1 #C1CFD699000000FF,-2,2 #C1CFD699000000FF,0,2 #C1CFD699000000FF,2,2 #C1CFD699000000FF,-2,0 #C1CFD699000000FF,2,0 #C1CFD699000000FF,-2,-2 #C1CFD699000000FF,0,-2 #C1CFD699000000FF,2,-2)
		

		// Circular Progress Bar 
		M_CircularBarBT:(@R-120,125,?INDEX?)
	}}
EndM



Macro:(M_BoardTargetPanelLong,?INDEX?,?X?,?Y?,?TYPE?)
	Rect:(?X?,?Y?,[@W/3],@H)
		If:(?TYPE?="NewTarget")
			if(twk(BoardTargets,MatchesRemaining) > 0)
			<
				.set(gel.alpha,0)
				if(twk(BoardTargets,IntroMsgClosed) = 1)
				<
					Delay(1+[?INDEX?*0.3])
					frlerp(gel.alpha,1,0.05)
					:Post(UI_Swoosh)
				>
			>
		EndIf
	{{
		// Image
		M_BoardTargetImage:(@C-160,40,?INDEX?)


		// Target Title Text 		
		M_Text:("Target ?INDEX?",0,25,0,0,L,C,Text,KNUL23,Upper,0,0,#00000000,NoItalics,#FFFFFFFF,ref)
			.set(gel.text,loc(targets_TARGET) :: " " :: ?INDEX?)
			.set(gel.x,@C-[%gfw/2]+12)
		{{
			Draw:(Icon_Target,-38,-20,40,40)
		}}

		
		//Board Target Desc
		M_Text:("",10,382,@W-140,0,C,C,TextBox,KNUL28,,0,0,#00000000,NoItalics,#252525FF,ref,BoardTargets,Target?INDEX?Desc)

		// Circular Progress Bar 
		M_CircularBarBT:(@R-120,335,?INDEX?)
	}}
EndM
