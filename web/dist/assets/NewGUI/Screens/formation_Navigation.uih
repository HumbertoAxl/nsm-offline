	M_Directions:(?CAT?,?TWK?,3,?REF?,10,,,5)
	M_Directions:(?CAT?,?TWK?,4,?REF?,8,,,4)
	M_Directions:(?CAT?,?TWK?,5,?REF?,6,,,4)
	M_Directions:(?CAT?,?TWK?,6,?REF?,8,10,,6)
	M_Directions:(?CAT?,?TWK?,7,?REF?,6,7,10,6)
	M_Directions:(?CAT?,?TWK?,8,?REF?,,10,,6)
	M_Directions:(?CAT?,?TWK?,9,?REF?,,10,,6)
EndM

