Macro:(M_Directions,?CAT?,?TWK?,?PRESET?,?REF?,?LEFT?,?RIGHT?,?UP?,?DOWN?)
	if(twk(?CAT?,?TWK?) = ?PRESET?)
	<
		If:(?LEFT? >= 0)
			CTRLPress(LEFT)
			<
				CTRLSetSelected(?REF??LEFT?)
				Post(CTRLNavigate)
			>
		EndIf

		If:(?RIGHT? >= 0)
			CTRLPress(RIGHT)
			<
				CTRLSetSelected(?REF??RIGHT?)
				Post(CTRLNavigate)
			>
		EndIf

		If:(?UP? >= 0)
			CTRLPress(UP)
			<
				CTRLSetSelected(?REF??UP?)
				Post(CTRLNavigate)
			>
		EndIf

		If:(?DOWN? >= 0)
			CTRLPress(DOWN)
			<
				CTRLSetSelected(?REF??DOWN?)
				Post(CTRLNavigate)
			>
		EndIf
	>
EndM

	// Formations
	// 1  --  3-4-3
	// 2  --  4-2-2-2
	// 3  --  3-4-2-1
	// 4  --  4-1-4-1
	// 5  --  4-2-3-1
	// 6  --  4-3-3
	// 7  --  4-4-1-1
	// 8  --  4-4-2
	// 9  --  5-3-2

Macro:(M_FormationNavigation_10,?CAT?,?TWK?,?REF?)
	M_Directions:(?CAT?,?TWK?,1,?REF?,9,,,7)
	M_Directions:(?CAT?,?TWK?,2,?REF?,9,8,,6)
	M_Directions:(?CAT?,?TWK?,3,?REF?,8,9,,7)
	M_Directions:(?CAT?,?TWK?,4,?REF?,7,8,,5)
	M_Directions:(?CAT?,?TWK?,5,?REF?,8,9,,7)
	M_Directions:(?CAT?,?TWK?,6,?REF?,9,,,7)
	M_Directions:(?CAT?,?TWK?,7,?REF?,9,,,9)
	M_Directions:(?CAT?,?TWK?,8,?REF?,9,,,7)
	M_Directions:(?CAT?,?TWK?,9,?REF?,9,,,6)
EndM


