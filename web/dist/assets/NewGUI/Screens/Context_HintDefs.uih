	// Cards Carousel Reminder
	M_ContextHintDialog:(home,CONTEXTCARDCAROUSEL,@r-390+@f,@t,110,50,loc(CHINT_CARDCAROUSEL),@r-288+@f,@t+110,FTUE_MultiTap,,@l+310-@f,-@t+350,OK,,,,CardCarousel,1,GameScreen,,#00000040,LEFT) ref:Hint_CardCarousel
		float(%wasVisible)
		if(gel.vis)
		<
			set(%wasVisible,1)
		>
		if(%wasVisible and(not(gel.vis)))
		<
			set(%wasVisible,0)
			set(twk(FtueNoLocal,ContextHintActive),0)
			set(twk(ContextHint,CardCarouselEnabled),0)
			set(twk(ContextHint,CardCarouselCount),0)
		>

	// Apply TeamTalk Hint not using Context Dialog
	Rect:()
		set(gel.vis,(shell(GameScreen)="formationmatch") and(twk(ScreenTransition,Active)=0) and(twk(DynamicOverlay,CurrentTopOverlay)="") and(twk(Formation,CurrentTab)=3) and(twk(Match,TeamTalkEnabled)) and(twk(Match,TeamTalkCount) > 0))
	{
		M_HandAnim_DragHoldRelease:(910,500-[@z/2],340-[@y/2],400)
	}
}