Spine:(NSM_BGFX02,@C+200,@M+200,65,BGFX02,Once) 
	float(%t,%play,%r)
	add(%t,FrameTime)
	.set(%r,frand(450,1200))
	if(%t > %r)
	<
		:set(%play,1)
	>
	.set(gel.anim.speed,0)
	.set(gel.colour,#FFFFFF50)
	if(%play)
	<
		:set(gel.anim.normtime,0)
		:set(gel.anim.speed,0.1)
		if(gel.anim.normtime > 0.99)
		<
			:set(%play,0)
			:set(%t,0)
			:set(%r,frand(450,1200))
		>
	>

// SingleStreak04
Spine:(NSM_BGFX02,@C+700,@M-300,65,BGFX02,Once) 
	float(%t,%play,%r)
	add(%t,FrameTime)
	.set(%r,frand(50,800))
	if(%t > %r)
	<
		:set(%play,1)
	>
	.set(gel.anim.speed,0)
	.set(gel.colour,#FFFFFF30)
	if(%play)
	<
		:set(gel.anim.normtime,0)
		:set(gel.anim.speed,0.1)
		if(gel.anim.normtime > 0.99)
		<
			:set(%play,0)
			:set(%t,0)
			:set(%r,frand(50,800))
		>
	>

// DustMote01
Spine:(NSM_BGFX_Dustmote,@C,@M,,BGFX_Dustmote,Once) 
	Scale(2,2)
	float(%t,%play,%r)
	add(%t,FrameTime)
	.set(%r,frand(300,1500))
	if(%t > %r)
	<
		:set(%play,1)
	>
	.set(gel.anim.speed,0)
	.set(gel.colour,#FFFFFF30)
	if(%play)
	<
		:set(gel.anim.normtime,0)
		:set(gel.anim.speed,0.3)
		if(gel.anim.normtime > 0.99)
		<
			:set(%play,0)
			:set(%t,0)
			:set(%r,frand(300,1500))
		>
	>

// DustMote02
Spine:(NSM_BGFX_Dustmote,@C-60,@M+80,,BGFX_Dustmote,Once) 
	Scale(1,1)
	float(%t,%play,%r)
	add(%t,FrameTime)
	.set(%r,frand(400,1200))
	if(%t > %r)
	<
		:set(%play,1)
	>
	.set(gel.anim.speed,0)
	.set(gel.colour,#FFFFFF30)
	if(%play)
	<
		:set(gel.anim.normtime,0)
		:set(gel.anim.speed,0.5)
		if(gel.anim.normtime > 0.99)
		<
			:set(%play,0)
			:set(%t,0)
			:set(%r,frand(400,1200))
		>
	>

// DustMote03
Spine:(NSM_BGFX_Dustmote,@C-420,@M+260,,BGFX_Dustmote,Once) 
	Scale(0.6,0.6)
	float(%t,%play,%r)
	add(%t,FrameTime)
	.set(%r,frand(200,800))
	if(%t > %r)
	<
		:set(%play,1)
	>
	.set(gel.anim.speed,0)
	.set(gel.colour,#FFFFFF40)
	if(%play)
	<
		:set(gel.anim.normtime,0)
		:set(gel.anim.speed,0.5)
		if(gel.anim.normtime > 0.99)
		<
			:set(%play,0)
			:set(%t,0)
			:set(%r,frand(200,800))
		>
	>

Spine:(NSM_BGFX_DustClouds,@C,@M,,BGFX_DustClouds,Loop) 
	.set(gel.anim.speed,0.1)
	.set(gel.colour,#FFFFFF30)

Spine:(NSM_BGFX_DustClouds,@C+250,@M+150,,BGFX_DustClouds,Loop) 
	.set(gel.anim.speed,0.15)
	.set(gel.colour,#FFFFFF30)



//Text
M_Text:(CLOUD_GETTING_ROOT_FILE,@C,@M+200,0,0,C,C,TextLoc,KNUL20,Upper,0,0,#00000000,NoItalics,#404040FF,ref)
	M_Style:(Outline,#40404010)


//CONNECT ANIM
AnimInstance:(@C-109,@M-83,Connect_Seq)	
	Handle(0.5,0.5)