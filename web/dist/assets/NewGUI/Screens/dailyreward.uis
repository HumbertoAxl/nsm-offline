Macro:(M_RewardItem)
    Rect:(0,0,365,347)
        float(%lerpAmt)
        Handle(182,240)
        set(%lerpAmt,[[@y/2]+gel.gx-[@w/2]]/[@w/2])
        set(gel.scale,lerp(1.1,0.7,min(1,abs(%lerpAmt))))
        if(abs(%lerpAmt) < 0.25)
        <
           
        >
    {{
         Draw:(White,0,0,200,200,,#FF000020)
    }}
EndM

