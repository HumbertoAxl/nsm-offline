    M_ReelItem:(5)
    M_ReelItem:(6)
    M_ReelItem:(7)
    M_ReelItem:(8)
    M_ReelItem:(9)
    M_ReelItem:(10)
    M_ReelItem:(11)
    M_ReelItem:(12)
M_ReelContainerCLOSE:()



// Temporary Trigger
Draw:(White,100,100,100,100)
    Click()
    <
        :call(ReelContainer,SpinReel)
    >

Text:(,450,200)
    set(gel.text,twk(DailyReward,ReelState))

M_DailyRewardTemplate:(1,Bux,?TEXT?)

