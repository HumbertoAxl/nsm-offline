//-------------------------------------------------------------------------------------------IMPORTS
Import:(Core.uih)
Import:(Core_ImageDefs.uih)
Import:(ImageDefs_characters.uih)
Import:(cards.uih)
//
//----------------------------------------------------------------------------------LOCAL IMAGE DEFS
//---------------------------------------------------------------------------------------------SETUP
Rect:()
	// Setup
	.set(twk(Dilemma,ContinueEnabled),0)
	.set(twk(Dilemma,Selected),-1)

// Audio
Rect:()
	set(twk(Audio,SuppressAllAmbient),1)
	
//----------------------------------------------------------------------------------------ANIMATIONS
//-----------------------------------------------------------------------------------------TEMPLATES
//--------------------------------------------------------------------------------------------MACROS
Macro:(M_Reward_Relationship)
	Rect:(0,0,0,30) ref:Root
		float(%w,%h,%id)
	{
		M_Text:("",0,0,@W,30,C,C,Text,KNUL24,,0,0,#00000000,NoItalics,#FFFFFFFF,Text)
			M_Style:(Outline,#FFFFFF10)
			.set(gel.w,%w)
	}
EndM

Macro:(M_Reward_Cash)
	Rect:(0,0,0,30) ref:Root
		float(%w,%h,%id)
	{
		M_Text:("",0,0,@W,30,L,C,Text,KNUL24,,0,0,#00000000,NoItalics,#FFFFFFFF,Text)
			M_Style:(Outline,#FFFFFF10)
			.set(gel.text,"★ " :: gel.text)
			.set(gel.w,%w)
			.set(gel.x,[%w-%gfw]/2)
			if(twk(Dilemma,Selected) = %id)
			<
				Delay(0.55)
				.set(twk(Money,BuxEmitterX),[@C]-38)
				.set(twk(Money,BuxEmitterY),410)
				.set(twk(Money,BuxIncrease),twk(Dilemma,CashReward))
				.set(twk(Money,BuxEmitterState),1)
			>
	}
EndM

