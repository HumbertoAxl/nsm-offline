// ----------------------------------------------- TEMPLATES

Draw:(ChartPoint,0,0,12,12,,#80808080) ref:ChartPoint
	Scale(0.5,0.5)
	Handle(0.5,0.5)
{
	M_Text:(,-50,-40,100,50,C,C,Text,KNUL18,,1,0,#FFFFFFFFFFFFFFFF,NoItalics,#FFFFFFFFFFFFFFFF,ChartPoint)
		CharacterSpacing(2.5)
		set(%gfw,strwidth(gel.text,0)*1.3)
		Layer(AboveText)
		{
			Draw:(RoundedPanel,0,-25,100,40,,#FEFEFEFF000000FF) ref:ChartPoint
				Scale(0.5,0.5)
				Layer(Text)
				.set(gel.w,%gfw+50)
				.set(gel.hx,[gel.w/2])
		}
} Template

Draw:(ChartLine,0,0,1,4) ref:ChartLine
