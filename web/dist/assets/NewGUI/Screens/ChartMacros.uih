} Template

Draw:(Chart_X,,,,,,#808080FFFFFFFFFF) ref:ChartXAxis
	Handle(0.5,0)
{{
	Draw:(RoundedPanel,-12,5,24,24,,#00000020FFFFFFFF)
	M_Text:(W,0,18,0,0,C,C,Text,KNUL20,,1,0,#252525FF000000FF,NoItalics,#252525FF000000FF,ChartXAxisBottomLabel)
	{
		Draw:(Icon_CupSmall,11,2,30,30,,#252525FFFFFFFFFF) $HIDE ref:Icon
	}

	M_Text:(H,0,0,0,0,C,C,Text,KNUL20,,1,0,#252525FF000000FF,NoItalics,#252525FF000000FF,ChartXAxisTopLabel)
		.sub(gel.y,15)
	{
		Rect:() $HIDE ref:Icon
	}
}} Template

