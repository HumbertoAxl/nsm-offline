// ----------------------------------------------- MACROS

Macro:(M_ChartYLine,?Y?,?TEXT?)
	Draw:(White,0,?Y?,@W,2,,#DDDDDDFF)
	Text:(?TEXT?,0,?Y?,,,R,,#555555FF)
		FontShadow(0,0)
		Handle(1,0.5)
		Italicise(0.0)
		FontScale(0.5,0.5)
		FontSize(0)
EndM




Macro:(M_ChartArea,?X?,?Y?,?W?,?H?,?MARGIN_L?,?MARGIN_R?,?MARGIN_T?,?MARGIN_B?,?REF?)
	Rect:(?X?+?MARGIN_L?,?Y?+?MARGIN_T?,?W?,?H?) ref:?REF?
	{{
		//Draw:(White,-?MARGIN_L?,-?MARGIN_T?,@W+[?MARGIN_L?+?MARGIN_R?],@H+[?MARGIN_T?+?MARGIN_B?],)
		Draw:(White,0,0,@W,@H,,#DDDDDDFF)
		Draw:(White,1,1,@W-2,@H-2)
	}}
EndM

Macro:(M_ChartArea100,?X?,?Y?,?W?,?H?,?MARGIN_L?,?MARGIN_R?,?MARGIN_T?,?MARGIN_B?,?REF?)
	M_ChartArea:(?X?,?Y?,?W?,?H?,?MARGIN_L?,?MARGIN_R?,?MARGIN_T?,?MARGIN_B?,?REF?)
	{{
		Define:(?SPLIT_Y?=@H/9)
		M_ChartYLine:(0,100)
		M_ChartYLine:(?SPLIT_Y?,)
		M_ChartYLine:(?SPLIT_Y?*2,70)
		M_ChartYLine:(?SPLIT_Y?*3,)
		M_ChartYLine:(?SPLIT_Y?*4,50)
		M_ChartYLine:(?SPLIT_Y?*5,)
		M_ChartYLine:(?SPLIT_Y?*6,30)
		M_ChartYLine:(?SPLIT_Y?*7,)
		M_ChartYLine:(?SPLIT_Y?*8,10)
		M_ChartYLine:(?SPLIT_Y?*9,)
	}}
EndM

Macro:(M_ChartArea2Splits,?X?,?Y?,?W?,?H?,?MARGIN_L?,?MARGIN_R?,?MARGIN_T?,?MARGIN_B?,?REF?,?TEXT_B?,?TEXT_M?,?TEXT_T?)
	M_ChartArea:(?X?,?Y?,?W?,?H?,?MARGIN_L?,?MARGIN_R?,?MARGIN_T?,?MARGIN_B?,?REF?)
	{{
		Define:(?SPLIT_Y?=@H/2)
		M_ChartYLine:(0,?TEXT_T?)
		M_ChartYLine:(?SPLIT_Y?,?TEXT_M?)
		M_ChartYLine:(?SPLIT_Y?*2,?TEXT_B?)
	}}
EndM