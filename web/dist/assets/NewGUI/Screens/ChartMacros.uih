Draw:(ChartPoint,0,0,8,8,,#80808080) ref:SeasonReviewChartPoint
	Scale(0.5,0.5)
	Handle(0.5,0.5)
	float(%id)
	colvar(%col)
	set(%col,#252525FF)
	if(twk(SeasonReview,ViewStreak)=0)
	<
		if(%id>=twk(SeasonReview,UnbeatenStreakStart) and(%id<[twk(SeasonReview,UnbeatenStreakStart)+twk(SeasonReview,UnbeatenStreak)]))
		<
			set(%col,#FFFF00FF)
		>
	>
	if(twk(SeasonReview,ViewStreak)=1)
	<
		if(%id>=twk(SeasonReview,WinStreakStart) and(%id<[twk(SeasonReview,WinStreakStart)+twk(SeasonReview,WinStreak)]))
		<
			set(%col,#00FF00FF)
		>
	>
	if(twk(SeasonReview,ViewStreak)=2)
	<
		if(%id>=twk(SeasonReview,LossStreakStart) and(%id<[twk(SeasonReview,LossStreakStart)+twk(SeasonReview,LossStreak)]))
		<
			set(%col,#FF0000FF)
		>
	>
	frlerp(gel.colour,%col,0.1)
{
} Template

Draw:(ChartLine,0,0,1,4) ref:SeasonReviewChartLine
	Handle(0,0.5)
	float(%id)
	colvar(%col)
	set(%col,#252525FF)
	if(twk(SeasonReview,ViewStreak)=0)
	<
		if(%id>twk(SeasonReview,UnbeatenStreakStart) and(%id<[twk(SeasonReview,UnbeatenStreakStart)+twk(SeasonReview,UnbeatenStreak)]))
		<
			set(%col,#FFFF00FF)
		>
	>
	if(twk(SeasonReview,ViewStreak)=1)
	<
		if(%id>twk(SeasonReview,WinStreakStart) and(%id<[twk(SeasonReview,WinStreakStart)+twk(SeasonReview,WinStreak)]))
		<
			set(%col,#00FF00FF)
		>
	>
	if(twk(SeasonReview,ViewStreak)=2)
	<
		if(%id>twk(SeasonReview,LossStreakStart) and(%id<[twk(SeasonReview,LossStreakStart)+twk(SeasonReview,LossStreak)]))
		<
			set(%col,#FF0000FF)
		>
	>
	frlerp(gel.colour,%col,0.1)
{
} Template

