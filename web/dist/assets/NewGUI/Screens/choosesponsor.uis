//-------------------------------------------------------------------------------------------IMPORTS
Import:(Core.uih)
//
//----------------------------------------------------------------------------------LOCAL IMAGE DEFS
##N
Macro:(M_SponsorImageDef,?INDEX?)
	If:(?INDEX? < 10)
		Img:(Sponsor_?INDEX?,NewGUI/Sponsors/Sponsor_00?INDEX?.png) FORCE Volatile:Sponsors00?INDEX?
	Else
		Img:(Sponsor_?INDEX?,NewGUI/Sponsors/Sponsor_0?INDEX?.png) FORCE Volatile:Sponsors0?INDEX?
	EndIf
EndM
##-
Macro:(M_SponsorImageDef,?INDEX?)
	If:(?INDEX? < 10)
		Img:(Sponsor_?INDEX?,NewGUI/Sponsors/Sponsor_00?INDEX?.png) FORCE Volatile:Sponsors
	Else
		Img:(Sponsor_?INDEX?,NewGUI/Sponsors/Sponsor_0?INDEX?.png) FORCE Volatile:Sponsors
	EndIf
EndM
##*

M_SponsorImageDef:(1)
M_SponsorImageDef:(2)
