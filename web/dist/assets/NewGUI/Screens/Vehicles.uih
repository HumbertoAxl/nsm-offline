//Turbine Macro
Macro:(M_Turbine,?POSX?,?POSY?,?POSZ?,?ROTZ?,?SPD?)
	Locator:((?POSX?,?POSY?,?POSZ?),(0,0,?ROTZ?),(1,1,1))
	{
		Locator:((0,-175,2620),(0,0,0),(1,1,1))
		{
			DrawStaticModel:(Turbine_HI,Base_HI)
				M_TextureSelect:()
		}

		Locator:((0,-175,95),(0,0,0),(1,1,1))
		{
			DrawStaticModel:(Turbine_Motor_HI,Base_HI)
				M_TextureSelect:()
		}
		Locator:((0,0,0),(0,0,0),(1,1,1))
			add(gel3d.roty,?SPD?)
		{
			DrawStaticModel:(Turbine_Blades_HI,Base_HI)
				M_TextureSelect:()
		}

		//Turbine Light
		UseShader:(ZSafeSprite)
		Layer(ZSprite)
		{
			Rect:()
			set(gel.vis,twk(Facilities,Night) = 1)
			{
				if(shell(GameScreen) ="home")
				<
					Locator:((0,-100,-100),(0,0,90),(1,1,1))
				>
				else
				<
					Locator:((0,-100,-100),(0,0,0),(1,1,1))
				>
				{
					Billboard:(NSM_HPadLight,0,0,0,220,220,0,#FF1E0060FFFFFFFF)
					   	set(gel.depth,gel.dist)
					   	PulseAlpha(0,1,0.6,0.3,0,0.15,0.15)
					    Handle(0.5,0.5)
				}
			}

		}

	}
EndM

//Vehicle Macros
Macro:(M_Vehicle,?POSX?,?POSY?,?VEH?,?TEX?,?ROT?,?COL?)
	Locator:((?POSX?,?POSY?,-2),(0,0,?ROT?),(1,1,1))
	{
		DrawStaticModel:(?VEH?_?COL?,NSM_?TEX?Sheet)
		 Blend(ONE,INV_IMAGE_ALPHA)
	}
EndM

Macro:(M_Vehicle_HI,?POSX?,?POSY?,?VEH?,?TEX?,?ROT?)
	Locator:((?POSX?,?POSY?,-2),(0,0,?ROT?),(1,1,1))
	{
		DrawStaticModel:(?VEH?_HI,NSM_?TEX?Sheet_HI)	
	}
EndM

Macro:(M_Vehicle_HI_Single,?POSX?,?POSY?,?VEH?,?TEX?,?ROT?)
	Locator:((?POSX?,?POSY?,-2),(0,0,?ROT?),(1,1,1))
	{
		DrawStaticModel:(?VEH?_HI,NSM_?TEX?Sheet_HI)
			Blend(ONE,INV_IMAGE_ALPHA)
			M_TextureSelect:()
		
	}
EndM

Macro:(M_Train,?POSX?,?POSY?,?VEH?,?TEX?,?ROT?)
	Locator:((?POSX?,?POSY?,-2),(0,0,?ROT?),(1,1,1))
	{
		DrawStaticModel:(?VEH?,?TEX?)
			M_TextureSelect:()
	}
EndM

Macro:(M_Truck,?POSX?,?POSY?,?ROT?,?TRAILER?,?TRAILERROT?,?SPONSOR?)
	Locator:((?POSX?,?POSY?,-2),(0,0,?ROT?),(1,1,1))
	{
		DrawStaticModel:(Truck_Cab_HI,NSM_VehicleSheet)
			Blend(ONE,INV_IMAGE_ALPHA)
			M_TextureSelect:()
		Rect:() $HIDE
			set(gel.vis,?TRAILER? = 1)
		{
			Locator:((0,0,0),(0,0,?TRAILERROT?),(1,1,1))
			{
				DrawStaticModel:(Truck_Trailer_HI,NSM_VehicleSheet)
					Blend(ONE,INV_IMAGE_ALPHA)
					M_TextureSelect:()
				
				
				Rect:() $HIDE
					set(gel.vis,twk(Facilities,Night)=0)
				{
					DrawStaticModel:(Truck_Sign_HI,Sponsor_?SPONSOR?)
						Blend(ONE,INV_IMAGE_ALPHA)
				}
				Rect:() $HIDE
					set(gel.vis,twk(Facilities,Night)=1)
				{
					DrawStaticModel:(Truck_Sign_HI_Night,Sponsor_?SPONSOR?)
						Blend(ONE,INV_IMAGE_ALPHA)
				}
			}
		}
	}
EndM

//Coach Macro
Macro:(M_Coach,?POSX?,?POSY?,?MESH?,?TEX?,?ROT?,?SCALE?)
	Locator:((?POSX?,?POSY?,-2),(0,0,?ROT?),(?SCALE?,?SCALE?,?SCALE?))
	{
		DrawStaticModel:(?MESH?,?TEX?)
			Blend(ONE,INV_IMAGE_ALPHA)
			M_TextureSelect:()
	}
EndM

//Ambulance Macro
Macro:(M_Ambulance,?POSX?,?POSY?,?ROT?,?SCALE?)
	Locator:((?POSX?,?POSY?,-2),(0,0,?ROT?),(?SCALE?,?SCALE?,?SCALE?))
	{
		DrawStaticModel:(Ambulance_HI,NSM_VehicleSheet)
			Blend(ONE,INV_IMAGE_ALPHA)
			M_TextureSelect:()
	}
EndM


	
//FastFood
Macro:(M_FastFood,?POSX?,?POSY?,?VEH?,?TEX?,?ROT?)
	Locator:((?POSX?,?POSY?,0),(0,0,?ROT?),(1,1,1))
	{
		UseShader:(Simple3DNZW)
			Layer(Shadows)
		{
			DrawStaticModel:(?VEH?_Shadow,Construction_Sheet01)
				Blend(ONE,INV_IMAGE_ALPHA)
		}
		
		DrawStaticModel:(?VEH?,NSM_?TEX?Sheet)
			Layer(Ground)
			M_TextureSelect:()
	}
EndM


//Vehicle pathing Macro
Macro:(M_VehPath,?VEHTYPE?,?VEHCLASS?,?SPD?,?ROTZ?,?DELAY1?,?DELAY2?,?VAR?,?LIGHTOFFSET?)
Locator:((0,0,0),(0,0,0),(1,1,1))
	Euler(RYP)
	float(%FCURVE?VAR?)
	float(%CarRandDelay)
	float(%MoveCar?VAR?)
	if(%MoveCar?VAR? = 0)
	<
		//Random delay for Vehicle start
		:set(%CarRandDelay,frand(?DELAY1?,?DELAY2?))
		:Delay(%CarRandDelay)
		:set(%MoveCar?VAR?,1)
	>
	if(%MoveCar?VAR? = 1)
	<
		add(%FCURVE?VAR?,0.0?SPD?)
		if(%FCURVE?VAR?>1)
		<
			set(%FCURVE?VAR?,0)
			set(%MoveCar?VAR?,0)
		>
	>
	FollowCurve(CarTravel,CarTravel?VAR?,%FCURVE?VAR?,true)
{	
		Locator:((0,0,0),(0,0,?ROTZ?),(1,1,1))
		{
			M_Vehicle_HI_Single:(0,0,?VEHTYPE?,?VEHCLASS?,0)

			Locator:((0,?LIGHTOFFSET?,0),(0,0,0),(1,1,1))
				set(gel.vis,twk(Facilities,Night) =1)
			{
				DrawStaticModel:(Car_Lights_HI,NSM_Headlight)
					Blend(ONE,INV_IMAGE_ALPHA)
					
			}
		}
}
EndM



//Tractor pathing Macro
Macro:(M_TractorPath,?SPD?,?ROTZ?,?DELAY1?,?DELAY2?,?VAR?)
Locator:((0,0,0),(0,0,0),(1,1,1))
			Euler(RYP)
			float(%FCURVE?VAR?)
			float(%CarRandDelay)
			float(%MoveCar?VAR?)
			if(%MoveCar?VAR? = 0)
			<
				//Random delay for Vehicle start
				:set(%CarRandDelay,frand(?DELAY1?,?DELAY2?))
				:Delay(%CarRandDelay)
				:set(%MoveCar?VAR?,1)
			>
			if(%MoveCar?VAR? = 1)
			<
				add(%FCURVE?VAR?,0.0?SPD?)
				if(%FCURVE?VAR?>1)
				<
					set(%FCURVE?VAR?,0)
					set(%MoveCar?VAR?,0)
				>
			>
			FollowCurve(CarTravel,TractorTravel?VAR?,%FCURVE?VAR?,true)
		{	
				Locator:((0,0,0),(0,0,?ROTZ?),(0.9,0.9,0.9))
				{
					DrawStaticModel:(Tractor_HI,NSM_Tractor)
						Blend(ONE,INV_IMAGE_ALPHA)
				}
		}
EndM