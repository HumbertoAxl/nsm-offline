//----------------------------------------------------------------------------Macros

Macro:(M_ChooseHoardingContents,?SLOT?,?TYPE?,?DEFAULT?)
	Rect:()
		.if(twk(Match,PlayerAtHome)=0)
		<
			// Away match, random sponsor in the valid sponsor range. E.g: Sponsor_32
			set(twk(Club,Hoarding?SLOT??TYPE?Content), "Sponsor_" :: fmt(rand(1,55),X))
		>
		else
		<
			//	Home match
			if((twk(Club,SpecialEffect) = 1) and(twk(Club,DisabledSponsor) = ?SLOT?))
			<
				//	This slot scheduled for a special effect sponsor, so one of the 2 in valid range. E.g: Sponsor_56
				set(twk(Club,Hoarding?SLOT??TYPE?Content), "Sponsor_" :: fmt(rand(56,57),X))
			>
			else
			<
				//	Normal player sponsor slot
				if(twk(Club,HasSponsor?SLOT?))
				<
					// If we have a sponsor use it.
					set(twk(Club,Hoarding?SLOT??TYPE?Content), "Sponsor_" :: twk(Club,Sponsor?SLOT?Id))
				>
				else
				<
					//	Or mark as Fallback if we have nothing in here
					if(?DEFAULT?="")
					<
						set(twk(Club,Hoarding?SLOT??TYPE?Content), "Fallback")
					>
					else
					<
						set(twk(Club,Hoarding?SLOT??TYPE?Content), ?DEFAULT?)
					>
				>
			>
		>
EndM

Macro:(M_ChooseAllHoardingContents)
	Rect:()
	{{
		M_ChooseHoardingContents:(1,Dynamic,Sponsor_Default1)
		M_ChooseHoardingContents:(2,Dynamic,Sponsor_Default2)
		M_ChooseHoardingContents:(3,Dynamic,Sponsor_Default3a)
		M_ChooseHoardingContents:(1,Static,Sponsor_1)
		M_ChooseHoardingContents:(2,Static,Sponsor_2)
		M_ChooseHoardingContents:(3,Static,Sponsor_3)
	}}
EndM



//---------------------------------------------------------------------------Animation
Animation:(2100,Loop) ref:Hoarding3AAnim
{
	//Ad1 ON
	During:(0,600)
	{
		//Ad 1
		Rect:(0,0,256,256,#FFFFFFFFFFFFFFFF)
		{{
			Draw:(White,64,0,90,256,,#FFFFFFFFFFFFFFFF)
				set(gel.img, twk(Club,Hoarding1DynamicContent))
		}}
	}


	//Ball On
	Rect:()
		set(gel.vis(twk(Club,Hoarding1DynamicContent) = Sponsor_Default1))	
	{
		During:(0,20)
		{
			Draw:(Sponsor_Ball,32,0,30,256,,#FFFFFFFFFFFFFFFF)
				TweenPos(32,128,0,1)
				Handle(0.5,0.5)
		}
		During:(21,27)
		{
			Draw:(Sponsor_Ball,32,128,30,256,,#FFFFFFFFFFFFFFFF)
				TweenPos(32,100,0,1)
				Handle(0.5,0.5)
		}
		During:(28,34)
		{
			Draw:(Sponsor_Ball,32,100,30,256,,#FFFFFFFFFFFFFFFF)
				TweenPos(32,128,0,1)
				Handle(0.5,0.5)
		}
		During:(35,601)
		{
			Draw:(Sponsor_Ball,32,128,30,256,,#FFFFFFFFFFFFFFFF)
				Handle(0.5,0.5)
		}
	}


	//Ad1 to Ad2 transition
	During:(601,700)
	{
		//Ad1
		Rect:(0,0,256,256,#FFFFFFFFFFFFFFFF)
			TweenPos(-256,0,0,-1)
		{{
			Draw:(White,64,0,90,256,,#FFFFFFFFFFFFFFFF)
				set(gel.img, twk(Club,Hoarding1DynamicContent))

			Rect:()
				set(gel.vis,(twk(Club,Hoarding1DynamicContent) = Sponsor_Default1))
			{							
				Draw:(Sponsor_Ball,32,128,30,256,,#FFFFFFFFFFFFFFFF)
				Handle(0.5,0.5)
				Draw:(Sponsor_Default1,78,0,100,256,,#FFFFFFFFFFFFFFFF)
			}	
		}}
			
		//------------Ad2 
		Rect:(256,0,256,256,#FFFFFFFFFFFFFFFF)
			TweenPos(0,0,0,-1)
		{{
			Draw:(White,64,0,90,256,,#FFFFFFFFFFFFFFFF)
				set(gel.img, twk(Club,Hoarding2DynamicContent))
		}}
	}
	
	//Ad2 on (701,1300,00,600)
	During:(701,1300)
	{
		Draw:(White,64,0,90,256,,#FFFFFFFFFFFFFFFF)
			set(gel.img, twk(Club,Hoarding2DynamicContent))
	}

	//Ad2 to Ad3 transition (1331,1429)
	During:(1331,1429)
	{
		//Ad3
		Rect:(256,0,256,256,#FFFFFFFFFFFFFFFF)
			TweenPos(0,0,0,-1)
		{{
			Rect:()
				set(gel.vis(twk(Club,Hoarding3DynamicContent) = Sponsor_Default3a))	
			{
				Draw:(Sponsor_Default3b,78,0,100,256,,#FFFFFFFFFFFFFFFF)
			}
		}}
	}
	During:(1301,1399)
	{
		//Ad2
		Rect:(0,0,256,256,#FFFFFFFFFFFFFFFF)
			TweenPos(-256,0,0,-1)
		{{
			Draw:(White,64,0,90,256,,#FFFFFFFFFFFFFFFF)
				set(gel.img, twk(Club,Hoarding2DynamicContent))
		}}
		
		//Ad3
		Rect:(256,0,256,256,#FFFFFFFFFFFFFFFF)
			TweenPos(0,0,0,-1)
		{{
			Draw:(White,64,0,90,256,,#FFFFFFFFFFFFFFFF)
				set(gel.img, twk(Club,Hoarding3DynamicContent))	
		}}
	}
		During:(1301,1399)
	{
		//Ad3
		Rect:(256,0,256,256,#FFFFFFFFFFFFFFFF)
			TweenPos(0,0,0,-1)
		{{
			Draw:(White,64,0,90,256,,#FFFFFFFFFFFFFFFF)
				set(gel.img, twk(Club,Hoarding3DynamicContent))		
		}}
	}

	//Ad3b on
	During:(1430,1999)
	{
		Draw:(Sponsor_Default3b,78,0,100,256,,#FFFFFFFFFFFFFFFF)
			set(gel.vis(twk(Club,Hoarding3DynamicContent) = Sponsor_Default3a))		
	}
	//Ad3a on
	During:(1400,1999)
	{
		Draw:(White,64,0,90,256,,#FFFFFFFFFFFFFFFF)
			set(gel.img, twk(Club,Hoarding3DynamicContent))		
	}


	//Ad3 to Ad1 transition
	During:(2000,2099)
	{
		//Ad3
		Rect:(0,0,256,256,#FFFFFFFFFFFFFFFF)
			TweenPos(-256,0,0,-1)
		{{
			Draw:(White,64,0,90,256,,#FFFFFFFFFFFFFFFF)
				set(gel.img, twk(Club,Hoarding3DynamicContent))		
			Rect:()
				set(gel.vis(twk(Club,Hoarding3DynamicContent) = Sponsor_Default3a))	
			{
				Draw:(Sponsor_Default3b,78,0,100,256,,#FFFFFFFFFFFFFFFF)
			}
		}}
		
		//Ad1
		Rect:(256,0,256,256,#FFFFFFFFFFFFFFFF)
			TweenPos(0,0,0,-1)
		{{
			Draw:(White,64,0,90,256,,#FFFFFFFFFFFFFFFF)
				set(gel.img,twk(Club,Hoarding1DynamicContent))		
		}}
	}

} 


//---------------------------------------------------------------------------Surfaces

Surf:($Ad_Pitch,256,256)

View:($Ad_Pitch,256,256)
{
	Sheet:() 
	{
		Cls:(#FFFFFFFF)	
		Draw:(White,5,10,246,236,,#FFFFFFFF)
			set(gel.img,twk(Club,Hoarding1StaticContent))		

		Draw:(Fade_Down,0,270,256,-100,,#00000040)

	}
}


