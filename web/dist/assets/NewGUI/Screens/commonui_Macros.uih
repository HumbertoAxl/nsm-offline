Macro:(M_Navigation_Search)
	M_Screen_Home:()
	M_Screen_League:()
	if((shell(GameScreen) = "staff") and(twk(DynamicOverlay,CurrentTopOverlay) = ""))
	<	
		CTRLPress(DOWN)
		<
			CTRLSetSelected(RootFitnessCentre1,staff)
			Post(CTRLNavigate)
		>
	>
	if((shell(GameScreen) = "club") and(twk(DynamicOverlay,CurrentTopOverlay) = ""))
	<
		if(twk(Club,CurrentTab) = 1)
		<
			CTRLPress(DOWN)
			<
				CTRLSetSelected(PressPanel,club)
				Post(CTRLNavigate)
			>
		>
	>
	M_DOL_Manager:()
	M_DOL_Search:()
	M_Screen_SquadData:(RoleCombo)
EndM

Macro:(M_Navigation_Targets)
	M_Screen_Home:()
	M_Screen_League:()
	M_DOL_Manager:()
	M_DOL_Search:()
	M_Screen_SquadData:(RoleCombo)
EndM

Macro:(M_Navigation_Cards)
	M_Screen_Home:()
	M_Screen_League:()
	if((shell(GameScreen) = "formationmenu") and(twk(DynamicOverlay,CurrentTopOverlay) = ""))
	<	
		CTRLPress(DOWN)
		<
			if(twk(Formation,CurrentTab) = 1)
			<
				CTRLSetSelected(SubsSelectGroup,formationmenu)
				Post(CTRLNavigate)
			>
			if(twk(Formation,CurrentTab) = 2)
			<
				Post("CTRLCardCarouselDown")
			>
			if(twk(Formation,CurrentTab) = 3)
			<
				CTRLSetSelected(squaddatabutton,formationmenu)
				Post(CTRLNavigate)
			>
		>
	>
	if((shell(GameScreen) = "staff") and(twk(DynamicOverlay,CurrentTopOverlay) = ""))
	<
		CTRLPress(DOWN)
		<
			if(twk(Staff,PostMatchState) = 0)
			<
				CTRLSetSelected(RootYouthAcademy,staff)
				Post(CTRLNavigate)
			>
			else
			<
				CTRLSetSelected(CoachingRootYouthAcademy,staff)
				Post(CTRLNavigate)
			>
		>
	>	
	if((shell(GameScreen) = "club") and(twk(DynamicOverlay,CurrentTopOverlay) = ""))
	<
		if(twk(Club,CurrentTab) = 1)
		<
			CTRLPress(DOWN)
			<
				CTRLSetSelected(BoardPanel,club)
				Post(CTRLNavigate)
			>
		>
		if(twk(Club,CurrentTab) = 3)
		<
			CTRLPress(DOWN)
			<
				CTRLSetSelected(DataToggleGroup,club)
				Post(CTRLNavigate)
			>
		>
	>
	if((shell(GameScreen) = "staffhirelist") and(twk(DynamicOverlay,CurrentTopOverlay) = ""))
	<
		CTRLPress(DOWN)
		<
			CTRLSetSelected(DataListHeader,staffhirelist)
			Post(CTRLNavigate)
		>
	>
	M_DOL_Search:()
	M_DOL_Manager:()
	M_DOL_PlayerProfile:(PlayerNextButton)
	M_DOL_StaffProfile:(StaffNextButton)
	M_Screen_SquadData:(ViewCombo)
EndM

