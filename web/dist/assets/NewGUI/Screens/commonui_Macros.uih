Macro:(M_Navigation_Manager)
	CTRLBlock(LEFT)
	M_Screen_Home:()
	M_Screen_League:()
	M_DOL_Manager:()
	M_DOL_Search:()
	M_Screen_SquadData:(RoleCombo)
	M_DOL_PlayerProfile:(PlayerPrevButton)
	M_DOL_StaffProfile:(StaffPrevButton)
EndM

