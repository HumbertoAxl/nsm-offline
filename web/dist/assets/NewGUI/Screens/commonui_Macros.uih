Animation:(100,Clamp) ref:CoinSting
{
	During:(0,100)
	{
		Rect:()
			.set(gel.alpha,0.1)
		{
	    	Draw:(Header_Hex,-29,-17,50,50)
	    	Draw:(Header_Hex,-29,17,50,50)
	    	Draw:(Header_Hex,2,-36,50,50)
	    	Draw:(Header_Hex,2,36,50,50)

	    	Draw:(Header_Hex,34,-17,50,50)
	    	Draw:(Header_Hex,34,17,50,50)
		}
	}

	During:(0,20)
    {
    	Draw:(Header_Hex,-29,17,50,50,,#FFFFFF00)
    		TweenAlpha(1,0.1)
    }	
	During:(20,60)
    {
    	Draw:(Header_Hex,-29,17,50,50)
    		TweenAlpha(0,0.1)
    }	

	During:(10,30)
    {
    	Draw:(Header_Hex,-29,-17,50,50,,#FFFFFF00)
    		TweenAlpha(1,0.1)
    	Draw:(Header_Hex,2,36,50,50,,#FFFFFF00)
    		TweenAlpha(1,0.1)
    }
	During:(30,70)
    {
    	Draw:(Header_Hex,-29,-17,50,50)
    		TweenAlpha(0,0.1)
    	Draw:(Header_Hex,2,36,50,50)
    		TweenAlpha(0,0.1)
    }

   	During:(20,40)
    {
    	Draw:(Header_Hex,2,-36,50,50,,#FFFFFF00)
    		TweenAlpha(1,0.1)
    	Draw:(Header_Hex,34,17,50,50,,#FFFFFF00)
    		TweenAlpha(1,0.1)
    }
   	During:(40,80)
    {
    	Draw:(Header_Hex,2,-36,50,50)
    		TweenAlpha(0,0.1)
    	Draw:(Header_Hex,34,17,50,50)
    		TweenAlpha(0,0.1)
    }

   	During:(30,50)
    {
    	Draw:(Header_Hex,34,-17,50,50,,#FFFFFF00)
    		TweenAlpha(1,0.1)
    }
   	During:(50,90)
    {
    	Draw:(Header_Hex,34,-17,50,50)
    		TweenAlpha(0,0.1)
    }
}


Macro:(M_HeaderZoneOPEN,?X?,?Y?,?W?,?H?,?CAT?,?VAR?,?SCREEN?,?LINK?,?ID?,?CATINT?,?VARINT?)
	Dissolve:(?X?,?Y?,?W?,?H?) ref:Header?ID?
		.set(gel.alpha,0)
		float(%pressed,%clicked,%zoneRearm)
		if(%rearm)
		<
			:set(gel.alpha,0)
		>
		if(twk(?CAT?,?VAR?) = 1)
		<
			set(%zoneRearm,0)
			:set(%zoneRearm,1)
			frlerp(gel.alpha,1,0.15)	
		>
		else
		<
			frlerp(gel.alpha,0,0.15)
		>
		Press()
		<
			:set(%pressed,1)
		>
		else
		<
			:set(%pressed,0)
		>
		// Click
		set(%clicked,0)
		func(ClickFunc)
		<
			if(twk(?CAT?,?VAR?) and twk(?CATINT?,?VARINT?))
			<
				.set(twk(CardsCarousel,State),0)
				Post(UI_Select)
				set(%clicked,1)
				Post(?LINK?)
			>
		>
		Click()
		<
			call(ClickFunc)
		>
		CTRLClick(?BTNOK?)
		<
			call(ClickFunc)
		>
		// PS4 only - hide the blue selection box around the Cards Carousel header item, during ftue only
		##4
		if((twk(?CAT?,?VAR?)) and twk(?CATINT?,?VARINT?) and (?ID? oneof(2,3,4,5,6,7)))
		<
			if(?ID?=6)
			<
				if(twk(Ftue,Enabled) = 0)
				<
					CTRLSelect(CTRLSquareSelected,0,0,0,0)
				>
				elif((twk(Ftue,Enabled) = 1) and(twk(Ftue,Step) = 75))
				<
					CTRLClearSelect()
				>>
			>
			else
			<
				CTRLSelect(CTRLSquareSelected,0,0,0,0)
			>
		>
		##-
		if((twk(?CAT?,?VAR?) and twk(?CATINT?,?VARINT?)) and(?ID? oneof(2,3,4,5,6,7)))
		<
			CTRLSelect(CTRLSquareSelected,0,0,0,0)
		>
		##*
	{{
		Draw:(White,0,0,1,@H,,#606060FF)
		Draw:(White,@R,0,1,@H,,#606060FF)

		Draw:(White,0,0,@W+1,@H,,#FFFFFF00)
			Layer(AboveText)
			Additive()
			if(%pressed)
			<
				set(gel.alpha,0.2)
			>
			else
			<
				if(gel.alpha > 0.01)
				<
					frlerp(gel.alpha,0,0.05)
				>
			>
EndM


Macro:(M_HeaderZoneCLOSE)
	}}
EndM


Macro:(M_CurrencyReadout,?X?,?Y?)
