Macro:(M_TeamScore,?X?,?Y?,?INDEX?)
	M_Text:(,?X?,?Y?,0,0,C,C,Text,KNUL40,,1,0,#FFFFFFFF,NoItalics,#FFFFFFFF,ref,Match,Team?INDEX?Score)
		Handle(0.5,0.75)
		float(%score,%flash,%targetScale)
		.set(%targetScale,1)
		// Reset score float
		if(twk(Match,Half) = 0)
		<
			:set(%score,0)
		>
		if(twk(Match,Team?INDEX?Score) > %score)
		<
			:set(gel.scale,1)
			:Delay(0.1)
			:set(%flash,1)
			:set(%score,twk(Match,Team?INDEX?Score))
		>
		if(%flash)
		<
			:set(%targetScale,1.5)
			:Delay(2)
			:set(%targetScale,1)
			:set(%flash,0)
		>
		if(%targetScale > 1)
		<
			PulseAlpha(1,0.1,0.2,0.2,0.1,0.1,0.1)
		>
		else
		<
			set(gel.alpha,1)
		>
		frlerp(gel.scale,%targetScale,0.1)
EndM



// Macrod script
Macro:(M_DOL_Manager)
	if(twk(DynamicOverlay,CurrentTopScreen) = "manager")
	<
		if((twk(Manager,CurrentTab) = 3) and(twk(Manager,PrestigeCount) > 0))
		<
			CTRLPress(DOWN)
			<
				CTRLSetSelected(PrestigeComboComboSelected,manager)
				Post(CTRLNavigate)
			>
		>
		if(twk(Manager,CurrentTab) = 5)
		<
			CTRLPress(DOWN)
			<
				##P4
				CTRLSetSelected(CTRLSelect,manager,,settingsmusicslider)
				##IAN
				CTRLSetSelected(settingsmusictoggle,manager)
				##*
			>
		>
	>
EndM

