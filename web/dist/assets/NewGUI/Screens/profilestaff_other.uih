//----------------------------------------------------------------------------------LOCAL IMAGE DEFS
Rect:()
	set(gel.vis,twk(Negotiate,InProgress) = 0 and(twk(ProfileStaff,IsPotentialHire) and(twk(ProfileStaff,Sku)="")))
{
	// TABS
	Rect:(0,350,@W,215+@z)
	{{
		Draw:(Tab_BG50,@f,-2,@w,58)
	}}





	// TABS CONTENT
	Rect:(0,401+[@z/2],@W,235)
	{{
		// Contracts
		Rect:(@C-[@W/4],5,[@W/2],@H)
		{{
			Tile:(White,0,15,@W,1,,#0000001A)
				Copies(1,3)
				Spacing(0,50)
			
			M_Text:(profile_NEWCONTRACT,0,40,0,0,L,C,TextLoc,KNUL25,,0,0,#00000000,NoItalics,#505050FF,ref)
			
			M_Button:(@R-190,45,80,40,Button_SilverSliced,,0,0,0,0,#FFFFFFFF,profilestaff.btn_NegotiationSub,StaffOtherNegotiationSubButton,"-",0,0,C,C,Text,KNUL25,Upper,1,0,#252525FF,NoItalics,#252525FF,textref)
				M_CTRLButtonExtra:(?BTNOK?,true,CTRLButtonSelected,3,3,6,6)
				set(%disabled,twk(Negotiate,Increment) = 40)
				CTRLBlock(LEFT)
				CTRLPress(UP)
				<
					CTRLSetSelected(StaffPrevButton)
					Post(CTRLNavigate)
				>
			
			M_Button:(@R-90,45,80,40,Button_SilverSliced,,10,-5,64,64,#FFFFFFFF,profilestaff.btn_NegotiationAdd,StaffOtherNegotiationAddButton,"+",0,0,C,C,Text,KNUL25,Upper,1,0,#252525FF,NoItalics,#252525FF,textref)
				M_CTRLButtonExtra:(?BTNOK?,true,CTRLButtonSelected,3,3,6,6)
				set(%disabled,twk(Negotiate,Increment) = 100)
				CTRLBlock(RIGHT)

			M_Text:(,0,40,@W,0,R,C,Text,KNUL25,,1,0,#252525FF,NoItalics,#252525FF,ref,Negotiate,Increment,DoLTR)
			M_Text:(profile_WAGEDEMANDS,0,90,0,0,L,C,TextLoc,KNUL25,,0,0,#00000000,NoItalics,#505050FF,ref)
			M_Text:(,0,90,@W,0,R,C,Text,KNUL25,,1,0,#252525FF,NoItalics,#252525FF,ref)
				set(gel.text,"★ " :: commasfmt(twk(Negotiate,RawDemands)))

			M_Button:(@C,177,220,85,Button_GreenSliced,Blank,20,2,50,50,#252525FF,profilestaff.btn_Negotiate,StaffOtherOfferButton,loc(profile_CONFIRMOFFER),0,3,C,C,TextBox,KNUL22,Upper,0,0,#00000000,NoItalics,#FFFFFFFF,textref)
				M_CTRLButtonExtra:(?BTNOK?,true,CTRLButtonSelected,3,3,6,6)
				CTRLBlock(LEFT,RIGHT)
				CTRLPress(UP)
				<
					CTRLSetSelected(StaffOtherNegotiationSubButton)
					Post(CTRLNavigate)
				>
		}}
	}}
}