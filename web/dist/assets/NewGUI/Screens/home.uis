// Audio
Rect:()
	set(twk(Audio,Ambient),"training")
	
//----------------------------------------------------------------------------------------ANIMATIONS

//--------------------------------------------------------------------------------------------MACROS

//Set this to a texture to show the colliders for selecting other facilities in the distance
Define:(?SHOW_FACILITY_SELECTION_COLLIDERS?=) 


Macro:(M_RotateAroundFacility_LocatorDef)
	Locator:()
		float(%POSX,%POSY,%DIST,%ROTX,%ROTZ,%BLEND)
		float(%YA,%H,%V,%XO,%YO,%DX)
EndM
Macro:(M_RotateAroundFacility_LocatorUpdate,?CAT1?,?VAR1?,?ID1?,?CAT2?,?VAR2?,?ID2?)	    
    if(twk(?CAT1?,?VAR1?) = ?ID1? and(twk(?CAT2?,?VAR2?) = ?ID2?))
	<
		if(twk(FacilityView,Rotated) = 0)
		<
			set(%YA,%ROTZ)
		>

	    if(twk(ControllerInput,Enabled) = 1)
		<
			if(abs(JoyX1) > 0.2)
			<
				:set(twk(FacilityView,Rotated),1)
				set(%DX,JoyX1)
			>
		>
		else
		<
		    if(TouchDown and(twk(FacilityView,Zooming)=0))
		    <
		    	float(%lastTX)
		    	if(TouchY > [@T+50] and(TouchY < [@B-295]))
		    	<
					:set(%lastTX,TouchX)
					:set(twk(FacilityView,Rotated),1)
					set(%DX,min(10,max(-10,[TouchX-%lastTX]*0.15)))

					set(%lastTX,TouchX)
				>
			>
		>
	    
	    add(%YA,%DX)
	    set(%DX,%DX*0.95)

	    if(abs(%DX) < 0.01)
	    <
	    	if(twk(Home,ForceTargetUpdate) = 1)
	    	<
	    		:set(twk(Home,FacilityCamBlend),1)
	    	>
	    	else
	    	<
	    		set(twk(Home,FacilityCamBlend),%BLEND)
	    	>
	    >
	    else
	    <
	    	:set(twk(Home,FacilityCamBlend),1)
	    >

	    // Calculate vertical length
	    set(%V,%DIST*sin(%ROTX))
	    // Calculate horizontal length
	    set(%H,%DIST*cos(%ROTX))
	    set(%XO,-%H*sin(%YA))
	    set(%YO,%H*cos(%YA))

	    set(gel3d.x,%POSX+%XO)
	    set(gel3d.y,%POSY+%YO)
	    set(gel3d.z,%V)
	    set(gel3d.rotx,%ROTX)
	    set(gel3d.rotz,-%YA)
	    M_BlendCameraToLocator:((twk(Home,FacilityCamBlend)),(twk(Home,FacilityCamBlend)),40) //FIXEDFOV
    >
EndM


Macro:(M_RotateAroundFacility,?POSX?,?POSY?,?DIST?,?ROTX?,?ROTZ?,?BLEND?)
	float(%YA,%H,%V,%XO,%YO,%DX)
    :set(%YA,?ROTZ?)

    if(TouchDown and(twk(FacilityView,Zooming)=0))
    <
    	float(%lastTX)
    	if(TouchY > [@T+50] and(TouchY < [@B-295]))
    	<
			:set(%lastTX,TouchX)
			set(%DX,min(10,max(-10,[TouchX-%lastTX]*0.15)))

			set(%lastTX,TouchX)
		>
    >
    
    add(%YA,%DX)
    set(%DX,%DX*0.95)
    if(abs(%DX) < 0.01)
    <
    	if(twk(Home,ForceTargetUpdate) = 1)
    	<
    		:set(twk(Home,FacilityCamBlend),1)
    	>
    	else
    	<
    		:set(twk(Home,FacilityCamBlend),?BLEND?)
    	>
    >
    else
    <
    	:set(twk(Home,FacilityCamBlend),1)
    >

    // Calculate vertical length
    set(%V,?DIST?*sin(?ROTX?))
    // Calculate horizontal length
    set(%H,?DIST?*cos(?ROTX?))
    set(%XO,-%H*sin(%YA))
    set(%YO,%H*cos(%YA))

    set(gel3d.x,?POSX?+%XO)
    set(gel3d.y,?POSY?+%YO)
    set(gel3d.z,%V)
    set(gel3d.rotx,?ROTX?)
    set(gel3d.rotz,-%YA)
EndM
Macro:(M_FacilityBuildingCam,?POSX?,?POSY?,?DIST?,?ROTX?,?ROTZ?,?CAT1?,?VAR1?,?ID1?,?CAT2?,?VAR2?,?ID2?,?CAT3?,?VAR3?,?ID3?,?DELAY?,?BLEND?)
	Locator:(?POSX?,?POSY?,?DIST?,?ROTX?,,?ROTZ?)
		if(twk(?CAT1?,?VAR1?) = ?ID1? and(twk(?CAT2?,?VAR2?) = ?ID2? and(twk(?CAT3?,?VAR3?) = ?ID3?)))
		<
			//:Delay(?DELAY?)

			M_RotateAroundFacility:(?POSX?,?POSY?,?DIST?,?ROTX?,?ROTZ?,?BLEND?)
			M_BlendCameraToLocator:((twk(Home,FacilityCamBlend)),(twk(Home,FacilityCamBlend)))
		>
EndM

Macro:(M_FacilityBuildingCamAlt,?POSX?,?POSY?,?DIST?,?ROTX?,?ROTZ?,?CAT1?,?VAR1?,?ID1?,?CAT2?,?VAR2?,?ID2?,?CAT3?,?VAR3?,?ID3?,?DELAY?,?BLEND?)
	if(twk(?CAT1?,?VAR1?) = ?ID1? and(twk(?CAT2?,?VAR2?) = ?ID2? and(twk(?CAT3?,?VAR3?) = ?ID3?)))
	<
		//:Delay(?DELAY?)

		if(twk(FacilityView,Rotated) = 0)
		<
			set(%POSX,?POSX?)
			set(%POSY,?POSY?)
			set(%ROTX,?ROTX?)
			set(%ROTZ,?ROTZ?)
			set(%BLEND,?BLEND?)
		>
		set(%DIST,?DIST?)
	>
EndM

Macro:(M_StadiumSectionCam,?POSX?,?POSY?,?DIST?,?ROTX?,?ROTZ?,?CAT1?,?VAR1?,?ID1?,?CAT2?,?VAR2?,?ID2?,?CAT3?,?VAR3?,?ID3?,?BLEND?)
	Locator:(?POSX?,?POSY?,?DIST?,?ROTX?,,?ROTZ?)
		if(twk(?CAT1?,?VAR1?) = ?ID1? and(twk(?CAT2?,?VAR2?) = ?ID2? and(twk(?CAT3?,?VAR3?) = ?ID3?)))
		<
			if(twk(Home,ForceTargetUpdate) = 1)
    		<
	    		set(twk(Home,FacilityCamBlend),1)
    		>
    		else
    		<
	    		set(twk(Home,FacilityCamBlend),?BLEND?)
    		>
			//:Delay(?DELAY?)
			M_BlendCameraToLocator:((twk(Home,FacilityCamBlend)),(twk(Home,FacilityCamBlend)),60) //FIXEDFOV
		>
EndM


Macro:(M_FacilityButton,?X?,?Y?,?IMAGE?,?TITLE?,?ID?,?VAR?,?FOCUS?)
	Rect:(?X?,?Y?,120,84)
		Handle(0.5,0.5)
		Click()
		<
			if(twk(Home,CurrentFacility) != ?ID?)
			<
				Post(UI_Swoosh)
			>
			:set(twk(Home,CurrentFacility),?ID?)
			:set(twk(Home,CameraMode),1)
			Post(home.btn_FacilityPressed)
		>
	{{
		Rect:()
			float(%scale)
			.set(gel.scale,0.82)
			.set(gel.alpha,0.5)
			if(twk(Home,CurrentFacility) = ?ID?)
			<
				set(%scale,1.2)
				:Delay(0.2)
				set(%scale,1)
			>
			else
			<
				set(%scale,0.82)
			>
			frlerp(gel.scale,%scale,0.15)
			if(twk(Home,CurrentFacility) = ?ID?)
			<
				frlerp(gel.alpha,1,0.15)
			>
			else
			<
				:set(gel.alpha,0.5)
			>
		{{
			// Icons
		
			Rect:()
			##P4N
				if((Player.weatherSeason = 3) and(twk(Facilities,Night) = 0))
				<
					set(gel.colour,#1E3146FFFFFFFFFF)
				>
				else
				<
					set(gel.colour,#FFFFFFFFFFFFFFFF)
				>
			##IA
				set(gel.colour,#FFFFFFFFFFFFFFFF)
			##*
			{
				Draw:(Icon_Home_Frame)
					Scale(0.5,0.5)
					Handle(0.5,0.5)

				Draw:(?IMAGE?,0,0)
					Handle(0.5,0.5)
					Scale(0.4,0.4)
			}

		}}
			Draw:(Fade_Right,35,2,150,25,,#20202090)
				Handle(0,0.5)
				Layer(Text)
				if(twk(Home,CurrentFacility) = ?ID?)
				<
					##P4N
					.if((Player.weatherSeason = 3) and(twk(Facilities,Night) = 0))
					<
						set(gel.colour,#FFFFFF90)
					>
					else
					<
						set(gel.colour,#20202090)
					>
					##*

					frlerp(gel.alpha,0.9,0.1)
				>
				else
				<
					:set(gel.alpha,0)
				>

			Tile:(Fade_Right,35,-11,150,2,,#FFFFFF00)
				Handle(0,0.5)
				Copies(1,2)
				Spacing(0,26)
				Layer(Text)
				if(twk(Home,CurrentFacility) = ?ID?)
				<
					##P4N
					.if((Player.weatherSeason = 3) and(twk(Facilities,Night) = 0))
					<
						set(gel.colour,#1E314600)
					>
					else
					<
						set(gel.colour,#FFFFFF00)
					>
					##*
					frlerp(gel.alpha,0.65,0.1)
				>
				else
				<
					:set(gel.alpha,0)
				>
				

		Clip:(30,-15,400,30)
		{
			M_Text:(?TITLE?,0,2,0,0,L,C,TextLoc,KNUL22,Upper,0,0,#00000000,NoItalics,#FFFFFF00,ref)
				M_Style:(Outline,#FFFFFF30FFFFFFFF)
				CharacterSpacing(1)
				if(twk(Home,CurrentFacility) = ?ID?)
				<
					##P4N
					.if((Player.weatherSeason = 3) and(twk(Facilities,Night) = 0))
					<
						set(gel.colour,#1E314600)
					>
					else
					<
						set(gel.colour,#FFFFFF00)
					>
					##*
					frlerp(gel.alpha,1,0.15)
					frlerp(gel.x,17,0.15)
				>
				else
				<
					:set(gel.alpha,0)
					:set(gel.x,0)
				>
		}	

	}}

	If:(?VAR?)
		Rect:(?X?,?Y?)
			Layer(Debug)
			LockLayer()
		   	set(gel.vis,twk(?VAR?Construction,Alert))
		{{
			Draw:(Icon_Alert_Exclamation_BG,17,-42,36,36,,#FFFFFF90FFFFFFFF)
			M_ExclamationAlert:(10,-49)
		}}
	EndIf

	Rect:(?X?,?Y?,120,74) ref:?TITLE?
		Handle(0.5,0.5)
		CTRLSelect(CTRLCircleSelected,-60,-37,-46,1)
		CTRLBlock(RIGHT)

		CTRLClick(?BTNOK?)
		<
			if(twk(Home,CurrentFacility) != ?ID?)
			<
				Post(UI_Swoosh)
				:set(twk(Home,CurrentFacility),?ID?)
				:set(twk(Home,CameraMode),1)
				Post(home.btn_FacilityPressed)
			>
			else
			<
				set(twk(Home,CameraMode),?FOCUS?)
				set(twk(FacilityView,Focused),?VAR?)
				Post(home.btn_Build,?VAR?)
				set(twk(Home,SpectatorMode),0)
				Post(UI_Select)
				Post(UI_Swoosh)
				set(twk(PlayerSaved,OpenedFacilityController),1)
			>
		>
		OnPost("home.ForceHighlight"::?VAR?)
		<
			CTRLSetSelected()
		>
		CTRLIsSelected()
		<
			set(twk(Home,CurrentHighlightFacility),?ID?)
		>

		float(%scale)
		if(twk(Home,CurrentFacility) = ?ID?)
		<
			set(%scale,1.45)
			:Delay(0.2)
			set(%scale,1.2)
		>
		else
		<
			set(%scale,1)
		>
		frlerp(gel.scale,%scale,0.15)
	{{
		Rect:() ref:CTRL_HighlightRef
		{
			M_SwitchButtonHint:(?ICONOK?,16,-35)
		}
			set(gel.vis,0)
			if(twk(Home,CurrentFacility) = ?ID?)
			<
				CTRLIsSelected()
				<
					set(gel.vis,1)
				>
				else
				<
					set(twk(Home,CurrentHighlightFacility),-1)
				>
			>
	}}
EndM



