//-----------------------------------------------------------------------------------------Cam Var
  M_SetCameraVariablesFromTweaks:()

//-----------------------------------------------------------------------------------------Camera
	Camera:((0,0,0),(0,0,0),66.461,(0.01,0.01,0.01),,@w,@h) ref:Camera
	//FIXEDFOV
		float(%tx,%ty)
	    M_PositionCamera:()
	{	
		Rect:()
			if(TouchDown)
			<
				:set(%tx,TouchX)
				:set(%ty,TouchY)
			>

		//Skydome
		M_SkyMacro:(0,0,100,0,0,0,1,1,1,Simple3D)
		
		//SkyHorizon
		M_HorizonMacro:(0,0,100,0,0,0,1,1,1)	

		//-------------------------------------------------------Facility Location Click area
		//STADIUM 
		M_FacilityLocationHotArea:(0,0,-850,35,35,7,0,0,0,1,?SHOW_FACILITY_SELECTION_COLLIDERS?)
		//FITNESS 
		M_FacilityLocationHotArea:(550,13800,-850,26,20,7,0,0,0,2,?SHOW_FACILITY_SELECTION_COLLIDERS?)
		//MEDICAL 
		M_FacilityLocationHotArea:(-12300,-7000,-850,25.5,26,7,0,0,0,3,?SHOW_FACILITY_SELECTION_COLLIDERS?)
		//SCOUT 
		M_FacilityLocationHotArea:(-11600,9700,-850,36,31,7,0,0,0,4,?SHOW_FACILITY_SELECTION_COLLIDERS?)
		//SHOP 
		M_FacilityLocationHotArea:(-200,-8700,-850,20,24,7,0,0,0,5,?SHOW_FACILITY_SELECTION_COLLIDERS?)
		//YOUTH 
		M_FacilityLocationHotArea:(11500,9200,-850,36,28,7,0,0,0,6,?SHOW_FACILITY_SELECTION_COLLIDERS?)
		//TRAINING 
		M_FacilityLocationHotArea:(9500,-1000,-850,26,33,7,0,0,0,7,?SHOW_FACILITY_SELECTION_COLLIDERS?)

			
		//--------------------Fitness
		M_FitnessCentre:(1)
	
		//---------------------Medical
		M_MedicalUnit:(1)
		
		//---------------------Scout
		M_ScoutsOffice:(1)

		//---------------------ClubShop
		M_ClubShop:(1)

		//---------------------Youth
		M_YouthAcademy:(1)

		//--------------------Training
		M_TrainingGround:(1)
			


		//-------------------------------------------------------Stadium and Facility Meshes
		//Stadium
		Locator:((0,0,0),(0,0,0),(1,1,1))
		{
			M_StadiumBaseHome:(1)
			M_3DPitchHome:(1)
			M_LowerStadiumHome:(Stadium,1,True)		
		}



		//-------------------------------------------------------Surrounding Enivironment
		M_NSMWorld:(1)
		
		M_FreestandingAds:(1)
		##IA
		M_TrafficLights:(1)
		##*


		//--------------------------------------------------------Construction stopwatch timers
		//Analogue_Match Timer
		Rect:() 
		{
			M_ConstructionTimer:(0,90,0,1.3,0.3,2,TrainingGround)	
			M_ConstructionTimer:(0,90,0,1.3,0.3,2,FitnessCentre)
			M_ConstructionTimer:(0,90,0,1.3,0.3,2,YouthAcademy)	
			M_ConstructionTimer:(0,90,0,1.3,0.3,2,ClubShop)
			M_ConstructionTimer:(0,90,0,1.3,0.3,2,MedicalUnit)
			M_ConstructionTimer:(0,90,0,1.3,0.3,2,ScoutsOffice)

			M_ConstructionTimer:(0,90,0,1.3,0.3,2,PitchStandN)	
			M_ConstructionTimer:(0,90,0,1.3,0.3,2,PitchStandE)	
			M_ConstructionTimer:(0,90,0,1.3,0.3,2,PitchStandS)	
			M_ConstructionTimer:(0,90,0,1.3,0.3,2,PitchStandW)	
			M_ConstructionTimer:(0,90,0,1.3,0.3,2,PitchCorners)	
		}

		//Digital Real world Timer
		Rect:()
		{
			M_ConstructionTimerDig:(0,90,0,1.6,0.3,2,TrainingGround)	
			M_ConstructionTimerDig:(0,90,0,1.6,0.3,2,FitnessCentre)
			M_ConstructionTimerDig:(0,90,0,1.6,0.3,2,YouthAcademy)	
			M_ConstructionTimerDig:(0,90,0,1.6,0.3,2,ClubShop)	
			M_ConstructionTimerDig:(0,90,0,1.6,0.3,2,MedicalUnit)	
			M_ConstructionTimerDig:(0,90,0,1.6,0.3,2,ScoutsOffice)

			M_ConstructionTimerDig:(0,90,0,1.6,0.3,2,PitchStandN)	
			M_ConstructionTimerDig:(0,90,0,1.6,0.3,2,PitchStandE)	
			M_ConstructionTimerDig:(0,90,0,1.6,0.3,2,PitchStandS)	
			M_ConstructionTimerDig:(0,90,0,1.6,0.3,2,PitchStandW)	
			M_ConstructionTimerDig:(0,90,0,1.6,0.3,2,PitchCorners)
		}	
	}


	Rect:()
		inittwk(twk(Home,ForceTargetUpdate),0)
		if(twk(Home,CameraMode) = 1)
		<
			set(twk(Home,ResetForceTargetUpdate),0)
		>
		set(twk(Home,ForceTargetUpdate),twk(Home,ResetForceTargetUpdate))


		//--------------------------------------------------------------------------------------

}



// Distance & Angle based fog
Rect:()
	if(shell(Facility) = "facility")
	<
		frlerp(gel.alpha,0,0.05)
	>
	else
	<
		:set(gel.alpha,1)
	>
{
	Draw:(Fade_Down,@L,@T,@W,550,,#FFFFFFFFFFFFFFFF)
		Layer(Debug)
		Handle(0,0)
		##IA
		if(twk(Facilities,Night)=1)
		<
			set(gel.colour,#603090FF)
		>
		##P4N
		if(twk(Facilities,Night)=1)
		<
			set(gel.colour,#603090FF)
		>
		elif(Player.weatherSeason = 0)
		<
			set(gel.colour,#B5F6FCFF)
		>
		elif(Player.weatherSeason = 2)
		<
			set(gel.colour,#FFD2BEFF)
		>
		elif(Player.weatherSeason = 3)
		<
			set(gel.colour,#FFFFFFFF)
		>
		else
		<
			set(gel.colour,#FFFFFFFF)
		>>>>
		##*
		float(%rate)
		set(%rate,[1-[[twk(Home,CamMinXA)-twk(Cam,RX)]/[twk(Home,CamMinXA)-twk(Home,CamMaxXA)]]]*[1-twk(FacilityView,Scale)])
		set(gel.h,lerp(300,0,[twk(Home,CamMinXA)-twk(Cam,RX)]/[twk(Home,CamMinXA)-twk(Home,CamMaxXA)]))
		set(gel.alpha,lerp(0,0.4,%rate))
}

// Camera control hints
Rect:(@R-195,@T+80,,,,#FFFFFF00)
	float(%maxWidth)
	Layer(Debug)
	if(twk(ControllerInput,Enabled)=1)
	<
		frlerp(gel.alpha,1,0.1)
	>
	else
	<
		frlerp(gel.alpha,0,0.1)
	>
{{
	// Rotate
	Rect:()
		set(gel.vis,not(twk(FacilityView,Focused) oneof("PitchCorners","Pitch","PitchStandW","PitchStandS","PitchStandE","PitchStandN")))
	{
		M_SwitchStickHint:(✃,37,0)
		M_Text:(home_camrotate,80,0,0,33,L,C,TextLoc,KNUL23,,1,0,#FFFFFFFF,NoItalics,#FFFFFF00,ref)
			M_Style:(Outline,#FFFFFF30FFFFFFFF)
			.set(%maxWidth,max(%maxWidth,%gfw))
			##P4N
			if((Player.weatherSeason = 3) and(twk(Facilities,Night) = 0))
			<
				set(gel.colour,#1E3146FFFFFFFFFF)
			>
			else
			<
				set(gel.colour,#FFFFFFFFFFFFFFFF)
			>
			##IA
				set(gel.colour,#FFFFFFFFFFFFFFFF)
			##*
	}

	// Zoom
	Rect:()
		set(gel.vis,twk(FacilityView,Focused) = "NONE")
	{
		M_SwitchButtonHint:(⛐,0,40)
		M_SwitchButtonHint:(⛑,37,40)
		M_Text:(home_camzoom,80,40,0,33,L,C,TextLoc,KNUL23,,1,0,#FFFFFFFF,NoItalics,#FFFFFF00,ref)
			M_Style:(Outline,#FFFFFF30FFFFFFFF)
			.set(%maxWidth,max(%maxWidth,%gfw))
			##P4N
			if((Player.weatherSeason = 3) and(twk(Facilities,Night) = 0))
			<
				set(gel.colour,#1E3146FFFFFFFFFF)
			>
			else
			<
				set(gel.colour,#FFFFFFFFFFFFFFFF)
			>
			##IA
				set(gel.colour,#FFFFFFFFFFFFFFFF)
			##*
	}
}}
	set(gel.x,@R-%maxWidth-124)


//-----------------------------------------------------------------------------------------Facility Selection Buttons
Rect:() ref:DissolveRoot

Rect:(@o,@T+[@z/2],@s,@H)
	Layer(Debug)
{{
	Rect:(0,100) $HIDE
		if((twk(Ftue,Enabled) = 0) or(twk(Ftue,Step) > 5))
		<
			set(gel.vis,twk(Home,CameraMode) = 1)
		>
	{{
		M_FacilityButton:(60,0,Icon_Home_Stadium,home_side_STADIUM,1,Pitch,10)
		M_FacilityButton:(60,85,Icon_Home_Training,home_side_TRAINING,7,TrainingGround,16)
		M_FacilityButton:(60,170,Icon_Home_Fitness,home_side_FITNESS,2,FitnessCentre,11)
		M_FacilityButton:(60,255,Icon_Home_Youth,home_side_YOUTH,6,YouthAcademy,15)
		M_FacilityButton:(60,340,Icon_Home_Medical,home_side_MEDICAL,3,MedicalUnit,12)
		M_FacilityButton:(60,425,Icon_Home_Scout,home_side_SCOUT,4,ScoutsOffice,13)
		M_FacilityButton:(60,510,Icon_Home_Shop,home_side_STORE,5,ClubShop,14)
	}}
}}

