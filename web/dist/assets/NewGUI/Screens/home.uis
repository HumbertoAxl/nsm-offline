//-------------CameraSetup
##IA
If:(?TALLCONTENT?)
	Rect:()
 		.set(twk(Home,CamMinDistance),[10000*0.85])
  		.set(twk(Home,CamMaxDistance),[15000*0.85])
Else
	Rect:()
 		.set(twk(Home,CamMinDistance),10000)
 		.set(twk(Home,CamMaxDistance),15000)
 		.set(twk(Home,CamMinXA),-30)
		.set(twk(Home,CamMaxXA),-60)	
EndIf
##P4N
.set(twk(Home,CamMinDistance),7800)
.set(twk(Home,CamMaxDistance),14200)
.set(twk(Home,CamMinXA),-20)
.set(twk(Home,CamMaxXA),-75)
##*

//---------------------------------------------------------------------------------------------SETUP
Rect:()
	inittwk(twk(Home,CurrentFacility),1)
	##P4
	.set(twk(FacilityView,Scale),0.5)
	##N
	.set(twk(FacilityView,Scale),0.75)
	##*
	.set(twk(Match,PlayerAtHome),1)
	Rearmable()
	.set(twk(Pitch,PitchPattern),twk(PlayerSaved,MowType))
	set(twk(Debug,STX),TouchX)

	.set(twk(Facilities,PitchLevelPreview),0)
	.set(twk(Facilities,PitchStandNLevelPreview),0)
	.set(twk(Facilities,PitchStandSLevelPreview),0)
	.set(twk(Facilities,PitchStandWLevelPreview),0)
	.set(twk(Facilities,PitchStandELevelPreview),0)
	.set(twk(Facilities,PitchCornersLevelPreview),0)
	.set(twk(Facilities,TrainingGroundLevelPreview),0)
	.set(twk(Facilities,MedicalUnitLevelPreview),0)
	.set(twk(Facilities,FitnessCentreLevelPreview),0)
	.set(twk(Facilities,ScoutsOfficeLevelPreview),0)
	.set(twk(Facilities,ClubShopLevelPreview),0)
	.set(twk(Facilities,YouthAcademyLevelPreview),0)

	set(twk(Facilities,PitchLevelVisible),max(twk(Facilities,PitchLevelPreview),twk(Facilities,PitchLevel)))
	set(twk(Facilities,PitchStandNLevelVisible),max(twk(Facilities,PitchStandNLevelPreview),twk(Facilities,PitchStandNLevel)))
	set(twk(Facilities,PitchStandSLevelVisible),max(twk(Facilities,PitchStandSLevelPreview),twk(Facilities,PitchStandSLevel)))
	set(twk(Facilities,PitchStandWLevelVisible),max(twk(Facilities,PitchStandWLevelPreview),twk(Facilities,PitchStandWLevel)))
	set(twk(Facilities,PitchStandELevelVisible),max(twk(Facilities,PitchStandELevelPreview),twk(Facilities,PitchStandELevel)))
	set(twk(Facilities,PitchCornersLevelVisible),max(twk(Facilities,PitchCornersLevelPreview),twk(Facilities,PitchCornersLevel)))
	set(twk(Facilities,TrainingGroundLevelVisible),max(twk(Facilities,TrainingGroundLevelPreview),twk(Facilities,TrainingGroundLevel)))
	set(twk(Facilities,MedicalUnitLevelVisible),max(twk(Facilities,MedicalUnitLevelPreview),twk(Facilities,MedicalUnitLevel)))
	set(twk(Facilities,FitnessCentreLevelVisible),max(twk(Facilities,FitnessCentreLevelPreview),twk(Facilities,FitnessCentreLevel)))
	set(twk(Facilities,ScoutsOfficeLevelVisible),max(twk(Facilities,ScoutsOfficeLevelPreview),twk(Facilities,ScoutsOfficeLevel)))
	set(twk(Facilities,ClubShopLevelVisible),max(twk(Facilities,ClubShopLevelPreview),twk(Facilities,ClubShopLevel)))
	set(twk(Facilities,YouthAcademyLevelVisible),max(twk(Facilities,YouthAcademyLevelPreview),twk(Facilities,YouthAcademyLevel)))

	if((twk(Facilities,PitchStandSLevelVisible)=6)or(twk(Facilities,PitchStandNLevelVisible)=6)or(twk(Facilities,PitchStandELevelVisible)=6)or(twk(Facilities,PitchStandWLevelVisible)=6))
	<
		set(twk(Facilities,PitchStandNLevelVisible),6)
		set(twk(Facilities,PitchStandSLevelVisible),6)
		set(twk(Facilities,PitchStandELevelVisible),6)
		set(twk(Facilities,PitchStandWLevelVisible),6)
		set(twk(Facilities,PitchCornersLevelVisible),6)
	>
	.set(twk(Match,StadTeamName),twk(Player,TeamName))
	inittwk(twk(Match,Team1Col),twk(Player,HomeShirtCol1))

	// Horizon
	.set(twk(Match,Horizon),0)
	{{
		//	Setup sponsor data for home screen stadium
		M_ChooseAllHoardingContents:()
		M_ChooseAllFreestandingContents:()
	}}

	//Seasons
	.if(Player.weatherSeason = 0)<
		set(twk(Facilities,Season),"_Spring")
	>
	.if(Player.weatherSeason = 1)<
		set(twk(Facilities,Season),"")
	>
	.if(Player.weatherSeason = 2)<
		set(twk(Facilities,Season),"_Autumn")
	>
	.if(Player.weatherSeason = 3)<
		set(twk(Facilities,Season),"_Winter")
	>

