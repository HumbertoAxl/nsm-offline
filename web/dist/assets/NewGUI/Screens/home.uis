//----------------------------------------------------------------------------------------Camera Positions

Rect:() 
   	M_CameraVariables:()
   	float(%screenStartTX,%screenStartTY,%screenTX,%screenTY)
   	if(TouchDown)
   	<
   		:set(%screenStartTX,TouchX)
   		:set(%screenStartTY,TouchY)
   		set(%screenTX,TouchX)
   		set(%screenTY,TouchY)
   	>
{
	//-------------------------------------------------------------Global Cam
	Locator:(0,0,0,0,0,0) ref:GlobalCamLocator
		if(twk(Home,CameraMode) = 1)
		<
			if(twk(Match,DebugCamera) = 2)
			<
				M_DebugCamControl:()
			>
			else
			<
				M_FreeCamControl:()
			>
			##IA
