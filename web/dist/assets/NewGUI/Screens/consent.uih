

Macro:(M_Consent_Panel)

	// AC: Placeholder fuse consent request form.
	Rect:(@L,@T,@W,@H)
		Layer(Text)
		LockLayer()
		Click()
		set(gel.vis,twk(Consent,RequestFuseConsent))
	{
		Draw:(White,0,0,@W,@H,,#000000E0)

		M_Text:("Fuse Consent Request",@C,@M,0,65,C,C,Text,KNUL23,,0,0,#FFFFFFFF,Italics,#FFFFFFFF,ref)

		M_Button:(@C,@B-245,400,60,Button_GreenSliced,,0,0,0,0,#FFFFFFFF,link,ref,"YES",0,3,C,C,Text,KNUL22,Upper,0,0,#00000000,NoItalics,#FFFFFFFF,textref)
			if(%clicked)
			<
				Post(Fuse_Consent_Given)
				set(twk(Consent,RequestFuseConsent),0)
			>

		M_Button:(@C,@B-145,400,60,Button_RedSliced,,0,0,0,0,#FFFFFFFF,link,ref,"NO",0,3,C,C,Text,KNUL22,Upper,0,0,#00000000,NoItalics,#FFFFFFFF,textref)
			if(%clicked)
			<
				Post(Fuse_Consent_Denied)
				set(twk(Consent,RequestFuseConsent),0)
			>
	}

EndM