Img:(contract_5,NewGUI/UI/Contract/contract_5.png) FORCE Volatile:Contract
Img:(contract_6,NewGUI/UI/Contract/contract_6.png) FORCE Volatile:Contract
Img:(contract_7,NewGUI/UI/Contract/contract_7.png) FORCE Volatile:Contract
Img:(contract_8,NewGUI/UI/Contract/contract_8.png) FORCE Volatile:Contract
