//---------------------------------------------------------------------------------------------SETUP
If:(?REALLYWIDECONTENT?)
	Define:(?PRODUCTSPACING?=@w/4.8)
Else
	Define:(?PRODUCTSPACING?=@w/3.5)
EndIf

// Audio
Rect:()
	set(twk(Audio,SuppressAllAmbient),1)
	
//----------------------------------------------------------------------------------------ANIMATIONS
//-----------------------------------------------------------------------------------------TEMPLATES
//--------------------------------------------------------------------------------------------MACROS
Import:(store_templates.uih)
//-------------------------------------------------------------------------------------------CONTENT

M_NewDialogOPEN:(loc(store_HEADER),store)
	Click()
	<
		set(twk(Header,StoreState),0)
	>
// ----------------
// ----------------

	Rect:(@L,@T,@W,@H)
		Click()
		<
			set(twk(Store,SelectedUId),"")
		>

	// Tabs
	Rect:(0,0,@W,40)
		float(%tabx)
		set(%tabx,30)
		set(gel.vis,twk(Ftue,Enabled) = 0)
	{{
		Draw:(Tab_BG50,@f,-2,@w,58)
		M_Tab:(30,0,220,50,(twk(StoreLayout,Bux_TabName)),1,Store,CurrentTab,,5)
			if(twk(Store,ShowBuxTab) = 1)
			<
				set(gel.vis,1)
				set(gel.x,%tabx)
				set(%tabx,[%tabx+220])
			>
			else
			<
				set(gel.vis,0)
			>
		M_Tab:(250,0,220,50,(twk(StoreLayout,CoachingCards_TabName)),2,Store,CurrentTab,,5)
			if(twk(Store,ShowCoachingCardsTab) = 1)
			<
				set(gel.vis,1)
				set(gel.x,%tabx)
				set(%tabx,[%tabx+220])
			>
			else
			<
				set(gel.vis,0)
			>
		M_Tab:(470,0,220,50,(twk(StoreLayout,ManagerCards_TabName)),3,Store,CurrentTab,,5)
			if(twk(Store,ShowManagerCardsTab) = 1)
			<
				set(gel.vis,1)
				set(gel.x,%tabx)
				set(%tabx,[%tabx+220])
			>
			else
			<
				set(gel.vis,0)
			>
		M_Tab:(690,0,220,50,(twk(StoreLayout,StaffCards_TabName)),4,Store,CurrentTab,,5)
			if(twk(Store,ShowStaffCardsTab) = 1)
			<
				set(gel.vis,1)
				set(gel.x,%tabx)
				set(%tabx,[%tabx+220])
			>
			else
			<
				set(gel.vis,0)
			>
		M_Tab:(910,0,220,50,(twk(StoreLayout,PlayerPack_TabName)),5,Store,CurrentTab,,5)
			if(twk(Store,ShowPlayerPacksTab) = 1)
			<
				set(gel.vis,1)
				set(gel.x,%tabx)
				set(%tabx,[%tabx+220])
			>
			else
			<
				set(gel.vis,0)
			>
	}}

	// Tabs
	Rect:(0,0,@W,40)
		float(%tabx)
		set(%tabx,30)
		set(gel.vis,twk(Ftue,Enabled) = 1)
	{{
		Draw:(Tab_BG50,@f,-2,@w,58)
		M_Tab:(30,0,220,50,store_TAB_BUX,1,Store,CurrentTab,,5)
		// M_Tab:(250,0,220,50,store_TAB_COACHING,2,Store,CurrentTab,,5)
		// M_Tab:(470,0,220,50,store_TAB_MANAGER,3,Store,CurrentTab,,5)
		// M_Tab:(690,0,220,50,store_TAB_STAFF,4,Store,CurrentTab,,5)
		M_Tab:(250,0,220,50,store_TAB_PACKS,5,Store,CurrentTab,,5)
	}}

	//Swipe SwipePanels
	Rect:(0,40,@W,@H-40) ref:SwipePanels
		Layer(AboveText2)
		if(twk(Store,CurrentTab) = 1)
		<
			SwipePanel(PageSystem,BlockScroll,PageSystem,BlockScrollVel,Store,ScrollX,Store,ScrollXVel) ref:SwipePanelStore
		>
		if(twk(Store,CurrentTab) = 2)
		<
			SwipePanel(PageSystem,BlockScroll,PageSystem,BlockScrollVel,Store,PlayerCardScrollX,Store,PlayerCardScrollXVel) ref:SwipePanelPlayerStore
		>
		if(twk(Store,CurrentTab) = 3)
		<
			SwipePanel(PageSystem,BlockScroll,PageSystem,BlockScrollVel,Store,ManagerCardScrollX,Store,ManagerCardScrollXVel) ref:SwipePanelManagerStore
		>
		if(twk(Store,CurrentTab) = 4)
		<
			SwipePanel(PageSystem,BlockScroll,PageSystem,BlockScrollVel,Store,StaffCardScrollX,Store,StaffCardScrollXVel) ref:SwipePanelStaffStore
		>
		if((twk(Store,CurrentTab) = 5) and(twk(Ftue,Enabled) = 0))
		<
			SwipePanel(PageSystem,BlockScroll,PageSystem,BlockScrollVel,Store,PlayerPackScrollX,Store,PlayerPackScrollXVel) ref:SwipePanelPlayerPackStore
		>

	//-----------------------------------------------------------------------------------------PAGE 1: Bux 

	Dissolve:(0,50,@W,@H-45) ref:BuxTab
		M_FadingTabContent:(Store,CurrentTab,1)
	{{	
		M_Text:("Store_NoProductsMessage",0,@M-20,@W,0,C,C,TextLoc,KNUL28,,0,0,#00000000,NoItalics,#252525FFFFFFFFFF,Message)

		Rect:(@L,@T,@W,@H)
		{{
			Rect:(30,30+[@z/2],@W-60,@H-30-[@z/2])
			{{
				Rect:(0,0,@W,@H) ref:Container
					.set(twk(Store,ScrollX),0)
					ChildrenOffset(?PRODUCTSPACING?,0,False) ref:ChildrenOffset
					SnappingListX(Store,ScrollX,@W,Store,ScrollXVel,SwipePanels,SwipePanelStore,15,0.1,true) ref:ScrollingListBux
				{
				}
				M_ScrollIndicatorAltH:(@B-5,@W,Store,ScrollX,Container,ScrollingListBux,SwipePanels,SwipePanelStore)
			}}
		}}
	}}

	//-----------------------------------------------------------------------------------------PAGE 2: Player Cards 

	Dissolve:(0,50,@W,@H-45) $HIDE ref:CoachingCardsTab
		M_FadingTabContent:(Store,CurrentTab,2)
	{{	
		M_Text:("Store_NoProductsMessage",0,@M-20,@W,0,C,C,TextLoc,KNUL28,,0,0,#00000000,NoItalics,#252525FFFFFFFFFF,Message)

		Rect:(@L,@T,@W,@H)
		{{
			Rect:(30,30+[@z/2],@W-60,@H-30-[@z/2])
			{{
				Rect:(0,0,@W,@H) ref:Container 
					.set(twk(Store,PlayerCardScrollX),0)
					ChildrenOffset(?PRODUCTSPACING?,0,False) ref:ChildrenOffset
					SnappingListX(Store,PlayerCardScrollX,@W,Store,PlayerCardScrollXVel,SwipePanels,SwipePanelPlayerStore,15,0.1,true) ref:ScrollingListPlayerCards
				{
				}
				M_ScrollIndicatorAltH:(@B-5,@W,Store,PlayerCardScrollX,Container,ScrollingListPlayerCards,SwipePanels,SwipePanelPlayerStore)
			}}
		}}
	}}

	//-----------------------------------------------------------------------------------------PAGE 3: Manager Cards 

	Dissolve:(0,50,@W,@H-45) $HIDE ref:ManagerCardsTab
		M_FadingTabContent:(Store,CurrentTab,3)
	{{	
		M_Text:("Store_NoProductsMessage",0,@M-20,@W,0,C,C,TextLoc,KNUL28,,0,0,#00000000,NoItalics,#252525FFFFFFFFFF,Message)

		Rect:(@L,@T,@W,@H)
		{{
			Rect:(30,30+[@z/2],@W-60,@H-30-[@z/2])
			{{
				Rect:(0,0,@W,@H) ref:Container
					.set(twk(Store,ManagerCardScrollX),0)
					ChildrenOffset(?PRODUCTSPACING?,0,False) ref:ChildrenOffset
					SnappingListX(Store,ManagerCardScrollX,@W,Store,ManagerCardScrollXVel,SwipePanels,SwipePanelManagerStore,15,0.1,true) ref:ScrollingListManagerCards
				{
				}
				M_ScrollIndicatorAltH:(@B-5,@W,Store,ManagerCardScrollX,Container,ScrollingListManagerCards,SwipePanels,SwipePanelManagerStore)
			}}
		}}
	}}

	//-----------------------------------------------------------------------------------------PAGE 4: Staff Cards 

	Dissolve:(0,50,@W,@H-45) $HIDE ref:StaffCardsTab
		M_FadingTabContent:(Store,CurrentTab,4)
	{{	
		M_Text:("Store_NoProductsMessage",0,@M-20,@W,0,C,C,TextLoc,KNUL28,,0,0,#00000000,NoItalics,#252525FFFFFFFFFF,Message)

		Rect:(@L,@T,@W,@H)
		{{
			Rect:(30,30+[@z/2],@W-60,@H-30-[@z/2])
			{{
				Rect:(0,0,@W,@H) ref:Container
					.set(twk(Store,StaffCardScrollX),0)
					ChildrenOffset(?PRODUCTSPACING?,0,False) ref:ChildrenOffset
					SnappingListX(Store,StaffCardScrollX,@W,Store,StaffCardScrollXVel,SwipePanels,SwipePanelStaffStore,15,0.1,true) ref:ScrollingListStaffCards
				{
				}
				M_ScrollIndicatorAltH:(@B-5,@W,Store,StaffCardScrollX,Container,ScrollingListStaffCards,SwipePanels,SwipePanelStaffStore)
			}}
		}}
	}}

	//-----------------------------------------------------------------------------------------PAGE 5: Player Packs 

	Dissolve:(0,50,@W,@H-45) $HIDE ref:PlayerPackTab
		M_FadingTabContent:(Store,CurrentTab,5)
	{{	
		M_Text:("Store_NoProductsMessage",0,@M-20,@W,0,C,C,TextLoc,KNUL28,,0,0,#00000000,NoItalics,#252525FFFFFFFFFF,Message)

		Rect:(@L,@T,@W,@H)
		{{
			Rect:(30,30+[@z/2],@W-60,@H-30-[@z/2])
			{{
				Rect:(0,0,@W,@H) ref:Container
					.set(twk(Store,PlayerPackScrollX),0)
					ChildrenOffset(?PRODUCTSPACING?,0,False) ref:ChildrenOffset
					SnappingListX(Store,PlayerPackScrollX,@W,Store,PlayerPackScrollXVel,SwipePanels,SwipePanelPlayerPackStore,15,0.1,true) ref:ScrollingListPlayerPack
				{
				}
				M_ScrollIndicatorAltH:(@B-5,@W,Store,PlayerPackScrollX,Container,ScrollingListPlayerPack,SwipePanels,SwipePanelPlayerPackStore)
			}}
		}}
	}}

// ----------------

M_NewDialogCLOSE:()