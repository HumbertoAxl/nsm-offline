//----------------------------------------------------------------------------------LOCAL IMAGE DEFS
Rect:()
	set(gel.vis,twk(Negotiate,InProgress) = 0 and(twk(ProfileStaff,IsPotentialHire) = 0))
{

	// Status Info
	Rect:(307,275)
	{{
		Rect:()
			set(gel.vis,twk(ProfileStaff,StatusInfo) != "")
		{
			Draw:(Icon_StatusAlert,0,0,45,45,,#DD1010FF)
			M_Text:(,58,23,755+@y,0,L,C,TextBox,KNUL24,,0,0,#00000000,NoItalics,#252525FF,ref,ProfileStaff,StatusInfo)
		}
	}}


	// TABS
	Rect:(0,350,@W,215+@z)
		CTRLClick(LT,false)
		<
			:set(twk(ProfileStaff,CurrentTab),max(1,twk(ProfileStaff,CurrentTab)-1))
		>
	{{
		Draw:(Tab_BG50,@f,-2,@w,58)
		M_Tab:(30,0,220,50,profile_player_CONCERNS,1,ProfileStaff,CurrentTab,,5)
		M_Tab:(250,0,220,50,profile_player_ACTIONS,2,ProfileStaff,CurrentTab,,5)
			set(gel.vis,twk(ProfileStaff,ActionsTabEnabled) = 1)

		M_SwitchTabs:(1,ProfileStaff,0,9999,0,9999)
			set(gel.vis,twk(ProfileStaff,ActionsTabEnabled) = 0)

		M_SwitchTabs:(2,ProfileStaff,11,10,462,10)
			set(gel.vis,twk(ProfileStaff,ActionsTabEnabled) = 1)
	}}


	// TABS CONTENT
	Rect:(0,401+[@z/2],@W,235)
	{{
		// TAB 1 CONCERNS
		Dissolve:()
			if(twk(ProfileStaff,CurrentTab) = 1)
			<
				:set(gel.vis,1)
				frlerp(gel.alpha,1,0.25)
			>
			else
			<
				frlerp(gel.alpha,0,0.25)
				if(gel.alpha < 0.01)
				<
					:set(gel.vis,0)
				>
			>
		{
			Rect:(0,0,[@W/4],@H)
			{{
				M_Text:(profile_player_CONCERNS_MANAGEMENT,@C,25,0,0,C,C,TextLoc,KNUL20,Upper,0,0,#00000000,NoItalics,#505050FF,ref)
				M_ConcernWheel:(@C-58,80,ProfileStaff,ManagementConcernsVal,Icon_Concern_Management)
				M_Text:("-",0,53,@W,0,C,C,TextBox,KNUL23,,1,0,#252525FF,NoItalics,#252525FF,ref,ProfileStaff,ManagementConcerns)
					LineSpacing(0.8)
				Draw:(White,@R,15,1,@H-30,,#FFFFFF80)
			}}

			Rect:(@W*0.25,0,[@W/4],@H)
			{{
				M_Text:(profile_player_CONCERNS_DEVELOPMENT,@C,25,0,0,C,C,TextLoc,KNUL20,Upper,0,0,#00000000,NoItalics,#505050FF,ref)
				M_ConcernWheel:(@C-58,80,ProfileStaff,DevelopmentConcernsVal,Icon_Concern_Development)
				M_Text:("-",0,53,@W,0,C,C,TextBox,KNUL23,,1,0,#252525FF,NoItalics,#252525FF,ref,ProfileStaff,DevelopmentConcerns)
					LineSpacing(0.8)
				Draw:(White,@R,15,1,@H-30,,#FFFFFF80)
			}}
			Rect:(@W*0.5,0,[@W/4],@H)
			{{
				M_Text:(profile_player_CONCERNS_CONTRACT,@C,25,0,0,C,C,TextLoc,KNUL20,Upper,0,0,#00000000,NoItalics,#505050FF,ref)
				M_ConcernWheel:(@C-58,80,ProfileStaff,ContractConcernsVal,Icon_Concern_Contract)
				M_Text:("-",0,53,@W,0,C,C,TextBox,KNUL23,,1,0,#252525FF,NoItalics,#252525FF,ref,ProfileStaff,ContractConcerns)
					LineSpacing(0.8)
				Draw:(White,@R,15,1,@H-30,,#FFFFFF80)
			}}
			Rect:(@W*0.75,0,[@W/4],@H)
			{{
				M_Text:(profile_player_CONCERNS_FORM,@C,25,0,0,C,C,TextLoc,KNUL20,Upper,0,0,#00000000,NoItalics,#505050FF,ref)
				M_ConcernWheel:(@C-58,80,ProfileStaff,FormConcernsVal,Icon_Concern_TeamForm)
				M_Text:("-",0,53,@W,0,C,C,TextBox,KNUL23,,1,0,#252525FF,NoItalics,#252525FF,ref,ProfileStaff,FormConcerns)
					LineSpacing(0.8)
			}}
		}


		// TAB 2 ACTIONS
		Dissolve:()
			if(twk(ProfileStaff,CurrentTab) = 2)
			<
				:set(gel.vis,1)
				frlerp(gel.alpha,1,0.25)
			>
			else
			<
				frlerp(gel.alpha,0,0.25)
				if(gel.alpha < 0.01)
				<
					:set(gel.vis,0)
				>
			>
		{
			// Contracts (non-iap)
			Rect:(@C-[@W/4],5,[@W/2],@H)
				set(gel.vis,not(twk(ProfileStaff,IsIAP)))
			{{
				Tile:(White,0,15,@W,1,,#0000001A)
					Copies(1,3)
					Spacing(0,50)
				
				M_Text:(profile_NEWCONTRACT,0,40,0,0,L,C,TextLoc,KNUL25,,0,0,#00000000,NoItalics,#505050FF,ref)

				M_Button:(@R-190,45,80,40,Button_SilverSliced,,0,0,0,0,#FFFFFFFF,profilestaff.btn_NegotiationSub,StaffNegotiationSubButton,"-",0,0,C,C,Text,KNUL25,Upper,1,0,#252525FF,NoItalics,#252525FF,textref)
					M_CTRLButtonExtra:(?BTNOK?,true,CTRLButtonSelected,3,3,6,6)
					set(%disabled,twk(Negotiate,Increment) = 40)
					CTRLBlock(LEFT)
					CTRLPress(UP)
					<
						CTRLSetSelected(StaffPrevButton)
						Post(CTRLNavigate)
					>

				M_Button:(@R-90,45,80,40,Button_SilverSliced,,10,-5,64,64,#FFFFFFFF,profilestaff.btn_NegotiationAdd,StaffNegotiationAddButton,"+",0,0,C,C,Text,KNUL25,Upper,1,0,#252525FF,NoItalics,#252525FF,textref)
					M_CTRLButtonExtra:(?BTNOK?,true,CTRLButtonSelected,3,3,6,6)
					set(%disabled,twk(Negotiate,Increment) = 100)
					CTRLBlock(RIGHT)

				M_Text:(,0,40,@W,0,R,C,Text,KNUL25,,1,0,#252525FF,NoItalics,#252525FF,ref,Negotiate,Increment,DoLTR)
				M_Text:(profile_WAGEDEMANDS,0,90,0,0,L,C,TextLoc,KNUL25,,0,0,#00000000,NoItalics,#505050FF,ref)
				M_Text:(,0,90,@W,0,R,C,Text,KNUL25,,1,0,#252525FF,NoItalics,#252525FF,ref)
					set(gel.text,"★ " :: commasfmt(twk(Negotiate,RawDemands)))

				Rect:()
					strvar(%BUTTONTEXT)
					init(%BUTTONTEXT,"")
				{
					M_Button:(@C-130,177,220,85,Button_RedSliced,Blank,20,2,50,50,#252525FF,profilestaff.btn_Fire,StaffFireButton,(%BUTTONTEXT),0,3,C,C,TextBox,KNUL22,Upper,0,0,#00000000,NoItalics,#FFFFFFFF,textref)
						M_CTRLButtonExtra:(?BTNOK?,true,CTRLButtonSelected,3,3,6,6)
						CTRLBlock(LEFT)
						CTRLPress(UP)
						<
							CTRLSetSelected(StaffNegotiationSubButton)
							Post(CTRLNavigate)
						>
						if(twk(ProfileStaff,Type) oneof(0,1,2))
						<
							:set(%BUTTONTEXT,loc(profile_staff_FIRE_COACH))
						>
						elif(twk(ProfileStaff,Type) = 3)
						<
							:set(%BUTTONTEXT,loc(profile_staff_FIRE_SCOUT))
						>
						elif(twk(ProfileStaff,Type) = 4)
						<
							:set(%BUTTONTEXT,loc(profile_staff_FIRE_PHYSIO))
						>>>
				}

				M_Button:(@C+130,177,220,85,Button_GreenSliced,Blank,20,2,50,50,#252525FF,profilestaff.btn_Negotiate,StaffRenewButton,loc(profile_RENEWOFFER),0,3,C,C,TextBox,KNUL22,Upper,0,0,#00000000,NoItalics,#FFFFFFFF,textref)
					M_CTRLButtonExtra:(?BTNOK?,true,CTRLButtonSelected,3,3,6,6)
					CTRLBlock(RIGHT)
			}}

			Rect:(@C-[@W/4],5,[@W/2],@H)
				set(gel.vis,twk(ProfileStaff,IsIAP))
			{{
			
				Rect:()
					strvar(%BUTTONTEXT)
					init(%BUTTONTEXT,"")
				{
					M_Button:(@C,177,220,85,Button_RedSliced,Blank,20,2,50,50,#252525FF,profilestaff.btn_Fire,StaffOfferButton,(%BUTTONTEXT),0,3,C,C,TextBox,KNUL22,Upper,0,0,#00000000,NoItalics,#FFFFFFFF,textref)
						M_CTRLButtonExtra:(?BTNOK?,true,CTRLButtonSelected,3,3,6,6)
						CTRLBlock(LEFT,RIGHT)
						if(twk(ProfileStaff,Type) oneof(0,1,2))
						<
							:set(%BUTTONTEXT,loc(profile_staff_FIRE_COACH))
						>
						elif(twk(ProfileStaff,Type) = 3)
						<
							:set(%BUTTONTEXT,loc(profile_staff_FIRE_SCOUT))
						>
						elif(twk(ProfileStaff,Type) = 4)
						<
							:set(%BUTTONTEXT,loc(profile_staff_FIRE_PHYSIO))
						>>>
						CTRLPress(UP)
						<
							CTRLSetSelected(StaffPrevButton)
							Post(CTRLNavigate)
						>
				}
			}}
		}
	}}
}