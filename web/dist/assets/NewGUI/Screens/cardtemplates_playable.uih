//----------------------------------------------------------------------------------------ANIMATIONS

// Sunburst Burst 
Animation:(2000,Loop) ref:Burst
{
	During:(0,2000,>)
    {
        Draw:(Burst,0,0,200,200,0,#FFFFFF10)
        	Additive()
            Handle(0.5,0.5)
            TweenAngle(-360)

        Draw:(Burst,0,0,200,200,0,#FFFFFF20)
            Handle(0.5,0.5)
            TweenAngle(360)
    }
}

//--------------------------------------------------------------------------------------------MACROS

//Back Tip
Macro:(M_BackTip,?TEXT?)
	// English language
	M_Text:(?TEXT?,-@C+5,-15,@W-8,0,C,C,TextBox,KNUL18,,1,0,#50505080,Italics,#505050FF,ref)
		.set(gel.vis,TPlayerClass.languageId = 0)
		CharacterSpacing(1.5)
		LineSpacing(0.85)

	// Smaller text for all other languages
	M_Text:(?TEXT?,-@C+5,-15,@W-8,0,C,C,TextBox,KNUL17,,1,0,#50505080,Italics,#505050FF,ref)
		.set(gel.vis,TPlayerClass.languageId > 0)
		CharacterSpacing(1.5)
		LineSpacing(0.85)
EndM

//---------------------------------------------------------------------------------------------------------
//--------------------------------------------------------------------------------------------MANAGER CARDS
//---------------------------------------------------------------------------------------------------------

//Manager Card Macro
Macro:(M_ManagerCardData,?CARDTYPE?,?IMAGE?,?IMAGEX?,?IMAGEY?,?IMAGESCALE?)
	Rect:() ref:DataRoot
		float(%BoostAmount,%EnergyEffect)
	{
		Text:() $HIDE ref:Boost
			.set(%BoostAmount,gel.text)

		//Card Reflection
		Draw:(Card_Reflection,0,88,122,,,#FFFFFF00FFFFFFFF)
			Handle(0.5,0.5)
			if(not(%dragging))
			<
				frlerp(gel.alpha,0.2,0.05)
			>
			else
			<
				:set(gel.alpha,0)
			>

		//Card Name 
		M_Text:(,-[@W/2],49,@W,0,C,C,Text,KNUL17,Upper,0,0,#00000000,NoItalics,#252525FF,Name)
			M_Style:(Outline,#25252520)


		//For cards other than NRG, sets the energy it gives you
		Text:() $HIDE ref:Energy
		
		//Card Image
		UseShader:(Region)
			SetUniform4F(region,gel.gx-[53*bakedTrans.ix],gel.gy-[71*bakedTrans.jy],[106*bakedTrans.ix],[110*bakedTrans.jy])
		{
			//Draw:(White,-@W/2,-@H/2,@W,@H,,#B5C4CCFF)
			AnimInstance:(0,-10,Burst)
			
			If:(?CARDTYPE?="NRG")
				Draw:(LightGlow,-100,-110,200,200)
					if(%BoostAmount<=25)
					<
						.set(gel.colour,#2CC36580FFFFFFFF)
					>
					elif(%BoostAmount<=50)
					<
						.set(gel.colour,#FFFF7480FFFFFFFF)
					>
					elif(%BoostAmount<=75)
					<
						.set(gel.colour,#74C3FF80FFFFFFFF)
					>
					elif(%BoostAmount<=100)
					<
						.set(gel.colour,#FFFF7480FFFFFFFF)
					>>>>
			EndIf
			
			Draw:(?IMAGE?,?IMAGEX?,?IMAGEY?)
				.set(gel.scale,?IMAGESCALE?)
				Handle(0.5,0.5)

			//Draw:(?IMAGE?,-2,-2,110,114)
			//	Handle(0.5,0.5)


			If:(?CARDTYPE?="NRG")
				if(%BoostAmount<=25)
				<
					:set(gel.img,"Card_NRG_Green")
				>
				elif(%BoostAmount<=50)
				<
					:set(gel.img,"Card_NRG_Gold")
				>
				elif(%BoostAmount<=75)
				<
					:set(gel.img,"Card_NRG_Blue")
				>
				elif(%BoostAmount<=100)
				<
					:set(gel.img,"Card_NRG_Black")
				>>>>
			EndIf

			Rect:()
				set((gel.vis,?CARDTYPE?) oneof("PHYSIO","APPEAL","CONTRACT"))
			{
				Draw:(Glow_Quarter,-20,0,74,74,90)
			}
		}

		//Card boost (not shown on NRG, Meeting or Teamtalk)
		Rect:() ref:BoostSign
		{
			Rect:()
				strvar(%boostsign)
				.set(gel.vis,not(?CARDTYPE? oneof("NRG","MEETING","TEAMTALK")))
			{
				Text:() $HIDE ref:BoostSign
					set(%boostsign,gel.text)
				M_Text:(,46,-53,0,0,R,C,Text,KNUL45,,0,0,#00000000,NoItalics,#252525FF,ref)
					M_Style:(Outline,#25252550)
					CharacterSpacing(1.5)
					.set(gel.scale,0.5)
					.set(gel.text,LTR(%boostsign :: fmt(%BoostAmount,X)))
			}
		}

		// Energy Effect for cards other than NRG
		Rect:() ref:EnergyEffect
		{
			Rect:()
				set(gel.vis,?CARDTYPE?!="NRG")
			{
				// Energy Cost
				Rect:(-47,58,100,12)
				{{
					Draw:(White,0,0,@W,@H,,#B5C4CCFFFFFFFFFF)
					Draw:(White,0,0,@W,@H,,#42BB00FFFFFFFFFF)
						.set(gel.scalex,abs(%EnergyEffect)/100)
						if(%EnergyEffect >= 0)
				        <
				        	set(gel.colour,#42BB00FFFFFFFFFF)
				        >
				        else
				        <
				           	set(gel.colour,#DD1010FFFFFFFFFF)
				        >
					Draw:(White,0,@M,@W,[@H/2],,#00000015FFFFFFFF)
					Draw:(White,25,0,1,@H,,#FFFFFFFFFFFFFFFF)
					Draw:(White,50,0,1,@H,,#FFFFFFFFFFFFFFFF)
					Draw:(White,75,0,1,@H,,#FFFFFFFFFFFFFFFF)
				}}	
				
				Draw:(Circle_50,-55,55,15,15,,#FFFFFFFFFFFFFFFF)
				Rect:()
				{
					Draw:(Card_Energy,-58,55,18,,,#20CC18FFFFFFFFFF)
				}
					:set(gel.vis,%EnergyEffect>0)

				Rect:()
				{
					Draw:(Card_Energy,-58,55,18,,,#B5C4CCFFFFFFFFFF)
				}
					:set(gel.vis,%EnergyEffect=0)

				Rect:()
				{
					Draw:(Card_Energy,-58,55,18,,,#DD1010FFFFFFFFFF)
				}	
					:set(gel.vis,%EnergyEffect<0)
			}

			// Energy Effect for NRG cards
			Rect:()
				set((gel.vis,?CARDTYPE?) oneof("NRG"))
			{
				// Energy Cost
				Rect:(-47,58,100,12)
				{{
					Draw:(White,0,0,@W,@H,,#B5C4CCFFFFFFFFFF)
					Draw:(White,0,0,@W,@H,,#42BB00FFFFFFFFFF)
						.set(gel.scalex,%BoostAmount/100)
				
					Draw:(White,0,@M,@W,[@H/2],,#00000015FFFFFFFF)
					Draw:(White,25,0,1,@H,,#FFFFFFFFFFFFFFFF)
					Draw:(White,50,0,1,@H,,#FFFFFFFFFFFFFFFF)
					Draw:(White,75,0,1,@H,,#FFFFFFFFFFFFFFFF)
				}}	
					Draw:(Circle_50,-55,55,15,15,,#FFFFFFFFFFFFFFFF)
					Draw:(Card_Energy,-58,55,18,,,#20CC18FFFFFFFFFF)
			}
		}
	}
EndM

