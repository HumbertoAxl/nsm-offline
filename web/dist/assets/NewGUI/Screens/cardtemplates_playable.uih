//---------------------------------------------------------------------------------------------------------
//-------------------------------------------------------------------------------------------COACHING CARDS
//---------------------------------------------------------------------------------------------------------

//Coaching Card Macro 
Macro:(M_CoachingCardData,?CARDTYPE?,?IMAGE?,?IMAGEX?,?IMAGEY?,?IMAGESCALE?,?COL?)
	Rect:() ref:DataRoot
		float(%BoostAmount,%EnergyEffect)
	{
		//Card Reflection
		Draw:(Card_Reflection,0,88,122,,,#FFFFFF00FFFFFFFF)
			Handle(0.5,0.5)
			if(not(%dragging))
			<
				frlerp(gel.alpha,0.2,0.05)
			>
			else
			<
				:set(gel.alpha,0)
			>

		Draw:(PlayableCard_Base,-@W/2,-@H/2,@W,@H)

		//Card Name 
		M_Text:(,-[@W/2],49,@W,0,C,C,Text,KNUL17,Upper,0,0,#00000000,NoItalics,#252525FF,Name)
			M_Style:(Outline,#25252520)
		
		//Card Image
		UseShader:(Region)
			SetUniform4F(region,gel.gx-[53*bakedTrans.ix],gel.gy-[71*bakedTrans.jy],[106*bakedTrans.ix],[110*bakedTrans.jy])
		{
			AnimInstance:(0,-10,Burst)
			Draw:(LightGlow,-100,-110,200,200,,?COL?FFFFFFFF)
			Draw:(?IMAGE?,?IMAGEX?,?IMAGEY?)
				.set(gel.scale,?IMAGESCALE?)
				Handle(0.5,0.5)
			
			Rect:()
				set(gel.vis,?CARDTYPE?!="AddSide")
			{
				Draw:(Card_Star5,-8,-83,74,74) ref:BlankStar
			}
		}
		
		Rect:() ref:BoostContainer
		{
			If:(?CARDTYPE?="AddSide")
				Draw:(Glow_Quarter,-20,0,74,74,90)
				M_Text:(LCR,46,-53,0,0,R,C,Text,KNUL45,,0,0,#00000000,NoItalics,#252525FF,Boost)
					M_Style:(Outline,#25252550)
					CharacterSpacing(1.5)
					.set(gel.scale,0.5)
					Text:() $HIDE ref:BoostSign
					Draw:(Card_Star0,-1,-75,60,60) $HIDE ref:Quality
			Else
				Draw:(Card_Star0,-1,-75,60,60) ref:Quality

				//Card Boost
				Text:() $HIDE ref:BoostSign
				Text:() $HIDE ref:Boost
			EndIf
		}

		Text:() $HIDE ref:Energy

		// Energy Effect
		Rect:() ref:EnergyEffect
		{
			// Energy Cost
			Rect:(-47,58,100,12)
			{{
				Draw:(White,0,0,@W,@H,,#B5C4CCFFFFFFFFFF)
				Draw:(White,0,0,@W,@H,,#DD1010FFFFFFFFFF)
					.set(gel.scalex,abs(%EnergyEffect)/100)
				Draw:(White,0,@M,@W,[@H/2],,#00000015FFFFFFFF)
				Draw:(White,25,0,1,@H,,#FFFFFFFFFFFFFFFF)
				Draw:(White,50,0,1,@H,,#FFFFFFFFFFFFFFFF)
				Draw:(White,75,0,1,@H,,#FFFFFFFFFFFFFFFF)
			}}	
			
			Draw:(Circle_50,-55,55,15,15,,#FFFFFFFFFFFFFFFF)
			Rect:()
			{
				Draw:(Card_Energy,-58,55,18,,,#B5C4CCFFFFFFFFFF)
			}
				:set(gel.vis,%EnergyEffect=0)

			Rect:()
			{
				Draw:(Card_Energy,-58,55,18,,,#DD1010FFFFFFFFFF)
			}	
				:set(gel.vis,%EnergyEffect!=0)
		}
	}
EndM

