Img:(Highlight_Circle,NewGUI/UI/Controller/Highlight_Circle.png)
Img:(Highlight_Round,NewGUI/UI/Controller/Highlight_Round.png,30,30,30,30,0.5)
Img:(Highlight_Square,NewGUI/UI/Controller/Highlight_Square.png,6,6,6,6)
Img:(Highlight_Replay,NewGUI/UI/Controller/Highlight_Replay.png,28,28,28,28)
Img:(Highlight_Pitch,NewGUI/UI/Controller/Highlight_Pitch.png,80,80,0,0)


Macro:(M_CTRLAnimDoodadCommon)
	float(%attractTimer,%timer,%w,%h,%vis)
	set(gel.vis,%vis)
	set(%vis,0)
	CTRLIsSelected()
	<
		add(%attractTimer,FrameTime*0.6)
		add(%timer,FrameTime*0.1)
		fmod(%attractTimer,40)
		fmod(%timer,20)
	>
	else
	<
		set(%attractTimer,0)
		set(%timer,0)
	>
	if(%timer < 10)
	<
		set(gel.colour,collerp(#29A1DBFFFFFFFFFF,#0653B2FFFFFFFFFF,[%timer/10]))
	>
	else
	<
		set(gel.colour,collerp(#0653B2FFFFFFFFFF,#29A1DBFFFFFFFFFF,[%timer-10]/10))
	>
EndM

Rect:() ref:CTRLBlank
	M_CTRLAnimDoodadCommon:()
{
} Template


Rect:() ref:CTRLButtonSelected
	M_CTRLAnimDoodadCommon:()
	Layer(AboveText2)
{
	// Attract
	Draw:(Highlight_Round,0,0,340,340)
		if(%attractTimer < 10)
		<
			set(gel.w,lerp(%w+8,%w,%attractTimer/10))
			set(gel.h,lerp(%h+8,%h,%attractTimer/10))
		>
		set(gel.hx,gel.w/2)
		set(gel.hy,gel.h/2)
		set(gel.x,-%w/2)
		set(gel.y,-%h/2)

	// Highlight
	Draw:(Highlight_Round,0,0,340,340)
		.set(gel.w,%w)
		.set(gel.h,%h)
		set(gel.hx,gel.w)
		set(gel.hy,gel.h)
} Template


