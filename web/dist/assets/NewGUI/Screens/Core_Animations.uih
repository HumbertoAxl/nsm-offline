// Inside CTRLSelectGroup back up anims
Macro:(M_CTRLAnimDoodadGroup)
	float(%w,%h,%vis)
	.set(gel.colour,#CC1618FF)
	set(gel.vis,%vis)
	set(%vis,0)
EndM

Macro:(M_CornerHint)
	Rect:() ref:CornerHint
		float(%cornerHintVis)
		set(gel.vis,%cornerHintVis)
		set(%cornerHintVis,0)
		.set(gel.x,-[%w/2]+1)
		.set(gel.y,[%h/2]-31)
	{{
		Draw:(Circle_50,-1,-1,32,32)

		Draw:(Circle_20,6,6,18,18,,#FFFFFFFF00000000)
		M_Text:(?ICONCAN?,15,16,,,C,C,Text,KNUL25,,0,0,#00000000,NoItalics,#505050FF,ref)
			Scale(0.72,0.725)
	}}
EndM

