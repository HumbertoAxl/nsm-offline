
Macro:(M_HeaderControl,?ENABLED?,?SHELL?,?SHELLID?,?TITLENAME?,?TITLE?,?HELP?,?MANAGER?,?SOCIAL?,?SEARCH?,?TARGETS?,?CARDS?,?BUX?,?ALLOWSTORE?,?MATCHSCORE?,?OPTIONS?)
	Rect:()
	{
		Rect:()
			float(%update)
			set(%update,0)
			if((shell(?SHELL?)="?SHELLID?"))
			<
				:set(%update,1)

				if(shellvis(?SHELL?) = true)
				<
					set(%update,1)
				>
			>

			if(%update)
			<
				// Enabled state
				set(twk(Header,Enabled),?ENABLED?)

				If:(?TITLENAME?)
					:set(twk(Header,ScreenTitle),loc(?TITLENAME?))
				EndIf

				set(twk(Header,ShowScreenTitle),?TITLE?)
				set(twk(Header,ShowHelp),?HELP?)
				set(twk(Header,ShowManager),?MANAGER?)
				set(twk(Header,ShowSocial),?SOCIAL?)
				set(twk(Header,ShowSearch),?SEARCH?)
				set(twk(Header,ShowTargets),?TARGETS?)
				set(twk(Header,ShowCards),?CARDS?)
				set(twk(Header,ShowBux),?BUX?)
				##IA
				set(twk(Header,AllowStore),?ALLOWSTORE?)
				##P4N
				set(twk(Header,AllowStore),0)
				##*
				if(twk(Settings,AppVariant)=Japan)
				<
					set(twk(Header,AllowStore),0)
					set(twk(Header,AllowRedeem),?ALLOWSTORE?)
				>
				set(twk(Header,ShowMatchScore),?MATCHSCORE?)
				set(twk(Header,ShowOptions),?OPTIONS?)
			>
	}
EndM

M_HeaderControl:(1,GameScreen,animatedleague,standings_HEADER,1,1)

