// Negotiating Contract
Rect:()
	if(twk(Negotiate,InProgress))
	<
		:set(twk(Header,ScreenTitle),loc(offer_HEADER))
		set(twk(Header,ShowScreenTitle),1)
		set(twk(Header,ShowHelp),1)
		set(twk(Header,ShowManager),0)
		set(twk(Header,ShowSocial),0)
		set(twk(Header,ShowSearch),0)
		set(twk(Header,ShowTargets),0)
		set(twk(Header,ShowCards),0)
		set(twk(Header,ShowBux),1)
		##IA
		set(twk(Header,AllowStore),1)
		##*
	>


// Transferring Player
Rect:()
	if(twk(Transfer,InProgress))
	<
		:set(twk(Header,ScreenTitle),loc(transfer_HEADER))
		set(twk(Header,ShowScreenTitle),1)
		set(twk(Header,ShowHelp),1)
		set(twk(Header,ShowManager),0)
		set(twk(Header,ShowSocial),0)
		set(twk(Header,ShowSearch),0)
		set(twk(Header,ShowTargets),0)
		set(twk(Header,ShowCards),0)
		set(twk(Header,ShowBux),1)
		##IA
		set(twk(Header,AllowStore),1)
		##*
	>

