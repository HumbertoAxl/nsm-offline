{{
	Rect:(0,0,250,50)
	{{
		M_ComboEntry:(Manager,PrestigeCombo,manager.cmb_PrestigeSelected,1,"",1)
	}}

	M_ComboOPEN:(@R-275,@T+80+83,250,60,Manager,PrestigeCombo,manager.cmb_PrestigeClose)
		Rect:(0,0,300,100) ref:ItemHook
			ChildrenOffset(0,50) ref:Offset
		{{
		}}
	M_ComboCLOSE:(Manager,PrestigeCombo)
}}
