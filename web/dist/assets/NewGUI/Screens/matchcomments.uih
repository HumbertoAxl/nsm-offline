// TEAM
Cull:(0,0,?COMW?,?COMH?) ref:HomeComment
{{
    M_BaseHomeComment:(HomeComment)
}} Template

Cull:(0,0,?COMW?,?COMH?) ref:AwayComment
{{
    M_BaseAwayComment:(AwayComment)
}} Template


// ASSISTANT
Cull:(0,0,?COMW?,?COMH_L?) ref:AssistantComment
{{
    Draw:(Com_Panel_Light,0,0,@W,@H) ref:AssistantComment
    Clip:(0,-50,@W,@H+50) ref:AssistantComment
    {
        M_AssistantFace:(AssistantSlotGameScreen,45,90,AssistantComment)
            Scale(0.45,0.45)
    }
    M_Text:(,125,0,@W-135,@H,C,C,TextBoxAtt,KNUL25,,1,1,#252525FF,NoItalics,#252525FF,AssistantComment)   
}} Template






