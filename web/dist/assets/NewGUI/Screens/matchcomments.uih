// VERSUS
Cull:(0,0,?COMW?,?COMH_L?) ref:VersusComment
{{
    Rect:(@W*0.25,45)
    {{
        Rect:()
            .set(gel.scale,0.5)
        {
            DrawEmbedded:(MatchHomeTeamBadge)
        }
        Draw:(Badge_Shadow,-45,30,90,12,,#00000040)
        M_Text:("",0,55,0,0,C,C,Text,KNUL25,Upper,1,0,#252525FF,NoItalics,#252525FF,HomeTeam)
    }}

    Rect:(@W*0.75,45)
    {{
        Rect:()
            .set(gel.scale,0.5)
        {
            DrawEmbedded:(MatchAwayTeamBadge)
        }
        Draw:(Badge_Shadow,-45,30,90,12,,#00000040)
        M_Text:("",0,55,0,0,C,C,Text,KNUL25,Upper,1,0,#252525FF,NoItalics,#252525FF,AwayTeam)
    }}

    // Versus Text
    M_Text:(sla_versus,@C,50,0,0,C,C,TextLoc,KNUL40,,0,1,#252525FF,NoItalics,#252525FF,ref)

}} Template


// SCORE READOUT
