//-------------------------------------------------------------------------------------------IMPORTS
Import:(Core.uih)
//
Import:(badge_Macros.uih)
Import:(formation_Macros.uih)
Import:(ImageDefs_characters.uih)
Import:(club_Macros.uih)
//----------------------------------------------------------------------------------LOCAL IMAGE DEFS
Import:(ImageDefs_kits.uih)
//---------------------------------------------------------------------------------------------SETUP
// Audio
Rect:()
	set(twk(Audio,SuppressAllAmbient),1)
	
//----------------------------------------------------------------------------------------ANIMATIONS
//-----------------------------------------------------------------------------------------TEMPLATES
//--------------------------------------------------------------------------------------------MACROS
//-------------------------------------------------------------------------------------------CONTENT

Dissolve:(@o,@T,@s,@H) ref:DissolveRoot
{{
	// Tabs
	Rect:(@L,@T+80,@W,60)
		Layer(Text)
	{{
		Draw:(Dialog_Fade,@f,60,@w,200,,#FFFFFFAA)
			Layer(Default)
		Draw:(Tab_BG60,@f,-2,@w,68)
		M_Tab:(30,0,220,60,club_RELATIONSHIPS,1,Club,CurrentTab)
		M_Tab:(250,0,220,60,club_OVERVIEW,2,Club,CurrentTab)
		M_Tab:(470,0,220,60,club_DATA,3,Club,CurrentTab)

		M_SwitchTabs:(3,Club,12,15,681,15)
	}}



	//--------------------------------------------------------------------------- Relationships Tab
	Rect:()
		M_FadingTabContent:(Club,CurrentTab,1)
	{
		Rect:(22,@T+155,@W-44,510)
		{{
			//Fans
			Rect:(0+8,0,[@W/4]-16,@H) ref:FanPanel
				float(%adjustState)
				func(ClickFunc)
				<
					Post(UI_Select)
					CTRLSetSelected(RelPriceButton,club)
					set(%adjustState,1)
				>
				func(BackFunc)
				<
					Message("club.btn_TicketsCancel")
					Message("club.btn_ShopCancel")
					set(%adjustState,0)
					CTRLPopSelectGroup()
					CTRLSetSelected(FanPanelCTRLGroup)
				>
			{{
				//Fans Relationship
				CTRLSelectGroup:(-3,-3,@W+6,@H+6,,CTRLBasicSelected,,,,,,,CTRLGroupRound) ref:FanPanelCTRLGroup
					CTRLClick(?BTNOK?)
					<
						callparent(1,ClickFunc)
					>
					Click()
					<
						callparent(1,ClickFunc)
					>

				{
					Rect:(0,0,@W,@H) ref:FansPanel
						M_CellPress:()

					{{
						Rect:()
							CTRLSelect(CTRLBlank)
							CTRLHasSelectedGroup()
							<
								:set(%adjustState,1)
							>
							else
							<
								:set(%adjustState,0)
							>

						Draw:(Rounded_Shadowed_Reflection,-7,@B,@W+14,72)
						Draw:(FloorShadow,-12,@B-2,@W+24,11)
						Draw:(Rounded_Shadowed,-16,-13,@W+32,@H+32)

						Draw:(NewStarShape,0,0,@W,460,,#E8E8E8FFFFFFFFFF)

						// Title
						Draw:(Header_Hexagons,0,0,@W,34)
						M_Text:(generic_FANS,0,0,@W,34,C,C,TextLoc,KNUL23,Upper,0,0,#00000000,NoItalics,#FFFFFFFF,Type)
							M_Style:(Outline,#FFFFFF20)

						// Character
						Draw:(Character_Fan,@C-188-[@y*0.05],0,300,300)
						M_CircularBar:(@C+3+[@y*0.05],120,Club,FansRelationship)
						M_Text:(,10,295,@W-20,0,C,C,TextBox,KNUL25,,1,0,#25252580,Italics,#252525FF,ref)
							.set(gel.text,"“ " :: twk(Club,FansRelationshipDesc) :: " ”")
							LineSpacing(0.8)
							

						Draw:(White,0,345,@W,1,,#00000015)
						M_Text:(club_RELATIONSHIPS_TICKETS_LC,@C-60-58-[@y*0.05],385,116,0,C,C,TextBox,KNUL23,,0,0,#00000000,NoItalics,#505050FF,ref)
						
						M_Text:(,@C-60-60-[@y*0.05],435,120,0,C,C,Text,KNUL25,,1,0,#252525FF,NoItalics,#252525FF,ref)
							set(gel.text,"★ " :: commasfmt(twk(Club,TicketPrice)))
						
						M_Text:(club_RELATIONSHIPS_MERCH_LC,@C+60-55+[@y*0.05],385,110,0,C,C,TextBox,KNUL23,,0,0,#00000000,NoItalics,#505050FF,ref)
							
						M_Text:(performance_NOTOWNED,@C+50-60+[@y*0.05],435,140,0,C,C,TextLoc,KNUL22,,0,0,#00000000,NoItalics,#808080FF,ref)
							set(gel.vis,twk(Facilities,ClubShopLevel) = 0)
						M_Text:(,@C+60-60+[@y*0.05],435,120,0,C,C,TextLoc,KNUL25,,1,0,#252525FF,NoItalics,#252525FF,ref,Club,ShopPrices)
							set(gel.vis,twk(Facilities,ClubShopLevel) > 0)

						// Panel Action
						Rect:(0,@B-50,@W,50)
						{{
							Tile:(White,12,0,8,1,,#AAAAAAFFFFFFFFFF)
								Copies([[@W-12]/15],1)
								Spacing(15,0)
							Draw:(Button_Shade,0,@M,@W,@H/2,,#00000010FFFFFFFF)
							M_Text:(club_RELATIONSHIPS_ADJUST,0,@M,@W,0,C,C,TextLoc,KNUL23,Upper,0,0,#00000000,NoItalics,#252525FF,ref)
								M_Style:(Outline,#25252520)
						}}

						Rect:()
							Layer(AboveText)
							LockLayer()
							float(%panelState)
						{
							Draw:(Button_Shade,0,@B+1,@W,0,,#CCCCCC00FFFFFFFF)
								Click()
								Handle(0,1)
								if(%adjustState = 1)
								<
									:Delay(0.2)
									frlerp(gel.alpha,1,0.25)
									frlerp(gel.h,477,0.25)
									if(gel.h > 476)
									<
										:set(gel.h,477)
									>
									:Delay(0.3)
									set(%panelState,1)
								>
								if(%adjustState = 0)
								<
									:Delay(0.2)
									:set(%panelState,0)
									frlerp(gel.alpha,0,0.25)
									frlerp(gel.h,0,0.25)
								>
								if(%adjustState = -1)
								<
									:set(%panelState,0)
									set(gel.alpha,0)
									set(gel.h,0)
								>
								set(gel.hy,gel.h)
							
							Rect:() $HIDE
								if(%panelState = 1)
								<
									:set(gel.vis,1)
									frlerp(gel.alpha,1,0.2)
								>
								else
								<
									frlerp(gel.alpha,0,0.2)
									if(gel.alpha < 0.01)
									<
										set(gel.alpha,0)
										set(gel.vis,0)
									>
								>
								if(twk(Club,CurrentTab) != 1)
								<
									:Message("club.btn_TicketsCancel")
									:Message("club.btn_ShopCancel")
									:set(%adjustState,-1)
								>
							{
								//--------------Ticket Prices
								Rect:(0,34,@W,50)
								{{

									M_Text:(club_RELATIONSHIPS_TICKETS,@C,20,0,0,C,C,TextLoc,KNUL23,Upper,0,0,#00000000,NoItalics,#252525FF,ref)

									//Price
									M_Text:("50",@C,50,0,0,C,C,Text,KNUL25,,1,0,#252525FF,NoItalics,#252525FF,ref)
										set(gel.text,"★ " :: commasfmt(twk(Club,TicketPrice)))
										strvar(%current)
										.set(%current,gel.text)
										if(%current != gel.text)
										<
											:set(gel.alpha,0)
											:set(gel.scale,0.5)
											:set(%current,gel.text)
										>
										frlerp(gel.alpha,1,0.1)
										frlerp(gel.scale,1,0.2)

									// Ticket Price Down
									M_Button:(@C-60,100,110,40,Button_SilverSliced,,10,-5,64,64,#FFFFFFFF,club.btn_TicketsDown,ref,"-",0,0,C,C,Text,KNUL25,Upper,1,0,#252525FF,NoItalics,#252525FF,textref)
										set(%disabled,twk(Club,TicketPriceBand) = 0)
										M_CTRLButtonExtra:(?BTNOK?,true,CTRLButtonSelected,3,3,6,6)
										CTRLBlock(UP,LEFT)
										CTRLClick(?BTNCAN?)
										<
											Post(UI_Back)
											call(FanPanel,BackFunc)
										>
				
									// Ticket Price Up
									M_Button:(@C+60,100,110,40,Button_SilverSliced,,10,-5,64,64,#FFFFFFFF,club.btn_TicketsUp,ref,"+",0,0,C,C,Text,KNUL25,Upper,1,0,#252525FF,NoItalics,#252525FF,textref)
										set(%disabled,twk(Club,TicketPriceBand) = 8)
										M_CTRLButtonExtra:(?BTNOK?,true,CTRLButtonSelected,3,3,6,6)
										CTRLBlock(UP)
										CTRLClick(?BTNCAN?)
										<
											Post(UI_Back)
											call(FanPanel,BackFunc)
										>
									
									// Tip
									M_Text:("Club_TicketPricesTip",10,160,@W-20,0,C,C,TextBox,KNUL22,,0,0,#00000000,NoItalics,#505050FF,ref)
										LineSpacing(0.8)
								}}

								//----------------------------------------------------
								Draw:(White,0,232,@W,3,,#252525FFFFFFFFFF)
								//----------------------------------------------------

								//--------------Store Prices
								Rect:()
									set(gel.vis,twk(Facilities,ClubShopLevel) > 0)
								{
									Rect:(0,233,@W,50)
									{{
										M_Text:(club_RELATIONSHIPS_MERCH,@C,20,0,0,C,C,TextLoc,KNUL23,Upper,0,0,#00000000,NoItalics,#252525FF,ref)

										// Price Bracket Text
										M_Text:("50",@C,50,0,0,C,C,Text,KNUL25,,1,0,#252525FF,NoItalics,#252525FF,ref,Club,ShopPrices)
											strvar(%current)
											.set(%current,gel.text)
											if(%current != gel.text)
											<
												:set(gel.alpha,0)
												:set(gel.scale,0.5)
												:set(%current,gel.text)
											>
											frlerp(gel.alpha,1,0.1)
											frlerp(gel.scale,1,0.2)

										// Reduce Price Button
										M_Button:(@C-60,100,110,40,Button_SilverSliced,,10,-5,64,64,#FFFFFFFF,club.btn_ShopDown,ref,"-",0,0,C,C,Text,KNUL25,Upper,1,0,#252525FF,NoItalics,#252525FF,textref)
											set(%disabled,twk(Club,ShopPricesBand) = 0)
											M_CTRLButtonExtra:(?BTNOK?,true,CTRLButtonSelected,3,3,6,6)
											CTRLBlock(LEFT)
											CTRLClick(?BTNCAN?)
											<
												Post(UI_Back)
												call(FanPanel,BackFunc)
											>

										// Increase Price Button
										M_Button:(@C+60,100,110,40,Button_SilverSliced,,10,-5,64,64,#FFFFFFFF,club.btn_ShopUp,ref,"+",0,0,C,C,Text,KNUL25,Upper,1,0,#252525FF,NoItalics,#252525FF,textref)
											set(%disabled,twk(Club,ShopPricesBand) = 5)
											M_CTRLButtonExtra:(?BTNOK?,true,CTRLButtonSelected,3,3,6,6)
											CTRLClick(?BTNCAN?)
											<
												Post(UI_Back)
												call(FanPanel,BackFunc)
											>

										// Tip
										M_Text:("Club_ShopPricesTip",10,160,@W-20,0,C,C,TextBox,KNUL22,,0,0,#00000000,NoItalics,#505050FF,ref)
											LineSpacing(0.8)
									}}
								}
								
								// Close Button
								//----------------------------------------------------
								M_Button:(@C-60,@B-34,110,50,Button_RedSliced,Icon_Cross,@C-20,5,40,40,#FFFFFFFF,link,RelPriceButton,"",0,3,C,C,Text,KNUL22,Upper,0,0,#00000000,NoItalics,#252525FF,textref,,BackButtonAudio)
									M_CTRLButtonExtra:(?BTNOK?,true,CTRLButtonSelected,3,3,6,6)
									CTRLBlock(LEFT)
									if(%clicked)
									<
										call(FanPanel,BackFunc)
									>
									CTRLClick(?BTNCAN?)
									<
										Post(UI_Back)
										call(FanPanel,BackFunc)
									>

								// Confirm Button
								M_Button:(@C+60,@B-34,110,50,Button_GreenSliced,Icon_Tick,@C-20,5,40,40,#FFFFFFFF,link,ref,"",0,3,C,C,Text,KNUL22,Upper,0,0,#00000000,NoItalics,#252525FF,textref)
									M_CTRLButtonExtra:(?BTNOK?,true,CTRLButtonSelected,3,3,6,6)
									if((twk(Club,CurrentTicketPriceBand) = twk(Club,TicketPriceBand)) and(twk(Club,CurrentShopPricesBand) = twk(Club,ShopPricesBand)))
									<
										set(%disabled,1)
									>
									else
									<
										set(%disabled,0)
									>
									if(%clicked)
									<
										Message(club.btn_TicketsConfirm)
										Message(club.btn_ShopConfirm)
										:set(%adjustState,0)
										CTRLPopSelectGroup()
										CTRLSetSelected(FanPanelCTRLGroup)
									>
									CTRLClick(?BTNCAN?)
									<
										Post(UI_Back)
										call(FanPanel,BackFunc)
									>
							}
							
						}
						M_CellPressHighlight:()
					}}
				}
			}}

			// Press
			Rect:([@W*0.25]+8,0,[@W/4]-16,@H)
			{{
				Rect:(0,0,@W,@H) ref:PressPanel
					M_CellPress:()
					func(ClickFunc)
					<
						Post(UI_Select)
						Message(commonui.btn_Social)
					>
					M_CTRLCellExtra:(?BTNOK?,true,CTRLBasicSelected,0,0,6,6)
					Click()
					<
						call(ClickFunc)
					>
				{{
					Draw:(Rounded_Shadowed_Reflection,-7,@B,@W+14,72)
					Draw:(FloorShadow,-12,@B-2,@W+24,11)
					Draw:(Rounded_Shadowed,-16,-13,@W+32,@H+32)

					Draw:(NewStarShape,0,0,@W,460,,#E8E8E8FFFFFFFFFF)

					// Title
					Draw:(Header_Hexagons,0,0,@W,34)
					M_Text:(generic_PRESS,0,0,@W,34,C,C,TextLoc,KNUL23,Upper,0,0,#00000000,NoItalics,#FFFFFFFF,Type)
						M_Style:(Outline,#FFFFFF20)

					// Character
					Draw:(Character_Press,@C-188-[@y*0.05],0,300,300)
					M_CircularBar:(@C+3+[@y*0.05],120,Club,PressRelationship)
					M_Text:(,10,295,@W-20,0,C,C,TextBox,KNUL25,,1,0,#25252580,Italics,#252525FF,ref)
						.set(gel.text,"“ " :: twk(Club,PressRelationshipDesc) :: " ”")
						LineSpacing(0.8)

					Draw:(White,0,345,@W,1,,#00000015)
					// Panel Action
					Rect:(0,@B-50,@W,50)
					{{
						Tile:(White,12,0,8,1,,#AAAAAAFFFFFFFFFF)
							Copies([[@W-12]/15],1)
							Spacing(15,0)
						Draw:(Button_Shade,0,@M,@W,@H/2,,#00000010FFFFFFFF)
						M_Text:(club_RELATIONSHIPS_MESSAGES,0,@M,@W,0,C,C,TextLoc,KNUL23,Upper,0,0,#00000000,NoItalics,#252525FF,ref)
							M_Style:(Outline,#25252520)
					}}
					M_CellPressHighlight:()
				}}			
			}}

			// Sponsors
			Rect:(@C+8,0,[@W/4]-16,@H)
			{{
				Rect:(0,0,@W,@H) ref:SponsorsPanel
					M_CellPress:()
					func(ClickFunc)
					<
						Post(UI_Select)
						Message(club.btn_ViewSponsors)
					>
					M_CTRLCellExtra:(?BTNOK?,true,CTRLBasicSelected,0,0,6,6)
					Click()
					<
						call(ClickFunc)
					>
				{{
					Draw:(Rounded_Shadowed_Reflection,-7,@B,@W+14,72)
					Draw:(FloorShadow,-12,@B-2,@W+24,11)
					Draw:(Rounded_Shadowed,-16,-13,@W+32,@H+32)

					Draw:(NewStarShape,0,0,@W,460,,#E8E8E8FFFFFFFFFF)

					// Title
					Draw:(Header_Hexagons,0,0,@W,34)
					M_Text:(generic_SPONSORS,0,0,@W,34,C,C,TextLoc,KNUL23,Upper,0,0,#00000000,NoItalics,#FFFFFFFF,Type)
						M_Style:(Outline,#FFFFFF20)

					// Character
					Draw:(Character_Sponsor,@C-188-[@y*0.05],0,300,300)
					M_CircularBar:(@C+3+[@y*0.05],120,Club,SponsorRelationship)
					M_Text:(,10,295,@W-20,0,C,C,TextBox,KNUL25,,1,0,#25252580,Italics,#252525FF,ref)
						.set(gel.text,"“ " :: twk(Club,SponsorRelationshipDesc) :: " ”")
						LineSpacing(0.8)

					Draw:(White,0,345,@W,1,,#00000015)
					// No Sponsor
					Rect:()
						set(gel.vis,not(twk(Club,HasSponsor1)))
					{
						M_Text:("Sponsor_Alert_Shirt",10,390,@W-20,34,C,C,TextBox,KNUL22,,0,0,#00000000,NoItalics,#808080FF,ref)
					}

					// Has Sponsor
					Rect:()
						set(gel.vis,twk(Club,HasSponsor1))
					{
						M_Text:("sponsor_WINBONUSES",@C-60-55-[@y*0.05],385,110,0,C,C,TextBox,KNUL23,,0,0,#00000000,NoItalics,#505050FF,ref)
						M_Text:(,@C-60-60-[@y*0.05],435,120,0,C,C,Text,KNUL25,,1,0,#252525FF,NoItalics,#252525FF,ref)
							set(gel.text,"★ " :: commasfmt(twk(Club,Sponsor1WinBonus)+twk(Club,Sponsor2WinBonus)+twk(Club,Sponsor3WinBonus)))

						M_Text:("sponsor_GOALBONUSES",@C+60-55+[@y*0.05],385,110,0,C,C,TextBox,KNUL23,,0,0,#00000000,NoItalics,#505050FF,ref)
						M_Text:(,@C+60-60+[@y*0.05],435,120,0,C,C,Text,KNUL25,,1,0,#252525FF,NoItalics,#252525FF,ref)
							set(gel.text,"★ " :: commasfmt(twk(Club,Sponsor1GoalBonus)+twk(Club,Sponsor2GoalBonus)+twk(Club,Sponsor3GoalBonus)))
					}

					// Panel Action
					Rect:(0,@B-50,@W,50)
					{{
						Tile:(White,12,0,8,1,,#AAAAAAFFFFFFFFFF)
							Copies([[@W-12]/15],1)
							Spacing(15,0)
						Draw:(Button_Shade,0,@M,@W,@H/2,,#00000010FFFFFFFF)
						M_Text:(club_RELATIONSHIPS_VIEWSPONSORS,0,@M,@W,0,C,C,TextLoc,KNUL23,Upper,0,0,#00000000,NoItalics,#252525FF,ref)
							M_Style:(Outline,#25252520)
					}}
					M_CellPressHighlight:()
				}}				
			}}

			// Board
			Rect:([@W*0.75]+8,0,[@W/4]-16,@H)
			{{
				Rect:(0,0,@W,@H) ref:BoardPanel
					M_CellPress:()
					func(ClickFunc)
					<
						Post(UI_Select)
						Message(club.btn_RequestFunds)
					>
					M_CTRLCellExtra:(?BTNOK?,true,CTRLBasicSelected,0,0,6,6) 
					Click()
					<
						call(ClickFunc)
					>
				{{
					Draw:(Rounded_Shadowed_Reflection,-7,@B,@W+14,72)
					Draw:(FloorShadow,-12,@B-2,@W+24,11)
					Draw:(Rounded_Shadowed,-16,-13,@W+32,@H+32)

					Draw:(NewStarShape,0,0,@W,460,,#E8E8E8FFFFFFFFFF)

					// Title
					Draw:(Header_Hexagons,0,0,@W,34)
					M_Text:(generic_BOARD,0,0,@W,34,C,C,TextLoc,KNUL23,Upper,0,0,#00000000,NoItalics,#FFFFFFFF,Type)
						M_Style:(Outline,#FFFFFF20)

					// Character
					Draw:(Character_Board,@C-188-[@y*0.05],0,300,300)
					M_CircularBar:(@C+3+[@y*0.05],120,Club,BoardRelationship)
					M_Text:(,10,295,@W-20,0,C,C,TextBox,KNUL25,,1,0,#25252580,Italics,#252525FF,ref)
						.set(gel.text,"“ " :: twk(Club,BoardRelationshipDesc) :: " ”")
						LineSpacing(0.8)
		

					Draw:(White,0,345,@W,1,,#00000015)
					M_Text:(club_RELATIONSHIPS_SHARE,@C-100,385,200,0,C,C,TextBox,KNUL23,,0,0,#00000000,NoItalics,#505050FF,ref)
					M_Text:(,@C,435,0,0,C,C,Text,KNUL25,,1,0,#252525FF,NoItalics,#252525FF,ref)
						set(gel.text,LTR(fmt(Player.shareholderPercentage,X) :: "%"))

					// Panel Action
					Rect:(0,@B-50,@W,50)
					{{
						Tile:(White,12,0,8,1,,#AAAAAAFFFFFFFFFF)
							Copies([[@W-12]/15],1)
							Spacing(15,0)
						Draw:(Button_Shade,0,@M,@W,@H/2,,#00000010FFFFFFFF)
						M_Text:(club_RELATIONSHIPS_FUNDS,0,@M,@W,0,C,C,TextLoc,KNUL22,Upper,0,0,#00000000,NoItalics,#252525FF,ref)
							M_Style:(Outline,#25252520)
					}}
					M_CellPressHighlight:()
				}}				
			}}
		}}
	}

	//--------------------------------------------------------------------------- Overview Tab
	
	Clip:(@L,@T+140,@W,@H-210) $HIDE
		M_FadingTabContent:(Club,CurrentTab,2)
			.set(twk(Club,OverviewScroll),0)
			if(not(gel.vis))
			<
				:set(twk(Club,OverviewScrollVel),0)
			>
	{{	
		CTRLSelectGroup:(0,0,@W,@H,,CTRLSquareSelected,,,,,,,CTRLGroupSquare) ref:OverviewGroup
		{
			// Club Overview Scrolling List
			Rect:(0,0,@W,@H) ref:SwipePanels
				if(not(twk(CardEngine,DraggingCard)))
				<
					SwipePanel(Club,OverviewScroll,Club,OverviewScrollVel) ref:SwipePanelOverview

				>
			{{
				Rect:(0,0,@W,@H) ref:OverviewList
					ScrollingList(Club,OverviewScroll,@H,Club,OverviewScrollVel) ref:ScrollingListOverview
					CTRLScrollList(ScrollingListOverview) ref:CTRLScrollList
					float(%yPos)
					set(%yPos,0)
				{{
					// Club Details
					Rect:(30,0,[@W-90]/2,@H)
					{{
						// Title
						Draw:(White,0,15,@W,34,,#808080FFFFFFFFFF)
						Draw:(White,0,16,@W,32,,#B0B0B0FFFFFFFFFF)
						M_Text:(club_CLUB,10,15,0,34,L,C,TextLoc,KNUL23,Upper,0,0,#00000000,NoItalics,#FFFFFFFF,ref)

						// Club Name
						M_Text:(,10,85,0,0,L,C,TextLoc,KNUL25,,0,0,#00000000,NoItalics,#505050FF,ref)
							.set(gel.text,loc(Name) :: ":")
							set(%gfo,%gfw)
						{{
