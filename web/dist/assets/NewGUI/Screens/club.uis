							set(%gfo,%gfw)
						{{
							// Under Construction
							Rect:()
								.set(gel.vis,twk(ScoutsOfficeConstruction,TimeRemaining) >= 1)
							{
								M_Text:(,0,0,0,0,L,C,Text,KNUL25,,1,0,#252525FF,NoItalics,#252525FF,ref)
									.set(gel.x,%gfo+10)
									.set(gel.text,loc(club_OTHERLEVEL) :: " " :: LTR([twk(Facilities,ScoutsOfficeLevel)+1]))
									PulseAlpha(1,0,0.3,0.3,2,2,2)
						
								M_Text:(,0,0,0,0,L,C,Text,KNUL25,,1,0,#252525FF,NoItalics,#252525FF,ref)
									.set(gel.x,%gfo+10)
									.set(gel.text," ":: SLTR("(") :: loc(club_CONSTRUCTION) :: SLTR(")"))
									PulseAlpha(0,1,0.3,0.3,2,2,2)
							}

							// Not Owned or Owned
							Rect:()
								.set(gel.vis,twk(ScoutsOfficeConstruction,TimeRemaining) < 1)
							{
								M_Text:(,0,0,0,0,L,C,Text,KNUL25,,1,0,#252525FF,NoItalics,#252525FF,ref)
									.set(gel.x,%gfo+10)
									if(twk(Facilities,ScoutsOfficeLevel) = 0)
									<
										.set(gel.text,loc(club_NOTOWNED))
									>
									else
									<
										.set(gel.text,loc(club_OTHERLEVEL) :: " " :: LTR(twk(Facilities,ScoutsOfficeLevel)))
									>
							}
						}}
						Draw:(White,0,300,@W,1,,#0000001AFFFFFFFF)
				
						// Club Shop
						M_Text:(club_CLUBSHOP,10,330,0,0,L,C,TextLoc,KNUL25,,0,0,#00000000,NoItalics,#505050FF,ref)
							set(%gfo,%gfw)
						{{
							// Under Construction
							Rect:()
								.set(gel.vis,twk(ClubShopConstruction,TimeRemaining) >= 1)
							{
								M_Text:(,0,0,0,0,L,C,Text,KNUL25,,1,0,#252525FF,NoItalics,#252525FF,ref)
									.set(gel.x,%gfo+10)
									.set(gel.text,loc(club_OTHERLEVEL) :: " " :: LTR([twk(Facilities,ClubShopLevel)+1]))
									PulseAlpha(1,0,0.3,0.3,2,2,2)
						
								M_Text:(,0,0,0,0,L,C,Text,KNUL25,,1,0,#252525FF,NoItalics,#252525FF,ref)
									.set(gel.x,%gfo+10)
									.set(gel.text," ":: SLTR("(") :: loc(club_CONSTRUCTION) :: SLTR(")"))
									PulseAlpha(0,1,0.3,0.3,2,2,2)
							}

							// Not Owned or Owned
							Rect:()
								.set(gel.vis,twk(ClubShopConstruction,TimeRemaining) < 1)
							{
								M_Text:(,0,0,0,0,L,C,Text,KNUL25,,1,0,#252525FF,NoItalics,#252525FF,ref)
									.set(gel.x,%gfo+10)
									if(twk(Facilities,ClubShopLevel) = 0)
									<
										.set(gel.text,loc(club_NOTOWNED))
									>
									else
									<
										.set(gel.text,loc(club_OTHERLEVEL) :: " " :: LTR(twk(Facilities,ClubShopLevel)))
									>
							}
						}}
						Draw:(White,0,350,@W,1,,#0000001AFFFFFFFF)

						// Club Shop Prices
						M_Text:(club_CLUBSHOP_PRICES,10,380,0,0,L,C,TextLoc,KNUL25,,0,0,#00000000,NoItalics,#505050FF,ref)
							set(%gfo,%gfw)
						{{
							// Not owned
							Rect:()
								.set(gel.vis,twk(Facilities,ClubShopLevel) = 0)
							{
								M_Text:(,0,0,0,0,L,C,Text,KNUL25,,1,0,#252525FF,NoItalics,#252525FF,ref)
									.set(gel.x,%gfo+10)
									if(twk(ClubShopConstruction,TimeRemaining) >= 1)
									<
										.set(gel.text,SLTR("(") :: loc(club_CONSTRUCTION) :: SLTR(")"))
									>
									else
									<
										.set(gel.text,loc(club_NOTOWNED))
									>
							}

							// Owned
							Rect:()
								.set(gel.vis,twk(Facilities,ClubShopLevel) > 0)
							{
								M_Text:(,0,0,0,0,L,C,Text,KNUL25,,1,0,#252525FF,NoItalics,#252525FF,ref)
									.set(gel.x,%gfo+10)
									set(gel.text(twk(Club,ShopPrices)))

							}
						}}
						Draw:(White,0,400,@W,1,,#0000001AFFFFFFFF)

						// Ticket Prices
						M_Text:(club_RELATIONSHIPS_TICKETS_LC,10,430,0,0,L,C,TextLoc,KNUL25,,0,0,#00000000,NoItalics,#505050FF,ref)
							set(%gfo,%gfw)
						{{
							M_Text:(,0,0,0,0,L,C,Text,KNUL25,,1,0,#252525FF,NoItalics,#252525FF,ref)
								.set(gel.x,%gfo+10)
								set(gel.text,"★ " :: commasfmt(twk(Club,TicketPrice)))
						}}
						Draw:(White,0,450,@W,1,,#0000001AFFFFFFFF)

						//Adjust Prices Button
						M_Text:(Overview_Title_AdjustPrices,10,485,0,0,L,C,TextLoc,KNUL25,,0,0,#00000000,NoItalics,#505050FF,ref)

						M_Button:(@R-97,490,160,50,Button_GreenSliced,,0,0,0,0,#FFFFFFFF,,,loc(Overview_Adjust),0,3,C,C,Text,KNUL22,Upper,0,0,#00000000,NoItalics,#FFFFFFFF,)
							M_CTRLButtonExtra:(?BTNOK?,true,CTRLButtonSelected,3,3,6,6)
							if(%clicked)
							<
								set(twk(Club,CurrentTab),1)
								call(FanPanel,ClickFunc)
								CTRLSetSelected(RelPriceButton,club)
							>
						
						Draw:(White,0,520,@W,1,,#0000001AFFFFFFFF)
					}}
				}}

				Rect:(0,10,@W,@H-20)
				{{
					M_ScrollIndicatorAlt:(@R-25,@H,Club,OverviewScroll,OverviewList,ScrollingListOverview,SwipePanels,SwipePanelOverview)
				}}
			}}
		}

		M_SwitchStickHint:(✃,@R-37,@B-53,Y)
			CTRLScrollListIcon(OverviewList,CTRLScrollList)
	}}

	//--------------------------------------------------------------------------- Sponsors Tab
	
	// Rect:(@L,@T+140,@W,@H-225) $HIDE
	// 	M_FadingTabContent:(Club,CurrentTab,3)
	// {{
	// 	M_Sponsor:(@C-320-160-35,0,1,club_SPONSOR_SHIRT)
	// 	M_Sponsor:(@C-160,0,2,club_SPONSOR_SLEEVE)
	// 	M_Sponsor:(@C+160+35,0,3,club_SPONSOR_HOARDING)
	// }}

	//--------------------------------------------------------------------------- Data Tab
	
	Rect:(@L,@T+140,@W,@H-210) $HIDE
		M_FadingTabContent:(Club,CurrentTab,3)
		.set(twk(Club,DataFilterScroll),0)
		if(not(gel.vis))
		<
			:set(twk(Club,DataFilterScrollVel),0)
		>
		float(%swiping)
	{{
		// Data Mess
		Clip:(0,0,@W-260,@H) ref:SwipePanel
			if(not(twk(CardEngine,DraggingCard)))
			<
				if(%swiping oneof(0,1))
				<
					SwipePanel(PageSystem,BlockScroll,PageSystem,BlockScrollVel,History,ChartScroll,History,ChartScrollVel) ref:SwipePanelData
					<
						:set(%swiping,1)
					>
					else
					<
						set(%swiping,0)
					>
				>
			>
		{{
			Rect:(0,0,@W,@H)
				set(gel.vis,twk(History,NumberOfEntries) = 0)
			{{
				M_Text:(club_DATAMESS,0,@M-20,@W,0,C,C,TextLoc,KNUL28,,0,0,#00000000,NoItalics,#252525FF,ref)
			}}

			Rect:(30,0)
			{
				Rect:(0,40,@W,450+@z) ref:ClubChart
					ScrollingListX(History,ChartScroll,@W-50,History,ChartScrollVel) ref:ScrollingList
					CTRLScrollList(ScrollingList) ref:CTRLScrollList
					.set(twk(History,ChartScroll),-5000)

					ChartXAxis(ChartXAxisBottomLabel,ChartXAxisTopLabel,History,ChartBottomAxisFixtures,History,ChartTopAxisFixtures,History,ChartCupFixtures)

					ChartLine(History,ChartSquadHappiness,#A15E9DFFFFFFFFFF,0,100) ref:SquadHappiness
					ChartLine(History,ChartRelationBoard,#282828FFFFFFFFFF,0,100) ref:RelationBoard
					ChartLine(History,ChartRelationFans,#CC1618FFFFFFFFFF,0,100) ref:RelationFans
					ChartLine(History,ChartRelationPress,#2196F3FFFFFFFFFF,0,100) ref:RelationPress
					ChartLine(History,ChartRelationSponsor,#263186FFFFFFFFFF,0,100) ref:RelationSponsor
					
					ChartLine(History,ChartLeaguePos,#CC1618FFFFFFFFFF,30,1,1) ref:LeaguePos
					ChartLine(History,ChartSquadSkills,#151515FFFFFFFFFF,0,100) ref:SquadSkills
					ChartLine(History,ChartSquadFitness,#3DAC00FFFFFFFFFF,0,100) ref:SquadFitness
					ChartLine(History,ChartSquadValue,#036E98FFFFFFFFFF,0,1000000) ref:SquadValue

					ChartLine(History,ChartAttendance,#607D8BFFFFFFFFFF,0,100) ref:Attendance
					ChartLine(History,ChartRevenue,#263186FFFFFFFFFF,0,100) ref:Revenue
					ChartLine(History,ChartSponsorship,#990353FFFFFFFFFF,0,100) ref:Sponsorship
					ChartLine(History,ChartTVBonus,#00CDC8FFFFFFFFFF,0,100) ref:TVBonus

					ChartLine(History,ChartTicketPrices,#3F51B5FFFFFFFFFF,0,100) ref:TicketPrices
					ChartLine(History,ChartGateReceipts,#E68900FFFFFFFFFF,0,100) ref:GateReceipts
					ChartLine(History,ChartShopSales,#9B3C15FFFFFFFFFF,0,100) ref:ShopSales
					ChartLine(History,ChartPricebandShop,#6A5A50FFFFFFFFFF,0,100,0,History,ChartPricebandShopDisplay) ref:PricebandShop

					ChartLineToggle(SquadHappiness,History,ChartToggle,SHAPPINESS)
					ChartLineToggle(RelationBoard,History,ChartToggle,RBOARD)
					ChartLineToggle(RelationFans,History,ChartToggle,RFANS)
					ChartLineToggle(RelationPress,History,ChartToggle,RPRESS)
					ChartLineToggle(RelationSponsor,History,ChartToggle,RSPONSOR)
					
					ChartLineToggle(LeaguePos,History,ChartToggle,LPOS)
					ChartLineToggle(SquadSkills,History,ChartToggle,SSKILLS)
					ChartLineToggle(SquadFitness,History,ChartToggle,SFITNESS)
					ChartLineToggle(SquadValue,History,ChartToggle,SVALUE)

					ChartLineToggle(Attendance,History,ChartToggle,ATT)
					ChartLineToggle(Revenue,History,ChartToggle,REVENUE)
					ChartLineToggle(Sponsorship,History,ChartToggle,SPONSORBNS)
					ChartLineToggle(TVBonus,History,ChartToggle,TVB)

					ChartLineToggle(TicketPrices,History,ChartToggle,PBT)
					ChartLineToggle(GateReceipts,History,ChartToggle,GATER)
					ChartLineToggle(ShopSales,History,ChartToggle,SHOPS)
					ChartLineToggle(PricebandShop,History,ChartToggle,PBS)
			}

			Rect:(30,0,@W-60,@H)
			{{
				M_ScrollIndicatorAltH:(@B,@W,History,ChartScroll,ClubChart,ScrollingList,SwipePanel,SwipePanelData)
			}}

			Rect:()
				:set(gel.vis,twk(History,NumberOfEntries) > 0)
			{
				M_SwitchStickHint:(✃,@R-59,@B-36,X)
					CTRLScrollListIcon(ClubChart,CTRLScrollList)
			}
		}}

		CTRLSelectGroup:(@R-260,0,260,@H,,CTRLSquareSelected,,,,,,,CTRLGroupSquare) ref:DataToggleGroup
		{
			// Filters
			Rect:(@R-260,0,260,@H)
			{{
				Draw:(PanelAngled,-3,-3,@W+6,@H+6,,#FFFFFF70FFFFFFFF)
				Clip:(0,1,@W,@H-2)
				{{
					// Data Filter Clipped Content
					Rect:(0,0,@W,@H) ref:SwipePanel
						if(not(twk(CardEngine,DraggingCard)))
						<
							if(%swiping oneof(0,2))
							<
								SwipePanel(Club,DataFilterScroll,Club,DataFilterScrollVel) ref:SwipePanelData
								<
									:set(%swiping,2)
								>
								else
								<
									set(%swiping,0)
								>
							>
						>
					{{
						Rect:(30,35,@W,@H-25)
						{{
							Rect:(100,0,@W,@H) ref:DataList
								ScrollingList(Club,DataFilterScroll,@H,Club,DataFilterScrollVel) ref:ScrollingListData
								CTRLScrollList(ScrollingListData) ref:CTRLScrollList
								float(%yPos)
								set(%yPos,0)
							{{
								M_ResetAllToggle:(0,0,0)
								M_PerformanceToggle:(0,0,1,"League Position",LPOS,#CC1618FFFFFFFFFF)
								M_PerformanceToggle:(0,0,2,"Attendance",ATT,#607D8BFFFFFFFFFF)
								M_PerformanceToggle:(0,0,3,"finances_TicketPrice",PBT,#3F51B5FFFFFFFFFF)
								M_PerformanceToggle:(0,0,4,"finances_GateReceipts",GATER,#E68900FFFFFFFFFF)
								M_PerformanceToggle:(0,0,5,"finances_ClubShopSales",SHOPS,#9B3C15FFFFFFFFFF)
								M_PerformanceToggle:(0,0,6,"finances_ClubShopPrices",PBS,#6A5A50FFFFFFFFFF)
								M_RelationshipToggle:(0,0,7,RBOARD,RFANS,RPRESS,RSPONSOR,#282828FFFFFFFFFF,#CC1618FFFFFFFFFF,#2196F3FFFFFFFFFF,#263186FFFFFFFFFF)
								M_PerformanceToggle:(0,0,11,"Squad Rating",SSKILLS,#151515FFFFFFFFFF)
								M_PerformanceToggle:(0,0,12,"Squad Energy",SFITNESS,#3DAC00FFFFFFFFFF)
								M_PerformanceToggle:(0,0,13,"Squad Happiness",SHAPPINESS,#A15E9DFFFFFFFFFF)
								M_PerformanceToggle:(0,0,14,"Revenue",REVENUE,#263186FFFFFFFFFF)
								M_PerformanceToggle:(0,0,15,"Sponsorship",SPONSORBNS,#990353FFFFFFFFFF)
								M_PerformanceToggle:(0,0,16,"Squad Value",SVALUE,#036E98FFFFFFFFFF)
							}}
						}}
						
						Rect:(0,10,@W,@H-20)
						{{
							M_ScrollIndicatorAlt:(@R-25,@H,Club,DataFilterScroll,DataList,ScrollingListData,SwipePanel,SwipePanelData)
						}}

					}}
				}}
			}}
		}
		M_SwitchStickHint:(✃,@R-37,@B-53,Y)
			CTRLScrollListIcon(DataList,CTRLScrollList)
	}}
}}