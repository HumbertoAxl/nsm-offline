Macro:(M_Corners_012_WallSigns)
	//Shadows
	Locator:((0,0,-1),(0,0,90),(1,1,1))
	{
		UseShader:(Simple3DNZW)
			Layer(Shadows)
		{
			DrawStaticModel:(Stadium_Wall_NE_Shadow_Lv_1,WallShadow)
				Blend(ONE,INV_IMAGE_ALPHA)
			DrawStaticModel:(Stadium_Wall_SE_Shadow_Lv_1,WallShadow)
				Blend(ONE,INV_IMAGE_ALPHA)
			DrawStaticModel:(Stadium_Wall_SW_Shadow_Lv_1,WallShadow)
				Blend(ONE,INV_IMAGE_ALPHA)
			DrawStaticModel:(Stadium_Wall_NW_Shadow_Lv_1,WallShadow)
				Blend(ONE,INV_IMAGE_ALPHA)
		}

	}
	
	Locator:((0,0,0),(0,0,90),(1,1,1))
	{
		//Wall
		Batch:(Stadium_Walls_1)
			M_TextureSelect:(Stadium_Lv_3)
		{
			DrawStaticModel:(Stadium_Wall_NE_Lv_1,Stadium_Lv_3)
			DrawStaticModel:(Stadium_Wall_SE_Lv_1,Stadium_Lv_3)
			DrawStaticModel:(Stadium_Wall_SW_Lv_1,Stadium_Lv_3)
			DrawStaticModel:(Stadium_Wall_NW_Lv_1,Stadium_Lv_3)
		}

		Batch:(Stadium_Ads_1)
			M_TextureSelect:(Stadium_Adverts_Lv_3)
		{
			DrawStaticModel:(Stadium_WallSign_SE_Lv_1,Stadium_Adverts_Lv_3)
			DrawStaticModel:(Stadium_WallSign_NE_Lv_1,Stadium_Adverts_Lv_3)
			DrawStaticModel:(Stadium_WallSign_NW_Lv_1,Stadium_Adverts_Lv_3)	
		}
	}
	Locator:((0,0,0),(0,-90,90),(1,1,1))
	{	
		//GateSign
		DrawStaticModel:(Stadium_WallSign_SW_Lv_1,Stadium_Adverts_Lv_3)
			M_TextureSelect:()
	}	
EndM

			//------------------------------------------------------------------------------Corner stands and bits that go with them
			Rect:()
				Layer(Ground)
				strvar(%rlayer)
				if(%currentFadeC <1.0)
				<
					set(%rlayer,Text)
				>
				else
				<
					set(%rlayer,RoofSolid)
				>
				selectchild(twk(Facilities,PitchCornersLevelVisible))
			{	
				Rect:() // Tier 0
				{
				//	M_Corners_012_WallSigns:()
				}

				Rect:() // Tier 1
				{
				//	M_Corners_012_WallSigns:()			AC: Shouldn't be needed. Go straight to T3
				}

				Rect:() // Tier 2
				{
					M_Corners_012_WallSigns:()

					Rect:() // HOME
						set(gel.vis,twk(Match,PlayerAtHome) = 1)
					{
						// Sign - colour bg name and badge
						//POSX,POSY,POSZ,ROTX,ROTY,ROTZ,BGW,BGH,BADGEX,BADGEY,BADGESIZE,TEXTX,TEXTY,TEXTW,FONTSIZE,FADE1X,FADE1Y,FADE1W,FADE1H,FADE2X,FADE2Y,FADE2W,FADE2H,SHADER
						M_StadTeamNameAndBadge:(2327,-2370,-317,0,-90,-90,348,45,30,22,42,210,-6,300,KNUL34,1,-1,-50,829,35,-1,50,829,45,ZSafeSprite,C,40)
							Layer(ZSprite)
					}

					//CheekyBurger
					M_FastFood:(1900,2960,CheekyBurger,FastFood,270)
					//HotDog
					M_FastFood:(2200,2650,HotDog,FastFood,180)
				}

				//-------------------------------------------------------------Corner Stands tier 3
				Rect:()
				{
			
					//Shadows
					Locator:((0,0,-1),(0,0,90),(1,1,1))
					{
						UseShader:(Simple3DNZW)
							Layer(Shadows)
						{
							Rect:()
								.set(gel.vis,twk(Facilities,Night) = 0)
							{
								Batch:(Corner_Shadows_3)
									Blend(ONE,INV_IMAGE_ALPHA)
								{
									DrawStaticModel:(Stadium_Seats_NE_Shadow_Lv_3,Stadium_T3_Shadows)
									DrawStaticModel:(Stadium_Seats_NW_Shadow_Lv_3,Stadium_T3_Shadows)
									DrawStaticModel:(Stadium_Seats_SE_Shadow_Lv_3,Stadium_T3_Shadows)
									DrawStaticModel:(Stadium_Seats_SW_Shadow_Lv_3,Stadium_T3_Shadows)
								}
							}
						}
					}
					
					//Seats
					Locator:((0,0,0),(0,0,90),(1,1,1))
					{
						Batch:(CornerSeats_3)
							M_TextureSelect:(Stadium_Lv_3)
						{
							DrawStaticModel:(Stadium_Seats_NE_Lv_3,Stadium_Lv_3)
							DrawStaticModel:(Stadium_Seats_NW_Lv_3,Stadium_Lv_3)
							DrawStaticModel:(Stadium_Seats_SE_Lv_3,Stadium_Lv_3)
							DrawStaticModel:(Stadium_Seats_SW_Lv_3,Stadium_Lv_3)
						}

				
						//Roof n Ads
						UseShader:(ProjectedLight3DVColFaded)
							set(gel.layer,%rlayer)
							SetSampler(TexSamp1,$CLOUDSHADOW)
							SetUniform1F(Fade,%currentFadeC)
						{
							DrawStaticModel:(Stadium_Signs_SW_Lv_3,Stadium_Adverts_Lv_3)	
								Blend(ONE,INV_IMAGE_ALPHA)
								M_TextureSelect:()

							Batch:(CornerRoofs_3)
								Blend(ONE,INV_IMAGE_ALPHA)
								M_TextureSelect:(Stadium_Lv_3)
							{
								DrawStaticModel:(Stadium_Roof_NE_Lv_3,Stadium_Lv_3)
								DrawStaticModel:(Stadium_Roof_NW_Lv_3,Stadium_Lv_3)
								DrawStaticModel:(Stadium_Roof_SE_Lv_3,Stadium_Lv_3)
								DrawStaticModel:(Stadium_Roof_SW_Lv_3,Stadium_Lv_3)
							}
						}
					}

					M_Crowd_Corner_3:()
					
				}

				//-------------------------------------------------------------Corner Stands tier 4
				Rect:()
				{
					//Shadows
					Locator:((0,0,-1),(0,0,90),(1,1,1))
					{
						UseShader:(Simple3DNZW)
							Layer(Shadows)
						{
							Rect:()
								.set(gel.vis,twk(Facilities,Night) = 0)
							{
								Batch:(Corner_Shadows_4)
									Blend(ONE,INV_IMAGE_ALPHA)
								{
									DrawStaticModel:(Stadium_Seats_NE_Shadow_Lv_4,Stadium_T4_Shadows)
									DrawStaticModel:(Stadium_Seats_NW_Shadow_Lv_4,Stadium_T4_Shadows)
									DrawStaticModel:(Stadium_Seats_SE_Shadow_Lv_4,Stadium_T4_Shadows)
									DrawStaticModel:(Stadium_Seats_SW_Shadow_Lv_4,Stadium_T4_Shadows)
								}
							}
						}
					}

					//Seats
					Locator:((0,0,0),(0,0,90),(1,1,1))
					{	
						Batch:(Corner_Seats_4)
							Blend(ONE,INV_IMAGE_ALPHA)
							M_TextureSelect:(Stadium_Lv_4)
						{
							DrawStaticModel:(Stadium_Seats_NE_Lv_4,Stadium_Lv_4)
							DrawStaticModel:(Stadium_Seats_SE_Lv_4,Stadium_Lv_4)
							DrawStaticModel:(Stadium_Seats_SW_Lv_4,Stadium_Lv_4)
						}
						DrawStaticModel:(Stadium_Seats_NW_Lv_4,Stadium_Lv_4)
							M_TextureSelectW:()

						//Roof n Ads
						UseShader:(ProjectedLight3DVColFaded)
							set(gel.layer,%rlayer)
							SetSampler(TexSamp1,$CLOUDSHADOW)
							SetUniform1F(Fade,%currentFadeC)
						{
							Batch:(Corner_Roofs_4)
								Blend(ONE,INV_IMAGE_ALPHA)
								M_TextureSelect:(Stadium_Lv_4)
							{
								DrawStaticModel:(Stadium_Roof_NE_Lv_4,Stadium_Lv_4)
								DrawStaticModel:(Stadium_Roof_SE_Lv_4,Stadium_Lv_4)
								DrawStaticModel:(Stadium_Roof_SW_Lv_4,Stadium_Lv_4)
							}
							DrawStaticModel:(Stadium_Roof_NW_Lv_4,Stadium_Lv_4)
								M_TextureSelectW:()
						}
					}

					M_Crowd_Corner_4:()

				}

				//-------------------------------------------------------------Corner Stands tier 5
				Rect:()
				{
					//Shadows
					Locator:((0,0,0),(0,0,90),(1,1,1))
					{
						UseShader:(Simple3DNZW)
							Layer(Shadows)
						{
							Rect:()
								.set(gel.vis,twk(Facilities,Night) = 0)
							{
								Batch:(Corner_Shadows_5)
									Blend(ONE,INV_IMAGE_ALPHA)
								{
									DrawStaticModel:(Stadium_Seats_NW_Shadow_Lv_5,Stadium_T5_Shadows)
									DrawStaticModel:(Stadium_Seats_SW_Shadow_Lv_5,Stadium_T5_Shadows)
									DrawStaticModel:(Stadium_Seats_NE_Shadow_Lv_5,Stadium_T5_Shadows)
									DrawStaticModel:(Stadium_Seats_SE_Shadow_Lv_5,Stadium_T5_Shadows)
								}
							}
						}
					}

					//Seats
					Locator:((0,0,0),(0,0,90),(1,1,1))
					{
						Batch:(Corner_Seats_5)
							Blend(ONE,INV_IMAGE_ALPHA)
							M_TextureSelect:(Stadium_Lv_5)
						{
							DrawStaticModel:(Stadium_Seats_NW_Lv_5,Stadium_Lv_5)
							DrawStaticModel:(Stadium_Seats_SW_Lv_5,Stadium_Lv_5)
							DrawStaticModel:(Stadium_Seats_NE_Lv_5,Stadium_Lv_5)
							DrawStaticModel:(Stadium_Seats_SE_Lv_5,Stadium_Lv_5)
						}
						
						//Roof n Ads
						UseShader:(ProjectedLight3DVColFaded)
							SetSampler(TexSamp1,$CLOUDSHADOW)
							SetUniform1F(Fade,%currentFadeC)
							set(gel.layer,%rlayer)
						{
							Batch:(Corner_Roofs_5)
								Blend(ONE,INV_IMAGE_ALPHA)
								M_TextureSelect:(Stadium_Lv_5)
								M_SeasonSSA:()
							{
								DrawStaticModel:(Stadium_Roof_NW_Lv_5,Stadium_Lv_5)
								DrawStaticModel:(Stadium_Roof_SW_Lv_5,Stadium_Lv_5)
								DrawStaticModel:(Stadium_Roof_NE_Lv_5,Stadium_Lv_5)
								DrawStaticModel:(Stadium_Roof_SE_Lv_5,Stadium_Lv_5)
							}
							##P4N
							Batch:(Corner_Roofs_5_Winter)
								Blend(ONE,INV_IMAGE_ALPHA)
								M_TextureSelect:(Stadium_Lv_5)
								M_SeasonW:()
							{
								DrawStaticModel:(Stadium_Roof_NW_Lv_5_Winter,Stadium_Lv_5)
								DrawStaticModel:(Stadium_Roof_SW_Lv_5_Winter,Stadium_Lv_5)
								DrawStaticModel:(Stadium_Roof_NE_Lv_5_Winter,Stadium_Lv_5)
								DrawStaticModel:(Stadium_Roof_SE_Lv_5_Winter,Stadium_Lv_5)
							}
							##*
						}
					}	

					M_Crowd_Corner_5:()

				}
			}
