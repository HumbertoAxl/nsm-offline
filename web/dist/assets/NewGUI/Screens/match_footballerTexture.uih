##*

Macro:(M_FootballerTexture,?ID?,?SKINCOL?,?HAIRCOL?,?KITSTYLE?,?KITCOL1?,?KITCOL2?,?SHORTSCOL?)
	Surf:($FOOTBALLERTEXTURESURF?ID?,128,128,True)

	View:($FOOTBALLERTEXTURESURF?ID?,256,256) ref:Texture
		RTTOnce()
	{
		Sheet:()
		{
			Cls:(#000000FF)
			Dissolve:()
			{
				Draw:(FootballerBoots,0,0,256,256,,#FFFFFFFF)
				Draw:(FootballerFace,0,0,256,256,,?SKINCOL?)
				Draw:(FootballerHair,0,0,256,256,,?HAIRCOL?)
				Draw:(FootballerShirt,0,0,256,256,,?KITCOL1?)

				Draw:(FootballerShirtStripesV,0,0,256,256,,?KITCOL2?)
					M_KitStyleImageSwitch:(?KITSTYLE?,"FootballerShirtStripesV","FootballerShirtStripesH","FootballerShirtSleeves","FootballerShirtChecks","FootballerShirtDiagonalHalf","FootballerShirtHorizontalHalf","FootballerShirtVerticalHalf","FootballerShirtVStripe","FootballerShirtCentreStripe","FootballerShirtSash","FootballerShirtQuarters")

				Draw:(FootballerShorts,0,0,256,256,,?SHORTSCOL?)
				Draw:(FootballerSocks,0,0,256,256,,?SHORTSCOL?)
			}
		}
	}
EndM