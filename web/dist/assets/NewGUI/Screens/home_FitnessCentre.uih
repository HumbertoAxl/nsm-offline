						//?POSX?,?POSY?,?POSZ?,?ROTX?,?ROTY?,?ROTZ?,?BGW?,?BGH?,?TEXTX?,?TEXTY?,?TEXTW?,?FONTSIZE?,?FSCALE?,?FADE1X?,?FADE1Y?,?FADE1W?,?FADE1H?,?FADE2X?,?FADE2Y?,?FADE2W?,?FADE2H?,?SHADER?
						M_TeamName:(900,-1442,-400,-90,-90,-90,645,80,330,0,635,KNUL64,1.2,-1,-50,829,35,-1,50,829,45,ZSafeSprite,,40)
							Layer(ZSprite)

						//Front Badge
						M_StadTeamBadge:(-884,-1220,-450,-125,-90,-90,380,ZSafeSprite,)
							Layer(ZSprite)
					}
					
					//Extras
					DrawStaticModel:(Fitness_Centre_Extra_Lv_6,Fitness_06)

					//Building Shadow
					UseShader:(Simple3DNZW)
						Layer(Shadows)
					{
						Locator:((1565,14467,0),(0,0,0),(1,1,1))
						{
							DrawStaticModel:(Fitness_Centre_Shadow_Lv_6,Fitness_06_Shadow)
								Blend(ONE,INV_IMAGE_ALPHA)
						}
					}

					
					//Tree Shadows
					UseShader:(Simple3DNZW)
						Layer(Shadows)
					{
						##IA
						DrawStaticModel:(Fitness_Centre_Trees_Shadow_Lv_6,GenTrees)
							Blend(ONE,INV_IMAGE_ALPHA)
						##P4N
						DrawStaticModel:(Fitness_Centre_Trees_Shadow_HI_Lv_6,Trees_HI)
							Blend(ONE,INV_IMAGE_ALPHA)
							M_TextureSelectW:()
						##*
					}

					//Trees STANDARD
					##IA
					UseShader:(ProjectedLight3DVColOneBit)
						Layer(OneBit)
						SetSampler(TexSamp1,$CLOUDSHADOW)
					{
						DrawStaticModel:(Fitness_Centre_Trees_Lv_6,GenTrees)
							Blend(ONE,INV_IMAGE_ALPHA)
					}
					//Trees HIGH DETAIL
					##P4N
					UseShader:(ProjectedLight3DVColOneBit_Alt)
						SetSampler(TexSamp1,$CLOUDSHADOW)
						Layer(OneBit)
					{
						DrawStaticModel:(Fitness_Centre_Trees_HI_Lv_6,Trees_HI)
							Blend(ONE,INV_IMAGE_ALPHA)
							M_TextureSelectW:()
					}
					##*	
					//Vehicles
					UseShader:(ProjectedLight3DVCol)
						SetSampler(TexSamp1,$CLOUDSHADOW)
						Layer(Ground)
					{
						Rect:()
							M_CheckShowCars:(FitnessCentre)
						{
							##IA
							Batch:(BatchedFitnessT6Cars)
								Blend(ONE,INV_IMAGE_ALPHA)
							{
								
								//Back
								M_Vehicle:(1565,12305,Car,Car,0,Purple)
								M_Vehicle:(1375,12305,Car,Car,182,Cyan)
								M_Vehicle:(1075,12305,Car,Car,-2,Orange)
								M_Vehicle:(905,12305,Car,Car,0,Green)
								M_Vehicle:(710,12305,Car,Car,180,Blue)
								//Front
								M_Vehicle:(1075,11685,Car,Car,0,Blue)
								M_Vehicle:(1375,11685,Car,Car,182,Red)
								M_Vehicle:(1565,11685,Car,Car,-2,White)
								M_Vehicle:(2055,11685,Car,Car,0,Blue)
								M_Vehicle:(2225,11685,Car,Car,180,Orange)
								M_Vehicle:(2740,11685,Car,Car,180,Black)
							}

							Batch:(BatchedFitnessT6Vans)
								Blend(ONE,INV_IMAGE_ALPHA)
							{
								//Back
								M_Vehicle:(2225,12305,Van,Van,0,Red)
							}
							##P4N
							Batch:(BatchedFitnessT6CarsHI)
								Blend(ONE,INV_IMAGE_ALPHA)
								M_TextureSelect:(NSM_CarSheet_HI)
							{	
								//Back
								M_Vehicle_HI:(1565,12305,Car3_Type2,Car,0)
								M_Vehicle_HI:(1375,12305,Car1_Type2,Car,182)
								M_Vehicle_HI:(1075,12305,Car2_Type1,Car,-2)
								M_Vehicle_HI:(905,12305,Car2_Type3,Car,0)
								M_Vehicle_HI:(710,12305,Car1_Type1,Car,180)
								//Front
								M_Vehicle_HI:(1075,11685,Car3_Type2,Car,0)
								M_Vehicle_HI:(1375,11685,Car1_Type3,Car,182)
								M_Vehicle_HI:(1565,11685,Car2_Type3,Car,-2)
								M_Vehicle_HI:(2055,11685,Car1_Type2,Car,0)
								M_Vehicle_HI:(2225,11685,Car2_Type1,Car,180)
								M_Vehicle_HI:(2740,11685,Car1_Type3,Car,180)
							}
							//Back
							M_Vehicle_HI_Single:(2225,12305,Van1_Type2,Van,0)
							##*
						}
					}
					


					//Running Track
					UseShader:(ProjectedLight3DVCol)
						Layer(AboveSky)
						SetSampler(TexSamp1,$CLOUDSHADOW)
					{
						Locator:((0,0,-1),(0,0,0),(1,1,1))
						{
							DrawStaticModel:(Fitness_Centre_Lines_Lv_3,Fitness_Track_02)
								Blend(ONE,INV_IMAGE_ALPHA)
								M_TextureSelectW:()
						}
					}
				
					M_FacilitySectionHotArea:(1150,14480,0,7.8,11.5,8,0,0,0,11,FitnessCentre,2,?FITNESS_CENTRE_SHOW_COLLIDERS?)
					M_FacilitySectionHotArea:(2550,14480,0,3.5,11.5,3.9,0,0,0,11,FitnessCentre,2,?FITNESS_CENTRE_SHOW_COLLIDERS?)
					M_FitnessConstruction6:()
				}
			}
		}
	}
EndM


