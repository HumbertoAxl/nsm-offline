//--------------------------------------------------------------------------------Fitness

//-------------------------------------TIER 3
View:(Fitness_03,512,512) 
##IA
	M_ONCE:()
##P4N
	if(twk(Facilities,Night) = 0)
	<
		M_ONCE:()
	>
	else
	<
		set(gel.vis,0)
	>
##*
{
	Sheet:()
	{
		Draw:(Fitness_T3_PrimaryCol,0,0,512,512,,#FFFFFFFFFFFFFFFF)
			set(gel.colour.RGBA,twk(Match,Team1Col))
	}
}
##P4N
View:(Fitness_03_Night,512,512) 
	if(twk(Facilities,Night) = 1)
	<
		M_ONCE:()
	>
	else
	<
		set(gel.vis,0)
	>
{
	Sheet:()
	{
		Draw:(Fitness_T3_PrimaryCol,0,0,512,512,,#FFFFFFFFFFFFFFFF)
			set(gel.colour.RGBA,twk(Match,Team1Col))
	}
}
##*


//-------------------------------------TIER 4
View:(Fitness_04,512,512) 
##IA
	M_ONCE:()
##P4N
	if(twk(Facilities,Night) = 0)
	<
		M_ONCE:()
	>
	else
	<
		set(gel.vis,0)
	>
##*
{
	Sheet:()
	{
		Draw:(Fitness_T4_PrimaryCol,0,0,512,512,,#FFFFFFFFFFFFFFFF)
			set(gel.colour.RGBA,twk(Match,Team1Col))
	}
}
##P4N
View:(Fitness_04_Night,512,512)
	if(twk(Facilities,Night) = 1)
	<
		M_ONCE:()
	>
	else
	<
		set(gel.vis,0)
	>
{
	Sheet:()
	{
		Draw:(Fitness_T4_PrimaryCol,0,0,512,512,,#FFFFFFFFFFFFFFFF)
			set(gel.colour.RGBA,twk(Match,Team1Col))
	}
}
