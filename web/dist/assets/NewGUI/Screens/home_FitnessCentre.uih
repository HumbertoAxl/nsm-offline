//Make This Define Equal to a Texture to show the colliders for the fitness centre
Define:(?FITNESS_CENTRE_SHOW_COLLIDERS?=) 

//----------------------------------Club Shop Macro
Macro:(M_FitnessCentre,?SCALE?)
	//Developed Facility 1
	Locator:((0,0,0),(0,0,0),(?SCALE?,?SCALE?,?SCALE?))
		Unload(Fitness_01_Shadow,Fitness_02_Shadow,Fitness_03_Shadow,Fitness_04_Shadow,Fitness_05_Shadow,Fitness_06_Shadow)
		Unload(Fitness_01,Fitness_02,Fitness_05,Fitness_06)
		Unload(Fitness_05_ROOF,Fitness_06_ROOF)
	{
		UseShader:(ProjectedLight3DVCol)
			SetSampler(TexSamp1,$CLOUDSHADOW)
		{
			
			Rect:()
				Layer(Ground)
				M_FacilityConstructionController:(FitnessCentre,2)
			{
				//-----------------------------------------------------Tier 0
				Rect:()
				{
					//Base
					##IA
					DrawStaticModel:(Fitness_Centre_Base_Lv_0,GenBase)
					##P4N
					DrawStaticModel:(Fitness_Centre_Base_HI_Lv_0,Base_HI)
						M_TextureSelectW:()
					##*

					//Fitness Centre Selection Hint
					M_AreaSelection:(550,13800,-2,2,FitnessCentre,27,20,0,0,180,Fitness,575)

					//Tree Shadows
					UseShader:(Simple3DNZW)
						Layer(Shadows)
					{
						##IA
						DrawStaticModel:(Fitness_Centre_Trees_Shadow_Lv_0,GenTrees)
							Blend(ONE,INV_IMAGE_ALPHA)
						##P4N
						DrawStaticModel:(Fitness_Centre_Trees_Shadow_HI_Lv_0,Trees_HI)
							Blend(ONE,INV_IMAGE_ALPHA)
							M_TextureSelectW:()
						##*
					}
				
					//Trees STANDARD
					##IA
					UseShader:(ProjectedLight3DVColOneBit)
						Layer(OneBit)
						SetSampler(TexSamp1,$CLOUDSHADOW)
					{
						DrawStaticModel:(Fitness_Centre_Trees_Lv_0,GenTrees)
							Blend(ONE,INV_IMAGE_ALPHA)
					}
					//Trees HIGH DETAIL
					##P4N
					UseShader:(ProjectedLight3DVColOneBit_Alt)
						SetSampler(TexSamp1,$CLOUDSHADOW)
						Layer(OneBit)
					{
						DrawStaticModel:(Fitness_Centre_Trees_HI_Lv_0,Trees_HI)
							Blend(ONE,INV_IMAGE_ALPHA)
							M_TextureSelectW:()
					}
					##*	
						
					M_FacilitySectionHotArea:(550,13800,0,26,20,10,0,0,0,11,FitnessCentre,2,?FITNESS_CENTRE_SHOW_COLLIDERS?)
				}
		

				//-----------------------------------------------------Tier 1
		
				Rect:()
				{
					//Base
					##IA
					DrawStaticModel:(Fitness_Centre_Base_Lv_1,GenBase)
					##P4N
					DrawStaticModel:(Fitness_Centre_Base_HI_Lv_1,Base_HI)
						M_TextureSelectW:()
					##*

					Locator:((775,15060,0),(0,0,0),(1,1,1))
						set(gel.vis,(twk(FitnessCentreConstruction,LastConstructionLevel) != 0) or(shell("Facility")!=""))
					{
						//Building Shadow
						DrawStaticModel:(Fitness_Centre_Shadow_Lv_1,Fitness_01_Shadow)
							Blend(ONE,INV_IMAGE_ALPHA)

						//Building
						DrawStaticModel:(Fitness_Centre_Lv_1,Fitness_01)
							M_TextureSelectW:()
						DrawStaticModel:(Fitness_Centre_Railing_Lv_1,Fitness_01_RAILING)
							Blend(ONE,INV_IMAGE_ALPHA)

						//Side Badge
						M_StadTeamBadge:(467,150,-145,0,-90,-90,150,ZSafeSprite,)
							Layer(ZSprite)
					}
					
					//Tree Shadows
					UseShader:(Simple3DNZW)
						Layer(Shadows)
					{
						##IA
						DrawStaticModel:(Fitness_Centre_Trees_Shadow_Lv_1,GenTrees)
							Blend(ONE,INV_IMAGE_ALPHA)
						##P4N
						DrawStaticModel:(Fitness_Centre_Trees_Shadow_HI_Lv_1,Trees_HI)
							Blend(ONE,INV_IMAGE_ALPHA)
							M_TextureSelectW:()
						##*
					}

					//Trees STANDARD
					##IA
					UseShader:(ProjectedLight3DVColOneBit)
						Layer(OneBit)
						SetSampler(TexSamp1,$CLOUDSHADOW)
					{
						DrawStaticModel:(Fitness_Centre_Trees_Lv_1,GenTrees)
							Blend(ONE,INV_IMAGE_ALPHA)
					}
					//Trees HIGH DETAIL
					##P4N
					UseShader:(ProjectedLight3DVColOneBit_Alt)
						SetSampler(TexSamp1,$CLOUDSHADOW)
						Layer(OneBit)
					{
						DrawStaticModel:(Fitness_Centre_Trees_HI_Lv_1,Trees_HI)
							Blend(ONE,INV_IMAGE_ALPHA)
							M_TextureSelectW:()
					}
					##*	
					//Vehicles
					UseShader:(ProjectedLight3DVCol)
						SetSampler(TexSamp1,$CLOUDSHADOW)
						Layer(Ground)
					{
						Rect:()
							M_CheckShowCars:(FitnessCentre)
						{
							##IA
							Batch:(BatchedFitnessT1Cars)
								Blend(ONE,INV_IMAGE_ALPHA)
							{
								//Back
								M_Vehicle:(2405,12305,Car,Car,182,Green)
								
								//Front
								M_Vehicle:(2225,11685,Car,Car,180,Purple)
								M_Vehicle:(2750,11685,Car,Car,0,Cyan)
							}
							//Back
							M_Vehicle:(2935,11685,Van,Van,180,White)
							##P4N
							Batch:(BatchedFitnessT1CarsHI)
								Blend(ONE,INV_IMAGE_ALPHA)
								M_TextureSelect:(NSM_CarSheet_HI)
							{
								//Back
								M_Vehicle_HI:(2405,12305,Car1_Type1,Car,182)
								//Front
								M_Vehicle_HI:(2225,11685,Car2_Type2,Car,180)
								M_Vehicle_HI:(2750,11685,Car3_Type1,Car,0)
							}
							//Back
							M_Vehicle_HI_Single:(2935,11685,Van1_Type1,Van,180)
							##*
						}
					}
					

					//Running Track
					UseShader:(ProjectedLight3DVCol)
						Layer(AboveSky)
						SetSampler(TexSamp1,$CLOUDSHADOW)
					{
						Locator:((0,0,-2),(0,0,0),(1,1,1))
						{
							DrawStaticModel:(Fitness_Centre_Lines_Lv_1,Fitness_Track_01)
								Blend(ONE,INV_IMAGE_ALPHA)
								M_TextureSelectW:()
						}
					}
											
					M_FacilitySectionHotArea:(730,15070,0,4.1,2.7,2.2,0,0,0,11,FitnessCentre,2,?FITNESS_CENTRE_SHOW_COLLIDERS?)
					M_FacilitySectionHotArea:(1300,15100,0,0.5,1.8,0.8,0,0,0,11,FitnessCentre,2,?FITNESS_CENTRE_SHOW_COLLIDERS?)
					M_FitnessConstruction1:(1)
				}
		

				//-----------------------------------------------------Tier 2
				Rect:()
				{
					//Base
					##IA
					DrawStaticModel:(Fitness_Centre_Base_Lv_2,GenBase)
					##P4N
					DrawStaticModel:(Fitness_Centre_Base_HI_Lv_2,Base_HI)
						M_TextureSelectW:()
					##*
					
					Locator:((880,15160,0),(0,0,0),(1,1,1))
					{
						//Building
						DrawStaticModel:(Fitness_Centre_Lv_2,Fitness_02)
							M_TextureSelectW:()

						//Side Badge
						M_StadTeamBadge:(687,-50,-145,0,-90,-90,160,ZSafeSprite,)
							Layer(ZSprite)

						//Front Sign and badge
						//POSX,POSY,POSZ,ROTX,ROTY,ROTZ,BGW,BGH,BADGEX,BADGEY,BADGESIZE,TEXTX,TEXTY,TEXTW,FONTSIZE,FADE1X,FADE1Y,FADE1W,FADE1H,FADE2X,FADE2Y,FADE2W,FADE2H,SHADER,Stand,ShadeCol
