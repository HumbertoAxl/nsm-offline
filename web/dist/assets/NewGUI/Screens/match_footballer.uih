Macro:(M_FootballerAnim,?SEQNAME?,?ANIMLENGTH?,?ANIMTYPE?,?SEQSTART?,?SEQEND?)
	Animation:(?ANIMLENGTH?,?ANIMTYPE?) ref:Footballer?SEQNAME?
	{
		ModelSequence:(FootballerModel,?SEQNAME?,?SEQSTART?,?SEQEND?) ref:?SEQNAME?
	}
EndM



