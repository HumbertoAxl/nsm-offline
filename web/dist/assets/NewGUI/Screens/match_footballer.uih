Macro:(M_Footballer,?ID?,?XSCALE?,?YSCALE?,?ZSCALE?)
	Rect:() ref:Footballer
		float(%x,%y,%z)
	{
		Rect:()
			Layer(FootballerPrep)
		{
			ApplyModelAnim:(FootballerBuff?ID?,0,FootballerStandIdle,1) ref:Anim
			ApplyModelAnim:(FootballerBuff?ID?,1,FootballerStandIdle,0) ref:Anim
		}

		M_CommonNonLocatorDraws:()

		M_PlayerShadow:(FootballerBuff?ID?,$FOOTBALLERSHADOWSURF?ID?)

		UseShader:(Anim3D)
			inherit(%CX,%CY,%CZ)
			//SetSampler(TexSamp1,RefMap)
			SetUniform4F(campos,%CX,%CY,%CZ)
			SetUniform4F(SpecParams,0.7)
		{
			Locator:((0,0,0),(0,0,0),(?XSCALE?,?YSCALE?,?ZSCALE?)) ref:Loc
				Layer(Players)
				set(gel3d.x,%x)
				set(gel3d.y,%y)
				set(gel3d.z,%z)
			{
				M_CommonLocatorDraws:()

				DrawModel:(FootballerBuff?ID?,$FOOTBALLERTEXTURESURF?ID?)
				{
					//UseShader:(Static3D)
					//	SetSampler(TexSamp1,RefMapBlur)
					//	SetUniform4F(campos,%CX,%CY,%CZ,1)
					//	SetUniform4F(SpecParams,1.2)
					//{
						// Centre Collider - needs to hit this to check other colliders
						Locator:((0,0,-30),(0,0,0),(8,8,8),3) ref:Loc
						{
						  	//DrawStaticModel:(Football_Low,White)
						}

						// Left Foot
						Locator:((0,0,0),(0,0,0),(1.2,1.2,1.2),0) ref:Loc
						{
							//DrawStaticModel:(Football_Low,White)
						}
						//Right Foot
						Locator:((0,0,0),(0,0,0),(1.2,1.2,1.2),1) ref:Loc
						{
							//DrawStaticModel:(Football_Low,White)
						}
						// Middle Foot
						Locator:((0,50,50),(0,0,0),(3.6,3.6,3.6),2) ref:Loc
						{
							//DrawStaticModel:(Football_Low,White)
						}
					//}
				}
			}
		}
	}
EndM