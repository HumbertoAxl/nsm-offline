Macro:(M_ScoutConstruction01,?NUM?)
	//ScoutsOfficeScaffold Tier1
	Rect:()
		M_CheckShowConstruction:(ScoutsOffice,?NUM?)
	{
		Locator:((-10650,8780,0),(0,0,90),(1,1,1))
		{
			//Base
			M_ConstructionBase_new:(0,150,-13,0,0,110,1.7,1.7,0.3)
									
			//Digger
			M_ConstructionObjPop_new:(-1200,-650,0,120,ConstructionPop,Diggerpop,Construction_Digger,Construction_Sheet01,Shadowpop,0.4,1,1,1)

			//Cement Truck
