//Make This Define Equal to a Texture to show the colliders for the scouts office
Define:(?SCOUTS_OFFICE_SHOW_COLLIDERS?=) 

//----------------------------------Medical Unit Macro
Macro:(M_ScoutsOffice,?SCALE?)
	Locator:((0,0,0),(0,0,0),(?SCALE?,?SCALE?,?SCALE?))
		Unload(Scout_01_Shadow,Scout_02_Shadow,Scout_03_Shadow,Scout_04_Shadow,Scout_05_Shadow,Scout_06_Shadow)
		Unload(Scout_01,Scout_02,Scout_03,Scout_04,Scout_05,Scout_06)
		Unload(Scout_06_ROOF)
	{
		UseShader:(ProjectedLight3DVCol)
			SetSampler(TexSamp1,$CLOUDSHADOW)
		{

			Rect:()
				Layer(Ground)
				M_FacilityConstructionController:(ScoutsOffice,4)
			{
				//-----------------------------------------------------Tier 0
				Rect:()
				{
					//Base
					##IA
					DrawStaticModel:(Scouts_Office_Base_Lv_0,GenBase)
					##P4N
					DrawStaticModel:(Scouts_Office_Base_HI_Lv_0,Base_HI)
						M_TextureSelectW:()
					##*

					//Scouts Office Selection Hint
					M_AreaSelection:(-10600,9400,-2,4,ScoutsOffice,27,20,0,0,180,Scout,575)
					
					//Tree Shadows
					UseShader:(Simple3DNZW)
						Layer(Shadows)
					{
						##IA
						DrawStaticModel:(Scouts_Office_Trees_Shadow_Lv_0,GenTrees)
							Blend(ONE,INV_IMAGE_ALPHA)
						##P4N
						DrawStaticModel:(Scouts_Office_Trees_Shadow_HI_Lv_0,Trees_HI)
							Blend(ONE,INV_IMAGE_ALPHA)
							M_TextureSelectW:()
						##*
					}

					//Trees STANDARD
					##IA
					UseShader:(ProjectedLight3DVColOneBit)
						Layer(OneBit)
						SetSampler(TexSamp1,$CLOUDSHADOW)
					{
						DrawStaticModel:(Scouts_Office_Trees_Lv_0,GenTrees)
							Blend(ONE,INV_IMAGE_ALPHA)
					}
					//Trees HIGH DETAIL
					##P4N
					UseShader:(ProjectedLight3DVColOneBit_Alt)
						SetSampler(TexSamp1,$CLOUDSHADOW)
						Layer(OneBit)
					{
						DrawStaticModel:(Scouts_Office_Trees_HI_Lv_0,Trees_HI)
							Blend(ONE,INV_IMAGE_ALPHA)
							M_TextureSelectW:()
					}
					##*	

					M_FacilitySectionHotArea:(-11600,9700,0,36,31,10,0,0,0,13,ScoutsOffice,4,?SCOUTS_OFFICE_SHOW_COLLIDERS?)
					M_ScoutConstruction01:(0)
				}


				//-----------------------------------------------------Tier 1
				Rect:()
				{
					//Base
					##IA
					DrawStaticModel:(Scouts_Office_Base_Lv_1,GenBase)
					##P4N
					DrawStaticModel:(Scouts_Office_Base_HI_Lv_1,Base_HI)
						M_TextureSelectW:()
					##*

					//Building
					Locator:((-10650,8780,0),(0,0,0),(1,1,1))
					{
						DrawStaticModel:(Scouts_Office_Lv_1,Scout_01)
							M_TextureSelectW:()

						DrawStaticModel:(Scouts_Office_Railing_Lv_1,Scout_01_RAILING)
							Blend(ONE,INV_IMAGE_ALPHA)
						
						//Front Badge
						M_StadTeamBadge:(75,-195,-150,-90,-90,-90,100,ZSafeSprite,)
							Layer(ZSprite)
					}
					
					//Building Shadow
					UseShader:(Simple3DNZW)
						Layer(Shadows)
					{
						Locator:((-10650,8780,0),(0,0,0),(1,1,1))
						{
							DrawStaticModel:(Scouts_Office_Shadow_Lv_1,Scout_01_Shadow)
								Blend(ONE,INV_IMAGE_ALPHA)
						}
					}

					//Tree Shadows
					UseShader:(Simple3DNZW)
						Layer(Shadows)
					{
						##IA
						DrawStaticModel:(Scouts_Office_Trees_Shadow_Lv_1,GenTrees)
							Blend(ONE,INV_IMAGE_ALPHA)
						##P4N
						DrawStaticModel:(Scouts_Office_Trees_Shadow_HI_Lv_1,Trees_HI)
							Blend(ONE,INV_IMAGE_ALPHA)
							M_TextureSelectW:()
						##*
					}

					//Trees STANDARD
					##IA
					UseShader:(ProjectedLight3DVColOneBit)
						Layer(OneBit)
						SetSampler(TexSamp1,$CLOUDSHADOW)
					{
						DrawStaticModel:(Scouts_Office_Trees_Lv_1,GenTrees)
							Blend(ONE,INV_IMAGE_ALPHA)
					}
					//Trees HIGH DETAIL
					##P4N
					UseShader:(ProjectedLight3DVColOneBit_Alt)
						SetSampler(TexSamp1,$CLOUDSHADOW)
						Layer(OneBit)
					{
						DrawStaticModel:(Scouts_Office_Trees_HI_Lv_1,Trees_HI)
							Blend(ONE,INV_IMAGE_ALPHA)
							M_TextureSelectW:()
					}
					##*
					//Vehicles
					Rect:()
						Layer(Ground)	
						M_CheckShowCars:(ScoutsOffice)
					{
						##IA
						Batch:(BatchedScoutsOfficeT1Cars)
							Blend(ONE,INV_IMAGE_ALPHA)
	    				{
	    					//Right Side				
	  						M_Vehicle:(-11040,7055,Car,Car,90,Blue)
	  									
	    					//Left Side
	    					M_Vehicle:(-10415,7050,Car,Car,-90,Purple)
	    					M_Vehicle:(-10415,6552,Car,Car,92,Black)		
	    				}
	    				//Vans
		  				M_Vehicle:(-11040,6790,Van,Van,-92,Red)
		  				##P4N
						Batch:(BatchedScoutsOfficeT1CarsHI)
							Blend(ONE,INV_IMAGE_ALPHA)
							M_TextureSelect:(NSM_CarSheet_HI)
	    				{
	    					//Right Side				
	  						M_Vehicle_HI:(-11040,7755,Car1_Type2,Car,90)
	  									
	    					//Left Side
	    					M_Vehicle_HI:(-10415,7750,Car2_Type3,Car,-90)
	    					M_Vehicle_HI:(-10415,7052,Car3_Type1,Car,92)		
	    				}
	    				//Vans
		  				M_Vehicle_HI_Single:(-11040,7390,Van1_Type2,Van,-92)
		  				##*
  					}
  					

					M_FacilitySectionHotArea:(-10650,8845,0,3.5,2.1,2.5,0,0,0,13,ScoutsOffice,4,?SCOUTS_OFFICE_SHOW_COLLIDERS?)
					M_FacilitySectionHotArea:(-10625,8570,0,1.6,0.9,1,0,0,0,13,ScoutsOffice,4,?SCOUTS_OFFICE_SHOW_COLLIDERS?)
					M_ScoutConstruction01:(1)
				}

				//-----------------------------------------------------Tier 2
				Rect:()
				{
					//Base
					##IA
					DrawStaticModel:(Scouts_Office_Base_Lv_2,GenBase)
					##P4N
					DrawStaticModel:(Scouts_Office_Base_HI_Lv_2,Base_HI)
						M_TextureSelectW:()
					##*

					//Building
					Locator:((-10480,8750,0),(0,0,0),(1,1,1))
					{
						DrawStaticModel:(Scouts_Office_Lv_2,Scout_02)
							M_TextureSelectW:()

						//TeamName
						//?POSX?,?POSY?,?POSZ?,?ROTX?,?ROTY?,?ROTZ?,?BGW?,?BGH?,?BADGEX?,?BADGEY?,?BADGESIZE?,?TEXTX?,?TEXTY?,?TEXTW?,?FONTSIZE?,?FSCALE?,?FADE1X?,?FADE1Y?,?FADE1W?,?FADE1H?,?FADE2X?,?FADE2Y?,?FADE2W?,?FADE2H?,?SHADER?,?STAND?)
						M_StadTeamNameAndBadge:(130,-345,-320,-90,-90,-90,700,90,65,44,85,406,7,680,KNUL64,1,-1,-50,829,35,-1,50,829,45,ZSafeSprite,,40)
							Layer(ZSprite)
					}
					
					//Building Shadow
					UseShader:(Simple3DNZW)
						Layer(Shadows)
					{
						Locator:((-10480,8750,0),(0,0,0),(1,1,1))
						{
							DrawStaticModel:(Scouts_Office_Shadow_Lv_2,Scout_02_Shadow)
								Blend(ONE,INV_IMAGE_ALPHA)
						}
					}

					//Tree Shadows
					UseShader:(Simple3DNZW)
						Layer(Shadows)
					{
						##IA
						DrawStaticModel:(Scouts_Office_Trees_Shadow_Lv_2,GenTrees)
							Blend(ONE,INV_IMAGE_ALPHA)
						##P4N
						DrawStaticModel:(Scouts_Office_Trees_Shadow_HI_Lv_2,Trees_HI)
							Blend(ONE,INV_IMAGE_ALPHA)
							M_TextureSelectW:()
						##*
					}

					//Trees STANDARD
					##IA
					UseShader:(ProjectedLight3DVColOneBit)
						Layer(OneBit)
						SetSampler(TexSamp1,$CLOUDSHADOW)
					{
						DrawStaticModel:(Scouts_Office_Trees_Lv_2,GenTrees)
							Blend(ONE,INV_IMAGE_ALPHA)
					}
					//Trees HIGH DETAIL
					##P4N
					UseShader:(ProjectedLight3DVColOneBit_Alt)
						SetSampler(TexSamp1,$CLOUDSHADOW)
						Layer(OneBit)
					{
						DrawStaticModel:(Scouts_Office_Trees_HI_Lv_2,Trees_HI)
							Blend(ONE,INV_IMAGE_ALPHA)
							M_TextureSelectW:()
					}
					##*
					//Vehicles
					Rect:()
						Layer(Ground)
						M_CheckShowCars:(ScoutsOffice)
					{
						##IA
						Batch:(BatchedScoutsOfficeT2Cars)
							Blend(ONE,INV_IMAGE_ALPHA)
	    				{
	    					//Right Side				
	  						M_Vehicle:(-11040,6755,Car,Car,90,Green)
	  									
	    					//Left Side
	    					M_Vehicle:(-10415,6750,Car,Car,-90,Blue)
	    					M_Vehicle:(-10415,6542,Car,Car,-90,Orange)
	    					M_Vehicle:(-10415,6952,Car,Car,92,Red)		
	    				}
	    				//Vans
		  				M_Vehicle:(-11040,7090,Van,Van,-92,Green)
		  				##P4N
						Batch:(BatchedScoutsOfficeT2CarsHI)
							Blend(ONE,INV_IMAGE_ALPHA)
							M_TextureSelect:(NSM_CarSheet_HI)
	    				{
	    					//Right Side				
	  						M_Vehicle_HI:(-11040,7755,Car1_Type1,Car,90)
	  									
	    					//Left Side
	    					M_Vehicle_HI:(-10415,7750,Car2_Type1,Car,-90)
	    					M_Vehicle_HI:(-10415,7392,Car1_Type2,Car,-90)
	    					M_Vehicle_HI:(-10415,7052,Car3_Type1,Car,92)		
	    				}
	    				//Vans
		  				M_Vehicle_HI_Single:(-11040,7390,Van1_Type1,Van,-92)
		  				##*
  					}
  					

					M_FacilitySectionHotArea:(-10480,8750,0,4.9,3,2.8,0,0,0,13,ScoutsOffice,4,?SCOUTS_OFFICE_SHOW_COLLIDERS?)
					M_ScoutConstruction2:()
				}
					
				//-----------------------------------------------------Tier 3
				Rect:()
				{
					//Base
					##IA
					DrawStaticModel:(Scouts_Office_Base_Lv_3,GenBase)
					##P4N
					DrawStaticModel:(Scouts_Office_Base_HI_Lv_3,Base_HI)
						M_TextureSelectW:()
					##*

					//Building
					Locator:((-10380,8790,0),(0,0,0),(1,1,1))
					{
						DrawStaticModel:(Scouts_Office_Lv_3,Scout_03)
							M_TextureSelectW:()
						//Front Badge
						M_StadTeamBadge:(0,-490,-365,-90,-90,-90,170,ZSafeSprite,)
							Layer(ZSprite)
					}
					
					//Building Shadow
					UseShader:(Simple3DNZW)
