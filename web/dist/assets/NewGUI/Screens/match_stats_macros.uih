Macro:(M_StatisticRow,?X?,?Y?,?TITLE?,?CAT?)
	Rect:(?X?,?Y?,650,40) ref:?CAT?
		float(%homeStat,%awayStat)
	{{
		M_Text:(?TITLE?,@C,-13,0,0,C,C,TextLoc,KNUL23,Upper,1,0,#252525FF,NoItalics,#252525FF,ref)

		M_Text:("",@C-355,5,0,0,C,C,Text,KNUL30,,1,0,#000000FF,NoItalics,#000000FF,ref)
			.set(gel.text,LTR(fmt(%homeStat,X)))

		M_Text:("",@C+355,5,0,0,C,C,Text,KNUL30,,1,0,#000000FF,NoItalics,#000000FF,ref)
			.set(gel.text,LTR(fmt(%awayStat,X)))

		Draw:(White,-1,-1,@W+2,16,,#252525CCFFFFFFFF)

		// Away Bar
		Draw:(White,0,0,@W,14,,#FFFFFFFFFFFFFFFF)
			.set(gel.colour.RGBA,twk(Match,Team2ShirtCol1))

		Clip:(0,-10,@W,30)
		{
			Draw:(Stat_Highlight,0,0,-650,14,,#FFFFFF80FFFFFFFF)
				Handle(0.5,0)
				if((%homeStat = 0) and(%awayStat = 0))
				<
					.set(gel.x,[@W/2])
					.set(gel.scalex,0.5)
				>
				else
				<
					.set(gel.x,[@W/[%homeStat+%awayStat]]*%homeStat)
					.set(gel.scalex,[1.5/[%homeStat+%awayStat]]*%awayStat)
				>
		}

		// Home Bar
		Clip:(0,-10,@W,30)
			.set(gel.w,[@W/2])
			if(%homeStat=0 and(%awayStat=0))
			<
				.set(gel.w,[@W/2])
			>
			else
			<
				.set(gel.w,[@W/[%homeStat+%awayStat]]*%homeStat)
			>
		{
			Draw:(White,0,0,@W,14,,#FFFFFFFFFFFFFFFF)
				.set(gel.colour.RGBA,twk(Match,Team1ShirtCol1))

			Draw:(Stat_Highlight,0,0,-650,14,,#FFFFFF80FFFFFFFF)
				Handle(0.5,0)
				if((%homeStat = 0) and(%awayStat = 0))
				<
					.set(gel.x,[@W/2])
					.set(gel.scalex,0.5)
				>
				else
				<
					.set(gel.x,[@W/[%homeStat+%awayStat]]*%homeStat)
					.set(gel.scalex,[1.5/[%homeStat+%awayStat]]*%homeStat)
				>
		}

		// Centre Line
		Draw:(White,0,0,2,14,,#252525FFFFFFFFFF)
			if((%homeStat = 0) and(%awayStat = 0))
			<
				.set(gel.x,[@W/2]-1)
			>
			elif((%homeStat = 0) or(%awayStat = 0))
			<
				set(gel.vis,0)
			>
			else
			<
				.set(gel.x,fmt([@W/[%homeStat+%awayStat]]*%homeStat,X)-1)
			>>
			
		// Inner shadow
		Draw:(Fade_Down,0,0,@W,5,,#00000040FFFFFFFF)
		Draw:(Fade_Down,0,14,@W,-5,,#00000040FFFFFFFF)
	}}
EndM