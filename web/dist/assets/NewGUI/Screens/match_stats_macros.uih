Macro:(M_BadgeBackground,?POSX?,?POSY?,?ANG?,?SHIELDCOLOUR?)
	Rect:(?POSX?,?POSY?)
	{{
		Rect:()
		{
			PushOrigin:(0,0)
				Rect:()
				{
					Draw:(White,-190,0,160,40,,?SHIELDCOLOUR?)		
						Handle(0.5,0.5)
						if(twk(Club,Sponsor1Id) <= 0)
						<
							set(gel.img,"MSG_News_NSAdvertiser_Right")
							set(gel.y,75)
							set(gel.scaley,1)
							Spinner(1)
						>
						else
						<
							set(gel.img,"Sponsor_" :: twk(Club,Sponsor1Id))
							set(gel.y,75)
							set(gel.scaley,1.55)
