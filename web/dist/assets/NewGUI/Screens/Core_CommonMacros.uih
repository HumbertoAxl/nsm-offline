Macro:(M_FTUEDisableButton,?POSTENABLE?,?POSTDISABLE?)
	If:(?POSTDISABLE?)
		OnPost(?POSTDISABLE?)
		<
			set(%disabled,1)
		>
	EndIf
	If:(?POSTENABLE?)
		OnPost(?POSTENABLE?)
		<
			set(%disabled,0)
		>
	EndIf
EndM


