//----------------------------------------------------------------------------------LOCAL IMAGE DEFS
Rect:()
	set(gel.vis,twk(Negotiate,InProgress) = 0 and(twk(ProfileStaff,IsPotentialHire) and((not(twk(ProfileStaff,Sku)="")))))
{
	// TABS
	Rect:(0,350,@W,215+@z)
	{{
		Draw:(Tab_BG50,@f,-2,@w,58)
	}}





	// TABS CONTENT
	Rect:(0,401+[@z/2],@W,235)
	{{
		// Contracts
		Rect:(@C-[@W/4],5,[@W/2],@H)
		{{
			Tile:(White,0,15,@W,1,,#0000001A)
				Copies(1,3)
				Spacing(0,50)
			
			M_Text:(profile_NEWCONTRACT,0,40,0,0,L,C,TextLoc,KNUL25,,0,0,#00000000,NoItalics,#505050FF,ref)
			M_Text:(,0,40,@W,0,R,C,Text,KNUL25,,1,0,#252525FF,NoItalics,#252525FF,ref,ProfileStaff,Value)

			Rect:()
				strvar(%BUTTONTEXT)
				init(%BUTTONTEXT,"")
			{
				M_Button:(@C,177,220,85,Button_GreenSliced,Blank,20,2,50,50,#252525FF,profilestaff.btn_PurchaseIAP,IAPStaffBuyButton,(%BUTTONTEXT),0,3,C,C,TextBox,KNUL22,Upper,0,0,#00000000,NoItalics,#FFFFFFFF,textref)
					M_CTRLButtonExtra:(?BTNOK?,true,CTRLButtonSelected,3,3,6,6)
					CTRLBlock(LEFT,RIGHT)
					if(twk(ProfileStaff,Type) oneof(0,1,2))
					<
						:set(%BUTTONTEXT,loc(profile_staff_BUY_COACH))
					>
					elif(twk(ProfileStaff,Type) = 3)
					<
						:set(%BUTTONTEXT,loc(profile_staff_BUY_SCOUT))
					>
					elif(twk(ProfileStaff,Type) = 4)
					<
						:set(%BUTTONTEXT,loc(profile_staff_BUY_PHYSIO))
					>>>
					CTRLPress(UP)
					<
						CTRLSetSelected(StaffPrevButton)
						Post(CTRLNavigate)
					>
			}
		}}
	}}
}