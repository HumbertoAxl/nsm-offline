Import:(badge_Macros.uih)
Import:(templates_combo.uih)
//--------------------------------------------------------------------------------------------LEAGUE
Img:(Icon_PosUp,NewGUI/UI/Icons/Icon_PosUp.png)
Img:(Icon_PosDown,NewGUI/UI/Icons/Icon_PosDown.png)
Img:(Icon_PosSame,NewGUI/UI/Icons/Icon_PosSame.png)
Img:(Cell_Stripe,NewGUI/UI/Cells/Cell_Stripe.png)

Macro:(M_ArrowSwitch,?X?,?Y?,?INC_MSG?,?DEC_MSG?)
	PushOrigin:(?X?,?Y?)
		Rect:(-160,0,160,55)
			float(%pressed)
			Press()
			<
				:set(%pressed,1)
			>
			else
			<
				:set(%pressed,0)
			>
			M_RepeatPressAction:(?DEC_MSG?)
		{{
			Draw:(Fade_Right,0,0,160,40,#FFFFFF00)
				Additive()
				if(%pressed)
				<
					frlerp(gel.alpha,0.15,0.25)
				>
				else
				<
					:set(gel.alpha,0)
				>
			Draw:(White,0,3,1,34,,#999999FF)
				set(gel.vis,twk(ControllerInput,Enabled) = 0)

			M_Text:("<",42,20,0,0,C,C,Text,KNUL25,,0,0,#00000000,NoItalics,#FFFFFFFF000000FF,ref)
				if(%pressed)
				<
					frlerp(gel.scale,1.4,0.25)
				>
				else
				<
					:set(gel.scale,1)
				>	
			M_SwitchButtonHint:(⛎,0,5)
			M_CTRLButtonExtra:(LB,false)
		}}

		Rect:(0,0,160,55)
			float(%pressed)
			Press()
			<
				:set(%pressed,1)
			>
			else
			<
				:set(%pressed,0)
			>
			M_RepeatPressAction:(?INC_MSG?)
		{{
			Draw:(Fade_Left,0,0,160,40,#FFFFFF00)
				Additive()
				if(%pressed)
				<
					frlerp(gel.alpha,0.15,0.25)
				>
				else
				<
					:set(gel.alpha,0)
				>		
			Draw:(White,@R,3,-1,34,,#999999FF)
				set(gel.vis,twk(ControllerInput,Enabled) = 0)

			M_Text:(">",118,20,0,0,C,C,Text,KNUL25,,0,0,#00000000,NoItalics,#FFFFFFFF000000FF,ref)
				if(%pressed)
				<
					frlerp(gel.scale,1.4,0.25)
				>
				else
				<
					:set(gel.scale,1)
				>	

			M_SwitchButtonHint:(⛏,127,5)
			M_CTRLButtonExtra:(RB,false)
		}}
	PopOrigin
EndM

// Headers
Macro:(M_LeagueStandingsHeader,?X?,?Y?,?W?,?H?)
	Rect:(?X?,?Y?,?W?,?H?)
		set(gel.vis,twk(League,CurrentTab) = 1)
	{{
		Rect:(30,0,@W-60,@H)
		{{
			Rect:()
				set(gel.vis,twk(League,GroupCount) <= 1)
			{
				M_Text:(league_TABLE_POSITION_tla,5,0,50,@H,C,C,TextLoc,KNUL20,Upper,1,0,#FFFFFFFF,NoItalics,#FFFFFFFF,ref)
				M_Text:(standings_TEAM,140,0,300,@H,L,C,TextLoc,KNUL20,Upper,1,0,#FFFFFFFF,NoItalics,#FFFFFFFF,ref)	
			}

			Rect:()
				set(gel.vis,twk(League,GroupCount) > 1)
			{
				M_ArrowSwitch:(160,0,league.btn_IncreaseGroup,league.btn_DecreaseGroup)

				M_Text:(,160,0,0,@H,C,C,Text,KNUL20,Upper,1,0,#FFFFFFFF,NoItalics,#FFFFFFFF,ref)
					set(gel.text,twk(League,GroupName))
					ToUpperCase()
			}
			
			M_Text:(standings_PLAYED_tla,400,0,0,@H,C,C,TextLoc,KNUL20,Upper,1,0,#FFFFFFFF,NoItalics,#FFFFFFFF,ref)

			M_Text:(standings_WON_sla,470+[@y*0.2],0,0,@H,C,C,TextLoc,KNUL20,Upper,1,0,#FFFFFFFF,NoItalics,#FFFFFFFF,ref)
			M_Text:(standings_DREW_sla,530+[@y*0.2],0,0,@H,C,C,TextLoc,KNUL20,Upper,1,0,#FFFFFFFF,NoItalics,#FFFFFFFF,ref)
			M_Text:(standings_LOST_sla,590+[@y*0.2],0,0,@H,C,C,TextLoc,KNUL20,Upper,1,0,#FFFFFFFF,NoItalics,#FFFFFFFF,ref)

			//	Smaller font size for LTR (text overlaps)
			Rect:()
				set(gel.vis,twk(Settings,UsingLTRText)=1)
			{
				M_Text:(standings_FOR_2la,660+[@y*0.4],0,0,@H,C,C,TextLoc,KNUL17,Upper,1,0,#FFFFFFFF,NoItalics,#FFFFFFFF,ref)
				M_Text:(standings_AGAINST_2la,730+[@y*0.4],0,0,@H,C,C,TextLoc,KNUL17,Upper,1,0,#FFFFFFFF,NoItalics,#FFFFFFFF,ref)
				M_Text:(standings_DIFF_2la,800+[@y*0.4],0,0,@H,C,C,TextLoc,KNUL17,Upper,1,0,#FFFFFFFF,NoItalics,#FFFFFFFF,ref)
			}
			Rect:()
				set(gel.vis,twk(Settings,UsingLTRText)=0)
			{
				M_Text:(standings_FOR_2la,660+[@y*0.4],0,0,@H,C,C,TextLoc,KNUL20,Upper,1,0,#FFFFFFFF,NoItalics,#FFFFFFFF,ref)
				M_Text:(standings_AGAINST_2la,730+[@y*0.4],0,0,@H,C,C,TextLoc,KNUL20,Upper,1,0,#FFFFFFFF,NoItalics,#FFFFFFFF,ref)
				M_Text:(standings_DIFF_2la,800+[@y*0.4],0,0,@H,C,C,TextLoc,KNUL20,Upper,1,0,#FFFFFFFF,NoItalics,#FFFFFFFF,ref)
			}

			M_Text:(standings_POINTS,880+[@y*0.6],0,0,@H,C,C,TextLoc,KNUL20,Upper,1,0,#FFFFFFFF,NoItalics,#FFFFFFFF,ref)
			M_Text:(standings_FORM,[@R-85]-[@y*0.2],0,0,@H,C,C,TextLoc,KNUL20,Upper,1,0,#FFFFFFFF,NoItalics,#FFFFFFFF,ref)
		}}
	}}
EndM

Macro:(M_LeagueFixturesHeader,?X?,?Y?,?W?,?H?)
	Rect:(?X?,?Y?,?W?,?H?)
		set(gel.vis,twk(League,CurrentTab) = 2)
	{{
		Rect:(30,0,@W-60,@H) ref:RoundHeader
		{{
			M_ArrowSwitch:(@C,0,league.btn_IncreaseFixtureRound,league.btn_DecreaseFixtureRound)

			M_Text:(,@C,0,0,@H,C,C,Text,KNUL20,Upper,1,0,#FFFFFFFF,NoItalics,#FFFFFFFF,ref)
				set(gel.text,loc(league_FIXTURES_ROUND) :: " " :: LTR(twk(League,FixturesRound)))
				ToUpperCase()

		}}
	}}
EndM

