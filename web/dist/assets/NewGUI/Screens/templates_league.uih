Macro:(M_LeagueStandingsRow,?REF?,?PLAYER?)
	Cull:(0,0,@W,55) ref:?REF?
		M_CellPress:()
		func(ClickFunc)
		<
			Post(UI_Select)
			Post(league.row_team,0) ref:Post
		>
		Click()
		<
			callparent(0,ClickFunc)
		>
		M_CTRLCellExtra:(?BTNOK?,true,CTRLBasicSelected,0,0,6,6)
		If:(?PLAYER?)
			.CTRLSetSelected()
		EndIf
	{{
		If:(?PLAYER?)
			Draw:(Cell55Dark,-3,-2,@W+6,59)
			M_Glint:(0,0,0,@W)
			M_Text:(,5,0,50,@H,C,C,Text,KNUL28,,1,0,#FFFFFFFF,NoItalics,#FFFFFFFF,Pos)
			M_Text:(,140,0,230,@H,L,C,Text,KNUL25,,1,0,#FFFFFFFF,NoItalics,#FFFFFFFF,Name)
			M_Text:(,400,0,0,@H,C,C,Text,KNUL28,,1,0,#FFFFFFFF,NoItalics,#FFFFFFFF,Played)
			M_Text:(,470+[@y*0.2],0,0,@H,C,C,Text,KNUL28,,1,0,#FFFFFFFF,NoItalics,#FFFFFFFF,Won)
			M_Text:(,530+[@y*0.2],0,0,@H,C,C,Text,KNUL28,,1,0,#FFFFFFFF,NoItalics,#FFFFFFFF,Drawn)
			M_Text:(,590+[@y*0.2],0,0,@H,C,C,Text,KNUL28,,1,0,#FFFFFFFF,NoItalics,#FFFFFFFF,Lost)
			M_Text:(,670+[@y*0.4],0,0,@H,C,C,Text,KNUL28,,1,0,#FFFFFFFF,NoItalics,#FFFFFFFF,GoalsFor)
			M_Text:(,730+[@y*0.4],0,0,@H,C,C,Text,KNUL28,,1,0,#FFFFFFFF,NoItalics,#FFFFFFFF,GoalsAgainst)
			M_Text:(,790+[@y*0.4],0,0,@H,C,C,Text,KNUL28,,1,0,#FFFFFFFF,NoItalics,#FFFFFFFF,GoalsDifference)
			M_Text:(,880+[@y*0.6],0,0,@H,C,C,Text,KNUL28,,1,0,#FFFFFFFF,NoItalics,#FFFFFFFF,Points)
		Else
			Draw:(Cell55,-3,-2,@W+6,59)
			M_Text:(,5,0,50,@H,C,C,Text,KNUL28,,1,0,#252525FF,NoItalics,#252525FF,Pos)
			M_Text:(,140,0,230,@H,L,C,Text,KNUL25,,1,0,#252525FF,NoItalics,#252525FF,Name)
			M_Text:(,400,0,0,@H,C,C,Text,KNUL28,,1,0,#252525FF,NoItalics,#252525FF,Played)
			M_Text:(,470+[@y*0.2],0,0,@H,C,C,Text,KNUL28,,1,0,#252525FF,NoItalics,#252525FF,Won)
			M_Text:(,530+[@y*0.2],0,0,@H,C,C,Text,KNUL28,,1,0,#252525FF,NoItalics,#252525FF,Drawn)
			M_Text:(,590+[@y*0.2],0,0,@H,C,C,Text,KNUL28,,1,0,#252525FF,NoItalics,#252525FF,Lost)
			M_Text:(,660+[@y*0.4],0,0,@H,C,C,Text,KNUL28,,1,0,#252525FF,NoItalics,#252525FF,GoalsFor)
			M_Text:(,730+[@y*0.4],0,0,@H,C,C,Text,KNUL28,,1,0,#252525FF,NoItalics,#252525FF,GoalsAgainst)
			M_Text:(,800+[@y*0.4],0,0,@H,C,C,Text,KNUL28,,1,0,#252525FF,NoItalics,#252525FF,GoalsDifference)
			M_Text:(,880+[@y*0.6],0,0,@H,C,C,Text,KNUL28,,1,0,#252525FF,NoItalics,#252525FF,Points)
		EndIf

		Draw:(White,880+[@y*0.6]-40,3,80,49,,#00000010FFFFFFFF)
		M_Badge:(110,@M,SD,1,TeamBadge)

		// Place indicator
		Draw:(Cell_Stripe,,,,,,#79E53EFFFFFFFFFF) $HIDE ref:Top
		Draw:(Cell_Stripe,,,,,,#3E9CE5FFFFFFFFFF) $HIDE ref:Promotion
		Draw:(Cell_Stripe,,,,,,#E53E3EFFFFFFFFFF) $HIDE ref:Relegation

		// Change indicator
		Draw:(Icon_PosUp,50,17,20,20) $HIDE ref:MovedUp
		Draw:(Icon_PosDown,50,17,20,20) $HIDE ref:MovedDown
		Draw:(Icon_PosSame,50,17,20,20) $HIDE ref:NotMoved

		M_FormGroup:(@R-150-[@y*0.2])
		
		M_CellPressHighlight:()
	}} Template
EndM


Define:(?MOVESPEED?=0.225)
Define:(?GAPTIME?=0.4)
Macro:(M_AnimatedStandingsRow,?REF?,?PLAYER?)
	Cull:(0,0,@W,55) ref:?REF?
		//func(ClickFunc)
		//<
		//>
		//M_CTRLCellExtra:(?BTNOK?,true,CTRLBasicSelected,0,0,6,6)
		float(%position,%positionChange,%step,%stepDelay,%targetY,%timer,%displacementX,%targetX,%timerX,%focusMe)
		:set(gel.y,%targetY)
		:set(gel.x,%targetX)
		.set(%step,0)
		.set(%timer,-3)
		.set(%timerX,0)	
		.set(twk(AnimatedLeague,Animating),twk(AnimatedLeague,ShouldAnimate))
		add(%timer,FrameTime * 0.04)
		add(%timerX,FrameTime * 0.04)
		if(twk(AnimatedLeague,HasAnimatedOnce) >0)
		<
			.set(twk(AnimatedLeague,Animating),0)
		>
		if((%focusMe > 0) and(twk(AnimatedLeague,Animating)))
		<
			.set(twk(AnimatedLeague,StandingsScroll),-(gel.y-150))
		>

		// Start movement
		if(%positionChange != 0)
		<	
			if(%timer > [%stepDelay*?GAPTIME?])
			<
				set(gel.y,%targetY)
				set(%step,max(-1,min(1,%positionChange)))
				set(%targetY,gel.y - (%step * 62))
				set(%positionChange,%positionChange - %step)
				set(%timer,%timer - ?GAPTIME?)
				set(%position,%position - %step)
				:Post(UI_ChangeTab)
			>
		>

		// Start Lateral movement
		if(%displacementX > 0)
		<	
			if(%timerX > 0.5)
			<
				set(%timerX,-1.5)
				set(%targetX,%displacementX)
				set(%displacementX,-twk(AnimatedLeague,PlayerDisplacementX))
			>
		>

		// Vertical movement complete, start lateral movement back
		if(%positionChange = 0)
		<
			if(%displacementX < 0)
			<
				if(%timerX > 0.5)
				<
					set(%timerX,-1.5)
					set(%targetX,0)
					set(%displacementX,0)
					set(twk(AnimatedLeague,Animating),0)
					set(twk(AnimatedLeague,HasAnimatedOnce),1)
				>
			>
		>

		
		// Handle movement
		if(%timerX >= 0.0)
		<
			frlerp(gel.x,%targetX,?MOVESPEED?)
		>
		frlerp(gel.y,%targetY,?MOVESPEED?)
			

		// Track player's team
		if(%positionChange != 0)
		<
			if(%focusMe > 0.0)
			<
				frlerp(twk(AnimatedLeague,StandingsScroll),-(gel.y-150),?MOVESPEED?)
			>
		>
	{{
		If:(?PLAYER?)
			Draw:(Cell55Dark,-3,-2,@W+6,59)
			M_Glint:(0,0,0,@W)
		Else
			Draw:(Cell55,-3,-2,@W+6,59)
		EndIf

		Rect:()
			.set(gel.alpha,0)
			if(twk(AnimatedLeague,Animating) = 0)
			<
				frlerp(gel.alpha,1,0.1)
			>
		{
			Draw:(Cell_Stripe,,,,,,#79E53EFFFFFFFFFF) $HIDE ref:Top
			Draw:(Cell_Stripe,,,,,,#3E9CE5FFFFFFFFFF) $HIDE ref:Promotion
			Draw:(Cell_Stripe,,,,,,#E53E3EFFFFFFFFFF) $HIDE ref:Relegation

			Draw:(Icon_PosUp,50,17,20,20) $HIDE ref:MovedUp
			Draw:(Icon_PosDown,50,17,20,20) $HIDE ref:MovedDown
			Draw:(Icon_PosSame,50,17,20,20) $HIDE ref:NotMoved
		}

		M_Badge:(110,@M,SD,1,TeamBadge)


		If:(?PLAYER?)
			M_Text:(,5,0,50,@H,C,C,Text,KNUL28,,1,0,#FFFFFFFF,NoItalics,#FFFFFFFF,Pos)
				.set(gel.alpha,0)
				if(twk(AnimatedLeague,Animating) = 0)
				<
					frlerp(gel.alpha,1,0.1)
				>
			M_Text:(,140,0,230,@H,L,C,Text,KNUL25,,1,0,#FFFFFFFF,NoItalics,#FFFFFFFF,Name)
		Else
			M_Text:(,5,0,50,@H,C,C,Text,KNUL28,,1,0,#252525FF,NoItalics,#252525FF,Pos)
				.set(gel.alpha,0)
				if(twk(AnimatedLeague,Animating) = 0)
				<
					frlerp(gel.alpha,1,0.1)
				>
			M_Text:(,140,0,230,@H,L,C,Text,KNUL25,,1,0,#252525FF,NoItalics,#252525FF,Name)
		EndIf


		
		Rect:()
			.set(gel.alpha,0)
			if(twk(AnimatedLeague,Animating) = 0)
			<
				frlerp(gel.alpha,1,0.1)
			>
		{
			If:(?PLAYER?)
				M_Text:(,400,0,0,@H,C,C,Text,KNUL28,,1,0,#FFFFFFFF,NoItalics,#FFFFFFFF,Played)
				M_Text:(,470+[@y*0.2],0,0,@H,C,C,Text,KNUL28,,1,0,#FFFFFFFF,NoItalics,#FFFFFFFF,Won)
				M_Text:(,530+[@y*0.2],0,0,@H,C,C,Text,KNUL28,,1,0,#FFFFFFFF,NoItalics,#FFFFFFFF,Drawn)
				M_Text:(,590+[@y*0.2],0,0,@H,C,C,Text,KNUL28,,1,0,#FFFFFFFF,NoItalics,#FFFFFFFF,Lost)
				M_Text:(,660+[@y*0.4],0,0,@H,C,C,Text,KNUL28,,1,0,#FFFFFFFF,NoItalics,#FFFFFFFF,GoalsFor)
				M_Text:(,730+[@y*0.4],0,0,@H,C,C,Text,KNUL28,,1,0,#FFFFFFFF,NoItalics,#FFFFFFFF,GoalsAgainst)
				M_Text:(,800+[@y*0.4],0,0,@H,C,C,Text,KNUL28,,1,0,#FFFFFFFF,NoItalics,#FFFFFFFF,GoalsDifference)
				M_Text:(,880+[@y*0.6],0,0,@H,C,C,Text,KNUL28,,1,0,#FFFFFFFF,NoItalics,#FFFFFFFF,Points)
			Else
				M_Text:(,400,0,0,@H,C,C,Text,KNUL28,,1,0,#252525FF,NoItalics,#252525FF,Played)
				M_Text:(,470+[@y*0.2],0,0,@H,C,C,Text,KNUL28,,1,0,#252525FF,NoItalics,#252525FF,Won)
				M_Text:(,530+[@y*0.2],0,0,@H,C,C,Text,KNUL28,,1,0,#252525FF,NoItalics,#252525FF,Drawn)
				M_Text:(,590+[@y*0.2],0,0,@H,C,C,Text,KNUL28,,1,0,#252525FF,NoItalics,#252525FF,Lost)
				M_Text:(,660+[@y*0.4],0,0,@H,C,C,Text,KNUL28,,1,0,#252525FF,NoItalics,#252525FF,GoalsFor)
				M_Text:(,730+[@y*0.4],0,0,@H,C,C,Text,KNUL28,,1,0,#252525FF,NoItalics,#252525FF,GoalsAgainst)
				M_Text:(,800+[@y*0.4],0,0,@H,C,C,Text,KNUL28,,1,0,#252525FF,NoItalics,#252525FF,GoalsDifference)
				M_Text:(,880+[@y*0.6],0,0,@H,C,C,Text,KNUL28,,1,0,#252525FF,NoItalics,#252525FF,Points)
			EndIf

			Draw:(White,880+[@y*0.6]-40,3,80,49,,#00000010)
			M_FormGroup:(@R-150-[@y*0.2])
		}
	}} Template
EndM