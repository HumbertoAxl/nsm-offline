// Cells
Macro:(M_LeagueFixtureRow,?REF?,?PLAYER?)
	Cull:(0,0,@W,55) ref:?REF?
		M_CellPress:()
		func(ClickFunc)
		<
			Post(UI_Select)
		 	Post(fixtures.btn_MatchInfo,0) ref:Post
		>
		Click()
		<
			callparent(0,ClickFunc)
		>
		M_CTRLCellExtra:(?BTNOK?,true,CTRLBasicSelected,0,0,6,6)
		If:(?PLAYER?)
			.CTRLSetSelected()
		EndIf
	{{
		If:(?PLAYER?)
			Draw:(Cell55Dark,-3,-2,@W+6,59)
			M_Glint:(0,0,0,@W)
			M_Text:("",20,0,0,@H,L,C,Text,KNUL28,,1,0,#FFFFFFFF,NoItalics,#FFFFFFFF,HomePosition)
			M_Text:("",@R-20,0,0,@H,R,C,Text,KNUL28,,1,0,#FFFFFFFF,NoItalics,#FFFFFFFF,AwayPosition)
			M_Text:("",20,0,0,@H,L,C,Text,KNUL28,,1,0,#FFFFFFFF,NoItalics,#FFFFFFFF,HomeCompetition)
			M_Text:("",@R-20,0,0,@H,R,C,Text,KNUL28,,1,0,#FFFFFFFF,NoItalics,#FFFFFFFF,AwayCompetition)
			M_Text:(New Star,@C-160,0,0,@H,R,C,Text,KNUL25,,1,0,#FFFFFFFF,NoItalics,#FFFFFFFF,?REF?)
			M_Text:(Dagenham,@C+160,0,0,@H,L,C,Text,KNUL25,,1,0,#FFFFFFFF,NoItalics,#FFFFFFFF,?REF?)
			M_Text:("00",@C-10,0,0,@H,R,C,Text,KNUL28,,1,0,#FFFFFFFF,NoItalics,#FFFFFFFF,?REF?)
			M_Text:("00",@C+10,0,0,@H,L,C,Text,KNUL28,,1,0,#FFFFFFFF,NoItalics,#FFFFFFFF,?REF?)
			M_Text:("-",@C,0,0,@H,C,C,Text,KNUL25,,1,0,#FFFFFFFF,NoItalics,#FFFFFFFF,?REF?)
		Else
			Draw:(Cell55,-3,-2,@W+6,59)
			M_Text:("",20,0,0,@H,L,C,Text,KNUL28,,1,0,#252525FF,NoItalics,#252525FF,HomePosition)
			M_Text:("",@R-20,0,0,@H,R,C,Text,KNUL28,,1,0,#252525FF,NoItalics,#252525FF,AwayPosition)
			M_Text:("",20,0,0,@H,L,C,Text,KNUL28,,1,0,#252525FF,NoItalics,#252525FF,HomeCompetition)
			M_Text:("",@R-20,0,0,@H,R,C,Text,KNUL28,,1,0,#252525FF,NoItalics,#252525FF,AwayCompetition)
			M_Text:(New Star,@C-160,0,0,@H,R,C,Text,KNUL25,,1,0,#252525FF,NoItalics,#252525FF,?REF?)
			M_Text:(Dagenham,@C+160,0,0,@H,L,C,Text,KNUL25,,1,0,#252525FF,NoItalics,#252525FF,?REF?)
			M_Text:("00",@C-10,0,0,@H,R,C,Text,KNUL28,,1,0,#252525FF,NoItalics,#252525FF,?REF?)
			M_Text:("00",@C+10,0,0,@H,L,C,Text,KNUL28,,1,0,#252525FF,NoItalics,#252525FF,?REF?)
			M_Text:("-",@C,0,0,@H,C,C,Text,KNUL25,,1,0,#252525FF,NoItalics,#252525FF,?REF?)
		EndIf

		Draw:(Cell_Fixture_Separator,@C-80,3)
		Draw:(Cell_Fixture_Separator,@C+80,3)

		M_Badge:(@C-120,@M,SD,1,TeamHomeBadge)
		M_Badge:(@C+120,@M,SD,1,TeamAwayBadge)

		M_CellPressHighlight:()
	}} Template
EndM

Macro:(M_FormItem,?X?,?Y?,?ALPHA?)
	Rect:(?X?,?Y?) ref:Form
		set(gel.colour,?ALPHA?FFFFFFFF)
	{{
		Rect:() $HIDE ref:Win
		{
			Draw:(RoundedPanel,0,0,24,24)
				.set(gel.colour,twk(FormColours,Win))
			M_Text:(standings_WON_sla,12,0,0,24,C,C,TextLoc,KNUL20,Upper,1,0,#FFFFFFFF,NoItalics,#FFFFFFFFFFFFFFFF,Form1)
		}

		Rect:() $HIDE ref:Draw
		{
			Draw:(RoundedPanel,0,0,24,24)
				.set(gel.colour,twk(FormColours,Draw))
			M_Text:(standings_DREW_sla,12,0,0,24,C,C,TextLoc,KNUL20,Upper,1,0,#FFFFFFFF,NoItalics,#FFFFFFFFFFFFFFFF,Form1)
		}

		Rect:() $HIDE ref:Loss
		{
			Draw:(RoundedPanel,0,0,24,24)
				.set(gel.colour,twk(FormColours,Loss))
			M_Text:(standings_LOST_sla,12,0,0,24,C,C,TextLoc,KNUL20,Upper,1,0,#FFFFFFFF,NoItalics,#FFFFFFFFFFFFFFFF,Form1)
		}
	}}
EndM

