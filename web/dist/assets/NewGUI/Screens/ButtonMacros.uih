Macro:(M_DefaultButtonAudio)
	if(not(%disabled))
	<
		if(%clicked)
		<
			Post(UI_Select)
		>
	>
EndM

Macro:(M_ForwardButtonAudio)
	if(not(%disabled))
	<
		if(%clicked)
		<
			Post(UI_Select)
		>
	>
EndM

Macro:(M_BackButtonAudio)
	if(not(%disabled))
	<
		if(%clicked)
		<
			Post(UI_Back)
		>
	>
EndM

Macro:(M_NoButtonAudio)

EndM

Macro:(M_PressOPEN,?X?,?Y?,?W?,?H?,?LINK?,?REF?,?AUDIOMACRO?)
	Rect:(?X?,?Y?,?W?,?H?,,#FFFFFFFF000000FF) ref:?REF?
		float(%disabled,%pressed,%leftPressed,%rightPressed,%clicked,%leftClicked,%rightClicked)
		//JF: Reset it when hidden - child reset not triggered
		if(gel.vis = 0)
		<
			:set(%clicked,0)
			:set(%pressed,0)
			:set(%leftPressed,0)
			:set(%rightPressed,0)
			:set(%leftClicked,0)
			:set(%rightClicked,0)
		>
		func(ZoneClicked)
		<
			callchild(PressClick,ButtonClicked)
		>
		Handle(0.5,0.5)
	{{
		Spine:(NSM_UI,0,0,,ButtonUniform,Once)
			if(twk(ControllerInput,Enabled) = 0)
			<
				:set(gel.anim.normtime,1)
				:set(gel.anim.speed,0)
				if(%pressed = 1)
				<
					:set(gel.anim.speed,0)
					:set(gel.anim.normtime,0)
				>
				else
				<
					:set(gel.anim.speed,2)
				>
			>
			else
			<
				:set(gel.anim.normtime,1)
				:set(gel.anim.speed,0)
			>
		{
			Rect:(0,0,?W?,?H?,,#FFFFFF00000000FF) ref:PressClick
				Slot(NSM_UI)
				Handle(0.5,0.5)
				if(%disabled)
				<
					set(gel.alpha,0.5)
					:set(%pressed,0)
					:set(%leftPressed,0)
					:set(%rightPressed,0)
				>
				else
				<
					set(gel.alpha,1)
					if(twk(ControllerInput,Enabled) = 0)
					<
						Press()
						<
							:set(%pressed,1)

							if(TouchX < gel.gx)
							<
								:set(%leftPressed,1)
								:set(%rightPressed,0)
							>
							else
							<
								:set(%rightPressed,1)
								:set(%leftPressed,0)
							>
						>
						else
						<
							:set(%pressed,0)
							:set(%leftPressed,0)
							:set(%rightPressed,0)
						>
					>

					// Click
					set(%clicked,0)
					set(%leftClicked,0)
					set(%rightClicked,0)
					Click()
					<
						if(TouchX < gel.gx)
						<
							set(%leftClicked,1)
						>
						else
						<
							set(%rightClicked,1)
						>
						callparent(0,ButtonClicked)
					>
				>

				func(ButtonClicked)
				<
					set(%clicked,1)
					Post(?LINK?)
					If:(?AUDIOMACRO?)
						£M_?AUDIOMACRO?:()
					Else
						M_DefaultButtonAudio:()
					EndIf
				>


			{{
				Rect:(@L,@T,@W,@H,,#FFFFFFFF000000FF)
				{{
EndM

Macro:(M_PressCLOSE)
				}}
			}}
		}
	}}
EndM





// ---------------------------------------------------------------------------------------------------------------------------------
Macro:(M_Button,?X?,?Y?,?W?,?H?,?IMAGE?,?ICON?,?IX?,?IY?,?IW?,?IH?,?ICOL?,?LINK?,?REF?,?TEXT?,?TX?,?TY?,?HALIGN?,?VALIGN?,?TYPE?,?SIZE?,?CASE?,?SHX?,?SHY?,?SHCOL?,?ITALICISE?,?COL?,?TEXTREF?,?INITTEXTONLY?,?AUDIOMACRO?,?PREFIX?)
	M_PressOPEN:(?X?,?Y?-5,?W?,?H?,?LINK?,?REF?,?AUDIOMACRO?)
		Draw:(Button_Shadow,-11,-5,@W+22,@H+21,,#00000080000000FF)
			set(gel.vis,not(%disabled))
		Draw:(?IMAGE?,0,0,@W,@H)
		If:(?ICON?)
			Draw:(?ICON?,?IX?,?IY?,?IW?,?IH?,0,?ICOL?000000FF)
		EndIf
		Draw:(Button_Shade,0,@M,@W,[@H/2],,#00000010FFFFFFFF)

		M_Text:(,?TX?,?TY?-2,@W,@H,?HALIGN?,?VALIGN?,?TYPE?,?SIZE?,,?SHX?,?SHY?,?SHCOL?,?ITALICISE?,?COL?,?TEXTREF?)
			If:(?INITTEXTONLY?)
				strvar(%buttonText)
				init(%buttonText,?CASE?(?TEXT?))
				.set(gel.text,%buttonText)
			Else 
				If:("?PREFIX?"<>"")
					if(twk(ControllerInput,Enabled))
					<
						// PB-The additional space before ?PREFIX? is to allow the font glyph and text to autoscroll fully, rather than go into the font and correct the off-centering of all glyphs.
						set(gel.text,?CASE?(" "::(?PREFIX?)::(?TEXT?)))
					>
					else
					<
						set(gel.text,?CASE?(?TEXT?))
					>
				Else
					set(gel.text,?CASE?(?TEXT?))
				EndIf
			EndIf
			//If:(?CASE?="Upper")
			//	ToUpperCase()
			//EndIf
		Draw:(RoundedPanel,0,0,@W,@H,,#FFFFFF00)
			Layer(AboveText)
			Additive()
			if(%pressed)
			<
				set(gel.colour,#60606060)
			>
			else
			<
				frlerp(gel.colour,#00000000,0.05)
			>
	M_PressCLOSE:()
		Layer(AboveText)
		LockLayer()
EndM
// ---------------------------------------------------------------------------------------------------------------------------------
Macro:(M_ButtonZone,?X?,?Y?,?W?,?H?)
	{
		Rect:(?X?,?Y?,?W?,?H?)
			Layer(Default)
			LockLayer()
			Press()
			<
				:set(%pressed,1)
			>
			else
			<
				:set(%pressed,0)
			>
			Click()
			<
				callparent(1,ZoneClicked)
			>
	}
EndM
// ---------------------------------------------------------------------------------------------------------------------------------
Macro:(M_RepeatPressAction,?LINK?)
	float(%t,%r)
	if(%pressed)
	<
		:Post(UI_Select)
		:set(%t,0)
		:set(%r,0)
		add(%t,FrameTime)
		:set(%r,0)
		add(%r,0.1)
		:Message(?LINK?)
		:Delay(0.6)
		if(%t > max(1,[10-%r]))
		<
			Message(?LINK?)
			set(%t,0)
		>
	>
EndM
// ---------------------------------------------------------------------------------------------------------------------------------
Macro:(M_ImageButton,?X?,?Y?,?ZONEW?,?ZONEH?,?IX?,?IY?,?IW?,?IH?,?ICON?,?ICOL?,?LINK?,?AUDIOMACRO?)
	Rect:(?X?,?Y?,?ZONEW?,?ZONEH?,,#FFFFFFFFFFFFFFFF) ref:PressClick
		Layer(AboveText)
		LockLayer()
		Handle(0.5,0.5)
		float(%disabled,%pressed,%clicked)
		if(gel.vis = 0)
		<
			:set(%pressed,0)
			:set(%clicked,0)
		>

		if(%disabled)
		<
			set(gel.alpha,0.5)
			:set(%pressed,0)
		>
		else
		<
			set(gel.alpha,1)

			// Press
			if(%pressed)
			<
				set(gel.scale,1.25)
			>
			else
			<
				frlerp(gel.scale,1,0.1)
			>

			Press()
			<
				set(%pressed,1)
			>
			else
			<
				set(%pressed,0)
			>

			// Click
			set(%clicked,0)
			Click()
			<
				callparent(0,ButtonClicked)
			>
		>

		func(ButtonClicked)
		<
			set(%clicked,1)
			Post(?LINK?)
			If:(?AUDIOMACRO?)
				£M_?AUDIOMACRO?:()
			Else
				M_DefaultButtonAudio:()
			EndIf
		>
	{{
		Draw:(?ICON?,?IX?,?IY?,?IW?,?IH?,,?ICOL?FFFFFFFF)
			Handle(0.5,0.5)
	}}
EndM
// ---------------------------------------------------------------------------------------------------------------------------------
Macro:(M_CTRLButtonExtra,?BUTTON?,?FOCUS?,?ANIM?,?X?,?Y?,?W?,?H?)
	float(%disabled)
	If:(?ANIM?)
		CTRLSelect(?ANIM?,?X?,?Y?,?W?,?H?)
	EndIf
	if(%disabled = 0)
	<
		CTRLPress(?BUTTON?,?FOCUS?)
		<
			set(%pressed,1)
		>
		else
		<
			set(%pressed,0)
		>
		CTRLClick(?BUTTON?,?FOCUS?)
		<
			callchild(PressClick,ButtonClicked)
		>
	>
EndM
// ---------------------------------------------------------------------------------------------------------------------------------
Macro:(M_CTRLButtonAndShortcutExtra,?BUTTON?,?ANIM?,?X?,?Y?,?W?,?H?,?SHORTCUT?,?REF?)
	float(%disabled)
	If:(?ANIM?)
		CTRLSelect(?ANIM?,?X?,?Y?,?W?,?H?)
	EndIf
	if(%disabled = 0)
	<
		set(%pressed,0)
		// Button
		CTRLPress(?BUTTON?,true)
		<
			set(%pressed,1)
		>
		CTRLClick(?BUTTON?,true)
		<
			callchild(PressClick,ButtonClicked)
		>

		// Shortcut button
		CTRLPress(?SHORTCUT?,false)
		<
			set(%pressed,1)
			If:(?REF?)
				CTRLSetSelected(?REF?)
			EndIf
		>
		CTRLClick(?SHORTCUT?,false)
		<
			callchild(PressClick,ButtonClicked)
		>
	>
EndM
// ---------------------------------------------------------------------------------------------------------------------------------
Macro:(M_CTRLButtonLRExtra,?BUTTON?,?FOCUS?,?ANIM?,?X?,?Y?,?W?,?H?,?SIDE?)
	float(%disabled)
	If:(?ANIM?)
		CTRLSelect(?ANIM?,?X?,?Y?,?W?,?H?)
	EndIf
	if(%disabled = 0)
	<
		CTRLPress(?BUTTON?,?FOCUS?)
		<
			If:(?SIDE?=L)
				set(%leftPressed,1)
			EndIf
			If:(?SIDE?=R)
				set(%rightPressed,1)
			EndIf
		>
		else
		<
			If:(?SIDE?=L)
				set(%leftPressed,0)
			EndIf
			If:(?SIDE?=R)
				set(%rightPressed,0)
			EndIf
		>
		CTRLClick(?BUTTON?,?FOCUS?)
		<
			If:(?SIDE?=L)
				set(%leftClicked,1)
			EndIf
			If:(?SIDE?=R)
				set(%rightClicked,1)
			EndIf
			callparent(1,ZoneClicked)
		>
	>
EndM
// ---------------------------------------------------------------------------------------------------------------------------------
Macro:(M_CTRLGenericClickableExtra,?BUTTON?,?SELECTED?,?ANIM?,?X?,?Y?,?W?,?H?)
	float(%clicked,%pressed)
	set(%clicked,0)
	set(%pressed,0)
	If:(?ANIM?)
		CTRLSelect(?ANIM?,?X?,?Y?,?W?,?H?)
	EndIf
	CTRLClick(?BUTTON?,?SELECTED?)
	<
		set(%clicked,1)
	>
	CTRLPress(?BUTTON?,?SELECTED?)
	<
		set(%pressed,1)
	>
EndM
// ---------------------------------------------------------------------------------------------------------------------------------
Macro:(M_CTRLImageButtonExtra,?BUTTON?,?ANIM?,?X?,?Y?,?W?,?H?)
	CTRLSelect(?ANIM?,?X?,?Y?,?W?,?H?)
	CTRLPress(?BUTTON?)
	<
		set(%pressed,1)
	>
	else
	<
		set(%pressed,0)
	>
	CTRLClick(?BUTTON?)
	<
		callparent(0,ButtonClicked)
	>
EndM
// ---------------------------------------------------------------------------------------------------------------------------------
Macro:(M_CTRLCellExtra,?BUTTON?,?FOCUS?,?ANIM?,?X?,?Y?,?W?,?H?)
	If:(?ANIM?)
		CTRLSelect(?ANIM?,?X?,?Y?,?W?,?H?)
	EndIf
	CTRLClick(?BUTTON?,?FOCUS?)
	<
		call(ClickFunc)
	>
	CTRLPress(?BUTTON?,?FOCUS?)
	<
		set(%pressed,1)
	>
EndM
// ---------------------------------------------------------------------------------------------------------------------------------